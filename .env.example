# ──────────────────────────────────────────────────────────────────────────────
# Selma Configuration — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# Priority: CLI arguments > Environment variables > pyproject.toml
#
# All paths below are relative to the project root where pyproject.toml lives,
# unless you use absolute paths.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Directive Paths (required) ──────────────────────────────────────────────
# Root directory containing policy/ and rule/ subdirectories
SELMA_DIRECTIVE_ROOT=directive

# Directory with policy definitions (YAML)
SELMA_DIRECTIVE_POLICY_DIR=directive/policy

# Directory with rule definitions (JSON)
SELMA_DIRECTIVE_RULE_DIR=directive/rule

# ─── Schema Paths (required) ─────────────────────────────────────────────────
# Root directory containing schema files
SELMA_SCHEMA_ROOT=schema

# Rule schema JSON file
SELMA_SCHEMA_RULE_SCHEMA=schema/rule_schema.json

# Policy doctrine YAML file
SELMA_SCHEMA_POLICY_DOCTRINE=schema/policy_doctrine.yaml

# ─── Lint Target Paths (required) ────────────────────────────────────────────
# Comma-separated directories/files to lint
SELMA_PATHS_INCLUDE=src,tests

# Comma-separated glob patterns to exclude
SELMA_PATHS_EXCLUDE=__pycache__,*.pyc,.git,.venv,build,dist,*.egg-info

# Comma-separated file extensions to lint
SELMA_PATHS_EXTENSIONS=.py

# ─── Output ──────────────────────────────────────────────────────────────────
# Output format: default, json, gcc, guidance
SELMA_OUTPUT_FORMAT=default

# Include guidance in output (true/false/yes/1)
SELMA_OUTPUT_GUIDE=false

# Output file path (empty = stdout)
SELMA_OUTPUT_FILE=

# Enable colored output (true/false)
SELMA_OUTPUT_COLOR=true

# ─── Execution ───────────────────────────────────────────────────────────────
# Skip external tools (true/false)
SELMA_EXECUTION_SKIP_TOOLS=false

# Skip AST rules (true/false)
SELMA_EXECUTION_SKIP_AST=false

# Run only one check (empty = all checks)
SELMA_EXECUTION_ONLY=

# Maximum parallel workers
SELMA_EXECUTION_MAX_WORKERS=4

# Per-file timeout in seconds
SELMA_EXECUTION_FILE_TIMEOUT=30

# ─── Rules Filter ────────────────────────────────────────────────────────────
# Comma-separated rule codes to disable (empty = none disabled)
SELMA_RULES_DISABLED=

# Only run these rule codes (empty = all rules)
SELMA_RULES_CODES=

# Exclude these rule codes (empty = none excluded)
SELMA_RULES_EXCLUDE_CODES=

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SELMA_LOGGING_LEVEL=WARNING

# Log format string
SELMA_LOGGING_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log file path (empty = stderr)
SELMA_LOGGING_FILE=
