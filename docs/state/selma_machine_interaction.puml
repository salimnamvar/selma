@startuml selma_machine_interaction
' ============================================================
' Selma — State Machine Interaction Overview
' Source:  docs/c4-model/c4_selma_component.puml + docs/state-machine ownership
' Contract: 1.1.0
' Role:    Cross-machine handoff overview (behavior only; C4 owns structure)
' ============================================================

title Selma — State Machine Interaction Overview\n<size:12><i>C4 handoffs · FSMs · domain service · offline tool · not freestanding engines</i></size>

!include ./common/sm_styles.puml

state "Capability Authorization" as Authz #B9770E : **api gate (cross-cutting)**\ningress · matrix · SoD · stage\nallow | deny + audit
state "Directive Lifecycle" as Dir #2C6E49 : C4: directives_application\nDraft · Active\nDeprecated · Superseded
state "Compilation / CG-IR" as Comp #1B7A6E : C4: compilation_application\nhermetic gates · CAS publish
state "CG-IR Hash Detail" as Hash #1B7A6E : dual-hash · reuse\n(detail of Comp)
state "Inspection Execution" as Insp #1B7A6E : C4: inspections_application\nsix pure stages
state "Finding Lifecycle" as Find #3B7DD8 : C4: findings_application\n**normative** · 11 states · SoD
state "HLC Detail" as Hlc #3B7DD8 : (pt, lc) advance\n(detail of event envelope)
state "Conflict Resolution" as Conf #1B7A6E : domain ResolveConflict\n(not a C4 peer) · artifacts
state "Architectural Certification" as Cert #B9770E : certification_tool\n(offline/CI · not C4 peer)
state "Artifact Lifecycle" as Art #4A4A4A : C4: artifacts_repository\nwrite-once · four kinds

[*] --> Authz : <b>MutatingRequestReceived</b>
Authz --> Dir : <b>AuthzAllowedDirective</b>\n[capability directive.*]
Authz --> Insp : <b>AuthzAllowedInspection</b>\n[capability inspection.*]
Authz --> Find : <b>AuthzAllowedFinding</b>\n[capability finding.* | evidence.*]
Authz --> Conf : <b>AuthzAllowedConflict</b>\n[capability conflict.resolve]
Authz --> [*] : <b>AuthzDenied</b>\nDomainUnchanged

Dir --> Comp : <b>CompileRequested</b>\npublish / identity op
Comp --> Hash : <b>HashDetailEntered</b>\nHash Nodes zoom
Hash --> Comp : <b>HashDetailReturned</b>\nsnapshot hash ready
Comp --> Art : <b>CgIrPublished</b>
Dir --> Art : <b>DirectiveRecorded</b>

Insp --> Comp : <b>CgIrPinned</b>\npin cg_ir_snapshot_hash
Insp --> Find : <b>FindingsBirthed</b>\nFindingCreated on Report
Insp --> Art : <b>InspectionArtifactPublished</b>\nsnapshot + trace
Insp --> Conf : <b>ConflictDetected</b>\nmulti-rule fire on frozen CG-IR

Find --> Hlc : <b>FindingEventAppended</b>\nevery success event
Hlc --> Find : <b>HlcTagged</b>\ntag logical_clock
Find --> Art : <b>FindingEventAppended</b>\nappend finding_events

Conf --> Art : <b>ConflictArtifactPublished</b>
Comp --> Conf : <b>ConflictDetected</b>\ncompile-time conflict map

Cert --> Art : <b>CertificationArtifactPublished</b>
Cert --> Comp : <b>CertificationSamplesRead</b>\nread CG-IR samples
Cert --> Find : <b>CertificationSamplesRead</b>\nSoD / mediated-feedback tests\n(no production mutation)

Art --> [*] : <b>ArtifactRetained</b>\narchived / retained

@enduml
