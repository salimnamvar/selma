@startuml state_machine_005_conflict_resolution
' ============================================================
' Title:     State Machine 005 Conflict Resolution
' Source:    docs/spec/contracts/conflict/detection.yaml
'            docs/spec/contracts/conflict/precedence.yaml
' C4:        ResolveConflict (domain · not peer) used by compilation_application | inspections_application
'            artifacts → artifacts_repository → artifacts_store
' Package:   conflicts_domain
' Contract:  1.3.0
' ============================================================

title **State Machine 005 — Conflict Resolution**\nC4: ResolveConflict (domain · not peer) · compilation_application | inspections_application\n<size:12><i>within-lineage binding · cross-lineage advisory · artifacts</i></size>

!include ./common/state_styles.puml
!include ./common/state_identities.puml

[*] --> DetectPair : <b>ConflictDetectionStarted</b>\nactor: System (compilation_application | inspections_application)\ncommand: consistency review | multi-rule fire\non frozen compiled rules snapshot\nstory: US-CD-001 / US-PR-001

state "Detect\nConflicting Pair" as DetectPair $STATE_COLOR_PENDING : **entry** scan conflicts_with or\noutcome contradiction\n(same lineage, both Fail,\ncontradictory deontics)\n**allowed** pair classify only\n**forbidden** mutate findings
state "No Conflict" as NoConflict $STATE_COLOR_STORE : **entry** no pair / both Pass\nPass+Fail / same-type Fail\n**allowed** terminal no-op\n**forbidden** artifact creation
state "Scope Check" as ScopeCheck $STATE_COLOR_PROCESS : **entry** compare lineage_id\n**allowed** branch binding vs advisory\n**forbidden** cross-lineage bind

' ---------- Hierarchical cascade (within-lineage binding) ----------
state "Binding Cascade" as BindingCascade $STATE_COLOR_PROCESS {
  [*] --> ExplicitOverride
  state "1. Explicit\nOverride" as ExplicitOverride $STATE_COLOR_PROCESS : **entry** always_wins | never_wins |\ndefer_to (execution id)\n**allowed** single override win\n**forbidden** self-ref defer_to (fall through)\ncycles (DFS) → ignore all defer_to
  state "2. Compatible\nOverrides" as CompatibleOverrides $STATE_COLOR_PROCESS : **entry** compatible_overrides()\nsymmetric pairs or identical defer_to\n**allowed** resolve or fall through\n**forbidden** partial bind on dual conflict
  state "3. Priority" as PriorityCheck $STATE_COLOR_PROCESS : **entry** lower priority_level wins\n1 constitutional … 5 advisory\n**allowed** strict winner or tie advance
  state "4. Specificity" as SpecificityCheck $STATE_COLOR_PROCESS : **entry** score = scope×100 + bound_fields\n**allowed** strict winner or tie advance
  state "5. Recency" as RecencyCheck $STATE_COLOR_PROCESS : **entry** newer created_at wins\nfrozen in node_body\n**allowed** strict later or artifact on identical ts

  ExplicitOverride --> CompatibleOverrides : <b>ConflictOverrideFallthrough</b>\nactor: System\n[noneOrDualOrAmbiguousOverride]
  CompatibleOverrides --> PriorityCheck : <b>ConflictFallthroughPriority</b>\nactor: System
  PriorityCheck --> SpecificityCheck : <b>ConflictFallthroughSpecificity</b>\nactor: System\n[priorityTie]
  SpecificityCheck --> RecencyCheck : <b>ConflictFallthroughRecency</b>\nactor: System\n[specificityTie]
}

state "Resolved\nBinding" as ResolvedBinding $STATE_COLOR_STORE : **entry** winner recorded · loser adjusted\n**allowed** terminal bind on frozen compiled rules snapshot\n**forbidden** rewrite compiled rules snapshot nodes
state "Conflict Artifact\nPending" as ArtifactPending $STATE_COLOR_GATE : **entry** requires human resolve\n**allowed** escalate to Official\n**forbidden** auto-bind

' ---------- Hierarchical human artifact path ----------
state "Human Artifact Path" as HumanArtifactPath $STATE_COLOR_PENDING {
  [*] --> HumanReview
  state "Human Review" as HumanReview $STATE_COLOR_PENDING : **entry** Official reviews artifact\n**allowed** resolve | deny/defer\n**forbidden** unauthenticated resolve
  state "Artifact\nResolved" as ArtifactResolved $STATE_COLOR_STORE : **entry** decision on same frozen snapshot\n**allowed** archive\n**forbidden** silent compiled rules intermediate representation rewrite
  state "Artifact\nRejected" as ArtifactRejected $STATE_COLOR_GATE : **entry** no change · remains open\n**allowed** reopen review\n**forbidden** partial resolution write
  state "Artifact\nArchived" as ArtifactArchived $STATE_COLOR_TERMINAL : **entry** immutable retention **terminal**\n**allowed** read-only audit\n**forbidden** mutate decision

  HumanReview --> ArtifactResolved : <b>ConflictArtifactResolved</b>\nactor: Regulatory Official\ncommand: conflict.resolve\n[capability: conflict.resolve]\n/ recordDecisionOnFrozenSnapshot()
  HumanReview --> ArtifactRejected : <b>ConflictArtifactRejected</b>\nactor: Regulatory Official\ncommand: deny / defer\n[capability: conflict.resolve]\n/ denialAuditArtifactStaysOpen()
  ArtifactResolved --> ArtifactArchived : <b>ConflictArtifactArchived</b>\nactor: System
  ArtifactRejected --> HumanReview : <b>ConflictReviewReopened</b>\nactor: Regulatory Official\n[capability: conflict.resolve]
  ArtifactArchived --> [*] : <b>Finalized</b>\nactor: System
}

' ---------- Cross-lineage advisory (read-only cascade abstraction) ----------
state "Advisory Path" as AdvisoryPath $STATE_COLOR_PROCESS {
  [*] --> AdvisoryCascade
  state "Run Precedence\nRead-Only" as AdvisoryCascade $STATE_COLOR_PROCESS : **entry** same cascade · no binding mutation\n**allowed** advisory signal only\n**forbidden** finding state machine / compiled rules intermediate representation write
  state "Advisory\nArtifact" as AdvisoryArtifact $STATE_COLOR_PENDING : **entry** binding_status=advisory\nrequires_human_action=true\n**allowed** human directive change → recompile\n**forbidden** auto-mutate findings/compiled rules intermediate representation
  state "No Advisory" as NoAdvisory $STATE_COLOR_STORE : **entry** no residual cross-lineage signal\n**allowed** terminal

  AdvisoryCascade --> AdvisoryArtifact : <b>ConflictAdvisoryEmitted</b>\nactor: System
  AdvisoryCascade --> NoAdvisory : <b>ConflictAdvisoryNone</b>\nactor: System
  AdvisoryArtifact --> [*] : <b>Finalized</b>\nactor: System
  NoAdvisory --> [*] : <b>Finalized</b>\nactor: System
}

DetectPair --> NoConflict : <b>ConflictNone</b>\nactor: System
DetectPair --> ScopeCheck : <b>ConflictPairDetected</b>\nactor: System
NoConflict --> [*] : <b>Finalized</b>\nactor: System

ScopeCheck --> BindingCascade : <b>ConflictBindingScope</b>\nactor: System\ncommand: enter binding cascade\n[sameLineageId]
ScopeCheck --> AdvisoryPath : <b>ConflictAdvisoryScope</b>\nactor: System\ncommand: enter advisory cascade\n[differentLineageId]

' External exits from cascade substates
ExplicitOverride --> ResolvedBinding : <b>ConflictResolvedBinding</b>\nactor: System\n/ winnerRecorded()
CompatibleOverrides --> ResolvedBinding : <b>ConflictResolvedBinding</b>\nactor: System
CompatibleOverrides --> ArtifactPending : <b>ConflictArtifactOpened</b>\nactor: System
PriorityCheck --> ResolvedBinding : <b>ConflictResolvedBinding</b>\nactor: System
SpecificityCheck --> ResolvedBinding : <b>ConflictResolvedBinding</b>\nactor: System
RecencyCheck --> ResolvedBinding : <b>ConflictResolvedBinding</b>\nactor: System
RecencyCheck --> ArtifactPending : <b>ConflictArtifactOpened</b>\nactor: System

ResolvedBinding --> [*] : <b>Finalized</b>\nactor: System

ArtifactPending --> HumanArtifactPath : <b>ConflictReviewOpened</b>\nactor: System\ncommand: open human review queue
HumanArtifactPath --> [*] : <b>Finalized</b>\nactor: System
AdvisoryPath --> [*] : <b>Finalized</b>\nactor: System

footer State Machine 005 · Contract 1.1.0 · conflicts_domain · Selma

@enduml
