@startuml sm_010_cgir_hash_chain
' ============================================================
' Title:     SM-010 CG-IR Hash Composition
' Source:    docs/spec/contracts/compilation/pipeline.yaml
'            docs/spec/contracts/compilation/hermetic_boundary.yaml
' C4:        compilation_application → compiled_rules_repository → compiled_rules_store
' Package:   compiled_rules_application (detail of SM-003)
' Contract:  1.1.0
' ============================================================

title **SM-010 — CG-IR Hash Composition**\nC4: compilation_application → compiled_rules_repository → compiled_rules_store\n<size:12><i>dual-hash · local identity · CAS dedup · compiled_at excluded</i></size>

!include ./common/sm_styles.puml

[*] --> NodeBodyLoaded : <b>HashChainStarted</b>\nactor: System (compilation_application)\ncommand: load semantic_body + presentation_body

state "Node Body\nLoaded" as NodeBodyLoaded #B9770E : **entry** semantic_body + presentation_body\n**allowed** enter DualHash\n**forbidden** neighbor embedding

' ---------- Orthogonal dual-hash (AND-decomposition) ----------
state "Dual Hash" as DualHash #1B7A6E {
  state "Semantic Region" as SemRegion {
    [*] --> SemanticHashComputed
    state "Semantic Hash\nComputed" as SemanticHashComputed #1B7A6E : **entry** SHA-256(canonical_json(semantic_body))\n**forbidden** include presentation fields
    SemanticHashComputed --> [*] : <b>SemanticHashReady</b>\nactor: System
  }
  --
  state "Presentation Region" as PresRegion {
    [*] --> PresentationHashComputed
    state "Presentation Hash\nComputed" as PresentationHashComputed #1B7A6E : **entry** SHA-256(canonical_json(presentation_body))\n**forbidden** alter semantic_hash
    PresentationHashComputed --> [*] : <b>PresentationHashReady</b>\nactor: System
  }
}

state "Check Semantic\nReuse" as CheckSemanticReuse #B9770E : **entry** compare prior snapshot node hashes\n**allowed** reuse or recompute branch\n**forbidden** force full rebuild when semantic matches
state "Reuse Semantic\nSubgraph" as ReuseSemantic #2C6E49 : **entry** semantic_hash match\neditorial change only\n**allowed** preserve evaluator subgraph\n**forbidden** recompute pure semantic work
state "Recompute\nEvaluator" as RecomputeEvaluator #1B7A6E : **entry** semantic_hash new or modified\n**allowed** rebuild evaluator materialization

' ---------- Compose & publish (sequential) ----------
state "Compose Snapshot" as ComposeSnapshot #3B7DD8 {
  [*] --> NodeHashComposed
  state "Node Hash\nComposed" as NodeHashComposed #3B7DD8 : **entry** SHA-256({semantic_hash, presentation_hash})\n**allowed** local node identity only\n**forbidden** embed graph neighbors
  state "Edge Hash\nComputed" as EdgeHashComputed #1B7A6E : **entry** per depends_on:\nSHA-256({source, target})\n**allowed** directional edges
  state "Snapshot Hash\nComposed" as SnapshotHashComposed #3B7DD8 : **entry** SHA-256({sorted node_hashes,\nsorted edge_hashes, provenance})\n**forbidden** include compiled_at
  NodeHashComposed --> EdgeHashComputed : <b>EdgeHashesComputed</b>\nactor: System\ncommand: for each depends_on
  EdgeHashComputed --> SnapshotHashComposed : <b>SnapshotHashComposed</b>\nactor: System\n[compiledAtExcluded]
  SnapshotHashComposed --> [*] : <b>ComposeCompleted</b>\nactor: System
}

state "Check CAS\nExistence" as CheckCAS #B9770E : **entry** lookup compiled_rules_store\n**allowed** dedup or new write
state "Published\n(Dedup)" as PublishedDedup #2C6E49 : **entry** hash exists · no-op **terminal**\n**allowed** return existing hash\n**forbidden** rewrite bytes
state "Published\n(New)" as PublishedNew #2C6E49 : **entry** novel snapshot write-once **terminal**\n**allowed** CAS put\n**forbidden** in-place update

NodeBodyLoaded --> DualHash : <b>DualHashStarted</b>\nactor: System

' Completion of both orthogonal regions → reuse check
DualHash --> CheckSemanticReuse : <b>DualHashReady</b>\nactor: System

CheckSemanticReuse --> ReuseSemantic : <b>SemanticSubgraphReused</b>\nactor: System\n[descriptionOrEditorialEditOnly]
CheckSemanticReuse --> RecomputeEvaluator : <b>SemanticSubgraphRecomputed</b>\nactor: System

ReuseSemantic --> ComposeSnapshot : <b>NodeHashComposeStarted</b>\nactor: System
RecomputeEvaluator --> ComposeSnapshot : <b>NodeHashComposeStarted</b>\nactor: System

ComposeSnapshot --> CheckCAS : <b>CasLookupStarted</b>\nactor: System

CheckCAS --> PublishedDedup : <b>CgIrDedupHit</b>\nactor: System\n[sameHashAndFrozenEnvAndEngine]
CheckCAS --> PublishedNew : <b>CgIrPublishedNew</b>\nactor: System

PublishedDedup --> [*] : <b>Finalized</b>\nactor: System
PublishedNew --> [*] : <b>Finalized</b>\nactor: System

footer SM-010 · Contract 1.1.0 · compilation_application · Selma

@enduml
