@startuml sm_011_machine_interaction
' ============================================================
' Title:     SM-011 Machine Interaction Overview
' Source:    docs/spec/contracts/ (all machines) · handoffs only
' C4:        api | *_application | ResolveConflict (domain) | certification_tool (offline)
' Package:   cross-machine handoffs only
' Contract:  1.1.0
' Role:      Cross-machine handoff overview (behavior only; C4 owns structure)
' ============================================================

title **SM-011 — Machine Interaction Overview**\nC4: api | *_application | ResolveConflict (domain) | certification_tool (offline)\n<size:12><i>authz → domain FSMs · compile · inspect · findings · cert · artifacts</i></size>

!include ./common/sm_styles.puml

state "SM-007 Authorization" as Authz #B9770E : C4: api\ningress · matrix · SoD · stage\nallow | deny + audit
state "SM-002 Directive Lifecycle" as Dir #2C6E49 : C4: directives_application\nDraft · Active · Deprecated · Superseded
state "SM-003 Compilation" as Comp #1B7A6E : C4: compilation_application\nhermetic gates · CAS publish
state "SM-010 CG-IR Hash" as Hash #1B7A6E : C4: compilation_application\ndual-hash · reuse (detail of SM-003)
state "SM-004 Inspection" as Insp #1B7A6E : C4: inspections_application\nsix pure stages · FindingOpenPort
state "SM-001 Finding Lifecycle" as Find #3B7DD8 : C4: findings_application\n**normative** · 11 states · SoD
state "SM-009 HLC" as Hlc #3B7DD8 : C4: finding_events_repository\n(pt, lc, node_id) advance
state "SM-005 Conflict" as Conf #1B7A6E : package: conflicts_domain\nResolveConflict (not C4 peer)
state "SM-006 Certification" as Cert #B9770E : C4 non-peer: certification_tool\nAA-01…AA-09 · offline/CI
state "SM-008 Artifact Lifecycle" as Art #4A4A4A : C4: artifacts_repository\nwrite-once

[*] --> Authz : <b>MutatingRequestReceived</b>
Authz --> Dir : <b>AuthzAllowedDirective</b>\n[capability directive.*]
Authz --> Insp : <b>AuthzAllowedInspection</b>\n[capability inspection.*]
Authz --> Find : <b>AuthzAllowedFinding</b>\n[capability finding.* | evidence.*]
Authz --> Conf : <b>AuthzAllowedConflict</b>\n[capability conflict.resolve]
Authz --> [*] : <b>AuthzDenied</b>\nDomainUnchanged

Dir --> Comp : <b>CompileRequested</b>\npublish / identity op
Comp --> Hash : <b>HashDetailEntered</b>\nHash Nodes zoom
Hash --> Comp : <b>HashDetailReturned</b>\nsnapshot hash ready
Comp --> Art : <b>CgIrPublished</b>
Dir --> Art : <b>DirectiveRecorded</b>

Insp --> Comp : <b>CgIrPinned</b>\npin cg_ir_snapshot_hash
Insp --> Find : <b>FindingsBirthed</b>\nFindingCreated on Report
Insp --> Art : <b>InspectionArtifactPublished</b>\nsnapshot + trace
Insp --> Conf : <b>ConflictDetected</b>\nmulti-rule fire on frozen CG-IR

Find --> Hlc : <b>FindingEventAppended</b>\nevery success event
Hlc --> Find : <b>HlcTagged</b>\ntag logical_clock
Find --> Art : <b>FindingEventAppended</b>\nappend finding_events

Conf --> Art : <b>ConflictArtifactPublished</b>
Comp --> Conf : <b>ConflictDetected</b>\ncompile-time conflict map

Cert --> Art : <b>CertificationArtifactPublished</b>
Cert --> Comp : <b>CertificationSamplesRead</b>\nread CG-IR samples
Cert --> Find : <b>CertificationSamplesRead</b>\nSoD / mediated-feedback tests\n(no production mutation)

Art --> [*] : <b>ArtifactRetained</b>\narchived / retained

footer SM-011 · Contract 1.1.0 · overview · Selma

@enduml
