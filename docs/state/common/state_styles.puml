' ============================================================
' Title:     Selma — State Machine Styles
' Purpose:   State view chrome + MICRO lifecycle aliases mapped
'            to Clean Architecture MACRO palette (ca_palette).
' Contract:  1.2.0
'
' Include order:
'   !include ./common/state_styles.puml
'   !include ./common/state_identities.puml
' ============================================================

!include ../../standards/common/ca_palette.puml

skinparam defaultFontName       "Arial"
skinparam defaultFontSize       11
skinparam stateFontSize         11
skinparam transitionFontSize    9
skinparam defaultTextAlignment  center
skinparam shadowing             false
skinparam roundCorner           8
skinparam handwritten           false
skinparam backgroundColor       $CA_CANVAS
skinparam titleFontSize         16
skinparam titleFontStyle        bold
skinparam titleFontColor        $CA_INK

skinparam state {
  BorderColor                $CA_INK
  FontColor                  #FFFFFF
  BackgroundColor            $CA_SOLID_INTERFACE
  BorderThickness            2
  FontStyle                  bold
  StartColor                 $CA_SOLID_APPLICATION
  EndColor                   $CA_SOLID_TERMINAL
  ArrowColor                 $CA_ARROW
  ArrowThickness             2
}

skinparam nodesep            50
skinparam ranksep            60
skinparam linetype           polyline

' ------------------------------------------------------------
' MICRO lifecycle colors → MACRO CA layers
' Use as:  state "Open" as Open $STATE_COLOR_RESOURCE
' ------------------------------------------------------------
' ACTOR     → CA actors (person)
' RESOURCE  → CA interface (resource/container hub)
' PROCESS   → CA application (in-flight use-case work)
' STORE     → CA frameworks (durable success)
' GATE      → CA micro gate (deny / fail)
' PENDING   → CA infrastructure / hermetic (queued, awaits)
' TERMINAL  → CA micro terminal
' DOMAIN    → CA domain (ResolveConflict path)
' EXTERNAL  → CA external (offline tool)
' ------------------------------------------------------------

!$STATE_COLOR_ACTOR     = $CA_SOLID_ACTOR
!$STATE_COLOR_RESOURCE  = $CA_SOLID_INTERFACE
!$STATE_COLOR_PROCESS   = $CA_SOLID_APPLICATION
!$STATE_COLOR_STORE     = $CA_SOLID_FRAMEWORKS
!$STATE_COLOR_GATE      = $CA_SOLID_GATE
!$STATE_COLOR_PENDING   = $CA_SOLID_INFRASTRUCTURE
!$STATE_COLOR_TERMINAL  = $CA_SOLID_TERMINAL
!$STATE_COLOR_DOMAIN    = $CA_SOLID_DOMAIN
!$STATE_COLOR_EXTERNAL  = $CA_SOLID_EXTERNAL
