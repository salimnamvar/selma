' ============================================================
' Title:     Selma — State Machine Styles (shared)
' Purpose:   ONE visual language for all state_machine_*.puml
'            diagrams. Palette is locked to C4 / package /
'            deployment semantic colors so views stay connected.
' Contract:  1.1.0
'
' Include order (every state machine diagram):
'   !include ./common/state_styles.puml
'   !include ./common/state_identities.puml
'
' Notes are FORBIDDEN in state-machine .puml files.
' ============================================================

skinparam defaultFontName       "Arial"
skinparam defaultFontSize       11
skinparam stateFontSize         11
skinparam transitionFontSize    9
skinparam defaultTextAlignment  center
skinparam shadowing             false
skinparam roundCorner           8
skinparam handwritten           false
skinparam backgroundColor       #FAFBFC
skinparam titleFontSize         16
skinparam titleFontStyle        bold
skinparam titleFontColor        #1A2332

skinparam state {
  BorderColor                #2C3E50
  FontColor                  #FFFFFF
  BackgroundColor            #3B7DD8
  BorderThickness            2
  FontStyle                  bold
  StartColor                 #1B7A6E
  EndColor                   #4A4A4A
  ArrowColor                 #34495E
  ArrowThickness             2
}

skinparam nodesep            50
skinparam ranksep            60
skinparam linetype           polyline

' ------------------------------------------------------------
' Semantic state colors (identical hex to C4 element palette)
' Use as:  state "Open" as Open $STATE_COLOR_RESOURCE
' ------------------------------------------------------------
' C4 person / actor            indigo   #4A6FA5  → STATE_COLOR_ACTOR
' C4 container / resource      blue     #3B7DD8  → STATE_COLOR_RESOURCE
' C4 system / in-flight        teal     #1B7A6E  → STATE_COLOR_PROCESS
' C4 store / durable success   green    #2C6E49  → STATE_COLOR_STORE
' C4 gate / deny / reject      red      #A93226  → STATE_COLOR_GATE
' C4 hermetic / pending human  amber    #B9770E  → STATE_COLOR_PENDING
' Terminal sink / retired      grey     #4A4A4A  → STATE_COLOR_TERMINAL
' C4 mediated / domain-only    purple   #8E44AD  → STATE_COLOR_DOMAIN
' C4 external / offline tool   grey     #8A9199  → STATE_COLOR_EXTERNAL
' ------------------------------------------------------------

!$STATE_COLOR_ACTOR     = "#4A6FA5"
!$STATE_COLOR_RESOURCE  = "#3B7DD8"
!$STATE_COLOR_PROCESS   = "#1B7A6E"
!$STATE_COLOR_STORE     = "#2C6E49"
!$STATE_COLOR_GATE      = "#A93226"
!$STATE_COLOR_PENDING   = "#B9770E"
!$STATE_COLOR_TERMINAL  = "#4A4A4A"
!$STATE_COLOR_DOMAIN    = "#8E44AD"
!$STATE_COLOR_EXTERNAL  = "#8A9199"

' When to apply (locked — same meaning on every diagram):
'   RESOURCE  — durable resource states (finding Open/Created, resource hubs)
'   PROCESS   — automated pipeline / pure evaluation / system advance
'   STORE     — durable success: published, verified, allowed, resolved binding
'   GATE      — capability deny, reject, failed, fatal
'   PENDING   — awaits human, draft, queued, pre-terminal waived, certificate run
'   TERMINAL  — sinks: closed, dismissed, superseded, archived, domain unchanged
'   DOMAIN    — domain service only (ResolveConflict path), not a C4 peer
'   EXTERNAL  — offline / optional external non-peer (certification_tool samples)
'   ACTOR     — reserved for actor-role emphasis (rare on pure FSMs)
