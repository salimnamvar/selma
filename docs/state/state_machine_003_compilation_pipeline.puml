@startuml state_machine_003_compilation_pipeline
' ============================================================
' Title:     State Machine 003 Compilation Pipeline
' Source:    docs/spec/contracts/compilation/pipeline.yaml
'            docs/spec/contracts/compilation/hermetic_boundary.yaml
'            docs/spec/contracts/data_stores/directives_store.yaml (compile_coordination)
' C4:        compilation_application → compiled_rules_repository → compiled_rules_store
'            drains compile_request outbox via directives_repository (store-mediated)
' Package:   compiled_rules_application (C4: compilation_application)
' Contract:  1.3.0
' ============================================================

title **State Machine 003 — Compilation Pipeline**\nC4: compilation_application → compiled_rules_repository → compiled_rules_store\n<size:12><i>validate → materialize · content-addressed storage publish · no doctrine at eval</i></size>

!include ./common/state_styles.puml
!include ./common/state_identities.puml

[*] --> Requested : <b>CompileRequested</b>\nactor: System (compilation_application drains outbox |\nclient enqueue via /compilations)\ncommand: directive change | compile trigger

state "Requested" as Requested $STATE_COLOR_PENDING : **entry** request_id assigned\n**allowed** dedup by (graph version + frozen_env)\n**forbidden** partial compiled rules snapshot write
state "Queued" as Queued $STATE_COLOR_PENDING : **entry** FIFO queue\n**allowed** writer-preference scheduling\n**forbidden** skip lock (directives lock contract)
state "Acquire\nRead Lock" as AcquireReadLock $STATE_COLOR_PENDING : **entry** seek directives read lock\n**allowed** concurrent compiles\n**forbidden** write-lock-while-awaiting-compile

' ---------- Composite: structural validation gates ----------
state "Structural Validation" as StructuralValidation $STATE_COLOR_PROCESS {
  [*] --> SchemaValidate
  state "Schema\nGate" as SchemaValidate $STATE_COLOR_PROCESS : **entry** JSON Schema Draft 2020-12\n**allowed** structural projection only\n**forbidden** skip complexity pass
  state "Complexity\nGate" as ComplexityValidate $STATE_COLOR_PROCESS : **entry** AST walk post-schema\n**allowed** depth≤32 · nodes≤256 · width≤64\nregex≤4096 · metadata≤16384 B\n**forbidden** schema-only conformance claim
  state "Portability\nGate" as PortabilityValidate $STATE_COLOR_PROCESS : **entry** RE2 · IEEE 754 finite\nUTC-Z · NFC · flags {i,m,s} only\n**forbidden** engine-specific regex
  state "Discriminator\nGate" as DiscriminatorValidate $STATE_COLOR_PROCESS : **entry** detection.strategy ↔ *_spec\nAST discriminator (compilation contract)\n**forbidden** weak if/then only
  state "Lineage DAG\nGate" as LineageValidate $STATE_COLOR_PROCESS : **entry** acyclicity · depth≤64\nparent existence · op cardinality\n**forbidden** self-reference

  SchemaValidate --> ComplexityValidate : <b>CompileGatePassed</b>\nactor: System (compilation_application)\n/ gateSchema()
  ComplexityValidate --> PortabilityValidate : <b>CompileGatePassed</b>\nactor: System\n/ gateComplexity()
  PortabilityValidate --> DiscriminatorValidate : <b>CompileGatePassed</b>\nactor: System\n/ gatePortability()
  DiscriminatorValidate --> LineageValidate : <b>CompileGatePassed</b>\nactor: System\n/ gateDiscriminator()
  LineageValidate --> [*] : <b>CompileGatePassed</b>\nactor: System\n/ gateLineage()\n/ recordLineageValidation()
}

' ---------- Composite: hash / conflict / policy materialization ----------
state "Materialize Compiled Rules" as MaterializeCompiledRules $STATE_COLOR_PROCESS {
  [*] --> HashNodes
  state "Hash Nodes" as HashNodes $STATE_COLOR_PROCESS : **entry** dual-hash model (compilation contract)\nsemantic_hash = SHA-256(semantic_body)\npresentation_hash = SHA-256(presentation_body)\nnode_hash = SHA-256({semantic, presentation})\n**allowed** reuse detection subgraph if semantic_hash match\n**forbidden** embed neighbor context · include presentation in semantic_hash
  state "Hash Edges" as HashEdges $STATE_COLOR_PROCESS : **entry** edge_hash = SHA-256(source, target)\n**allowed** directional depends_on only
  state "Conflict\nMap" as ConflictMap $STATE_COLOR_PROCESS : **entry** resolve_conflict mapping\nprecedence conflict/precedence.yaml\n**forbidden** bind cross-lineage
  state "Snapshot\nHash" as SnapshotHash $STATE_COLOR_PROCESS : **entry** cg_ir_snapshot_hash =\nSHA-256(sorted node_hashes +\nsorted edge_hashes + provenance)\n**forbidden** include compiled_at (US-CP-001)\nCAS: identical hash → dedup no-op
  state "Policy Runtime\nProhibition Assert" as PolicyAssert $STATE_COLOR_PROCESS : **entry** AA-02 path assert\n**allowed** policy absent from runtime paths\n**forbidden** load policy_doctrine.yaml

  HashNodes --> HashEdges : <b>CompileNodesHashed</b>\nactor: System
  HashEdges --> ConflictMap : <b>CompileEdgesHashed</b>\nactor: System
  ConflictMap --> SnapshotHash : <b>CompileConflictsMapped</b>\nactor: System\n/ unresolvedToConflictArtifactMeta()\n/ crossLineageAdvisoryOnly()
  SnapshotHash --> PolicyAssert : <b>CompileSnapshotHashed</b>\nactor: System
  PolicyAssert --> [*] : <b>CompileGatePassed</b>\nactor: System\n/ gateAa02()
}

state "Publish Content-Addressed Storage" as Publish $STATE_COLOR_STORE : **entry** immutable snapshot write\n**allowed** dedup if hash exists\n**forbidden** in-place mutate
state "Release Lock\n(Success)" as ReleaseLockOk $STATE_COLOR_STORE : **entry** read lock released after publish\n**allowed** inspections may pin hash
state "Release Lock\n(Abort)" as ReleaseLockFail $STATE_COLOR_GATE : **entry** read lock released after fail\n**allowed** Directive Graph unchanged
state "Completed" as Completed $STATE_COLOR_STORE : **entry** snapshot live\n**allowed** pin by inspections_application\n**forbidden** mutate snapshot
state "Failed" as Failed $STATE_COLOR_GATE : **entry** no partial compiled rules intermediate representation\n**allowed** audit entry only\n**forbidden** publish · graph mutation

Requested --> Queued : <b>CompileQueued</b>\nactor: System\ncommand: schedule compile
Queued --> AcquireReadLock : <b>CompileDequeued</b>\nactor: System\ncommand: grant FIFO slot
AcquireReadLock --> StructuralValidation : <b>CompileLockAcquired</b>\nactor: System\ncommand: acquire read lock
AcquireReadLock --> Queued : <b>CompileLockDeferred</b>\nactor: System\n[writeLockHeldOrWritePending]\n/ retryFifo()

' Composite completion: all structural gates passed
StructuralValidation --> MaterializeCompiledRules : <b>CompileStructuralOk</b>\nactor: System
MaterializeCompiledRules --> Publish : <b>CompileMaterialized</b>\nactor: System

' External FAIL exits from nested gates
SchemaValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ schemaErrorNoPartialCompiledRules()
ComplexityValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ complexityError()
PortabilityValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ portabilityError()
DiscriminatorValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ discriminatorError()
LineageValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ lineageError()
PolicyAssert --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ architecturalAuditErrorAa02()

Publish --> ReleaseLockOk : <b>CompiledRulesPublished</b>\nactor: System\ncommand: write-once publish
ReleaseLockOk --> Completed : <b>CompileLockReleased</b>\nactor: System
Completed --> [*] : <b>Finalized</b>\nactor: System

Failed --> ReleaseLockFail : <b>CompileLockReleased</b>\nactor: System
ReleaseLockFail --> [*] : <b>Finalized</b>\nactor: System

footer State Machine 003 · Contract 1.1.0 · compilation_application · Selma

@enduml
