' ============================================================
' Title:     Selma -- CompilationEngine Core
' Boundary:  CompilationEngine (Core)
' Purpose:   Hermetic compilation core: identity, transformation, hashing, incremental compilation
' Milestone: v2.0.0
' Version:   2.0.0
' Contract:  8.2.4
' Source:    docs/Regulation/SPECIFICATION.md 2.2-2.8, 2.6, 2.7
' Review:    Enhanced — 2026-07-06
' ============================================================
@startuml c4_selma_component_compilation_core
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- CompilationEngine Core

Container_Boundary(compilation_core, "CompilationEngine — Core") {

    Component(frozen_env_mgr, "FrozenEnvManager", "Python", "Pins: engine, toolchain, AI models, OS/runtime. Computes frozen_env_hash (2.7).")
    Component(concurrency_mgr, "ConcurrencyManager", "Python", "Read lock for compilation only. Writer-preference FIFO. DirectiveManager has its own concurrency control.")
    Component(identity_resolver, "IdentityResolver", "Python", "lineage_id assignment, execution_id generation. Merge: lexmin lineage. Fork/Split: inherit lineage (2.2, 2.3).")
    Component(rule_to_node, "RuleToNodeMapper", "Python", "2.8.1 transform: message -> description, weight -> severity_default, evaluator_type+config -> evaluator, target -> scope.target_type.")
    Component(param_merger, "ParameterMerger", "Python", "Shallow merge: parameters -> evaluator.config override (2.8.1).")
    Component(dep_graph, "DependencyGraphBuilder", "Python", "Topological sort, depends_on -> edges, acyclicity verification.")
    Component(hash_computer, "HashComputer", "Python", "semantic_hash (11 fields), presentation_hash (3 fields), node_hash = compose both. Canonical JSON, SHA-256 (2.6).")
    Component(edge_hasher, "EdgeHashComputer", "Python", "SHA-256({source, target}). Directional. Node-content independent (2.6).")
    Component(inc_compilation, "IncrementalCompilationManager", "Python", "Dirty marking by lineage_id, transitive dependent marking, cache lookup by semantic_hash, reuse unchanged node_hashes (2.6).")
}

Container(directive_mgr_ext, "DirectiveManager", "Python", "Triggers compilation on directive mutation (Authoring Layer).")

Rel(frozen_env_mgr, concurrency_mgr, "hermetic boundary config")
Rel(directive_mgr_ext, concurrency_mgr, "compilation trigger (on mutation or on-demand)")
Rel(concurrency_mgr, identity_resolver, "read lock acquired")
Rel(identity_resolver, rule_to_node, "validated rules")
Rel(rule_to_node, param_merger, "mapped rules")
Rel(param_merger, dep_graph, "merged parameters")
Rel(dep_graph, hash_computer, "all nodes")
Rel(dep_graph, edge_hasher, "node references")
Rel(hash_computer, inc_compilation, "node hashes")
Rel(edge_hasher, inc_compilation, "edge hashes")

@enduml
