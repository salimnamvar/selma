' ============================================================
' Title:     Selma -- CgIrStore Component Diagram
' Boundary:  CgIrStore
' Purpose:   Content-addressed storage with node/edge deduplication and lineage tracing
' Milestone: v2.0.0
' Version:   2.0.0
' Contract:  8.2.4
' Source:    docs/Regulation/SPECIFICATION.md 2.6, 2.2.2, 2.2.3, AA-06, AA-07 gates
' Review:    Enhanced — 2026-07-06
' ============================================================
@startuml c4_selma_component_cgir_store
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- CgIrStore Component Diagram

Container_Boundary(cgir, "CgIrStore") {
    Component(node_dedup, "NodeDeduplicator", "Python", "Lookup by node_hash. Reuse existing if match. Store new if unique. Enables incremental compilation (2.6).")
    Component(edge_dedup, "EdgeDeduplicator", "Python", "Lookup by edge_hash. Reuse if {source, target} match exists. Independent of node content (2.6).")

    Component(node_store, "NodeStore", "Python", "Key: node_hash. Value: node_body. Indices: semantic_hash, presentation_hash, lineage_id (2.6). [throughput: 1000 writes/s, latency: <100ms] [security: AES-256 at rest, TLS 1.3 in transit]")
    Component(edge_store, "EdgeStore", "Python", "Key: edge_hash. Value: {source, target}. Indices: source, target (2.6). [throughput: 1000 writes/s, latency: <100ms] [security: AES-256 at rest, TLS 1.3 in transit]")
    Component(snapshot_manifest, "SnapshotManifestStore", "Python", "Key: cg_ir_snapshot_hash. Value: {node_hashes: sorted[], edge_hashes: sorted[], provenance}. compiled_at in artifact, NOT in hash (2.6). [security: AES-256 at rest, TLS 1.3 in transit]")

    Component(node_lookup, "NodeLookup", "Python", "By node_hash, directive_id, lineage_id, semantic_hash.")
    Component(edge_lookup, "EdgeLookup", "Python", "By edge_hash, source directive_id, target directive_id.")
    Component(snapshot_lookup, "SnapshotLookup", "Python", "By snapshot hash, directive_graph_version, latest snapshot.")
    Component(lineage_tracer, "LineageTracer", "Python", "By lineage_id (all nodes), parent_lineage_ids, parent_execution_ids. Supports non-surviving parent queries (2.2.2).")
}

Container(compilation_engine, "CompilationEngine", "Python", "Produces nodes, edges, snapshot manifest.")
Container(inspection_pipeline, "InspectionPipeline", "Python", "Reads frozen CG-IR snapshot.")

Rel(compilation_engine, node_dedup, "new nodes")
Rel(compilation_engine, edge_dedup, "new edges")
Rel(compilation_engine, snapshot_manifest, "snapshot manifest")

Rel(node_dedup, node_store, "new (unique)")
Rel(edge_dedup, edge_store, "new (unique)")

Rel(node_store, node_lookup, "indexed")
Rel(edge_store, edge_lookup, "indexed")
Rel(snapshot_manifest, snapshot_lookup, "indexed")
Rel(node_store, lineage_tracer, "lineage index (parent_lineage_ids, parent_execution_ids)")
Rel(snapshot_manifest, lineage_tracer, "provenance-level lineage query (secondary)")

Rel(snapshot_lookup, inspection_pipeline, "reads frozen snapshot", "Content-addressed")
Rel(node_lookup, inspection_pipeline, "reads nodes", "Content-addressed")
Rel(edge_lookup, inspection_pipeline, "reads edges", "Content-addressed")
Rel(lineage_tracer, compilation_engine, "reads previous snapshot (incremental)", "Content-addressed")

@enduml
