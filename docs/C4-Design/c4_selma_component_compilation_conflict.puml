' ============================================================
' Title:     Selma -- CompilationEngine Conflict Metadata
' Boundary:  CompilationEngine (Conflict Metadata)
' Purpose:   Candidate conflict preparation, specificity precomputation, snapshot assembly, and provenance recording
' Milestone: v2.0.0
' Version:   2.0.0
' Contract:  8.2.4
' Source:    docs/Regulation/SPECIFICATION.md 2.6, 2.15, docs/User-Story/User_Stories.md S-05, S-28, AA-05
' Review:    Enhanced — 2026-07-06
' ============================================================
@startuml c4_selma_component_compilation_conflict
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- CompilationEngine Conflict Metadata

Container_Boundary(compilation_conflict, "CompilationEngine — Conflict Metadata") {

    Component(conflict_pair, "ConflictPairGenerator", "Python", "Consumes conflicts_with, generates candidate pairs, records in snapshot metadata (2.8.4, 2.15.1).")
    Component(specificity_scorer, "ScopeSpecificityScorer", "Python", "scope_specificity_score x 100 + count_bound_fields (2.8.2, 2.15).")
    Component(conflict_metadata, "ConflictMetadataAssembler", "Python", "Compilation-time preparation only: validates defer_to references and cycles, records candidate pairs, specificity inputs, and frozen conflict metadata for runtime and consistency review (2.15). No finding disposition decisions occur here.")
    Component(snapshot_assembler, "SnapshotAssembler", "Python", "sorted node_hashes[], sorted edge_hashes[] + provenance -> cg_ir_snapshot_hash. compiled_at EXCLUDED (2.6). Dry-run mode: returns snapshot without persisting.")
    Component(provenance_recorder, "ProvenanceRecorder", "Python", "engine_version, frozen_env_hash, directive_graph_version, lineage_validation result, creator_provenance mapping (2.6, 3.2).")
}

ContainerDb(cgir_store, "CgIrStore", "CAS", "Immutable CG-IR snapshots and shared node objects.")

Rel(conflict_pair, conflict_metadata, "candidate pairs")
Rel(specificity_scorer, conflict_metadata, "specificity scores")
Rel(conflict_metadata, snapshot_assembler, "frozen conflict metadata + ConflictArtifact templates")
Rel(provenance_recorder, snapshot_assembler, "frozen env + lineage metadata")
Rel(snapshot_assembler, cgir_store, "immutable CG-IR snapshot", "Content-addressed")

@enduml
