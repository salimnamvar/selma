' ============================================================
' Title:     Selma -- Container Diagram
' Boundary:  Selma Rule Regularity Platform
' Purpose:   White-box view: 12 internal containers carrying forward
'            the 3 governance actors and 6 external systems from the
'            Context Diagram. Reveals the hermetic compile boundary,
'            content-addressed CG-IR store, append-only Finding Event
'            Stream, Audit Event Store (security denials), five-gate
'            capability topology (S-34), and Architectural Audit Engine
'            (S-30 / AA-01..AA-07).
' Contract:  8.2.4
' Diagram:   8.2.4 (Phase B AIP alignment + deployability notes)
' ============================================================
@startuml c4_selma_container
title Selma -- Container Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only",        $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",           $legendText="append-only, HLC-ordered -- never mutated")
AddRelTag("mediated",            $legendText="mediated output -- Selma never mutates external state")
AddRelTag("capability_enforced", $legendText="capability-checked at mutation gate (S-34)")
AddRelTag("async",               $legendText="asynchronous / eventually consistent delivery")
AddRelTag("validation_only",     $legendText="read/inspect only -- no mutation authority")


' ============================================================
'  ACTORS (carried forward from Context Diagram)
' ============================================================

Person(regulatory_official, "Regulatory Official", "Human or AI agent. Full directive lifecycle (directive.*), Conflict Artifact resolution, finding disposition. SoD: cannot waive findings on own directives (S-29).")

Person(compliance_rep, "Compliance Representative", "Human or system. Submits targets, acknowledges findings, submits evidence. SoD: cannot approve own remediation (S-33).")

Person_Ext(system_actor, "Automated Service Account", "Programmatic. Narrowest capability set: inspection.submit, finding.view, analytics.view only.")


' ============================================================
'  EXTERNAL SYSTEMS (carried forward from Context Diagram)
' ============================================================

System_Ext(governance_contracts, "Governance Contracts (Audit Corpus)", "policy_doctrine.yaml (governance intent, runtime-prohibited), rule_schema.json (structural validation contract), directive tables (Machine ID lineage). Consumed exclusively at the hermetic compile boundary.")

System_Ext(iam, "Identity & Access Management", "Authentication and capability authority for all actor types. Provides identity tokens and capability assertions validated at every mutation gate (S-34).")

System_Ext(cicd, "CI/CD Pipeline", "External trigger for architectural certification (S-30). Invokes Architectural Audit Engine for AA-01..AA-07. Static analysis verifying policy_doctrine.yaml absence from all runtime source paths.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems and automated pipelines supplying inspection targets conforming to the target schema (S-10).")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention. Receives Finding Event Stream, security denial Audit Event Stream, inspection snapshots, system_state_hashes, pipeline traces, and AA certification artifacts. Supports external auditors, e-discovery, and read-only compliance dashboards.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows receiving mediated finding notifications. Selma never mutates external remediation state (AA-01).")


' ============================================================
'  SELMA SYSTEM BOUNDARY -- 12 CONTAINERS
' ============================================================

System_Boundary(selma, "Selma Rule Regularity Platform") {

    ' ── Request Ingress ──────────────────────────────────────
    Container(api_gateway, "API Gateway", "FastAPI / REST", "Single entry point for all actor types and target submissions. TLS 1.3, JWT/OIDC validation, capability hard-deny at request ingress (S-34 gate 1 of 5). No partial state mutation. Routes: directive.* to Directive Store; inspection.* to Inspection Pipeline; finding.* / evidence.* to Finding FSM Engine; conflict.resolve to Conflict Engine; read queries to Analytics Engine. Forwards denials to Audit Event Store.")

    ' ── Authoring / Directive Lifecycle ──────────────────────
    ContainerDb(directive_store, "Directive Store", "PostgreSQL", "Mutable, versioned source-of-truth for human-authored directives. Command path with stage-local capability gate (S-34 gate 2). Stores lineage_id <-> Machine ID bijection, dual identity, full revision history, fork/merge/split provenance (Sec.2.2, Sec.2.3, S-01..S-03, S-07, S-08, S-19, S-20, S-26). Read-locked during compilation; write-locked during mutations (Sec.3.4). Triggers Compilation Orchestrator on mutation.")

    ' ── Hermetic Compilation Boundary ────────────────────────
    Container_Boundary(hermetic_boundary, "Hermetic Compilation Boundary") {
        Container(compilation_engine, "Compilation Engine", "Python", "Hermetic compile boundary (AA-02, Sec.1.2). Deployment: on-demand Job/worker preferred (mutation- or CI-triggered), not a persistent always-on replica set; hermetic boundary is security isolation, not always-on grouping. Reads Directive Graph under read-lock (Sec.3.4). Validates JSON Schema, AST discriminator and complexity limits (Sec.2.9, S-27, S-31), lineage DAG invariants (Sec.2.2.3), RE2 canary checks (S-21, S-31), cross-layer version compatibility, frozen_env_hash pin (Sec.2.7). Dual-hash model (Sec.2.6, S-23, S-24). Boot-time policy absence assertion (AA-02). policy_doctrine.yaml MUST NOT be read at runtime. Publishes content-addressed CG-IR snapshots.")
    }

    ' ── Content-Addressed CG-IR ──────────────────────────────
    ContainerDb(cgir_store, "CG-IR Store", "Content-Addressed Storage", "Immutable CG-IR snapshots keyed by SHA-256 snapshot_hash (Sec.2.6, S-23, S-24). Node deduplication by node_hash; edge deduplication by edge_hash. Incremental reuse via semantic_hash. Never mutated after publication; indefinite retention. Loaded as frozen snapshot for all evaluation and conflict resolution.")

    ' ── Pure-Evaluator DAG Execution ─────────────────────────
    Container(inspection_pipeline, "Inspection Pipeline", "Python", "Pure-evaluator DAG execution (AA-03, S-10). Stage-local capability gate at pipeline entry (S-34 gate 3). Six-stage pipeline: normalize -> classify -> select_controls -> evaluate -> aggregate -> report. Topological sort respecting depends_on; per-node timeout default 30 s. Evaluator types: regex (RE2 only), field_check, threshold, composite; no IO, no randomness (Sec.2.9). 8-class fault taxonomy. Produces immutable inspection snapshots.")

    ' ── Deterministic Conflict Resolution ────────────────────
    Container(conflict_engine, "Conflict Resolution Engine", "Python", "Deterministic resolve_conflict per Sec.2.15 (AA-05, S-05, S-28). Single authority for compile-time precompute and runtime multi-fire resolution. Stage-local capability gate on conflict.resolve (S-34 gate 5). Precedence: explicit override -> compatible_overrides -> priority -> specificity -> recency -> Conflict Artifact. Operates exclusively on frozen CG-IR fields. Writes Conflict Artifacts to Execution Artifact Store; human dispositions applied at runtime (S-05).")

    ' ── Finding Lifecycle State Machine ──────────────────────
    Container(finding_fsm, "Finding FSM Engine", "Python", "Strict 10-state finding lifecycle machine per Sec.3.1 (S-12, S-13, S-14a/b/c, S-25, S-29). Capability gate at every human-triggered FSM transition (S-34 gate 4). SoD: creator_provenance blocks finding.waive (S-29, S-32); evidence submitter blocked from finding.approve_remediation (S-14a, S-33). Fail-closed when SoD dependency stores unavailable. Auto-transitions: Evidence Submitted -> Pending Verification, Verified -> Closed, Waived -> Closed. Generates HLC-ordered events (Sec.3.3).")

    ' ── Append-Only Finding Event Stream ─────────────────────
    ContainerDb(finding_event_store, "Finding Event Store", "Append-Only Log", "Immutable, HLC-ordered Finding Event Stream (Sec.3.1, Sec.3.3, S-14a). FindingCreated, DispositionChanged, FindingClosed events with SHA-256 event_hash integrity chain. Terminal states: Closed, Dismissed. Never mutated after append. Source of truth for finding state and disposition history. Does NOT store security denials.")

    ' ── Security Denial Audit Store ──────────────────────────
    ContainerDb(audit_event_store, "Audit Event Store", "Append-Only Log", "Platform-owned append-only security audit stream for capability and SoD denials (Sec.3.2, S-32, S-33, S-34). Records: {actor, capability, action, outcome: denied, timestamp, reason}. Separate from Finding Event Store (SoC). Replicates to external Audit Platform for long-term retention.")

    ' ── Read-Only Analytics and Query ────────────────────────
    Container(analytics_engine, "Analytics Engine", "Python", "Read-only aggregates, trends, and traceability queries over the Finding Event Stream and CG-IR (S-04, S-06, S-07, S-11, S-16, S-17, S-21..S-24, S-27). Causal explanations (S-16). Computes finding_aggregates for inspection context pre-invocation (Sec.2.11). Mediated feedback only -- zero write path to CG-IR, FSM, or Directive Store (AA-01, S-18). Human proposes directive changes via S-02 only.")

    ' ── Immutable Execution Artifacts ────────────────────────
    ContainerDb(artifact_store, "Execution Artifact Store", "Object Store", "Immutable inspection snapshots, pipeline traces, system_state_hashes (Sec.2.13, S-10, S-23), Conflict Artifacts pending human resolution (Sec.2.15, S-05; nested store), and AA certification artifacts (gate-ID PASS/FAIL evidence). Reproducibility: same CG-IR + target + frozen_env = same snapshot hash. Append-only after creation.")

    ' ── Assurance / Architectural Certification ──────────────
    Container(architectural_audit_engine, "Architectural Audit Engine", "Python", "In-boundary orchestrator for AA-01 through AA-07 certification (Sec.9.9, S-30). Deployment: CI-invoked Job/sidecar only -- not part of the always-running user-facing request path. Triggered by cicd. Validates each gate against enforcement components; reports pass/fail with explicit gate-ID traceability. Writes only certification artifacts to Execution Artifact Store. Validation/read only -- no mutation authority over Directive Store, CG-IR, Finding FSM, or Finding Event Store.")

}


' ============================================================
'  RELATIONSHIPS -- Actor Ingress
' ============================================================

Rel(regulatory_official, api_gateway, "directive.*, finding.dismiss/waive/approve_remediation/reject_remediation, conflict.resolve, analytics.view", "HTTPS", $tags="capability_enforced")
Rel(compliance_rep, api_gateway, "inspection.submit/reinspect, finding.acknowledge, evidence.submit, analytics.view", "HTTPS", $tags="capability_enforced")
Rel(system_actor, api_gateway, "inspection.submit, finding.view, analytics.view", "HTTPS", $tags="capability_enforced")


' ============================================================
'  RELATIONSHIPS -- External System Interactions
' ============================================================

Rel(api_gateway, iam, "validates identity tokens and capability assertions at request ingress gate (S-34)", "OAuth 2.0 / OIDC")
Rel(regulated_systems, api_gateway, "submits inspection targets conforming to target schema", "HTTPS / API")
Rel(api_gateway, regulated_systems, "returns inspection results and causal explanations (S-16)", "HTTPS / API", $tags="mediated")
Rel(cicd, architectural_audit_engine, "triggers AA-01..AA-07 certification suite with gate-ID reporting (S-30)", "CI/CD")
Rel(cicd, compilation_engine, "static analysis hooks for policy runtime prohibition (AA-02)", "CI/CD", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- API Gateway -> Internal Containers
' ============================================================

Rel(api_gateway, directive_store, "directive.* create/modify/retire/fork/merge/split/restore (S-01, S-02, S-07, S-08, S-19, S-20, S-26)", "SQL", $tags="capability_enforced")
Rel(api_gateway, compilation_engine, "triggers hermetic compilation on directive mutation; dry-run impact preview (S-09)", "Internal", $tags="compile_only")
Rel(api_gateway, inspection_pipeline, "routes inspection submissions with target payload (S-10, S-15)", "Internal", $tags="capability_enforced")
Rel(api_gateway, finding_fsm, "routes finding lifecycle transitions (finding.*, evidence.submit, S-12, S-13, S-14a/b/c, S-25, S-29)", "Internal", $tags="capability_enforced")
Rel(api_gateway, conflict_engine, "routes conflict.resolve requests on open Conflict Artifacts; consistency review (S-05)", "Internal", $tags="capability_enforced")
Rel(api_gateway, analytics_engine, "routes read queries: analytics (S-17), directive views (S-04), findings (S-11), explanations (S-16), governance audits (S-06, S-21..S-24, S-27)", "Internal", $tags="capability_enforced")
Rel(api_gateway, audit_event_store, "appends ingress capability denial audit records via Denial Handler (S-34 gate 1)", "Append-Only", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Stage-local denial appends
' ============================================================

Rel(directive_store, audit_event_store, "appends directive.* capability denials from gate 2 (S-34)", "Append-Only", $tags="immutable")
Rel(inspection_pipeline, audit_event_store, "appends inspection.submit/reinspect capability denials from gate 3 (S-34)", "Append-Only", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Compilation Engine
' ============================================================

Rel(compilation_engine, governance_contracts, "reads Directive Graph under hermetic read-lock; policy_doctrine.yaml compile-time only (Sec.1.2, Sec.9.7)", "compile-time only", $tags="compile_only")
Rel(compilation_engine, directive_store, "reads directive revisions and lineage state under read-lock (Sec.3.4)", "SQL", $tags="compile_only")
Rel(compilation_engine, conflict_engine, "applies conflict resolution mapping at compile time via single resolve_conflict authority (Sec.2.4 Step 3, Sec.2.15)", "Internal", $tags="compile_only")
Rel(compilation_engine, cgir_store, "publishes immutable content-addressed CG-IR snapshot (Sec.2.6, S-23, S-24)", "CAS Write", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- Inspection Pipeline
' ============================================================

Rel(inspection_pipeline, cgir_store, "loads frozen CG-IR snapshot by hash for pure DAG evaluation (S-10)", "CAS Read")
Rel(inspection_pipeline, analytics_engine, "fetches pre-inspection finding_aggregates for context object (Sec.2.11)", "Internal")
Rel(inspection_pipeline, conflict_engine, "applies pre-computed deterministic resolution when multiple nodes fire against same target (Sec.2.15, S-28)", "Internal")
Rel(inspection_pipeline, finding_fsm, "emits findings (Created -> Open) after DAG evaluation completes (S-10, Sec.2.12)", "Internal")
Rel(inspection_pipeline, artifact_store, "stores inspection snapshot, pipeline trace, and system_state_hash (Sec.2.13, Sec.3.6)", "Object Write")


' ============================================================
'  RELATIONSHIPS -- Finding FSM Engine
' ============================================================

Rel(finding_fsm, finding_event_store, "appends HLC-ordered finding lifecycle events (Sec.3.1, Sec.3.3, S-14a)", "Append-Only", $tags="immutable")
Rel(finding_fsm, cgir_store, "reads creator_provenance from snapshot node provenance for SoD enforcement (S-29, S-32, S-33)", "CAS Read-Only")
Rel(finding_fsm, audit_event_store, "appends SoD and capability denial records from gate 4 on blocked transitions (S-32, S-33, S-34)", "Append-Only", $tags="immutable")
Rel(finding_fsm, remediation_systems, "emits mediated finding state changes to operational workflows (S-14a, S-29)", "webhook / events", $tags="mediated,async")


' ============================================================
'  RELATIONSHIPS -- Analytics Engine
' ============================================================

Rel(analytics_engine, finding_event_store, "reads events for aggregates, trends, findings view, and governance audit (AA-01: read-only, S-17, S-11, S-06)", "SQL / Read-Only")
Rel(analytics_engine, cgir_store, "reads CG-IR nodes for active directive views and causal chain traversal (S-04, S-16)", "CAS Read-Only")


' ============================================================
'  RELATIONSHIPS -- Conflict Resolution Engine
' ============================================================

Rel(conflict_engine, cgir_store, "reads frozen node metadata for specificity scoring and priority comparison (Sec.2.15, Sec.2.8.2, S-05)", "CAS Read-Only")
Rel(conflict_engine, artifact_store, "stores and reads Conflict Artifacts; compile-time write and runtime human-resolve disposition (Sec.2.15, S-05)", "Object Read/Append", $tags="immutable")
Rel(conflict_engine, audit_event_store, "appends conflict.resolve capability denials from gate 5 (S-34)", "Append-Only", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Architectural Audit Engine
' ============================================================

Rel(architectural_audit_engine, api_gateway, "validates AA-01 mediated feedback ingress and denial audit path", "Internal", $tags="validation_only")
Rel(architectural_audit_engine, compilation_engine, "validates AA-02 policy prohibition, AA-06 discriminator, AA-07 portability", "Internal", $tags="validation_only")
Rel(architectural_audit_engine, inspection_pipeline, "validates AA-03 evaluator purity", "Internal", $tags="validation_only")
Rel(architectural_audit_engine, finding_fsm, "validates AA-04 segregation of duties", "Internal", $tags="validation_only")
Rel(architectural_audit_engine, conflict_engine, "validates AA-05 conflict resolution determinism", "Internal", $tags="validation_only")
Rel(architectural_audit_engine, analytics_engine, "validates AA-01 zero write path from analytics", "Internal", $tags="validation_only")
Rel(architectural_audit_engine, artifact_store, "writes AA certification artifacts with gate-ID PASS/FAIL evidence (S-30)", "Object Write", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Audit Replication
' ============================================================

Rel(finding_event_store, audit_platform, "replicates immutable Finding Event Stream for long-term retention (Sec.2.14)", "append-only / HLC-ordered", $tags="immutable,async")
Rel(audit_event_store, audit_platform, "replicates security denial Audit Event Stream for long-term retention (S-32, S-33, S-34)", "append-only", $tags="immutable,async")
Rel(artifact_store, audit_platform, "replicates inspection snapshots, pipeline traces, system state hashes, and certification artifacts (Sec.3.5, Sec.3.6)", "append-only", $tags="async")

@enduml
