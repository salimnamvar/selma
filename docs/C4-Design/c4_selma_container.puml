' ============================================================
' Title:     Selma -- Container Diagram
' Boundary:  Selma Rule Regularity Platform
' Purpose:   White-box view: 10 internal containers carrying forward
'            the 3 governance actors and 6 external systems from the
'            Context Diagram. Reveals the hermetic compile boundary,
'            content-addressed CG-IR store, append-only Finding Event
'            Stream, and capability-gated mutation paths.
' Version:   6.0.0
' ============================================================
@startuml c4_selma_container
title Selma -- Container Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only",        $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",           $legendText="append-only, HLC-ordered -- never mutated")
AddRelTag("mediated",            $legendText="mediated output -- Selma never mutates external state")
AddRelTag("capability_enforced", $legendText="capability-checked at mutation gate (S-34)")


' ============================================================
'  ACTORS (carried forward from Context Diagram)
' ============================================================

Person(regulatory_official, "Regulatory Official", "Human or AI agent. Full directive lifecycle (directive.*), Conflict Artifact resolution, finding disposition. SoD: cannot waive findings on own directives (S-29).")

Person(compliance_rep, "Compliance Representative", "Human or system. Submits targets, acknowledges findings, submits evidence. SoD: cannot approve own remediation (S-33).")

Person_Ext(system_actor, "Automated Service Account", "Programmatic. Narrowest capability set: inspection.submit, finding.view, analytics.view only.")


' ============================================================
'  EXTERNAL SYSTEMS (carried forward from Context Diagram)
' ============================================================

System_Ext(governance_contracts, "Governance Contracts", "policy_doctrine.yaml (governance intent, runtime-prohibited), rule_schema.json (structural validation contract), directive tables (Machine ID lineage). Consumed exclusively at the hermetic compile boundary.")

System_Ext(iam, "Identity & Access Management", "Authentication and capability authority for all actor types. Provides identity tokens and capability assertions validated at every mutation gate (S-34).")

System_Ext(cicd, "CI/CD Pipeline", "Automated architectural certification. Runs AA-01..AA-07 gate suite (S-30). Static analysis verifying policy_doctrine.yaml absence from all runtime source paths.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems and automated pipelines supplying inspection targets conforming to the target schema (S-10).")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention store for regulatory compliance and forensics. Receives Finding Event Stream, inspection snapshots, system state hashes, and pipeline traces.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows receiving mediated finding notifications. Selma never mutates external remediation state (AA-01).")


' ============================================================
'  SELMA SYSTEM BOUNDARY -- 10 CONTAINERS
' ============================================================

System_Boundary(selma, "Selma Rule Regularity Platform") {

    ' ── API Gateway ──────────────────────────────────────────
    Container(api_gateway, "API Gateway", "FastAPI / REST", "Single entry point for all actor types and target submissions. TLS 1.3, JWT/OIDC validation, capability enforcement at request ingress (S-34). Hard-deny on missing capabilities -- no partial state mutation. Routes: directive.* to DirectiveStore + CompilationEngine; inspection.* to InspectionPipeline; finding.* and evidence.* to FindingFsmEngine; conflict.resolve to ConflictEngine; read queries to AnalyticsEngine.")

    ' ── Directive Lifecycle ───────────────────────────────────
    ContainerDb(directive_store, "Directive Store", "PostgreSQL", "Mutable, versioned source-of-truth for human-authored directives. Stores lineage_id <-> Machine ID bijection, dual identity (lineage_id, execution_id), full revision history, and fork/merge/split provenance (Sec.2.2, Sec.2.3, S-01..S-03, S-07, S-08, S-19, S-20, S-26). Read-locked during compilation; write-locked during mutations (Sec.3.4).")

    ' ── Hermetic Compilation Boundary ────────────────────────
    Container_Boundary(hermetic_boundary, "Hermetic Compilation Boundary") {
        Container(compilation_engine, "Compilation Engine", "Python", "Hermetic compile boundary (AA-02, Sec.1.2). Reads Directive Graph under read-lock (Sec.3.4). Validates JSON Schema, AST-walking discriminator and complexity limits (Sec.2.9, S-27, S-31), lineage DAG invariants (Sec.2.2.3), RE2 canary checks (S-21, S-31), cross-layer version compatibility. Dual-hash model: semantic_hash + presentation_hash = node_hash (Sec.2.6, S-23, S-24). Incremental compilation via semantic_hash subgraph reuse. Generates content-addressed CG-IR snapshots. policy_doctrine.yaml MUST NOT be read at runtime.")
    }

    ' ── Content-Addressed CG-IR ──────────────────────────────
    ContainerDb(cgir_store, "CG-IR Store", "Content-Addressed Storage", "Immutable CG-IR snapshots keyed by SHA-256 snapshot_hash (Sec.2.6, S-23, S-24). Node deduplication by node_hash; edge deduplication by edge_hash. Incremental reuse via semantic_hash. Never mutated after publication; indefinite retention. Loaded as frozen snapshot for all evaluation and conflict resolution.")

    ' ── Pure-Evaluator DAG Execution ─────────────────────────
    Container(inspection_pipeline, "Inspection Pipeline", "Python", "Pure-evaluator DAG execution (AA-03, S-10). Six-stage pipeline: normalize -> classify -> select_controls -> evaluate -> aggregate -> report. Topological sort respecting depends_on; per-node timeout default 30 s. Evaluator types: regex (RE2 only), field_check, threshold, composite (depth <= 32, width <= 64); no IO, no randomness (Sec.2.9). 8-class fault taxonomy. Produces immutable point-in-time inspection snapshots.")

    ' ── Deterministic Conflict Resolution ────────────────────
    Container(conflict_engine, "Conflict Resolution Engine", "Python", "Deterministic resolve_conflict per Sec.2.15 (AA-05, S-05, S-28). Precedence chain: explicit override -> compatible_overrides (symmetric pairs) -> priority -> specificity (Sec.2.8.2) -> recency (created_at) -> Conflict Artifact. Detects defer_to cycles via DFS (S-28). Cross-lineage advisories are non-binding (Sec.2.15.2). Operates exclusively on frozen CG-IR fields. Escalates unresolvable conflicts as Conflict Artifacts for human resolution.")

    ' ── Finding Lifecycle State Machine ──────────────────────
    Container(finding_fsm, "Finding FSM Engine", "Python", "Strict 10-state finding lifecycle machine per Sec.3.1 (S-12, S-13, S-14a/b/c, S-25, S-29). Validates capability at every FSM transition gate (S-34). Segregation-of-duties: creator_provenance blocks finding.waive (S-29, S-32); evidence submitter blocked from finding.approve_remediation (S-14a, S-33). Auto-transitions: Evidence Submitted -> Pending Verification, Verified -> Closed, Waived -> Closed. Generates HLC-ordered events (Sec.3.3).")

    ' ── Append-Only Finding Event Stream ─────────────────────
    ContainerDb(finding_event_store, "Finding Event Store", "Append-Only Log", "Immutable, HLC-ordered Finding Event Stream (Sec.3.1, Sec.3.3, S-14a). FindingCreated, DispositionChanged, FindingClosed events with SHA-256 event_hash integrity chain. Terminal states: Closed, Dismissed. Never mutated after append. Source of truth for finding state and disposition history.")

    ' ── Read-Only Analytics and Query ────────────────────────
    Container(analytics_engine, "Analytics Engine", "Python", "Read-only aggregates and trend analysis over the Finding Event Stream (S-17). Serves active directive views (S-04), findings view (S-11), causal explanation queries (S-16), and governance audit queries (S-06, S-21..S-24, S-27). Computes finding_aggregates for inspection context object pre-invocation (Sec.2.11). Mediated feedback only -- zero write path to CG-IR, FSM, or Directive Store (AA-01, S-18).")

    ' ── Immutable Execution Artifacts ────────────────────────
    ContainerDb(artifact_store, "Execution Artifact Store", "Object Store", "Immutable inspection snapshots, pipeline traces, system_state_hashes (Sec.2.13, S-10, S-23), and Conflict Artifacts pending human resolution (Sec.2.15). Reproducibility: same CG-IR + target + frozen_env = same snapshot hash. Append-only after creation.")

}


' ============================================================
'  RELATIONSHIPS -- Actor Ingress
' ============================================================

Rel(regulatory_official, api_gateway, "directive.*, finding.dismiss/waive/approve_remediation/reject_remediation, conflict.resolve, analytics.view", "HTTPS", $tags="capability_enforced")
Rel(compliance_rep, api_gateway, "inspection.submit/reinspect, finding.acknowledge, evidence.submit, analytics.view", "HTTPS", $tags="capability_enforced")
Rel(system_actor, api_gateway, "inspection.submit, finding.view, analytics.view", "HTTPS", $tags="capability_enforced")


' ============================================================
'  RELATIONSHIPS -- External System Interactions
' ============================================================

Rel(api_gateway, iam, "validates identity tokens and capability assertions at request ingress gate", "OAuth 2.0 / OIDC")
Rel(regulated_systems, api_gateway, "submits inspection targets conforming to target schema", "HTTPS / API")
Rel(api_gateway, regulated_systems, "returns inspection results and causal explanations (S-16)", "HTTPS / API", $tags="mediated")
Rel(cicd, compilation_engine, "runs AA-01..AA-07 certification suite; enforces policy runtime prohibition via static analysis (S-30)", "CI/CD", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- API Gateway -> Internal Containers
' ============================================================

Rel(api_gateway, directive_store, "reads and writes directives, lineage records, and revision history (directive.*, S-07)", "SQL")
Rel(api_gateway, compilation_engine, "triggers hermetic compilation on directive mutation; dry-run impact preview (S-09)", "Internal", $tags="compile_only")
Rel(api_gateway, inspection_pipeline, "routes inspection submissions with target payload (inspection.submit/reinspect)", "Internal", $tags="capability_enforced")
Rel(api_gateway, finding_fsm, "routes finding lifecycle transitions (finding.*, evidence.submit)", "Internal", $tags="capability_enforced")
Rel(api_gateway, conflict_engine, "routes conflict.resolve requests on open Conflict Artifacts; consistency review (S-05)", "Internal", $tags="capability_enforced")
Rel(api_gateway, analytics_engine, "routes read queries: analytics (S-17), directive views (S-04), findings (S-11), explanations (S-16), governance audits (S-06, S-21..S-24, S-27)", "Internal")


' ============================================================
'  RELATIONSHIPS -- Compilation Engine
' ============================================================

Rel(compilation_engine, governance_contracts, "reads Directive Graph under hermetic read-lock; policy_doctrine.yaml compile-time only (Sec.1.2)", "compile-time only", $tags="compile_only")
Rel(compilation_engine, directive_store, "reads directive revisions and lineage state under read-lock (Sec.3.4)", "SQL", $tags="compile_only")
Rel(compilation_engine, conflict_engine, "applies conflict resolution mapping at compile time (Sec.2.4 Step 3, Sec.2.15)", "Internal", $tags="compile_only")
Rel(compilation_engine, cgir_store, "publishes immutable content-addressed CG-IR snapshot (Sec.2.6)", "CAS Write", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- Inspection Pipeline
' ============================================================

Rel(inspection_pipeline, cgir_store, "loads frozen CG-IR snapshot by hash for pure DAG evaluation", "CAS Read")
Rel(inspection_pipeline, analytics_engine, "fetches pre-inspection finding_aggregates for context object (Sec.2.11)", "Internal")
Rel(inspection_pipeline, conflict_engine, "applies pre-computed deterministic resolution when multiple nodes fire against same target (Sec.2.15)", "Internal")
Rel(inspection_pipeline, finding_fsm, "emits findings (Created -> Open) after DAG evaluation completes (S-10)", "Internal")
Rel(inspection_pipeline, artifact_store, "stores inspection snapshot, pipeline trace, and system_state_hash (Sec.2.13)", "Object Write")


' ============================================================
'  RELATIONSHIPS -- Finding FSM Engine
' ============================================================

Rel(finding_fsm, finding_event_store, "appends HLC-ordered finding lifecycle events (Sec.3.1, Sec.3.3)", "Append-Only", $tags="immutable")
Rel(finding_fsm, cgir_store, "reads creator_provenance from snapshot node provenance for SoD enforcement (S-29, S-32, S-33)", "CAS Read-Only")
Rel(finding_fsm, remediation_systems, "emits mediated finding state changes to operational workflows", "webhook / events", $tags="mediated")


' ============================================================
'  RELATIONSHIPS -- Analytics Engine
' ============================================================

Rel(analytics_engine, finding_event_store, "reads events for aggregates, trends, and findings view (AA-01: read-only)", "SQL / Read-Only")
Rel(analytics_engine, cgir_store, "reads CG-IR nodes for active directive views and causal chain traversal (S-04, S-16)", "CAS Read-Only")


' ============================================================
'  RELATIONSHIPS -- Conflict Resolution Engine
' ============================================================

Rel(conflict_engine, cgir_store, "reads frozen node metadata for specificity scoring and priority comparison (Sec.2.15, Sec.2.8.2)", "CAS Read-Only")
Rel(conflict_engine, artifact_store, "stores Conflict Artifacts pending human resolution (Sec.2.15)", "Object Write", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- Audit Replication
' ============================================================

Rel(finding_event_store, audit_platform, "replicates immutable Finding Event Stream for long-term retention", "append-only / HLC-ordered", $tags="immutable")
Rel(artifact_store, audit_platform, "replicates inspection snapshots, pipeline traces, and system state hashes", "append-only")

@enduml
