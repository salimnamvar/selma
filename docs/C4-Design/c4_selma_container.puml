' ============================================================
' Title:     Selma -- Container Diagram
' Boundary:  Selma Rule Regularity Platform
' Purpose:   White-box view: one deployable application service
'            (selma_app) and four data stores, carrying forward
'            actors and external systems from the Context Diagram.
' Contract:  8.2.4
' Diagram:   8.2.4
' ============================================================
@startuml c4_selma_container
title Selma -- Container Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only",        $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",           $legendText="append-only -- never mutated")
AddRelTag("mediated",            $legendText="mediated output -- Selma never mutates external state")
AddRelTag("capability_enforced", $legendText="permission-checked before action")
AddRelTag("async",               $legendText="asynchronous / eventually consistent delivery")


' ============================================================
'  ACTORS (verbatim from Context Diagram)
' ============================================================

Person(regulatory_official, "Regulatory Official", "Human or AI agent acting for the regulatory authority. Holds full directive lifecycle capabilities, Conflict Artifact resolution, and finding disposition.")

Person(compliance_rep, "Compliance Representative", "Human, AI agent, or programmatic service acting for the regulated entity. Submits inspection targets, acknowledges findings, and views findings and analytics.")


' ============================================================
'  EXTERNAL SYSTEMS (verbatim from Context Diagram)
' ============================================================

System_Ext(governance_contracts, "Governance Contracts", "Authoring artifacts that define the rules: the normative specification, structural schema, governance policy, and behavioral contracts. Consumed exclusively at compile time — never accessed at runtime.")

System_Ext(cicd, "CI/CD Pipeline", "Continuous integration pipeline that triggers architectural certification and verifies that governance artifacts are never accessed at runtime.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems supplying inspection targets conforming to the target schema. Any subject domain: financial ledgers, software repositories, document stores, environmental monitoring, or other.")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention store for regulatory compliance and forensics. Receives finding events, security audit records, inspection snapshots, and certification artifacts. Supports external auditors and compliance reporting.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows for remediation: ticketing systems, RPA platforms, and regulatory portals. Selma sends finding notifications only — it never directly modifies external remediation state.")


' ============================================================
'  SELMA SYSTEM BOUNDARY
' ============================================================

System_Boundary(selma, "Selma Rule Regularity Platform") {

    Container(selma_app, "Selma Application", "FastAPI / Python", "Domain-agnostic rule regularity platform. Compiles human-authored regulatory directives into executable rules, inspects submitted targets against those rules, and manages findings through a full lifecycle with audit trail. Enforces capability-based access control and segregation of duties across all governance operations. Reads governance contracts only at compile time — never at runtime.")

    ContainerDb(directive_store, "Directive Store", "PostgreSQL", "Mutable, versioned database storing human-authored directives. Tracks dual identity (immutable lineage ID and active execution ID), full revision history, and fork/merge/split provenance.")

    ContainerDb(cgir_store, "CG-IR Store", "Content-Addressed Storage", "Immutable store for compiled rule snapshots, keyed by content hash. Deduplicates identical rule nodes and edges across snapshots. Never modified after publication; retained indefinitely.")

    ContainerDb(event_store, "Event Store", "Append-Only Log", "Immutable, append-only log of finding lifecycle events and security denial records. Each event is chained with a hash for tamper evidence. Source of truth for finding state, disposition history, and audit trail. Finding events and security denials stored as separate logical streams.")

    ContainerDb(artifact_store, "Execution Artifact Store", "Object Store", "Immutable object store for inspection snapshots, execution traces, reproducibility hashes, conflict artifacts pending human resolution, and certification artifacts. Append-only after creation.")

}


' ============================================================
'  RELATIONSHIPS -- Actor Ingress (verbatim from Context Diagram)
' ============================================================

Rel(regulatory_official, selma_app, "authors and governs directives; resolves findings; views analytics", "HTTPS", $tags="capability_enforced")
Rel(compliance_rep, selma_app, "submits targets for inspection; acknowledges findings; views findings and analytics", "HTTPS", $tags="capability_enforced")


' ============================================================
'  RELATIONSHIPS -- External System Interactions
' ============================================================

Rel(regulated_systems, selma_app, "submits inspection targets conforming to target schema", "HTTPS / API")
Rel(selma_app, regulated_systems, "returns inspection results and explanations", "HTTPS / API", $tags="mediated")
Rel(cicd, selma_app, "triggers architectural certification and runtime compliance checks", "CI/CD")
Rel(selma_app, governance_contracts, "reads rule definitions at compile time only", "compile-time only", $tags="compile_only")
Rel(selma_app, remediation_systems, "emits finding events and status changes", "mediated / webhook", $tags="mediated,async")


' ============================================================
'  RELATIONSHIPS -- selma_app -> Data Stores
' ============================================================

Rel(selma_app, directive_store, "reads and writes directives, lineage state, and revision history", "SQL")
Rel(selma_app, cgir_store, "publishes and loads immutable compiled rule snapshots", "CAS")
Rel(selma_app, event_store, "appends finding events and security denial records; reads for analytics and context", "Append-Only / Read-Only", $tags="immutable")
Rel(selma_app, artifact_store, "stores inspection snapshots, traces, conflict artifacts, and certification artifacts", "Object Write")


' ============================================================
'  RELATIONSHIPS -- Audit Replication
' ============================================================

Rel(event_store, audit_platform, "replicates finding events and security denial records for long-term retention", "append-only", $tags="immutable,async")
Rel(artifact_store, audit_platform, "replicates inspection snapshots, traces, and certification artifacts", "append-only", $tags="async")

@enduml
