@startuml c4_selma_component_traceability_query
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- TraceabilityQueryService Component Diagram

Container_Boundary(traceability_query, "TraceabilityQueryService") {
    Component(query_capability_gate, "QueryCapabilityGate", "Python", "Stage-local gate. Enforces finding.view and conflict.resolve before read-side execution. No store reads before authorization (3.2, S-34).")
    Component(query_router, "QueryRouter", "Python", "Routes explanation, lineage history, consistency review, and governance audit requests to the correct handler.")
    Component(explanation_query, "ExplanationQueryHandler", "Python", "Builds the causal chain Finding -> Control Node -> Directive -> Revision -> Scope from frozen artifacts and current finding state (S-16).")
    Component(lineage_history_query, "LineageHistoryQueryHandler", "Python", "Returns active directives, revision history, and fork/merge/split provenance by lineage_id (S-04, S-07).")
    Component(consistency_review_query, "ConsistencyReviewQueryHandler", "Python", "Performs read-only consistency review over frozen CG-IR candidate pairs and same-lineage rules using deterministic resolve_conflict inputs (S-05, S-28).")
    Component(governance_audit_query, "GovernanceAuditQueryHandler", "Python", "Produces full audit and verification reports for provenance canonicalization, snapshot determinism, and edge-hash integrity (S-06, S-22, S-23, S-24).")
}

Container(api_gateway_ext, "ApiGateway", "FastAPI", "Routes read-side governance and traceability queries.")
ContainerDb(directive_store, "DirectiveStore", "PostgreSQL", "Directive graph persistence and revision history.")
ContainerDb(cgir_store, "CgIrStore", "CAS", "Frozen CG-IR snapshot metadata, nodes, scopes, and provenance.")
ContainerDb(finding_event_store, "FindingEventStore", "Append-Only Log", "Finding lifecycle state and history.")
ContainerDb(audit_event_store, "AuditEventStore", "Append-Only Log", "Security and governance audit entries.")
ContainerDb(execution_artifact_store, "ExecutionArtifactStore", "Object Store", "Inspection snapshots and pipeline traces.")

Rel(api_gateway_ext, query_capability_gate, "query request", "Internal")
Rel(query_capability_gate, query_router, "authorized query")
Rel(query_router, explanation_query, "finding.explain")
Rel(query_router, lineage_history_query, "active directives / lineage history")
Rel(query_router, consistency_review_query, "consistency review")
Rel(query_router, governance_audit_query, "governance audit / verification")

Rel(explanation_query, finding_event_store, "reads finding state and history", "Read-only")
Rel(explanation_query, cgir_store, "reads control nodes, scopes, provenance", "Content-addressed")
Rel(explanation_query, directive_store, "reads directive revisions and lineage", "SQL")
Rel(explanation_query, execution_artifact_store, "reads inspection snapshots and pipeline traces", "Object GET")

Rel(lineage_history_query, directive_store, "reads active directives and revision history", "SQL")

Rel(consistency_review_query, cgir_store, "reads candidate conflict pairs, specificity inputs, provenance", "Content-addressed")

Rel(governance_audit_query, cgir_store, "reads snapshot manifests, node hashes, edge hashes", "Content-addressed")
Rel(governance_audit_query, execution_artifact_store, "reads inspection snapshots", "Object GET")
Rel(governance_audit_query, audit_event_store, "reads governance audit entries", "Read-only")

@enduml