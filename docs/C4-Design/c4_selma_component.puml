' ============================================================
' Title:     Selma -- Component Diagram
' Boundary:  Selma Rule Regularity Platform
' Purpose:   Level 3 decomposition of the 10 containers from the
'            Container Diagram (v6.0.0). Reveals internal components
'            enforcing hermetic compilation, pure evaluator DAG
'            execution, deterministic conflict resolution, strict
'            10-state Finding FSM, append-only HLC event stream,
'            capability-gated mutation paths, and read-only analytics.
' Version:   1.0.0
' Sources:   SPECIFICATION.md 8.2.4, User_Stories.md,
'            Container Diagram v6.0.0, Context Diagram v4.0.0
' ============================================================
@startuml c4_selma_component
title Selma -- Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ../common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only",        $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",           $legendText="append-only, HLC-ordered -- never mutated")
AddRelTag("mediated",            $legendText="mediated output -- Selma never mutates external state")
AddRelTag("capability_enforced", $legendText="capability-checked at mutation gate (S-34)")


' ============================================================
'  ACTORS (carried forward from Context/Container Diagrams)
' ============================================================

Person(regulatory_official, "Regulatory Official", "Human or AI agent. Full directive lifecycle (directive.*), Conflict Artifact resolution, finding disposition. SoD: cannot waive findings on own directives (S-29).")

Person(compliance_rep, "Compliance Representative", "Human or system. Submits targets, acknowledges findings, submits evidence. SoD: cannot approve own remediation (S-33).")

Person_Ext(system_actor, "Automated Service Account", "Programmatic. Narrowest capability set: inspection.submit, finding.view, analytics.view only.")


' ============================================================
'  EXTERNAL SYSTEMS (carried forward from Context/Container)
' ============================================================

System_Ext(governance_contracts, "Governance Contracts (Audit Corpus)", "policy_doctrine.yaml (governance intent, runtime-prohibited), rule_schema.json (structural validation contract), directive tables (Machine ID lineage). Consumed exclusively at the hermetic compile boundary.")

System_Ext(iam, "Identity & Access Management", "Authentication and capability authority for all actor types. Provides identity tokens and capability assertions validated at every mutation gate (S-34).")

System_Ext(cicd, "CI/CD Pipeline", "Automated architectural certification. Runs AA-01..AA-07 gate suite (S-30). Static analysis verifying policy_doctrine.yaml absence from all runtime source paths.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems and automated pipelines supplying inspection targets conforming to the target schema (S-10).")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention store for regulatory compliance and forensics. Receives Finding Event Stream, inspection snapshots, system state hashes, and pipeline traces.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows receiving mediated finding notifications. Selma never mutates external remediation state (AA-01).")


' ============================================================
'  SELMA SYSTEM BOUNDARY -- 10 CONTAINERS DECOMPOSED
' ============================================================

System_Boundary(selma, "Selma Rule Regularity Platform") {

    ' ── 1. API GATEWAY ──────────────────────────────────────────
    Container_Boundary(api_gateway_boundary, "API Gateway") {
        Component(tls_handler, "TLS Termination Handler", "Reverse proxy / TLS 1.3", "Terminates TLS 1.3 connections. No plaintext ingress. Forwards validated connections to authentication layer.")
        Component(auth_handler, "JWT / OIDC Authenticator", "AuthN middleware", "Validates bearer tokens against IAM. Extracts actor identity and capability set. Rejects expired or unauthenticated requests with 401.")
        Component(capability_enforcer, "Capability Enforcer", "AuthZ middleware", "Hard-deny (403) on missing capabilities per capability matrix -- no partial state mutation (S-34). Validates required capabilities per route: directive.*, inspection.submit/reinspect, finding.acknowledge/dismiss/waive/approve_remediation/reject_remediation, evidence.submit, conflict.resolve, analytics.view.")
        Component(request_router, "Request Router", "FastAPI router", "Routes validated requests to domain containers by capability domain: directive.* -> Directive Store + Compilation Engine; inspection.* -> Inspection Pipeline; finding.* and evidence.* -> Finding FSM Engine; conflict.resolve -> Conflict Resolution Engine; read queries -> Analytics Engine.")
    }

    ' ── 2. DIRECTIVE STORE ──────────────────────────────────────
    Container_Boundary(directive_store_boundary, "Directive Store") {
        Component(directive_repo, "Directive Repository", "PostgreSQL / SQL", "CRUD for directives, lineage records, revision history. Stores lineage_id <-> Machine ID bijection, dual identity (lineage_id, execution_id), full revision history, fork/merge/split provenance (S-01..S-03, S-07, S-08, S-19, S-20, S-26).")
        Component(lineage_manager, "Lineage Manager", "Python / Graph", "Manages dual identity lifecycle: lineage_id (immutable root) and execution_id (mutable via fork/merge/split). Enforces lineage DAG invariants: acyclicity, depth <= 64, parent existence, operation consistency (fork=1 parent, merge=2, split=1), no self-reference, temporal ordering (Sec.2.2).")
        Component(lock_manager, "Lock Manager", "PostgreSQL", "Read-lock during compilation; write-lock during directive mutations (Sec.3.4). Writer-preference FIFO queue: pending write requests block new read lock grants to prevent write starvation. No lock-type inversion.")
        Component(revision_tracker, "Revision Tracker", "PostgreSQL", "Immutable log of all directive revisions with timestamps, authors, and diffs. Supports restore to previous revision (S-07, S-08).")
    }

    ' ── 3. HERMETIC COMPILATION BOUNDARY ────────────────────────
    Container_Boundary(hermetic_boundary, "Hermetic Compilation Boundary (AA-02)") {
        Container_Boundary(compilation_engine_boundary, "Compilation Engine") {

            ' ── Validation Pipeline (ordered: passes execute sequentially) ──
            Component(schema_validator, "Schema Validator", "JSON Schema Draft-07", "First-pass structural validation against rule_schema.json. Validates required fields, type discriminators, array bounds. Necessary but insufficient -- delegates to AST discriminator for semantic checks (Sec.2.9, Sec.9.7).")
            Component(ast_discriminator, "AST Discriminator Validator", "Python / AST Walker", "Normative compile-time gate per Sec.2.9. Walks evaluator_type <-> evaluator_config AST recursively. Validates oneOf branch consistency, sub_evaluator recursion, rejects cross-type key leakage. Engines relying on JSON Schema alone are non-conformant (S-27, S-31).")
            Component(complexity_validator, "Complexity Validator", "Python", "Enforces compile-time limits: composite depth <= 32, total nodes <= 256, composite width <= 64, regex pattern <= 4096 chars, metadata <= 16384 bytes (Sec.2.9, S-27).")
            Component(lineage_dag_validator, "Lineage DAG Validator", "Python", "Mechanical validation per Sec.2.2.3: DFS cycle detection, ancestry depth <= 64, parent existence verification, operation-cardinality consistency, temporal ordering (timestamp >= max parent timestamps), no self-reference. Emits lineage_validation artifact to snapshot provenance.")
            Component(re2_linter, "RE2 Portability Linter", "Python", "Runs RE2 canary test vectors C01-C07 (Sec.9.2.6). Rejects backreferences, atomic groups, possessive quantifiers. Validates regex pattern length <= 4096 (S-21, S-31).")
            Component(version_checker, "Cross-Layer Version Checker", "Python", "Enforces MAJOR version consistency across spec, schema, and policy. formal rule: dataset(S) accepts policy(P) iff floor(S) == floor(P). JSON Schema cannot enforce cross-file version consistency (Sec.5, x-cross-layer-binding).")

            ' ── Hashing & Compilation ─────────────────────────────────────
            Component(conflict_mapper, "Conflict Resolution Mapper", "Python", "Compile-time subset of resolve_conflict per Sec.2.4 Step 3 and Sec.2.15. Generates candidate conflict pairs from conflicts_with arrays. Pre-computes precedence chain outcomes. Delegates to Conflict Resolution Engine for deterministic resolution.")
            Component(dual_hash_engine, "Dual-Hash Engine", "Python", "Implements dual-hash model per Sec.2.6: semantic_hash (evaluator, scope, depends_on, priority, conflict_resolution, status, created_at) + presentation_hash (description, directive_revision, control_version) = node_hash. edge_hash = SHA-256({source, target}). snapshot_hash = SHA-256(sorted node_hashes + sorted edge_hashes + provenance). compiled_at excluded (S-23, S-24).")
            Component(incremental_compiler, "Incremental Compiler", "Python", "Diffs current vs prior directive graph. Reuses unchanged semantic_hash subgraphs across compilations. Marks changed nodes and transitive dependents as dirty. Only recomputes dirty nodes and affected edges (Sec.2.6, S-02, S-03, S-19, S-20, S-26).")
            Component(snapshot_publisher, "Snapshot Publisher", "Python", "Composes and atomically publishes immutable content-addressed CG-IR snapshot. CAS write: no-op on duplicate snapshot_hash. Indefinite retention. Snapshot is immutable after publication (Sec.2.6).")
        }
    }

    ' ── 4. CG-IR STORE ─────────────────────────────────────────
    Container_Boundary(cgir_store_boundary, "CG-IR Store") {
        Component(snapshot_mgr, "Snapshot Reader", "CAS / Read", "Loads frozen CG-IR snapshot by snapshot_hash for evaluation, conflict resolution, SoD enforcement, and analytics. Read-only -- never mutated. All runtime consumers operate on frozen snapshots (Sec.2.6, S-10).")
        ComponentDb(node_store, "Node / Edge Dedup Store", "CAS / Dedup", "Content-addressed nodes keyed by node_hash. Content-addressed directional edges keyed by edge_hash = SHA-256({source, target}). Deduplicated across snapshots for storage efficiency (Sec.2.6, S-23, S-24).")
    }

    ' ── 5. INSPECTION PIPELINE ──────────────────────────────────
    Container_Boundary(inspection_boundary, "Inspection Pipeline") {
        Component(target_normalizer, "Target Normalizer", "Python", "Stage 1: normalize. Validates target against schema. Applies deterministic preprocessing: NFC string normalization, UTC timestamp validation, IEEE 754 finite numeric check. Produces canonical target form (Sec.2.10).")
        Component(target_classifier, "Target Classifier", "Python", "Stage 2: classify. Classifies target by domain, jurisdiction, and target_type (text/structured/binary/any). Produces classification metadata for control selection (Sec.2.8.2).")
        Component(control_selector, "Control Selector", "Python", "Stage 3: select_controls. Loads frozen CG-IR snapshot. Filters nodes by scope applicability (domain, jurisdiction, filters). Respects depends_on ordering (Sec.2.8.2).")
        Component(dag_scheduler, "Topological DAG Scheduler", "Python", "Orders selected nodes by depends_on edges. Parallel execution of independent nodes. Per-node timeout default 30s. Enforces acyclicity (Sec.2.12).")
        Component(evaluator_runtime, "Evaluator Runtime Sandbox", "Python / Sandbox", "Stage 4: evaluate. Pure functional execution: regex (RE2 only), field_check (eq/neq/gt/gte/lt/lte/contains/matches), threshold (gt/gte/lt/lte on finite IEEE 754 doubles), composite (and/or/not, depth <= 32, width <= 64). No IO, no randomness (AA-03, Sec.2.9).")
        Component(fault_handler, "Fault Handler", "Python", "Implements 8-class execution fault taxonomy: Deterministic, Partial, Ambiguous, Dependency, Timeout, Resource, Schema, Corruption. Timeout: configurable retry (max 3). Deterministic failures: no retry (Sec.3.3).")
        Component(context_builder, "Context Builder", "Python", "Fetches pre-inspection finding_aggregates from Analytics Engine. Populates read-only Context object for evaluators. Context is immutable during evaluation (Sec.2.11).")
        Component(aggregator, "Outcome Aggregator", "Python", "Stage 5: aggregate. Maps evaluator outcomes (Pass/Fail/Partial/NeedsReview) to finding severities. Applies confidence capping. Produces deontic verdicts: obligation Fail = violation, prohibition Fail = violation, permission Fail = non-applicable (Sec.2.9.1).")
        Component(snapshot_finalizer, "Snapshot Finalizer", "Python", "Stage 6: report. Produces immutable point-in-time inspection snapshot: per-control results, pipeline trace, skipped_nodes, system_state_hash (CG-IR hash + target hash + frozen_env hash). Emits findings to FSM (Created -> Open auto-transition, Sec.2.12). Stores to Artifact Store (Sec.2.13, Sec.3.6).")
    }

    ' ── 6. CONFLICT RESOLUTION ENGINE ───────────────────────────
    Container_Boundary(conflict_boundary, "Conflict Resolution Engine") {
        Component(override_resolver, "Explicit Override Resolver", "Python", "Step 1: checks conflict_resolution field (always_wins/never_wins/defer_to). Highest-precedence. Validates defer_to target existence via defer_to_reference_resolution (Sec.2.15).")
        Component(compatible_resolver, "Compatible Overrides Resolver", "Python", "Step 2: resolves symmetric pairs {always_wins, never_wins} and identical defer_to targets deterministically via compatible_overrides(). Incompatible dual overrides escalate to Conflict Artifact (Sec.2.15, S-28).")
        Component(priority_comparator, "Priority Comparator", "Python", "Step 3: compares priority_level integers: constitutional=1, statutory=2, regulatory=3, operational=4, advisory=5. Higher-priority wins. Ties fall through to specificity (Sec.2.15).")
        Component(specificity_scorer, "Specificity Scorer", "Python", "Step 4: computes specificity_score = scope_specificity_score * 100 + count_bound_fields per Sec.2.8.2. More specific scope wins (Sec.2.15, S-05, S-28).")
        Component(recency_comparator, "Recency Comparator", "Python", "Step 5: compares created_at timestamps (ISO 8601 UTC, frozen in node_body). More recent wins. Last computed factor before escalation (Sec.2.15).")
        Component(cycle_detector, "defer_to Cycle Detector", "Python / DFS", "Detects directed cycles in defer_to subgraph via DFS (S-28). Cycles cause ALL defer_to overrides in affected subgraph to be ignored -- fall through to computed resolution (priority -> specificity -> recency). Also detects missing/ambiguous post-fork targets.")
        Component(cross_lineage_advisor, "Cross-Lineage Advisor", "Python", "Produces non-binding advisory Conflict Artifacts for cross-lineage pairs per Sec.2.15.2. binding_status=advisory, requires_human_action=true. Does not auto-modify findings or CG-IR.")
        Component(artifact_emitter, "Conflict Artifact Generator", "Python", "Escalates unresolvable within-lineage conflicts as Conflict Artifacts pending human resolution via conflict.resolve capability. Stores to Artifact Store (Sec.2.15, S-05).")
    }

    ' ── 7. FINDING FSM ENGINE ───────────────────────────────────
    Container_Boundary(fsm_boundary, "Finding FSM Engine") {
        Component(fsm_core, "FSM State Machine", "Python", "Strict 10-state lifecycle: Created -> Open -> Acknowledged -> Evidence Submitted -> Pending Verification -> Verified -> Closed. Non-linear paths: Dismissed (Open->), Waived (Open->), Rejected (Pending Verification->), Reopened (Rejected->Open). Terminal states: Closed, Dismissed (Sec.3.1, S-12..S-14, S-25, S-29).")
        Component(transition_validator, "Transition Gate Validator", "Python", "Validates allowed transitions per Sec.3.1 transition table. Rejects invalid transitions with 400. Maps triggers to required capabilities for gate check.")
        Component(capability_gate, "FSM Capability Gate", "Python", "Validates actor capability at every FSM transition (S-34). Capability matrix per Sec.3.2.1. Hard-deny (403) on missing capability. Audit-logged.")
        Component(sod_enforcer, "Segregation-of-Duties Enforcer", "Python", "Reads creator_provenance from CG-IR snapshot nodes. Enforces: finding.waive blocked if actor in creator_provenance (S-29, S-32). finding.approve_remediation blocked if actor is evidence submitter (S-14a, S-33). creator_provenance inherited through fork/merge/split.")
        Component(auto_transition_handler, "Auto-Transition Handler", "Python", "System auto-transitions (no user trigger): Created -> Open (on finding creation), Evidence Submitted -> Pending Verification, Verified -> Closed, Waived -> Closed. No capability check needed -- unconditional (Sec.3.1).")
        Component(hlc_generator, "HLC Generator", "Python", "Advances Hybrid Logical Clock per event. Produces (physical_time, logical_counter, node_id) tuples. Strictly lexicographically non-decreasing per node_id (Sec.2.14, Sec.3.3).")
        Component(event_serializer, "Event Serializer", "Python", "Builds immutable FindingEvent records: FindingCreated, DispositionChanged, FindingClosed. Computes SHA-256 event_hash = SHA-256(event minus event_hash). Appends to Finding Event Store (Sec.3.3, S-14a).")
    }

    ' ── 8. FINDING EVENT STORE ─────────────────────────────────
    Container_Boundary(fes_boundary, "Finding Event Store") {
        ComponentDb(event_appender, "Event Appender", "Append-Only Log", "Accepts HLC-ordered finding events. Appends immutably -- never overwrites or deletes. Enforces append-only semantics. Maintains HLC total order (Sec.3.1, Sec.3.3, S-14a).")
        Component(event_reader, "Event Reader", "Read-Only Query", "Serves read-only queries for Analytics Engine: aggregates, trends, findings view, terminal state filtering (Closed, Dismissed). No write path (AA-01).")
        ComponentDb(hash_verifier, "Hash Chain Verifier", "SHA-256 Integrity Log", "Maintains SHA-256 event_hash integrity chain across all events. Each event's hash incorporates previous event's hash. Tamper-evident chain for forensic audit (Sec.3.3).")
    }

    ' ── 9. ANALYTICS ENGINE ─────────────────────────────────────
    Container_Boundary(analytics_boundary, "Analytics Engine") {
        Component(aggregate_builder, "Aggregate Builder", "Python", "Computes finding_aggregates: historical counts by status, severity distributions, trend metrics. Pre-inspection context for Evaluator Runtime (Sec.2.11). Serves analytics queries (S-17). Zero write path to CG-IR, FSM, or Directive Store (AA-01, S-18).")
        Component(query_processor, "Query Processor", "Python", "Serves read-only queries: active directive views from CG-IR nodes (S-04), findings view from Event Stream (S-11), governance audit queries (S-06, S-21..S-24, S-27).")
        Component(causal_explainer, "Causal Explainer", "Python", "Traverses Finding -> Control Node -> Directive -> Revision -> Scope chains for causal explanation queries (S-16). Reads CG-IR nodes for dependency chain traversal.")
    }

    ' ── 10. EXECUTION ARTIFACT STORE ──────────────────────────
    Container_Boundary(artifact_boundary, "Execution Artifact Store") {
        ComponentDb(snapshot_archiver, "Inspection Snapshot Archiver", "Object Store", "Immutable inspection snapshots. Reproducibility invariant: same CG-IR + target + frozen_env = same snapshot hash. Contains per-control results, aggregate findings (Sec.2.13, S-10, S-23).")
        ComponentDb(trace_archiver, "Pipeline Trace Archiver", "Object Store", "Pipeline execution traces: per-stage timing, evaluator invocations, topological sort order, node skip records, fault taxonomy classification (Sec.3.6). Append-only.")
        ComponentDb(state_hash_store, "System State Hash Store", "Object Store", "system_state_hashes: hash of CG-IR snapshot hash + target hash + frozen_env hash + engine version. Excludes event ordering (circular dependency avoidance). Cryptographic anchor for reproducibility verification (Sec.2.13, S-23).")
        ComponentDb(conflict_artifact_store, "Conflict Artifact Store", "Object Store", "Conflict Artifacts pending human resolution via conflict.resolve capability (Sec.2.15, S-05). Contains: conflicting rule IDs, snapshot hash, computed resolution factors, reason for escalation, cross-lineage advisory status. Append-only -- immutable once created.")
        Component(artifact_replicator, "Artifact Replicator", "Object Store", "Replicates artifacts to Audit Platform for long-term retention (Sec.3.5, Sec.3.6). Append-only stream.")
    }

}


