' ============================================================
' Title:     Selma -- Component Diagram
' Boundary:  Selma Application
' Purpose:   Internal components of selma_app. Selma Interface,
'            data stores, and external systems from the Container
'            Diagram appear as external. No modules — components only.
' Contract:  8.2.4
' ============================================================
@startuml c4_selma_component
title Selma -- Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!theme plain
!include ./common/c4_styles.puml
!include ./common/c4_identities.puml

LAYOUT_LEFT_RIGHT()

' ============================================================
'  EXTERNAL SYSTEMS (ID + Name from c4_identities.puml)
' ============================================================

System_Ext(governance_contracts, $NAME_governance_contracts, $DESC_governance_contracts)
System_Ext(cicd, $NAME_cicd, $DESC_cicd)
System_Ext(regulated_systems, $NAME_regulated_systems, $DESC_regulated_systems)
System_Ext(audit_platform, $NAME_audit_platform, $DESC_audit_platform)
System_Ext(remediation_systems, $NAME_remediation_systems, $DESC_remediation_systems)


' ============================================================
'  SELMA INTERFACE (ID + Name from Container; now external)
' ============================================================

Container_Ext(selma_interface, $NAME_selma_interface, $TECH_selma_interface, $DESC_selma_interface)


' ============================================================
'  DATA STORES (ID + Name from Container; now external)
' ============================================================

ContainerDb_Ext(directive_store, $NAME_directive_store, $TECH_directive_store, $DESC_directive_store, $tags="store")
ContainerDb_Ext(cgir_store, $NAME_cgir_store, $TECH_cgir_store, $DESC_cgir_store, $tags="store")
ContainerDb_Ext(event_store, $NAME_event_store, $TECH_event_store, $DESC_event_store, $tags="store")
ContainerDb_Ext(artifact_store, $NAME_artifact_store, $TECH_artifact_store, $DESC_artifact_store, $tags="store")


' ============================================================
'  SELMA APPLICATION BOUNDARY (ID = selma_app, Name = $NAME_selma_app)
' ============================================================

Container_Boundary(selma_app, $NAME_selma_app) {

    Component(api_gateway, $NAME_api_gateway, $TECH_api_gateway, $DESC_api_gateway, $tags="gate")
    Component(hermetic_compiler, $NAME_hermetic_compiler, $TECH_hermetic_compiler, $DESC_hermetic_compiler, $tags="hermetic")
    Component(rule_inspector, $NAME_rule_inspector, $TECH_rule_inspector, $DESC_rule_inspector)
    Component(conflict_resolver, $NAME_conflict_resolver, $TECH_conflict_resolver, $DESC_conflict_resolver)
    Component(lifecycle_finder, $NAME_lifecycle_finder, $TECH_lifecycle_finder, $DESC_lifecycle_finder)
    Component(finding_analyzer, $NAME_finding_analyzer, $TECH_finding_analyzer, $DESC_finding_analyzer)
    Component(architectural_auditor, $NAME_architectural_auditor, $TECH_architectural_auditor, $DESC_architectural_auditor)
    Component(directives_adapter, $NAME_directives_adapter, $TECH_directives_adapter, $DESC_directives_adapter)
    Component(compiled_rules_adapter, $NAME_compiled_rules_adapter, $TECH_compiled_rules_adapter, $DESC_compiled_rules_adapter)
    Component(findings_audit_adapter, $NAME_findings_audit_adapter, $TECH_findings_audit_adapter, $DESC_findings_audit_adapter)
    Component(snapshots_adapter, $NAME_snapshots_adapter, $TECH_snapshots_adapter, $DESC_snapshots_adapter)

}


' ============================================================
'  RELATIONSHIPS -- Interface -> API Gateway
' ============================================================

Rel(selma_interface, api_gateway, "forwards user requests as REST API calls", "REST / HTTPS", $tags="capability_enforced")


' ============================================================
'  RELATIONSHIPS -- External System Interactions
' ============================================================

Rel(rule_inspector, regulated_systems, "inspects targets conforming to target schema", "HTTPS / API", $tags="mediated")
Rel(cicd, api_gateway, "triggers architectural certification and runtime compliance checks", "CI/CD")
Rel(hermetic_compiler, governance_contracts, "reads rule definitions at compile time only", "Compile-Time Only", $tags="compile_only")
Rel(lifecycle_finder, remediation_systems, "emits finding events and status changes", "Mediated / Webhook", $tags="mediated_async")


' ============================================================
'  RELATIONSHIPS -- API Gateway -> Components
' ============================================================

Rel(api_gateway, directives_adapter, "routes directive CRUD and lifecycle operations", "Internal", $tags="capability_enforced")
Rel(api_gateway, hermetic_compiler, "triggers compilation on directive change or CI/CD request", "Internal", $tags="compile_only")
Rel(api_gateway, rule_inspector, "routes inspection submissions with target payload", "Internal", $tags="capability_enforced")
Rel(api_gateway, lifecycle_finder, "routes finding lifecycle transitions and evidence submission", "Internal", $tags="capability_enforced")
Rel(api_gateway, conflict_resolver, "routes conflict resolution and consistency review requests", "Internal", $tags="capability_enforced")
Rel(api_gateway, finding_analyzer, "routes read queries for analytics, directives, findings, and audits", "Internal", $tags="capability_enforced")
Rel(api_gateway, architectural_auditor, "triggers architectural certification on CI/CD request", "Internal", $tags="validation_only")
Rel(api_gateway, findings_audit_adapter, "appends denied-request records", "Append-Only", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Hermetic Compiler
' ============================================================

Rel(hermetic_compiler, directive_store, "reads directive revisions and lineage state under read-lock", "SQL", $tags="compile_only")
Rel(hermetic_compiler, compiled_rules_adapter, "publishes immutable compiled rule snapshots", "Internal", $tags="compile_only")
Rel(hermetic_compiler, conflict_resolver, "applies conflict resolution mapping at compile time", "Internal", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- Rule Inspector
' ============================================================

Rel(rule_inspector, compiled_rules_adapter, "loads frozen rule snapshot for evaluation", "Internal")
Rel(rule_inspector, finding_analyzer, "fetches historical finding summaries for inspection context", "Internal", $tags="validation_only")
Rel(rule_inspector, conflict_resolver, "applies pre-computed conflict resolution when multiple rules fire", "Internal")
Rel(rule_inspector, lifecycle_finder, "emits new findings after evaluation completes", "Internal")
Rel(rule_inspector, snapshots_adapter, "stores inspection snapshot, execution trace, and reproducibility hash", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Lifecycle Finder
' ============================================================

Rel(lifecycle_finder, findings_audit_adapter, "appends finding lifecycle events", "Internal", $tags="immutable")
Rel(lifecycle_finder, compiled_rules_adapter, "reads provenance data for segregation-of-duties enforcement", "Internal", $tags="validation_only")
Rel(lifecycle_finder, findings_audit_adapter, "appends permission denial and segregation-of-duties records", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Conflict Resolver
' ============================================================

Rel(conflict_resolver, compiled_rules_adapter, "reads frozen rule metadata for specificity scoring and priority comparison", "Internal", $tags="validation_only")
Rel(conflict_resolver, snapshots_adapter, "stores and reads conflict artifacts pending human resolution", "Internal", $tags="immutable")
Rel(conflict_resolver, findings_audit_adapter, "appends conflict resolution permission denial records", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Finding Analyzer (Read-Only)
' ============================================================

Rel(finding_analyzer, findings_audit_adapter, "reads finding events for aggregates, trends, and views", "Internal", $tags="validation_only")
Rel(finding_analyzer, compiled_rules_adapter, "reads compiled rule nodes for directive views and causal explanations", "Internal", $tags="validation_only")


' ============================================================
'  RELATIONSHIPS -- Architectural Auditor
' ============================================================

Rel(architectural_auditor, snapshots_adapter, "writes certification artifacts with pass/fail evidence", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Adapter -> Data Store
' ============================================================

Rel(directives_adapter, directive_store, "reads and writes directives, lineage state, and revision history", "SQL")
Rel(compiled_rules_adapter, cgir_store, "publishes and loads immutable compiled rule snapshots", "CAS", $tags="immutable")
Rel(findings_audit_adapter, event_store, "appends finding events and security denial records; reads for analytics and context", "Append-Only / Read-Only", $tags="immutable")
Rel(snapshots_adapter, artifact_store, "stores inspection snapshots, traces, conflict artifacts, and certification artifacts", "Object Write", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Audit Replication
' ============================================================

Rel(findings_audit_adapter, api_gateway, "exposes finding events and security denial records for audit replication", "Internal")
Rel(snapshots_adapter, api_gateway, "exposes inspection snapshots, traces, and certification artifacts for audit replication", "Internal")
Rel(audit_platform, api_gateway, "replicates finding events, security audit records, inspection snapshots, and certification artifacts for long-term retention", "Append-Only", $tags="immutable_async")

SHOW_LEGEND()
@enduml
