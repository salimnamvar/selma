Rel(schema_validator, governance_contracts, "reads rule_schema.json, directive tables (compile-time only; NEVER at runtime -- AA-02)", "File/HTTP", $tags="compile_only")
Rel(schema_validator, ast_discriminator, "passes structurally valid rules for normative evaluator_type <-> evaluator_config gate (Sec.2.9)", "Internal", $tags="compile_only")
Rel(ast_discriminator, complexity_validator, "passes type-safe rules for recursive AST complexity limits (S-27)", "Internal", $tags="compile_only")
Rel(complexity_validator, lineage_dag_validator, "passes complexity-valid rules for lineage DAG invariant checks (Sec.2.2.3)", "Internal", $tags="compile_only")
Rel(lineage_dag_validator, re2_linter, "passes DAG-valid rules for RE2 portability checks (S-21, S-31)", "Internal", $tags="compile_only")
Rel(re2_linter, version_checker, "passes portable rules for cross-layer version compatibility (Sec.5)", "Internal", $tags="compile_only")
Rel(version_checker, conflict_mapper, "all validation gates pass -> compile-time conflict mapping (Sec.2.4 Step 3, Sec.2.15)", "Internal", $tags="compile_only")
Rel(conflict_mapper, dual_hash_engine, "conflict pairs resolved -> dual-hash computation (Sec.2.6)", "Internal", $tags="compile_only")
Rel(dual_hash_engine, incremental_compiler, "compares semantic_hash across runs for subgraph reuse (S-23, S-24)", "Internal", $tags="compile_only")
Rel(incremental_compiler, snapshot_publisher, "dirty nodes recomputed -> snapshot composition and publication", "Internal", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- Compilation Engine -> External / Storage
' ============================================================

