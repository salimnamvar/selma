' ============================================================
'  RELATIONSHIPS -- API Gateway -> Internal Containers
' ============================================================

Rel(request_router, directive_repo, "reads and writes directives, lineage records, revision history (directive.*, S-01, S-02, S-07, S-08, S-19, S-20, S-26)", "SQL", $tags="capability_enforced")
Rel(request_router, lineage_manager, "fork, merge, split, retire lifecycle operations (Sec.2.2)", "SQL", $tags="capability_enforced")
Rel(request_router, lock_manager, "acquires write-lock for directive mutations (Sec.3.4)", "Internal")
Rel(request_router, schema_validator, "triggers hermetic compilation on directive mutation; dry-run impact preview (S-09)", "Internal", $tags="compile_only")
Rel(request_router, target_normalizer, "routes inspection submissions with target payload (S-10, S-15)", "Internal", $tags="capability_enforced")
Rel(request_router, capability_gate, "routes finding lifecycle transitions (finding.*, evidence.submit, S-12..S-14, S-25, S-29)", "Internal", $tags="capability_enforced")
Rel(request_router, override_resolver, "routes conflict.resolve requests on open Conflict Artifacts; consistency review (S-05)", "Internal", $tags="capability_enforced")
Rel(request_router, aggregate_builder, "routes read queries: analytics (S-17), findings view (S-11)", "Internal")
Rel(request_router, causal_explainer, "routes causal explanation queries (S-16)", "Internal")
Rel(request_router, query_processor, "routes governance audit queries (S-06, S-21..S-24, S-27)", "Internal")


