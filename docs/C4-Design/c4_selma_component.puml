Rel(schema_validator, revision_tracker, "reads revision history under read-lock", "SQL", $tags="compile_only")
Rel(conflict_mapper, override_resolver, "delegates deterministic resolve_conflict for candidate conflict pairs (Sec.2.15, S-05, S-28)", "Internal", $tags="compile_only")
Rel(snapshot_publisher, node_store, "publishes immutable content-addressed nodes and edges (Sec.2.6, S-23, S-24)", "CAS Write", $tags="compile_only")


