' ============================================================
' Title:     Selma -- Component Diagram
' Boundary:  Selma Application (selma_app)
' Purpose:   Internal components of selma_app. Selma Interface,
'            data stores, and external systems from the Container
'            Diagram appear as external. No modules — components only.
' Contract:  8.2.4
' ============================================================
@startuml c4_selma_component
title Selma -- Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only",        $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",           $legendText="append-only -- never mutated")
AddRelTag("mediated",            $legendText="mediated output -- Selma never mutates external state")
AddRelTag("capability_enforced", $legendText="permission-checked before action")
AddRelTag("async",               $legendText="asynchronous / eventually consistent delivery")


' ============================================================
'  EXTERNAL SYSTEMS (verbatim from Context Diagram)
' ============================================================

System_Ext(governance_contracts, "Governance Contracts", "Authoring artifacts that define the rules: the normative specification, structural schema, governance policy, and behavioral contracts. Consumed exclusively at compile time — never accessed at runtime.")

System_Ext(cicd, "CI/CD Pipeline", "Continuous integration pipeline that triggers architectural certification and verifies that governance artifacts are never accessed at runtime.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems supplying inspection targets conforming to the target schema. Any subject domain: financial ledgers, software repositories, document stores, environmental monitoring, or other.")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention store for regulatory compliance and forensics. Receives finding events, security audit records, inspection snapshots, and certification artifacts. Supports external auditors and compliance reporting.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows for remediation: ticketing systems, RPA platforms, and regulatory portals. Selma sends finding notifications only — it never directly modifies external remediation state.")


' ============================================================
'  SELMA INTERFACE (from Container Diagram, now external)
' ============================================================

Container_Ext(selma_interface, "Selma Interface", "CLI / WebApp / DesktopApp / MobileApp", "User-facing interface across all delivery channels. Authenticates users, renders the UI, and translates user actions into REST API calls to the Selma Application.")


' ============================================================
'  DATA STORES (from Container Diagram)
' ============================================================

ContainerDb_Ext(directive_store, "Directives", "PostgreSQL", "Mutable, versioned rules authored by regulatory officials. Tracks dual identity (immutable lineage ID and active execution ID), full revision history, and fork/merge/split provenance.")

ContainerDb_Ext(cgir_store, "Compiled Rules", "Content-Addressed Storage", "Immutable compiled rule snapshots, keyed by content hash. Deduplicates identical rule nodes and edges across snapshots. Never modified after publication; retained indefinitely.")

ContainerDb_Ext(event_store, "Findings & Audit Trail", "Append-Only Log", "Immutable, tamper-evident log of finding lifecycle events and security denial records. Source of truth for finding state, disposition history, and compliance audit trail.")

ContainerDb_Ext(artifact_store, "Inspection Snapshots", "Object Store", "Immutable inspection snapshots, execution traces, reproducibility hashes, conflict artifacts pending human resolution, and certification artifacts. Append-only after creation.")


' ============================================================
'  SELMA_APP BOUNDARY
' ============================================================

Container_Boundary(selma_app, "Selma Application") {

    Component(api_gateway, "API Gateway", "REST API", "Single entry point for all requests. Authenticates, enforces permissions, routes requests to the appropriate component, and appends denied-request records to the Event Store.")

    Component(hermetic_compiler, "Hermetic Compiler", "Python", "Reads directives and governance contracts under a hermetic boundary. Validates schema, evaluator correctness, lineage integrity, and cross-runtime portability. Publishes immutable compiled rule snapshots. Asserts governance policy is absent from runtime paths at startup.")

    Component(inspector, "Inspector", "Python", "Executes compiled rules against submitted targets through a six-stage pipeline: normalize, classify, select controls, evaluate, aggregate, and report. Produces findings and immutable inspection snapshots.")

    Component(conflict_resolver, "Conflict Resolver", "Python", "Deterministic conflict resolution authority. Applies fixed precedence: explicit override, priority, specificity, recency. Unresolvable conflicts produce artifacts for human review.")

    Component(lifecycle_finder, "Lifecycle Finder", "Python", "Manages the full 10-state finding lifecycle from Created through Closed. Enforces permissions and segregation of duties at every human-triggered transition. Emits tamper-evident events to the Event Store.")

    Component(analyzer, "Analyzer", "Python", "Read-only aggregates, trend analysis, finding views, and causal explanations. Zero write path to any store — all feedback mediated through human-initiated directive changes.")

    Component(architectural_auditor, "Architectural Auditor", "Python", "Runs seven-gate architectural certification on CI trigger. Validates mediated feedback, policy prohibition, evaluator purity, segregation of duties, conflict determinism, discriminator completeness, and portability. Writes only certification artifacts.")

    Component(directives_adapter, "Directives Adapter", "Python", "Manages directive CRUD and lifecycle operations. Coordinates lock acquisition, lineage identity resolution, and triggers compilation after mutations.")

    Component(compiled_rules_adapter, "Compiled Rules Adapter", "Python", "Manages content-addressed storage of compiled rule snapshots. Handles publish, load, deduplication, and incremental reuse of snapshots.")

    Component(findings_audit_adapter, "Findings & Audit Trail Adapter", "Python", "Manages append-only event streams for finding lifecycle events and security denial records. Handles event appending, hash chain integrity, and replication to the external Audit Platform.")

    Component(snapshots_adapter, "Inspection Snapshots Adapter", "Python", "Manages immutable storage of inspection snapshots, execution traces, conflict artifacts, and certification artifacts. Handles write-once storage and replication to the external Audit Platform.")

}


' ============================================================
'  RELATIONSHIPS -- Interface -> API Gateway
' ============================================================

Rel(selma_interface, api_gateway, "forwards user requests as REST API calls", "REST / HTTPS", $tags="capability_enforced")


' ============================================================
'  RELATIONSHIPS -- External System Interactions
' ============================================================

Rel(regulated_systems, api_gateway, "submits inspection targets conforming to target schema", "HTTPS / API")
Rel(api_gateway, regulated_systems, "returns inspection results and explanations", "HTTPS / API", $tags="mediated")
Rel(cicd, api_gateway, "triggers compilation, certification, and runtime compliance checks", "CI/CD")
Rel(hermetic_compiler, governance_contracts, "reads rule definitions under hermetic read-lock", "compile-time only", $tags="compile_only")
Rel(lifecycle_finder, remediation_systems, "emits finding status changes", "webhook / events", $tags="mediated,async")


' ============================================================
'  RELATIONSHIPS -- API Gateway -> Components
' ============================================================

Rel(api_gateway, directives_adapter, "directive CRUD and lifecycle operations", "Internal", $tags="capability_enforced")
Rel(api_gateway, hermetic_compiler, "triggers compilation on directive change or CI/CD request", "Internal", $tags="compile_only")
Rel(api_gateway, inspector, "routes inspection submissions with target payload", "Internal", $tags="capability_enforced")
Rel(api_gateway, lifecycle_finder, "routes finding lifecycle transitions and evidence submission", "Internal", $tags="capability_enforced")
Rel(api_gateway, conflict_resolver, "routes conflict resolution and consistency review requests", "Internal", $tags="capability_enforced")
Rel(api_gateway, analyzer, "routes read queries for analytics, directives, findings, and audits", "Internal", $tags="capability_enforced")
Rel(api_gateway, architectural_auditor, "triggers architectural certification on CI/CD request", "Internal", $tags="validation_only")
Rel(api_gateway, findings_audit_adapter, "appends denied-request records", "Append-Only", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Hermetic Compiler
' ============================================================

Rel(hermetic_compiler, directive_store, "reads directive revisions and lineage state under read-lock", "SQL", $tags="compile_only")
Rel(hermetic_compiler, compiled_rules_adapter, "publishes immutable compiled rule snapshots", "Internal", $tags="compile_only")
Rel(hermetic_compiler, conflict_resolver, "applies conflict resolution mapping at compile time", "Internal", $tags="compile_only")


' ============================================================
'  RELATIONSHIPS -- Inspector
' ============================================================

Rel(inspector, compiled_rules_adapter, "loads frozen rule snapshot for evaluation", "Internal")
Rel(inspector, analyzer, "fetches historical finding summaries for inspection context", "Internal")
Rel(inspector, conflict_resolver, "applies pre-computed conflict resolution when multiple rules fire", "Internal")
Rel(inspector, lifecycle_finder, "emits new findings after evaluation completes", "Internal")
Rel(inspector, snapshots_adapter, "stores inspection snapshot, execution trace, and reproducibility hash", "Internal")


' ============================================================
'  RELATIONSHIPS -- Lifecycle Finder
' ============================================================

Rel(lifecycle_finder, findings_audit_adapter, "appends finding lifecycle events", "Internal", $tags="immutable")
Rel(lifecycle_finder, compiled_rules_adapter, "reads provenance data for segregation-of-duties enforcement", "Internal")
Rel(lifecycle_finder, findings_audit_adapter, "appends permission denial and segregation-of-duties records", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Conflict Resolver
' ============================================================

Rel(conflict_resolver, compiled_rules_adapter, "reads frozen rule metadata for specificity scoring and priority comparison", "Internal")
Rel(conflict_resolver, snapshots_adapter, "stores and reads conflict artifacts pending human resolution", "Internal", $tags="immutable")
Rel(conflict_resolver, findings_audit_adapter, "appends conflict resolution permission denial records", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Analyzer (Read-Only)
' ============================================================

Rel(analyzer, findings_audit_adapter, "reads finding events for aggregates, trends, and views", "Internal")
Rel(analyzer, compiled_rules_adapter, "reads compiled rule nodes for directive views and causal explanations", "Internal")


' ============================================================
'  RELATIONSHIPS -- Architectural Auditor
' ============================================================

Rel(architectural_auditor, snapshots_adapter, "writes certification artifacts with pass/fail evidence", "Internal", $tags="immutable")


' ============================================================
'  RELATIONSHIPS -- Adapter -> Data Store
' ============================================================

Rel(directives_adapter, directive_store, "reads and writes directives, lineage state, and revision history", "SQL")
Rel(compiled_rules_adapter, cgir_store, "publishes and loads immutable compiled rule snapshots", "CAS")
Rel(findings_audit_adapter, event_store, "appends finding events and security denial records; reads for analytics and context", "Append-Only / Read-Only", $tags="immutable")
Rel(snapshots_adapter, artifact_store, "stores inspection snapshots, traces, conflict artifacts, and certification artifacts", "Object Write")


' ============================================================
'  RELATIONSHIPS -- Audit Replication
' ============================================================

Rel(findings_audit_adapter, api_gateway, "exposes finding events and security denial records for audit replication", "Internal")
Rel(snapshots_adapter, api_gateway, "exposes inspection snapshots, traces, and certification artifacts for audit replication", "Internal")
Rel(api_gateway, audit_platform, "replicates finding events, security audit records, inspection snapshots, and certification artifacts", "append-only", $tags="immutable,async")

@enduml
