' ============================================================
' Title:     Selma -- Component Diagram
' Boundary:  Selma Rule Regularity Platform
' Purpose:   White-box view of components within each of the 10
'            containers from the Container Diagram (v6.0.0).
'            Decomposes containers into their internal components,
'            revealing data flow, validation gates, hashing
'            pipelines, FSM transitions, and conflict resolution
'            stages. Carries forward the 3 governance actors, 6
'            external systems, and all relationship tags.
' Version:   1.0.0
' Sources:   SPECIFICATION.md 8.2.4, rule_schema.json 8.2.4,
'            policy_doctrine.yaml 8.2.4, Contracts Directory,
'            Container Diagram v6.0.0, Context Diagram v4.0.0,
'            User_Stories.md 8.2.4
' ============================================================
@startuml c4_selma_component
title Selma -- Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only",        $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",           $legendText="append-only, HLC-ordered -- never mutated")
AddRelTag("mediated",            $legendText="mediated output -- Selma never mutates external state")
AddRelTag("capability_enforced", $legendText="capability-checked at mutation gate (S-34)")


' ===============================================================
'  ACTORS (carried forward from Context Diagram)
' ===============================================================

Person(regulatory_official, "Regulatory Official", "Human or AI agent. Full directive lifecycle (directive.*), Conflict Artifact resolution, finding disposition. SoD: cannot waive findings on own directives (S-29).")

Person(compliance_rep, "Compliance Representative", "Human or system. Submits targets, acknowledges findings, submits evidence. SoD: cannot approve own remediation (S-33).")

Person_Ext(system_actor, "Automated Service Account", "Programmatic. Narrowest capability set: inspection.submit, finding.view, analytics.view only.")


' ===============================================================
'  EXTERNAL SYSTEMS (carried forward from Context Diagram)
' ===============================================================

System_Ext(governance_contracts, "Governance Contracts (Audit Corpus)", "policy_doctrine.yaml (governance intent, runtime-prohibited), rule_schema.json (structural validation contract), directive tables (Machine ID lineage). Consumed exclusively at the hermetic compile boundary.")

System_Ext(iam, "Identity & Access Management", "Authentication and capability authority for all actor types. Provides identity tokens and capability assertions validated at every mutation gate (S-34).")

System_Ext(cicd, "CI/CD Pipeline", "Automated architectural certification. Runs AA-01..AA-07 gate suite (S-30). Static analysis verifying policy_doctrine.yaml absence from all runtime source paths.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems and automated pipelines supplying inspection targets conforming to the target schema (S-10).")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention store for regulatory compliance and forensics. Receives Finding Event Stream, inspection snapshots, system state hashes, and pipeline traces.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows receiving mediated finding notifications. Selma never mutates external remediation state (AA-01).")


' ===============================================================
'  SELMA SYSTEM BOUNDARY
' ===============================================================

System_Boundary(selma, "Selma Rule Regularity Platform") {

' ─────────────────────────────────────────────────────────────
'  1. API GATEWAY  (FastAPI / REST)
' ─────────────────────────────────────────────────────────────
Container_Boundary(api_gw, "API Gateway") {
    Component(tls_handler, "TLS Termination Handler", "Reverse proxy / TLS 1.3", "Terminates TLS 1.3 connections. Forwards validated connections to authenticator. No plaintext ingress.")
    Component(authenticator, "JWT / OIDC Authenticator", "AuthN middleware", "Validates bearer tokens from IAM (S-34). Extracts actor identity and capability set. Rejects expired or unauthenticated requests with 401.")
    Component(capability_enforcer, "Capability Enforcer", "AuthZ middleware", "Hard-deny on missing capabilities -- no partial state mutation. Validates required capabilities per route: directive.*, inspection.submit/reinspect, finding.acknowledge/dismiss/waive/approve_remediation/reject_remediation, evidence.submit, conflict.resolve, analytics.view (S-34). Enforces segregation-of-duties at request boundary.")
    Component(request_router, "Request Router", "FastAPI router", "Routes validated requests to domain containers by capability domain: directive.* -> DirectiveStore + CompilationEngine; inspection.* -> InspectionPipeline; finding.* and evidence.* -> FindingFsmEngine; conflict.resolve -> ConflictEngine; read queries -> AnalyticsEngine.")
}

' ─────────────────────────────────────────────────────────────
'  2. DIRECTIVE STORE  (PostgreSQL)
' ─────────────────────────────────────────────────────────────
Container_Boundary(dir_store, "Directive Store") {
    Component(directive_repo, "Directive Repository", "SQL / ORM", "CRUD for directives. Stores full rule records conforming to rule_schema.json: lineage_id, id, type, message, evaluator_type, evaluator_config, scope, status, created_at, metadata, lineage, conflict_resolution, parameters, weight, priority, depends_on, conflicts_with, anchor_ref (S-01..S-03, S-07, S-08, S-19, S-20, S-26).")
    Component(lineage_manager, "Lineage Manager", "Graph operations", "Manages dual identity: lineage_id (immutable root, ^[A-Z][A-Z0-9]+-[0-9]+$) <-> execution_id (mutable, extends with -SUFFIX on fork/merge/split). Enforces lineage DAG invariants: acyclicity, single root per active rule, parent existence, operation consistency (fork/split=1 parent, merge=2 parents), no self-reference, depth bound <= 64, temporal ordering (Sec.2.2, Sec.2.3). Implements deterministic merge: lineage_id = MIN(parents) lexicographically (Sec.2.2.2).")
    Component(lock_manager, "Lock Manager", "Read / write locks", "Read-locks directive graph during compilation (Sec.3.4). Write-locks during directive mutations. Prevents concurrent compile + mutate races. Writer-preference FIFO queue prevents write starvation.")
    Component(version_tracker, "Version Tracker", "Semantic versioning", "Tracks dataset version (MAJOR.MINOR.PATCH). Enforces version sync: major(dataset) == major(spec) for compatibility (Sec.5). Computes policy_contract_version cross-check against paired policy_doctrine.yaml.")
}

' ─────────────────────────────────────────────────────────────
'  3. COMPILATION ENGINE  (Hermetic Compilation Boundary)
' ─────────────────────────────────────────────────────────────
Container_Boundary(hermetic_boundary, "Hermetic Compilation Boundary") {
    Container_Boundary(comp_eng, "Compilation Engine") {
        Component(comp_trigger, "Compilation Trigger", "Orchestrator", "Receives compilation requests from API Gateway (directive mutation) or CI/CD pipeline (S-30). Acquires read-lock on Directive Store (Sec.3.4). Initiates the hermetic compile boundary. Rejects compilation if policy_doctrine.yaml is accessible from runtime paths (AA-02, Sec.1.2).")
        Component(schema_validator, "Schema Validator", "JSON Schema Draft-07", "Validates rule dataset against rule_schema.json: required fields (version, policy_contract_version, policy_contract_id, rules[]), rule field patterns (lineage_id, id), deontic type enum, evaluator_config oneOf branches, conflict_resolution if/then, lineage cardinality constraints, additionalProperties: false enforcement. Necessary but insufficient -- delegates to AST discriminator for semantic checks.")
        Component(ast_discriminator, "AST Discriminator Validator", "AST walker", "Walks full evaluator_config AST per Sec.2.9 Discriminator Validation. Validates evaluator_type <-> evaluator_config consistency across all oneOf branches and recursive sub_evaluators. Rejects invalid pairings that JSON Schema if/then weak filters miss. NOT chains limited to maxItems=1. This is the normative gate -- engines relying on JSON Schema alone are non-conformant (S-27, S-31).")
        Component(complexity_validator, "Complexity Validator", "Limit checker", "Enforces compile-time complexity limits per Sec.2.9: max_composite_depth <= 32, max_evaluator_nodes_per_rule <= 256, max_composite_width <= 64, max_regex_pattern_length <= 4096, max_metadata_bytes_per_rule <= 16384. Counts nodes: leaf=1, composite=1+sum(sub). Recursively walks sub_evaluator tree.")
        Component(lineage_dag_validator, "Lineage DAG Validator", "Graph validator", "Implements mechanical lineage DAG validation per Sec.2.2.3: builds ancestry graph, DFS cycle detection, parent existence verification, operation consistency (fork/split=1 parent, merge=2), no self-reference, depth bound <= 64, temporal ordering (timestamp >= max parent timestamps). Records lineage_validation artifact in CG-IR provenance.")
        Component(re2_canary_checker, "RE2 Canary Checker", "Regex linter", "Runs RE2 canary test vectors per Sec.9.2.6. Rejects PCRE-only features (backreferences, atomic groups, possessive quantifiers) that would cause cross-runtime divergence. Validates regex pattern length <= 4096 chars (S-21, S-31).")
        Component(portability_validator, "Portability Validator", "Invariant checker", "Enforces cross-runtime invariants per Sec.9.2.15: NFC string normalization, IEEE 754 finite doubles (no NaN / +/-Infinity), UTC-only timestamps (ISO 8601 Z suffix, no +/-HH:MM offsets), regex flags whitelist ^[ims]*$. Verifies ordered vs unordered array classification (Sec.2.16).")
        Component(version_compatibility_checker, "Cross-Layer Version Checker", "Semver validator", "Verifies major(policy_contract_version) == major(policy.version) at compile time -- JSON Schema cannot enforce cross-file version consistency (x-cross-layer-binding). Also verifies major(dataset.version) == major(spec_version) per compatibility matrix (Sec.5).")
        Component(conflict_mapper, "Conflict Resolution Mapper", "Compile-time resolver", "Applies conflict resolution mapping at compile time per Sec.2.4 Step 3 and Sec.2.15. Reads conflict_resolution fields (explicit overrides: always_wins, never_wins, defer_to). Detects defer_to cycles via DFS. Resolves compatible_overrides (symmetric pairs). Maps priority levels (constitutional=1..advisory=5). Pre-computes deterministic resolution for runtime consumption.")
        Component(hash_engine, "Dual-Hash Engine", "SHA-256 hasher", "Implements dual-hash model per Sec.2.6: semantic_hash (evaluator, scope, depends_on, priority, conflict_resolution, status, created_at) + presentation_hash (description, directive_revision, control_version) compose node_hash. edge_hash = SHA-256 of sorted {source, target}. snapshot_hash = SHA-256 of sorted node_hashes + sorted edge_hashes + provenance. hash_algorithm_version: 2 (Sec.x-deterministic-serialization). Canonical form: sorted JSON keys, UTF-8 no BOM, defaults not injected.")
        Component(incremental_compiler, "Incremental Compiler", "Subgraph reuser", "Compares semantic_hash of each node across compilation runs. Unchanged node_body produces identical node_hash (incremental reuse). Only rehashes nodes with changed semantic or presentation fields. Reduces compilation cost for large directive graphs.")
        Component(snapshot_generator, "CG-IR Snapshot Generator", "Immutable publisher", "Generates content-addressed CG-IR snapshot from validated and hashed nodes/edges. Writes snapshot to CG-IR Store. Snapshot is immutable after publication -- never mutated. Includes provenance: lineage_validation artifact, compilation timestamp, source directive versions, hash_algorithm_version.")
    }
}

' ─────────────────────────────────────────────────────────────
'  4. CG-IR STORE  (Content-Addressed Storage)
' ─────────────────────────────────────────────────────────────
Container_Boundary(cgir_boundary, "CG-IR Store") {
    Component(snapshot_publisher, "Snapshot Publisher", "CAS write", "Accepts immutable CG-IR snapshots from Compilation Engine. Keys by SHA-256 snapshot_hash. Rejects overwrites -- once published, a snapshot is permanent. Indefinite retention.")
    Component(snapshot_reader, "Snapshot Reader", "CAS read", "Loads frozen CG-IR snapshot by hash for evaluation, conflict resolution, SoD enforcement, and analytics. Snapshot is read-only -- no mutation. All runtime consumers operate on frozen snapshots.")
    Component(node_deduplicator, "Node / Edge Deduplicator", "Dedup engine", "Deduplicates nodes by node_hash and edges by edge_hash across snapshots. Enables storage efficiency via incremental reuse -- identical node_body across snapshots shares the same hash and storage location.")
}

' ─────────────────────────────────────────────────────────────
'  5. INSPECTION PIPELINE  (Pure-Evaluator DAG Execution)
' ─────────────────────────────────────────────────────────────
Container_Boundary(inspect_pipe, "Inspection Pipeline") {
    Component(target_normalizer, "Target Normalizer", "Stage 1: normalize", "Receives raw target from regulated systems via API Gateway. Applies deterministic preprocessing: NFC string normalization, UTC timestamp validation, IEEE 754 finite numeric check, UTF-8 encoding. Produces canonical target form for all downstream stages.")
    Component(target_classifier, "Target Classifier", "Stage 2: classify", "Classifies target by domain, jurisdiction, and target_type (text/structured/binary/any) per scope.target_type enum. Determines which scope filters apply. Produces classification metadata for control selection.")
    Component(control_selector, "Control Selector", "Stage 3: select_controls", "Loads frozen CG-IR snapshot from Snapshot Reader. Applies scope filtering: matches target classification against CG-IR node scope (domain, jurisdiction, filters[]). Respects depends_on ordering via topological sort. Selects the applicable control subset for this specific target.")
    Component(topo_sorter, "Topological Sorter", "DAG ordering", "Sorts selected controls by depends_on edges (DAG topological order). Per-node timeout default 30 s. Detects evaluation-order dependencies. Respects the depends_on field from rule_schema.json.")
    Component(evaluator_engine, "Evaluator Engine", "Stage 4: evaluate", "Pure-functional evaluator runtime (AA-03, Sec.2.9). No IO, no randomness, no side effects. Four evaluator types: regex (RE2 only), field_check (eq/neq/gt/gte/lt/lte/contains/matches), threshold (gt/gte/lt/lte on finite IEEE 754 doubles), composite (and/or/not, depth <= 32, width <= 64). Receives read-only Context object (Sec.2.11) containing target, finding_aggregates, and scope metadata. Evaluators MUST NOT mutate context. 8-class fault taxonomy.")
    Component(result_aggregator, "Result Aggregator", "Stage 5: aggregate", "Aggregates per-node evaluation results into finding candidates. Computes severity from weight (critical/high/medium/low/informational). Handles composite evaluator logic (AND/OR/NOT). Produces deontic verdicts: obligation Fail = violation, prohibition Fail = violation, permission Fail = non-applicable.")
    Component(report_generator, "Report Generator", "Stage 6: report", "Produces immutable point-in-time inspection snapshot containing: per-control evaluation results, aggregate findings, pipeline trace, system_state_hash (Sec.2.13), and reproducibility metadata (CG-IR snapshot hash + target hash + frozen_env hash). Writes snapshot to Artifact Store. Emits finding candidates to Finding FSM Engine (Created -> Open auto-transition, Sec.2.12).")
}

' ─────────────────────────────────────────────────────────────
'  6. CONFLICT RESOLUTION ENGINE  (Deterministic Multi-Factor)
' ─────────────────────────────────────────────────────────────
Container_Boundary(conflict_eng, "Conflict Resolution Engine") {
    Component(explicit_override_resolver, "Explicit Override Resolver", "Step 1", "Checks conflict_resolution field in CG-IR node (always_wins, never_wins, defer_to). This is the highest-precedence step -- explicit overrides take precedence over all computed factors (Sec.2.15). Validates defer_to target existence and resolves via defer_to_reference_resolution: active rule by execution ID, follow lineage chain for deprecated targets, escalate for post-fork ambiguity.")
    Component(compatible_overrides_resolver, "Compatible Overrides Resolver", "Step 2", "Resolves symmetric pairs per Sec.2.15 compatible_overrides(): {always_wins, never_wins} pairs and identical defer_to targets resolve deterministically. Incompatible dual overrides escalate to Conflict Artifact. All inputs are frozen CG-IR fields.")
    Component(priority_scorer, "Priority Scorer", "Step 3", "Compares priority levels: constitutional=1, statutory=2, regulatory=3, operational=4, advisory=5 (x-conflict-resolution-binding.priority_level_mapping). Higher-priority rule wins. Ties fall through to specificity.")
    Component(specificity_scorer, "Specificity Scorer", "Step 4", "Computes specificity_score per Sec.2.15 using scope_specificity_score from Sec.2.8.2 and evaluator field binding. More specific scope (narrower domain, tighter jurisdiction, more filters) wins over broader scope. Two implementations MUST agree on specificity ranking for identical CG-IR node bodies.")
    Component(recency_scorer, "Recency Scorer", "Step 5", "Compares created_at timestamps (ISO 8601 UTC). More recent rule wins. This is the last computed factor before escalation to Conflict Artifact.")
    Component(defer_to_cycle_detector, "defer_to Cycle Detector", "DFS validator", "Detects directed cycles in defer_to subgraph via DFS (S-28). Any cycle causes ALL defer_to overrides in the affected subgraph to be ignored -- fall through to computed resolution (priority -> specificity -> recency). Also detects missing or ambiguous (post-fork) defer_to targets.")
    Component(conflict_artifact_generator, "Conflict Artifact Generator", "Escalation", "Generates Conflict Artifacts when no deterministic winner can be selected by the precedence chain. Artifacts stored in Execution Artifact Store pending human resolution via conflict.resolve capability (S-05). Cross-lineage pairs produce advisory Conflict Artifacts only (Sec.2.15.2).")
}

' ─────────────────────────────────────────────────────────────
'  7. FINDING FSM ENGINE  (10-State Lifecycle Machine)
' ─────────────────────────────────────────────────────────────
Container_Boundary(finding_fsm_boundary, "Finding FSM Engine") {
    Component(fsm_state_machine, "FSM State Machine", "10-state automaton", "Enforces strict finding lifecycle per Sec.3.1 (S-12, S-13, S-14a/b/c, S-25, S-29). States: Created, Open, Acknowledged, Evidence Submitted, Pending Verification, Verified, Rejected, Dismissed, Waived, Closed. Terminal states: Closed, Dismissed. Auto-transitions: Evidence Submitted -> Pending Verification, Verified -> Closed, Waived -> Closed. All non-auto transitions require explicit actor trigger.")
    Component(transition_validator, "Transition Gate Validator", "Capability checker", "Validates required capability at every FSM transition gate (S-34). Maps transition triggers to capabilities: finding.acknowledge -> compliance_rep, finding.dismiss/waive/approve_remediation/reject_remediation -> regulatory_official, evidence.submit -> compliance_rep, finding.reopen -> regulatory_official. Rejects transitions when actor lacks required capability.")
    Component(sod_enforcer, "Segregation-of-Duties Enforcer", "Provenance guard", "Reads creator_provenance from CG-IR snapshot nodes (S-29, S-32, S-33). Blocks finding.waive if acting actor is in creator_provenance of the directive that produced the finding. Blocks finding.approve_remediation if acting actor submitted the remediation evidence. Enforces: directive creator cannot waive findings on own directives; evidence submitter cannot approve own remediation.")
    Component(auto_transition_handler, "Auto-Transition Handler", "System actor", "Executes automatic FSM transitions triggered by system (actor: system): Created -> Open (on finding emission from Inspection Pipeline), Evidence Submitted -> Pending Verification, Verified -> Closed, Waived -> Closed. No capability check required -- system auto-transitions are unconditional.")
    Component(hlc_event_writer, "HLC Event Writer", "Hybrid Logical Clock", "Generates HLC-ordered Finding Events on each state transition: FindingCreated, DispositionChanged, FindingClosed (Sec.3.3). Computes SHA-256 event_hash per event for integrity chain. Appends events to Finding Event Store. Events are immutable after append.")
}

' ─────────────────────────────────────────────────────────────
'  8. FINDING EVENT STORE  (Append-Only Log)
' ─────────────────────────────────────────────────────────────
Container_Boundary(fes_boundary, "Finding Event Store") {
    Component(event_appender, "Event Appender", "Append-only write", "Accepts HLC-ordered finding events from HLC Event Writer. Appends events immutably -- never overwrites or deletes. Enforces append-only semantics. Maintains SHA-256 event_hash integrity chain across all events.")
    Component(event_reader, "Event Reader", "Read-only query", "Serves read-only queries for Analytics Engine: aggregates, trends, findings view, causal chains. Supports terminal state filtering (Closed, Dismissed). No write path. Provides source of truth for finding state and disposition history.")
    Component(event_hasher, "Event Hasher", "SHA-256 integrity chain", "Computes SHA-256 event_hash for each appended event. Maintains hash chain: each event's hash incorporates the previous event's hash, forming a tamper-evident integrity chain for forensic audit (Sec.3.3).")
}

' ─────────────────────────────────────────────────────────────
'  9. ANALYTICS ENGINE  (Read-Only Aggregates)
' ─────────────────────────────────────────────────────────────
Container_Boundary(analytics_boundary, "Analytics Engine") {
    Component(aggregate_builder, "Aggregate Builder", "Pre-inspection context", "Computes finding_aggregates for inspection context object (Sec.2.11): historical finding counts by status, severity distribution, and trend metrics per target. Fed to Evaluator Engine as read-only context before evaluation. Also serves analytics queries (S-17). Zero write path to CG-IR, FSM, or Directive Store (AA-01, S-18).")
    Component(directive_view_provider, "Directive View Provider", "Active directive queries", "Serves active directive views (S-04) by reading CG-IR nodes from Snapshot Reader. Provides directive metadata, status, scope, evaluator type, priority, and lineage information for governance dashboards.")
    Component(findings_view_provider, "Findings View Provider", "Findings queries", "Serves findings view (S-11) by reading Finding Event Stream from Event Reader. Provides finding lifecycle state, disposition history, severity, and remediation status.")
    Component(causal_chain_traverser, "Causal Chain Traverser", "Explanation queries", "Serves causal explanation queries (S-16) by traversing CG-IR node dependency chains (depends_on). Provides human-readable explanations of why a finding was produced: which rules fired, what values triggered thresholds, how composite logic resolved.")
    Component(governance_audit_provider, "Governance Audit Provider", "Audit queries", "Serves governance audit queries (S-06, S-21..S-24, S-27): conflict resolution trace, lineage ancestry depth, hash integrity verification, compilation provenance, version compatibility status. Read-only -- zero write path.")
}

' ─────────────────────────────────────────────────────────────
'  10. EXECUTION ARTIFACT STORE  (Object Store)
' ─────────────────────────────────────────────────────────────
Container_Boundary(artifact_boundary, "Execution Artifact Store") {
    Component(inspection_snapshot_store, "Inspection Snapshot Store", "Immutable blobs", "Stores point-in-time inspection snapshots from Report Generator. Reproducibility invariant: same CG-IR + target + frozen_env = same snapshot hash (Sec.2.13, S-10, S-23). Append-only after creation. Includes per-control evaluation results, aggregate findings, and pipeline trace.")
    Component(pipeline_trace_store, "Pipeline Trace Store", "Execution trace log", "Stores pipeline execution traces: per-stage timing, evaluator invocations, topological sort order, node skip records (Sec.2.12 skipped_nodes cascade). Append-only. Enables reproducibility verification and performance diagnostics (Sec.3.6).")
    Component(system_state_hash_store, "System State Hash Store", "Integrity anchor", "Stores system_state_hashes per Sec.2.13: hash of CG-IR snapshot hash + evaluator runtime version + frozen environment metadata. Provides cryptographic anchor for reproducibility verification (S-23).")
    Component(conflict_artifact_store, "Conflict Artifact Store", "Pending resolution", "Stores Conflict Artifacts pending human resolution via conflict.resolve capability (Sec.2.15, S-05). Each artifact contains: conflicting rule IDs, computed resolution factors, reason for escalation, and cross-lineage advisory status. Append-only -- artifacts are immutable once created.")
}

}


' ===============================================================
'  RELATIONSHIPS -- Actor Ingress
' ===============================================================

Rel(regulatory_official, tls_handler, "directive.*, finding.dismiss/waive/approve_remediation/reject_remediation, conflict.resolve, analytics.view", "HTTPS", $tags="capability_enforced")
Rel(compliance_rep, tls_handler, "inspection.submit/reinspect, finding.acknowledge, evidence.submit, analytics.view", "HTTPS", $tags="capability_enforced")
Rel(system_actor, tls_handler, "inspection.submit, finding.view, analytics.view", "HTTPS", $tags="capability_enforced")


' ===============================================================
'  RELATIONSHIPS -- API Gateway Internal
' ===============================================================

Rel(tls_handler, authenticator, "forwards validated TLS connection", "internal")
Rel(authenticator, iam, "validates JWT/OIDC tokens, extracts capability set (S-34)", "OAuth 2.0 / OIDC")
Rel(authenticator, capability_enforcer, "passes authenticated identity + capabilities", "internal")
Rel(capability_enforcer, request_router, "passes authorized request with capability context", "internal")


' ===============================================================
'  RELATIONSHIPS -- API Gateway -> Directive Store
' ===============================================================

Rel(request_router, directive_repo, "reads and writes directives, lineage records, and revision history (directive.*, S-01, S-02, S-07, S-08, S-19, S-20, S-26)", "SQL")
Rel(request_router, lineage_manager, "identity lifecycle operations: fork, merge, split, revision, rename, retire (Sec.2.2)", "SQL")
Rel(request_router, lock_manager, "acquires read-lock for compilation trigger, write-lock for mutations (Sec.3.4)", "internal")
Rel(request_router, version_tracker, "verifies dataset version compatibility on mutation (Sec.5)", "internal")


' ===============================================================
'  RELATIONSHIPS -- API Gateway -> Compilation Engine
' ===============================================================

Rel(request_router, comp_trigger, "triggers hermetic compilation on directive mutation; dry-run impact preview (S-09)", "internal", $tags="compile_only")


' ===============================================================
'  RELATIONSHIPS -- API Gateway -> Inspection Pipeline
' ===============================================================

Rel(request_router, target_normalizer, "routes inspection submissions with target payload (S-10, S-15)", "internal", $tags="capability_enforced")


' ===============================================================
'  RELATIONSHIPS -- API Gateway -> Finding FSM
' ===============================================================

Rel(request_router, transition_validator, "routes finding lifecycle transitions (finding.*, evidence.submit, S-12, S-13, S-14a/b/c, S-25, S-29)", "internal", $tags="capability_enforced")


' ===============================================================
'  RELATIONSHIPS -- API Gateway -> Conflict Engine
' ===============================================================

Rel(request_router, explicit_override_resolver, "routes conflict.resolve requests on open Conflict Artifacts; consistency review (S-05)", "internal", $tags="capability_enforced")


' ===============================================================
'  RELATIONSHIPS -- API Gateway -> Analytics Engine
' ===============================================================

Rel(request_router, aggregate_builder, "routes read queries: analytics (S-17), findings (S-11)", "internal")
Rel(request_router, directive_view_provider, "routes directive views (S-04)", "internal")
Rel(request_router, causal_chain_traverser, "routes causal explanation queries (S-16)", "internal")
Rel(request_router, governance_audit_provider, "routes governance audit queries (S-06, S-21..S-24, S-27)", "internal")


' ===============================================================
'  RELATIONSHIPS -- External Systems -> API Gateway
' ===============================================================

Rel(regulated_systems, tls_handler, "submits inspection targets conforming to target schema", "HTTPS / API")
Rel(request_router, regulated_systems, "returns inspection results and causal explanations (S-16)", "HTTPS / API", $tags="mediated")
Rel(cicd, comp_trigger, "runs AA-01..AA-07 certification suite; enforces policy runtime prohibition via static analysis (S-30)", "CI/CD", $tags="compile_only")


' ===============================================================
'  RELATIONSHIPS -- Compilation Engine Internal
' ===============================================================

Rel(comp_trigger, lock_manager, "acquires read-lock on Directive Store before compilation (Sec.3.4)", "internal", $tags="compile_only")
Rel(comp_trigger, governance_contracts, "verifies policy_doctrine.yaml accessible for compile-time only; rejects if in runtime paths (AA-02, Sec.1.2, Sec.9.7)", "compile-time only", $tags="compile_only")
Rel(comp_trigger, schema_validator, "passes directive dataset for structural validation", "internal", $tags="compile_only")
Rel(schema_validator, ast_discriminator, "delegates evaluator_type <-> evaluator_config semantic validation (Sec.2.9)", "internal", $tags="compile_only")
Rel(ast_discriminator, complexity_validator, "passes evaluator AST for depth/node/width/pattern limits (Sec.2.9)", "internal", $tags="compile_only")
Rel(comp_trigger, lineage_dag_validator, "passes lineage records for DAG invariant validation (Sec.2.2.3)", "internal", $tags="compile_only")
Rel(lineage_dag_validator, directive_repo, "reads lineage records under read-lock (Sec.3.4)", "SQL", $tags="compile_only")
