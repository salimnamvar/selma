' ============================================================
@startuml c4_selma_component_compilation
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- CompilationEngine Component Overview

Container_Boundary(compilation, "CompilationEngine") {

    Boundary(val_pass, "Validation Pass") {
        Component(js_validator, "JsonSchemaValidator", "Python", "Three-pass validation pipeline with normative compile-time validators. See c4_selma_component_compilation_validation.puml.")
    }

    Boundary(core, "Core Compilation") {
        Component(identity_resolver, "IdentityResolver", "Python", "Hermetic compilation core: identity, transformation, hashing, incremental. See c4_selma_component_compilation_core.puml.")
    }

    Boundary(conflict, "Conflict Metadata") {
        Component(conflict_metadata, "ConflictMetadataAssembler", "Python", "Compilation-time preparation: candidate conflict pairs, specificity inputs, snapshot assembly, provenance. See c4_selma_component_compilation_conflict.puml.")
    }

    Component(error_handler, "ErrorHandler", "Python", "Aggregates all validation failures. Returns SchemaError. Any FAIL stops pipeline.")
}

ContainerDb(cgir_store, "CgIrStore", "CAS", "Immutable CG-IR snapshots and shared node objects.")
ContainerDb(directive_store, "DirectiveStore", "PostgreSQL", "Directive graph source of truth.")
Container(directive_mgr_ext, "DirectiveManager", "Python", "Triggers compilation on directive mutation (Authoring Layer).")

Rel(directive_store, val_pass, "directive graph (read lock)", "SQL")
Rel(directive_mgr_ext, core, "compilation trigger", "Internal")
Rel(val_pass, core, "validated rules (ALL PASS)")
Rel(core, conflict, "mapped nodes + dependency graph + frozen conflict inputs")
Rel(conflict, cgir_store, "immutable CG-IR snapshot", "Content-addressed")
Rel(val_pass, error_handler, "FAIL: validation errors")
Rel(conflict, cgir_store, "reads previous snapshot (incremental)", "Content-addressed")

@enduml
