@startuml c4_selma_service_context
' ============================================================
' Title:     selma_service — Context Diagram
' Boundary:  selma_service Universal Rule Governance Engine
' Purpose:   Show selma_service as the system under design, its actors,
'            and external dependencies
' Milestone: v1.0
' Version:   1.2.0
' Source:    contracts/SPECIFICATION.md
' ============================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Context.puml
!include common/c4_styles.puml
!theme plain
LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

title SELMA System — Context Diagram

Person(admin, "Rule Administrator", "Human authoring and maintaining rule sets via CLI or REST API", $sprite="person")
Person(agent, "AI Agent", "Autonomous agent that submits natural language rule requests", $sprite="person")
Person(developer, "Domain Developer", "Builds downstream services that consume rules via API or export", $sprite="person")

System(selma_service, "SELMA System", "Universal Rule Governance Engine: writes, validates, lints, and reasons about rules", $tags="system")

System_Ext(llm, "LLM Service", "OpenAI / Anthropic API for rule generation and deep reasoning", $tags="external")
System_Ext(fs, "File System", "Stores policy.md and rules.yaml per domain", $tags="external")
System_Ext(repo, "Git Repository", "Optional version control for rule history and audit trail", $tags="external")

Rel(admin, selma_service, "CRUD operations, validation, queries", "HTTPS / CLI")
Rel(agent, selma_service, "Submits natural language rule requests", "HTTPS")
Rel(developer, selma_service, "Fetches rules, exports domains", "HTTPS")
Rel(selma_service, llm, "Delegates AI rule generation and deep reasoning", "HTTPS")
Rel(selma_service, fs, "Reads and writes policy.md and rules.yaml", "I/O")
Rel(selma_service, repo, "Commits changes", "Git")

@enduml
