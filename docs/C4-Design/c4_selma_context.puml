' ============================================================
' Title:     Selma -- Context Diagram
' Boundary:  Selma Rule Regularity Platform
' Purpose:   Black-box view of the two governance actors, the
'            automated service account, and the five external
'            systems Selma compiles against, certifies, and
'            streams findings and security audit records into.
' Contract:  8.2.4
' Diagram:   8.2.4 (Phase B AIP alignment)
' ============================================================
@startuml c4_selma_context
title Selma -- Context Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Context.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

AddRelTag("compile_only", $legendText="compile-time only -- runtime access is prohibited")
AddRelTag("immutable",    $legendText="append-only -- never mutated")
AddRelTag("mediated",     $legendText="mediated output -- Selma never mutates external state")
AddRelTag("async",        $legendText="asynchronous / eventually consistent delivery")



Person(regulatory_official, "Regulatory Official", "Human or AI agent acting for the regulatory authority. Holds full directive lifecycle capabilities, Conflict Artifact resolution, and finding disposition.")

Person(compliance_rep, "Compliance Representative", "Human or system acting for the regulated entity. Submits inspection targets, acknowledges findings, and submits remediation evidence.")

Person_Ext(system_actor, "Automated Service Account", "Programmatic service account with the narrowest capability set: inspection submission, finding viewing, and analytics viewing only. Used by pipelines integrating compliance checks without governance rights.")

System(selma, "Selma", "Domain-agnostic rule regularity platform. Compiles human-authored regulatory directives into executable rules, inspects submitted targets against those rules, and manages findings through a full lifecycle with audit trail. Enforces capability-based access control and segregation of duties across all governance operations.")

System_Ext(governance_contracts, "Governance Contracts", "Authoring artifacts that define the rules: the normative specification, structural schema, governance policy, and behavioral contracts. Consumed exclusively at compile time — never accessed at runtime.")

System_Ext(cicd, "CI/CD Pipeline", "Continuous integration pipeline that triggers architectural certification and verifies that governance artifacts are never accessed at runtime.")

System_Ext(regulated_systems, "Target & Regulated Entity Systems", "Domain-agnostic external systems supplying inspection targets conforming to the target schema. Any subject domain: financial ledgers, software repositories, document stores, environmental monitoring, or other.")

System_Ext(audit_platform, "Audit & Observability Platform", "Immutable long-term retention store for regulatory compliance and forensics. Receives finding events, security audit records, inspection snapshots, and certification artifacts. Supports external auditors and compliance reporting.")

System_Ext(remediation_systems, "Remediation & Case Management", "Operational workflows for remediation: ticketing systems, RPA platforms, and regulatory portals. Selma sends finding notifications only — it never directly modifies external remediation state.")

Rel(regulatory_official, selma, "authors and governs directives; resolves findings; views analytics", "HTTPS")
Rel(compliance_rep, selma, "submits targets for inspection; acknowledges findings; submits remediation evidence", "HTTPS")
Rel(system_actor, selma, "submits inspections programmatically; views findings and analytics", "HTTPS")

Rel(selma, governance_contracts, "reads rule definitions at compile time only", "compile-time only", $tags="compile_only")
Rel(cicd, selma, "triggers architectural certification and runtime compliance checks", "CI/CD")

Rel(regulated_systems, selma, "submits inspection targets conforming to target schema", "HTTPS / API")
Rel(selma, regulated_systems, "returns inspection results and explanations", "HTTPS / API", $tags="mediated")

Rel(selma, audit_platform, "streams findings, security audit records, and inspection artifacts", "append-only", $tags="immutable,async")
Rel(selma, remediation_systems, "emits finding events and status changes", "mediated / webhook", $tags="mediated,async")

@enduml
