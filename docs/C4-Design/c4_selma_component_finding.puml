' ============================================================
' Title:     Selma -- FindingFsmEngine Component Diagram
' Boundary:  FindingFsmEngine
' Purpose:   Finding lifecycle state machine with SoD enforcement, capability gating, and audit trail
' Milestone: v2.0.0
' Version:   2.0.0
' Contract:  8.2.4
' Source:    docs/Regulation/SPECIFICATION.md 3.1-3.4, docs/User-Story/User_Stories.md Epic 4, AA-04 gate
' Review:    Enhanced — 2026-07-06
' ============================================================
@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!include ./common/c4_styles.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- FindingFsmEngine Component Diagram

Container_Boundary(fsm, "FindingFsmEngine") {
    Component(capability_checker, "CapabilityChecker", "Python", "Verifies actor holds required capability for requested transition (S-34).")
    Component(sod_enforcer, "SegregationOfDutiesEnforcer", "Python", "finding.waive: actor not in creator_provenance (S-29, S-32). finding.approve_remediation: actor != evidence submitter (S-14a, S-33).")
    Component(fsm_state_machine, "FsmStateMachine", "Python", "10 states, 11 transitions per SPEC 3.1. Created->Open (auto), Open->Acknowledged, Open->Dismissed, Open->Waived, Acknowledged->Evidence Submitted, Evidence Submitted->Pending Verification (auto), Pending Verification->Verified, Pending Verification->Rejected, Rejected->Open, Verified->Closed (auto), Waived->Closed (auto). Closed and Dismissed are terminal states with no outgoing transitions. Concurrency handled via HLC-ordering: read-before-write race detected post-hoc via HLC tuple ordering; conflicting transitions rejected on append.")
    Component(hlc_clock, "HlcClockManager", "Python", "physical_time -> logical_counter -> node_id -> event_id. Per-node non-decreasing. Absorbs wall clock regression (3.3).")
    Component(event_hasher, "EventHasher", "Python", "SHA-256(event payload). Ensures event integrity. Append-only guarantee.")
    Component(event_appender, "EventAppender", "Python", "Atomic append to Finding Event Stream. HLC total order. No mutation, no deletion.")
    Component(audit_logger, "AuditLogger", "Python", "Records all transitions: actor, timestamp, reason. Denials logged with CapabilityDenied reason (S-32, S-33, S-34).")
    Component(denial_handler, "DenialHandler", "Python", "403 CapabilityDenied. No partial state mutation. FSM state unchanged. Audit entry recorded.")
}

Container(api_gateway_ext, "ApiGateway", "FastAPI", "Dispatches finding transition requests (AA-04 Segregation of Duties).")
ContainerDb(finding_event_store, "FindingEventStore", "Append-Only Log", "HLC-ordered finding lifecycle events.")
ContainerDb(audit_event_store, "AuditEventStore", "Append-Only Log", "Security audit entries: denials, transition attempts, SoD violations (S-32, S-33, S-34). Separate retention policy. [security: SHA-256 hash chain, tamper-evident, append-only]")

Rel(api_gateway_ext, capability_checker, "transition request (actor, capability, finding_id, target_state, comments)", "Internal")
Rel(capability_checker, sod_enforcer, "capability held")
Rel(capability_checker, denial_handler, "capability missing")
Rel(sod_enforcer, fsm_state_machine, "SoD check passed")
Rel(sod_enforcer, denial_handler, "SoD violation")
Rel(fsm_state_machine, hlc_clock, "valid transition")
Rel(fsm_state_machine, denial_handler, "invalid transition")
Rel(hlc_clock, event_hasher, "HLC tuple")
Rel(event_hasher, event_appender, "hashed event")
Rel(event_appender, finding_event_store, "appends event with event_hash", "Append-only")
Rel(event_appender, api_gateway_ext, "transition confirmation", "Internal")

Rel(capability_checker, audit_logger, "transition attempt")
Rel(sod_enforcer, audit_logger, "SoD check result")
Rel(denial_handler, audit_logger, "denial recorded")
Rel(denial_handler, api_gateway_ext, "403 CapabilityDenied", "Internal")
Rel(audit_logger, audit_event_store, "audit entries", "Append-only")

Rel(finding_event_store, fsm_state_machine, "reads current finding state", "Read-only")
Rel(finding_event_store, sod_enforcer, "reads creator_provenance, evidence submitter history", "Read-only")

denial_handler -[hidden]right- finding_event_store

@enduml
