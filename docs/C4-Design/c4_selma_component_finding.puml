' ============================================================
' Title:     Selma -- FindingFsmEngine Component Diagram
' Boundary:  FindingFsmEngine
' Purpose:   Shows finding lifecycle state machine, capability gating, and event emission
' Milestone: v1.0.0
' Version:   1.0.0
' Source:    docs/Regulation/SPECIFICATION.md 3.1-3.2, docs/User-Story/User_Stories.md Epic 4
' Review:    pending
' ============================================================
@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Component.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma -- FindingFsmEngine Component Diagram

Container_Boundary(fsm, "FindingFsmEngine") {
    Component(capability_gater, "CapabilityGater", "Python", "Enforces capability matrix and segregation of duties at FSM transition gate per 3.2")
    Component(fsm_transition, "FsmTransition", "Python", "Finding state machine: Open, Acknowledged, Evidence Submitted, Pending Verification, Verified, Rejected, Dismissed, Waived, Closed")
    Component(event_emitter, "EventEmitter", "Python", "Appends HLC-ordered FindingCreated, DispositionChanged, FindingClosed events per 2.14")
    Component(hlc_clock, "HlcClock", "Python", "Hybrid Logical Clock for total event ordering per 2.14")
}

ContainerDb(finding_event_store, "FindingEventStore", "Append-Only Log", "HLC-ordered event stream")

Rel(capability_gater, fsm_transition, "Validated transition request")
Rel(fsm_transition, event_emitter, "Validated state change")
Rel(hlc_clock, event_emitter, "HLC tuple for event ordering")
Rel(event_emitter, finding_event_store, "Appends event with event_hash", "Append-only")

@enduml
