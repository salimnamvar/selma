  }

  abstract class "**MaterializeCgIr**" as MaterializeCgIr <<Use Case>> #E8F5E9/2E7D32 {
    - cgIrRepo: CgIrRepository
    + execute(controls: List~ControlNode~, edges: List~DependencyEdge~): CgIrSnapshot
  }

  abstract class "**PublishSnapshot**" as PublishSnapshot <<Use Case>> #E8F5E9/2E7D32 {
    - cgIrRepo: CgIrRepository
