' ═══════════════════════════════════════════════════════════
'  PORT INTERFACES
' ═══════════════════════════════════════════════════════════
package "<<application.ports>>\nRepository & Gateway Ports" as PORTS #FCE4EC/C62828 {

  interface "**DirectiveRepository**" as DirectiveRepository <<Port>> {
    + findById(id: LineageId): Directive
    + save(directive: Directive): void
    + findByStatus(status: DirectiveStatus): List~Directive~
    + nextExecutionId(): ExecutionId
    + readExecutable(id: LineageId | ExecutionId): ExecutableRuleDoc
    + readPolicyDoctrine(ref: PairedPolicyRef): GuidancePayload
    + listPolicyRefs(filter: Map): List~PairedPolicyRef~
  }

  interface "**CgIrRepository**" as CgIrRepository <<Port>> {
    + findByHash(hash: String): CgIrSnapshot
    + save(snapshot: CgIrSnapshot): void
    + latest(): CgIrSnapshot
  }

  interface "**EventStore**" as EventStore <<Port>> {
    + append(event: DomainEvent): void
    + stream(aggregate_id: String): List~DomainEvent~
    + stream(from: HlcTimestamp): List~DomainEvent~
  }

  interface "**ArtifactRepository**" as ArtifactRepository <<Port>> {
    + saveInspection(snapshot: InspectionSnapshot): void
    + findInspection(id: UUID): InspectionSnapshot
    + saveFinding(finding: Finding): void
    + findFinding(id: FindingId): Finding
    + saveConflict(artifact: ConflictArtifact): void
  }

  interface "**TargetGateway**" as TargetGateway <<Port>> {
    + fetchTarget(target_id: String): Target
    + hashTarget(target: Target): TargetHash
  }

}

' ═══════════════════════════════════════════════════════════
'  APPLICATION DTOs
' ═══════════════════════════════════════════════════════════
package "<<application.dto>>\nData Transfer Objects" as DTO_PKG #E8EAF6/3F51B5 {

  class "**InspectRequest**" as InspectRequest <<DTO>> #E8EAF6/3F51B5 {
    + target_id: String
    + target_payload: Map
    + directive_ids: List~LineageId~
  }

  class "**InspectResponse**" as InspectResponse <<DTO>> #E8EAF6/3F51B5 {
    + inspection_id: UUID
    + finding_count: int
    + status: InspectionStatus
    + findings: List~FindingSummary~
  }

  class "**QueryRequest**" as QueryRequest <<DTO>> #E8EAF6/3F51B5 {
    + scope: String
    + period: DateRange
    + filters: Map
  }

  class "**DirectiveCreateRequest**" as DirectiveCreateRequest <<DTO>> #E8EAF6/3F51B5 {
    + lineage_id: LineageId
    + subject: Subject
    + predicate: Predicate
    + detection_spec: DetectionSpec
    + paired_policy_ref: PairedPolicyRef
    + applicability: Applicability
    + priority: Priority
    + modality: DeonticModality
  }
}

' ═══════════════════════════════════════════════════════════
'  GOVERNANCE USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.governance>>\nGovernance" as UC_GOVERNANCE #E8F5E9/2E7D32 {

  abstract class "**CreateDirective**" as CreateDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + execute(req: DirectiveCreateRequest): Directive
    --
    <<requires>> directive.lineage.create
  }

  abstract class "**ModifyDirective**" as ModifyDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + execute(id: LineageId, changes: Map): Directive
    --
    <<requires>> directive.lineage.modify
  }

  abstract class "**RetireDirective**" as RetireDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + execute(id: LineageId): Directive
    --
    <<requires>> directive.lineage.retire
  }

  abstract class "**ForkDirective**" as ForkDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + execute(source: LineageId): Directive
    --
    <<requires>> directive.lineage.fork
  }

  abstract class "**MergeDirective**" as MergeDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + execute(left: LineageId, right: LineageId): Directive
    --
    <<requires>> directive.lineage.merge
  }

  abstract class "**SplitDirective**" as SplitDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + execute(source: LineageId): List~Directive~
    --
    <<requires>> directive.lineage.split
  }

  abstract class "**RestoreDirective**" as RestoreDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + execute(id: LineageId, revision: int): Directive
    --
    <<requires>> directive.lineage.restore
  }
}

