  }

  abstract class "**GenerateReport**" as GenerateReport <<Use Case>> #E8F5E9/2E7D32 {
    - artifactRepo: ArtifactRepository
    + execute(inspection: InspectionSnapshot, findings: List~Finding~): InspectResponse
  }
}

' ═══════════════════════════════════════════════════════════
'  FINDING USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.finding>>\nFinding Lifecycle" as UC_FINDING #E8F5E9/2E7D32 {

  abstract class "**CreateFinding**" as CreateFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(inspection_id: UUID, outcome: DetectionOutcome): Finding
    --
    <<requires>> finding.lifecycle.create
  }

  abstract class "**OpenFinding**" as OpenFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId): Finding
    --
    <<requires>> finding.lifecycle.open
  }

  abstract class "**SubmitEvidence**" as SubmitEvidence <<Use Case>> #E8F5E9/2E7D32 {
    - artifactRepo: ArtifactRepository
    - eventStore: EventStore
    + execute(finding_id: FindingId, evidence: EvidenceRef): Finding
  }

  abstract class "**ValidateFinding**" as ValidateFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId, disposition: Disposition): Finding
    --
    <<requires>> finding.lifecycle.validate
  }

  abstract class "**RemediateFinding**" as RemediateFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId): Finding
    --
    <<requires>> finding.lifecycle.remediate
  }

  abstract class "**VerifyFinding**" as VerifyFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId): Finding
    --
    <<requires>> finding.lifecycle.verify
    <<SoD>> verifier ≠ finder
  }

  abstract class "**WaiveFinding**" as WaiveFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId, reason: String): Finding
    --
    <<requires>> finding.lifecycle.waive
    <<SoD>> waivor ≠ finder
  }

  abstract class "**DismissFinding**" as DismissFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId, reason: String): Finding
    --
    <<requires>> finding.lifecycle.dismiss
  }

  abstract class "**CloseFinding**" as CloseFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - eventStore: EventStore
    + execute(finding_id: FindingId): Finding
    --
    <<requires>> finding.lifecycle.close
  }
}

