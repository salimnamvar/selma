'  INSPECTION USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.inspection>>\nInspection" as UC_INSPECTION #E8F5E9/2E7D32 {

  abstract class "**SubmitInspection**" as SubmitInspection <<Use Case>> #E8F5E9/2E7D32 {
    - targetGateway: TargetGateway
    - cgIrRepo: CgIrRepository
    - artifactRepo: ArtifactRepository
    + execute(req: InspectRequest): InspectResponse
  }

  abstract class "**NormalizeTarget**" as NormalizeTarget <<Use Case>> #E8F5E9/2E7D32 {
    + execute(raw: Map): Target
  }

  abstract class "**ClassifyTarget**" as ClassifyTarget <<Use Case>> #E8F5E9/2E7D32 {
    + execute(target: Target): TargetClassification
  }

  abstract class "**SelectControls**" as SelectControls <<Use Case>> #E8F5E9/2E7D32 {
    - cgIrRepo: CgIrRepository
    + execute(target: Target, snapshot: CgIrSnapshot): List~ControlNode~
  }

  abstract class "**EvaluateRules**" as EvaluateRules <<Use Case>> #E8F5E9/2E7D32 {
    + execute(target: Target, controls: List~ControlNode~): List~DetectionOutcome~
  }

  abstract class "**AggregateResults**" as AggregateResults <<Use Case>> #E8F5E9/2E7D32 {
