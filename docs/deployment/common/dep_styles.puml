' ============================================================
' Title:     Selma — Deployment Styles
' Purpose:   Deployment chrome + zone colors from CA MACRO layers.
' Contract:  1.1.0
'
' Include order:
'   !include common/dep_styles.puml
'   !include common/dep_identities.puml
' ============================================================

!include ../../standards/common/ca_palette.puml

!theme plain
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 10
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam roundCorner 8
skinparam handwritten false
skinparam backgroundColor $CA_CANVAS
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor $CA_INK
skinparam nodesep 40
skinparam ranksep 50

skinparam packageStyle rectangle
skinparam package {
  FontSize 11
  FontStyle bold
  FontColor $CA_INK
  BorderThickness 2
}

skinparam node {
  BackgroundColor $CA_CANVAS
  BorderColor $CA_BORDER_NEUTRAL
  FontSize 10
  FontColor $CA_INK
  BorderThickness 1.5
}

skinparam database {
  BackgroundColor $CA_SOLID_FRAMEWORKS
  BorderColor $CA_BORDER_FRAMEWORKS_DEEP
  FontColor #FFFFFF
  FontSize 10
  FontStyle bold
}

skinparam cloud {
  BackgroundColor $CA_SOLID_EXTERNAL
  BorderColor $CA_BORDER_EXTERNAL
  FontColor #FFFFFF
  FontSize 10
}

skinparam ArrowColor $CA_ARROW
skinparam ArrowThickness 1.5
skinparam ArrowFontSize 9
skinparam ArrowFontColor $CA_INK

' ── MACRO solid aliases ─────────────────────────────────────
!$DEP_COLOR_ACTOR       = $CA_SOLID_ACTOR
!$DEP_COLOR_CONTAINER   = $CA_SOLID_INTERFACE
!$DEP_COLOR_PROCESS     = $CA_SOLID_APPLICATION
!$DEP_COLOR_STORE       = $CA_SOLID_FRAMEWORKS
!$DEP_COLOR_GATE        = $CA_SOLID_GATE
!$DEP_COLOR_PENDING     = $CA_SOLID_INFRASTRUCTURE
!$DEP_COLOR_TERMINAL    = $CA_SOLID_TERMINAL
!$DEP_COLOR_DOMAIN      = $CA_SOLID_DOMAIN
!$DEP_COLOR_EXTERNAL    = $CA_SOLID_EXTERNAL

' ── Zone packages (CA layer mapping) ────────────────────────
' External User → ACTORS
' Public edge   → INTERFACE
' Application   → APPLICATION
' Data          → FRAMEWORKS
' External opt  → EXTERNAL
' Monitoring    → COMPOSITION (ops plane, not product peer)
!$DEP_ZONE_USER_FILL     = $CA_FILL_ACTOR
!$DEP_ZONE_USER_BORDER   = $CA_BORDER_ACTOR
!$DEP_ZONE_PUBLIC_FILL   = $CA_FILL_INTERFACE
!$DEP_ZONE_PUBLIC_BORDER = $CA_BORDER_INTERFACE
!$DEP_ZONE_APP_FILL      = $CA_FILL_APPLICATION
!$DEP_ZONE_APP_BORDER    = $CA_BORDER_APPLICATION
!$DEP_ZONE_DATA_FILL     = $CA_FILL_FRAMEWORKS
!$DEP_ZONE_DATA_BORDER   = $CA_BORDER_FRAMEWORKS
!$DEP_ZONE_EXT_FILL      = $CA_FILL_EXTERNAL
!$DEP_ZONE_EXT_BORDER    = $CA_BORDER_EXTERNAL
!$DEP_ZONE_MON_FILL      = $CA_FILL_COMPOSITION
!$DEP_ZONE_MON_BORDER    = $CA_BORDER_COMPOSITION

!$DEP_NODE_APP_BG        = $CA_SOLID_INTERFACE
!$DEP_NODE_LB_BG         = $CA_SOLID_INTERFACE_SOFT
!$DEP_NODE_PVC_BG        = $CA_SOLID_INFRASTRUCTURE
!$DEP_NODE_MON_BG        = $CA_FILL_COMPOSITION
