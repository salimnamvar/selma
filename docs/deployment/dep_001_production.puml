@startuml dep_001_production
' ============================================================
' Title:     DEP-001 Production Deployment
' Source:    docs/deployment/README.md · docs/standards/c4_registry.yaml
' C4:        clients → application → *_store | target_sources
' Package:   runtime co-locates compiled_rules_* with application process
' Purpose:   WHERE Selma runs: zones, nodes, failure domains, TLS.
'            Does NOT redraw component graph or package modules.
' Contract:  1.2.0
'
' Structure (mirrors package/state/c4 common/):
'   common/dep_styles.puml       — visual language + C4 palette
'   common/dep_identities.puml   — zone/node/edge/C4 labels
'   common/dep_section_*.puml    — one file per zone
'   common/dep_connections.puml  — all topology edges
'
' This file only orchestrates includes. Edit sections/connections
' to change structure; do not re-inline content here.
' ============================================================

!include common/dep_styles.puml
!include common/dep_identities.puml

title $TITLE_PRODUCTION

!include common/dep_section_user.puml
!include common/dep_section_public.puml
!include common/dep_section_application.puml
!include common/dep_section_data.puml
!include common/dep_section_external.puml
!include common/dep_section_monitoring.puml

!include common/dep_connections.puml

footer $FOOTER_PRODUCTION

@enduml
