' ============================================================
' Title:     Selma -- Production Deployment Diagram
' Purpose:   Deploy topology aligned with C4 1.1.0 resource model
' Contract:  1.1.0
' ============================================================
@startuml dep_001_production
title **DEP-001 — Production Deployment**\nSelma · Resource-oriented stores · Clean Architecture process\n

!theme plain
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor #FAFBFC

package "External User Zone" as USER_ZONE #F3E5F5/E1BEE7 {
    node "Clients\n(CLI / Web / Desktop / Mobile)" as CLIENTS <<docker or native>>
}

package "Public Zone" as PUBLIC_ZONE #E3F2FD/BBDEFB {
    node "Load Balancer\n(Nginx / Traefik)" as LOAD_BALANCER
}

package "Application Zone" as APP_ZONE #E8F5E9/C8E6C9 {
    node "Application container\n(Python 3.11+ / Docker)" as APP <<docker container>>
}

package "Data Zone" as DATA_ZONE #FFF3E0/FFE0B2 {
    database "directives_store\n(PostgreSQL)" as DIRECTIVES
    node "compiled_rules_store\n(CAS FS or S3)" as COMPILED
    database "finding_events_store\n(PostgreSQL append-only)" as EVENTS
    node "artifacts_store\n(Object Store)" as ARTIFACTS
}

package "External Zone (optional)" as EXT_ZONE #FCE4EC/F8BBD0 {
    cloud "target_sources\n(optional pull)" as TARGETS
}

package "Monitoring" as MON #E8EAF6/C5CAE9 {
    node "Prometheus / Grafana" as PROM
    node "ELK / Loki" as ELK
    node "Jaeger" as JAEGER
}

CLIENTS --> LOAD_BALANCER : HTTPS (TLS required)
LOAD_BALANCER --> APP : HTTPS API (TLS required in prod)

APP --> DIRECTIVES : SQL / TLS
APP --> COMPILED : CAS / TLS
APP --> EVENTS : Append-Only / TLS
APP --> ARTIFACTS : Object Write / TLS
APP --> TARGETS : optional HTTPS (timeouts + circuit breaker)

APP ..> PROM
APP ..> ELK
APP ..> JAEGER

legend bottom
  |= C4 ID |= Deploy role |
  | clients | External driving adapters (not part of Selma deployment) |
  | application | Process: api, *_application, *_repository, *_gateway |
  | directives_store · compiled_rules_store · finding_events_store · artifacts_store | Data zone stores |
  | target_sources | Optional external pull only |
  | CI/CD · audit export · remediation · certification_tool | Not required deploy peers |
  | Transport | TLS on all production hops; mTLS recommended for zero-trust data zone |
endlegend

@enduml
