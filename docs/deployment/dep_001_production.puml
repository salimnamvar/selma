' ============================================================
' Title:     Selma -- Production Deployment Diagram
' Purpose:   Deploy topology aligned with C4 1.1.0 resource model
' Contract:  1.1.0
' ============================================================
@startuml dep_001_production
title **DEP-001 — Production Deployment**\nSelma · Resource-oriented stores · Clean Architecture process\n

!theme plain
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor #FAFBFC

package "Public Zone" as PUBLIC_ZONE #E3F2FD/BBDEFB {
    node "Load Balancer\n(Nginx / Traefik)" as LOAD_BALANCER
    node "Clients\n(CLI / Web / Desktop / Mobile)" as CLIENTS <<docker or native>>
}

package "Application Zone" as APP_ZONE #E8F5E9/C8E6C9 {
    node "Application container\n(Python 3.11+ / Docker)" as APP <<docker container>> {
        rectangle "api\n(resource gate)" as API
        rectangle "compilation\n(hermetic)" as COMPILATION
        rectangle "inspection" as INSPECTION
        rectangle "findings" as FINDINGS
        rectangle "repositories\n+ optional target_sources_gateway" as REPOS
    }
}

package "Data Zone" as DATA_ZONE #FFF3E0/FFE0B2 {
    database "directives\n(PostgreSQL)" as DIRECTIVES
    node "compiled_rules\n(CAS FS or S3)" as COMPILED
    database "finding_events\n(Append-Only)" as EVENTS
    node "artifacts\n(Object Store)" as ARTIFACTS
}

package "External Zone (optional)" as EXT_ZONE #FCE4EC/F8BBD0 {
    cloud "target_sources\n(optional pull)" as TARGETS
}

package "Monitoring" as MON #E8EAF6/C5CAE9 {
    node "Prometheus / Grafana" as PROM
    node "ELK / Loki" as ELK
    node "Jaeger" as JAEGER
}

LOAD_BALANCER --> CLIENTS : HTTPS
LOAD_BALANCER --> APP : HTTPS API
CLIENTS --> API : REST / HTTPS

API --> COMPILATION
API --> INSPECTION
API --> FINDINGS
API --> REPOS
COMPILATION --> REPOS
INSPECTION --> REPOS
FINDINGS --> REPOS

REPOS --> DIRECTIVES : SQL
REPOS --> COMPILED : CAS
REPOS --> EVENTS : Append-Only
REPOS --> ARTIFACTS : Object Write
REPOS --> TARGETS : optional HTTPS

APP ..> PROM
APP ..> ELK
APP ..> JAEGER

legend bottom
  |= C4 ID |= Deploy role |
  | clients | Public driving adapters |
  | application / api / compilation / inspection / findings | Application process |
  | directives · compiled_rules · finding_events · artifacts | Data zone stores |
  | target_sources | Optional external pull only |
  | CI/CD · audit export · remediation | Not required deploy peers |
endlegend

@enduml
