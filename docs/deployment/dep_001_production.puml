' ============================================================
' Title:     Selma -- Production Deployment Diagram
' Purpose:   WHERE Selma runs: network zones, process nodes,
'            store failure domains, TLS hops, monitoring.
'            Uses C4 container/store IDs only. Does NOT redraw
'            component graph or package modules (see c4-model,
'            package).
' Contract:  1.1.0
' ============================================================
@startuml dep_001_production
title **DEP-001 — Production Deployment**\nZones · nodes · store failure domains · TLS\n

!theme plain
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor #FAFBFC
skinparam packageStyle rectangle
skinparam package {
  FontSize 11
  FontStyle bold
}
skinparam node {
  BackgroundColor #FAFBFC
  BorderColor #78909C
  FontSize 11
}
skinparam database {
  BackgroundColor #FFF8E1
  BorderColor #F57C00
}

' ── External User Zone (C4: clients — outside Selma deployables) ──
package "External User Zone" as USER_ZONE #F3E5F5/E1BEE7 {
  node "clients\nCLI / Web / Desktop / Mobile" as CLIENTS
}

' ── Public Zone ──
package "Public Zone" as PUBLIC_ZONE #E3F2FD/BBDEFB {
  node "Load Balancer HA\nmanaged multi-AZ or active/standby" as LOAD_BALANCER
}

' ── Application Zone (C4: application — one process; internals = C4 component) ──
package "Application Zone" as APP_ZONE #E8F5E9/C8E6C9 {
  node "application\nPython 3.11+ / Docker\nC4: application container\n(api · *_application ·\n*_repository · *_gateway\nin-process v1)" as APP
}

' ── Data Zone (C4: four *_store · production failure domains) ──
package "Data Zone" as DATA_ZONE #FFF3E0/FFE0B2 {
  node "PostgreSQL cluster A\nfailure domain A" as PG_A {
    database "directives_store" as DIRECTIVES
  }
  node "PostgreSQL cluster B\nfailure domain B" as PG_B {
    database "finding_events_store" as EVENTS
  }
  node "S3-compatible object store" as OBJ_STORE {
    database "compiled_rules_store\n(CAS)" as COMPILED
    database "artifacts_store\n(write-once)" as ARTIFACTS
  }
}

' ── External optional (C4: target_sources) ──
package "External Zone (optional)" as EXT_ZONE #FCE4EC/F8BBD0 {
  cloud "target_sources" as TARGETS
}

' ── Monitoring ──
package "Monitoring Zone" as MON #E8EAF6/C5CAE9 {
  node "Prometheus / Grafana" as PROM
  node "ELK / Loki" as ELK
  node "Jaeger" as JAEGER
}

' ── Topology edges only (not component use-case graph) ──
CLIENTS --> LOAD_BALANCER : HTTPS
LOAD_BALANCER --> APP : HTTPS / REST

APP --> DIRECTIVES : SQL / TLS
APP --> EVENTS : Append-Only / TLS
APP --> COMPILED : CAS / TLS
APP --> ARTIFACTS : Object Write / TLS
APP --> TARGETS : HTTPS optional

APP ..> PROM
APP ..> ELK
APP ..> JAEGER

footer DEP-001 · Contract 1.1.0 · topology only · C4 IDs · Selma

@enduml
