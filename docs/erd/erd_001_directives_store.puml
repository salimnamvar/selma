@startuml erd_001_directives_store
' ============================================================
' Title:     ERD-001 Directives Store
' Source:    docs/spec/contracts/data_stores/directives_store.yaml
' C4:        directives_store ← directives_repository
' Contract:  1.1.0
' ============================================================
!include common/erd_styles.puml

title Directives Store (PostgreSQL) — C4 store: directives_store · Mutable, Versioned

package "Directives" {
  entity "Directives" as Directives {
    * lineage_id : UUID <<PK, immutable>>
    --
    execution_id : UUID
    status : ENUM(active, deprecated, draft, superseded)
    revision : INTEGER
    head_snapshot_hash : CHAR(64) <<nullable, SHA-256>>
    metadata : JSONB
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
  }

  entity "DirectiveRevisions" as DirectiveRevisions {
    * revision_id : UUID <<PK>>
    --
    o lineage_id : UUID <<FK>>
    execution_id : UUID
    revision_number : INTEGER
    executable_document : JSONB
    policy_doctrine_document : JSONB
    paired_policy_ref : TEXT
    created_by : TEXT
    created_at : TIMESTAMPTZ
  }

  entity "LineageOperations" as LineageOperations {
    * operation_id : UUID <<PK>>
    --
    o lineage_id : UUID <<FK>>
    operation_type : ENUM(fork, merge, split)
    source_ids : JSONB
    target_ids : JSONB
    created_at : TIMESTAMPTZ
  }

  entity "CompileRequests" as CompileRequests {
    * request_id : UUID <<PK>>
    --
    o lineage_id : UUID <<FK>>
    revision_number : INTEGER
    status : ENUM(pending, in_progress, completed, failed, permanently_failed)
    idempotency_key : TEXT <<nullable>>
    enqueued_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ <<nullable>>
    last_error : TEXT <<nullable>>
  }
}

Directives ||--o{ DirectiveRevisions : "lineage_id"
Directives ||--o{ LineageOperations : "lineage_id"
Directives ||--o{ CompileRequests : "lineage_id"

note bottom of Directives
  **Locking Model**
  • read_lock  → concurrent reads (FOR SHARE / RR)
  • write_lock → exclusive writes, FIFO queue
  • Release read locks before hermetic CPU compile
  • Optimistic concurrency: ETag W/"{lineage}:{rev}"
  **head_snapshot_hash**
  • Latest published cg_ir_snapshot_hash for lineage
  • Set atomically when outbox → completed
  • null until first successful compile
end note

note bottom of DirectiveRevisions
  **Invariants**
  • lineage_id is immutable once set
  • Every modification creates a new revision
  • revision_number is monotonically increasing
  • Dual document: executable_document (rule_schema)
    + policy_doctrine_document (policy_doctrine)
  • paired_policy_ref links guidance to this revision
  • Compiler reads executable only; guidance reads doctrine only
end note

note bottom of CompileRequests
  **Transactional outbox**
  • Inserted in same TX as directive mutation
  • Unique (lineage_id, revision_number)
  • Drained by compilation_application
  • Temporary CG-IR lag is allowed
end note

note bottom of LineageOperations
  **Invariants**
  • source_ids / target_ids are JSON arrays
  • operation_type ∈ {fork, merge, split}
end note

@enduml
