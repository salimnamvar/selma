@startuml erd_001_directives_store
' ============================================================
' Title:     ERD-001 Directives Store
' Source:    docs/spec/contracts/data_stores/directives_store.yaml (physical_model)
'            docs/schema/rule_schema.json · docs/schema/policy_doctrine.yaml
'            docs/spec/contracts/directive/lifecycle.yaml
' C4:        directives_store ← directives_repository
' Package:   directives_infrastructure (C4: directives_repository)
' Contract:  docs/standards/VERSION
' Cardinality: every FK edge is Parent ||--o{ Child (1:M only)
' ============================================================

!include common/erd_styles.puml
!include common/erd_identities.puml

title $TITLE_DIRECTIVES

package "$PKG_DIRECTIVES_STORE" as PKG_DIR $ERD_PKG_STORE {

  entity "$TABLE_DIRECTIVES" as Directives <<mutable>> <<system_of_record>> {
    * **lineage_id** : UUID <<PK, immutable>>
    --
    execution_id : UUID <<indexed>>
    status : $ENUM_DIRECTIVE_STATUS
    revision : INTEGER <<head revision>>
    head_snapshot_hash : CHAR(64) <<nullable, SHA-256>>
    authored_by : TEXT
    superseded_by_execution_id : TEXT <<nullable>>
    retire_reason : TEXT <<nullable>>
    restore_from_revision : INTEGER <<nullable>>
    metadata : JSONB
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
    --
    <<trigger>> onCreateAssignLineage()
    <<trigger>> onReviseBumpRevision()
    <<trigger>> onPublishEnqueueOutbox()
    <<trigger>> onCompileCompletedAdvanceHead()
    <<guard>> statusAllowsForkMergeSplit()
    <<guard>> supersededByPresentWhenSuperseded()
    <<guard>> headSnapshotOnlyAdvancesOnCompleted()
    <<integrity>> lineageIdImmutable()
  }

  entity "$TABLE_DIRECTIVE_REVISIONS" as DirectiveRevisions <<append_only>> {
    * **revision_id** : UUID <<PK>>
    --
    o **lineage_id** : UUID <<FK → Directives>>
    execution_id : UUID
    * revision_number : INTEGER <<unique with lineage_id>>
    executable_document : JSONB <<rule_schema.json>>
    policy_doctrine_document : JSONB <<policy_doctrine.yaml>>
    * paired_policy_ref : TEXT <<unique, indexed>>
    change_trigger : TEXT <<create|modify|publish|restore|spawn>>
    created_by : TEXT
    created_at : TIMESTAMPTZ
    --
    <<trigger>> onInsertDualDocuments()
    <<guard>> bothDocumentsPresent()
    <<guard>> pairedPolicyRefResolvesInLineage()
    <<integrity>> revisionNumberMonotonicPerLineage()
  }

  entity "$TABLE_LINEAGE_OPERATIONS" as LineageOperations <<append_only>> {
    * **operation_id** : UUID <<PK>>
    --
    o **lineage_id** : UUID <<FK → Directives>>
    operation_type : $ENUM_LINEAGE_OPERATION
    source_ids : JSONB <<UUID array>>
    target_ids : JSONB <<UUID array>>
    parent_status_after : $ENUM_DIRECTIVE_STATUS
    created_by : TEXT
    created_at : TIMESTAMPTZ
    --
    <<trigger>> onForkMergeSplitRecord()
    <<guard>> parentWasActiveBeforeSpawn()
    <<integrity>> sourceAndTargetArraysNonEmpty()
  }

  entity "$TABLE_COMPILE_REQUESTS" as CompileRequests <<outbox>> <<mutable>> {
    * **request_id** : UUID <<PK>>
    --
    o **lineage_id** : UUID <<FK → Directives>>
    * revision_number : INTEGER <<unique with lineage_id>>
    status : $ENUM_COMPILE_REQUEST_STATUS
    trigger_source : TEXT <<mutation|api_compile|admin_retry>>
    idempotency_key : TEXT <<nullable>>
    worker_id : TEXT <<nullable, lease holder>>
    lease_expires_at : TIMESTAMPTZ <<nullable>>
    retry_count : INTEGER <<default 0>>
    failure_class : TEXT <<nullable, schema|retriable|lock_deferred>>
    last_error : TEXT <<nullable>>
    published_snapshot_hash : CHAR(64) <<nullable, SHA-256>>
    enqueued_at : TIMESTAMPTZ
    claimed_at : TIMESTAMPTZ <<nullable>>
    completed_at : TIMESTAMPTZ <<nullable>>
    --
    <<trigger>> onEnqueuePending()
    <<trigger>> onClaimLease()
    <<trigger>> onHeartbeatRefreshLease()
    <<trigger>> onCompletePublishSnapshot()
    <<trigger>> onFailOrPermanentlyFail()
    <<guard>> leaseHolderMayTransition()
    <<guard>> naturalKeyUniqueLineageRevision()
    <<integrity>> statusMachineLegalTransitions()
  }

  entity "$TABLE_PAIRED_POLICY_REF_COUNTS" as PairedPolicyRefCounts <<secondary_index>> {
    * **paired_policy_ref** : TEXT <<PK>>
    --
    refcount : INTEGER <<non-negative>>
    updated_at : TIMESTAMPTZ
    --
    <<trigger>> onFindingCreatedIncrement()
    <<guard>> refcountNonNegative()
    <<integrity>> hardDeleteForbiddenWhenRefcountPositive()
  }

  enum "$ENUM_DIRECTIVE_STATUS" as DirectiveStatus {
    draft
    active
    deprecated
    superseded
  }

  enum "$ENUM_LINEAGE_OPERATION" as LineageOperationType {
    fork
    merge
    split
  }

  enum "$ENUM_COMPILE_REQUEST_STATUS" as CompileRequestStatus {
    pending
    in_progress
    completed
    failed
    permanently_failed
  }
}

' ── Structural relationships: Parent ||--o{ Child (1:M only) ──
Directives ||--o{ DirectiveRevisions : "1:M lineage_id"
Directives ||--o{ LineageOperations : "1:M lineage_id"
Directives ||--o{ CompileRequests : "1:M lineage_id"
DirectiveRevisions ||--o{ PairedPolicyRefCounts : "1:M paired_policy_ref\n(UNIQUE child ⇒ at most one)"

' Attribute domains (not table FKs)
Directives }o..|| DirectiveStatus
CompileRequests }o..|| CompileRequestStatus
LineageOperations }o..|| LineageOperationType

legend bottom
  |= Rule |= Application |
  | Cardinality | **Only** Parent \|\|--o{ Child (1:M). No M:N edges. |
  | Optional one | 1:M + UNIQUE on child FK (PairedPolicyRefCounts) |
  | Methods | <<trigger>> row effects · <<guard>> column predicates · <<integrity>> invariants |
  | FSM graphs | State view + contracts — not drawn as transition edges here |
  | $LEGEND_ERD |
endlegend

footer ERD-001 · directives_store · docs/standards/VERSION · Selma

@enduml
