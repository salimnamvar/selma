@startuml erd_002_compiled_rules_store
' ============================================================
' Title:     ERD-002 Compiled Rules Store
' Source:    docs/spec/contracts/data_stores/compiled_rules_store.yaml
'            docs/spec/contracts/compilation/pipeline.yaml
' C4:        compiled_rules_store ← compiled_rules_repository
'            (compilation_application publish path)
' Package:   compiled_rules_infrastructure (C4: compiled_rules_repository)
' Contract:  1.3.0
'
' State machines supported by durable facts (not drawn here):
'   003 Compilation · 010 Hash composition · 005 Conflict (frozen body) · 008 Artifact
' ============================================================

!include common/erd_styles.puml
!include common/erd_identities.puml

title $TITLE_COMPILED_RULES

package "$PKG_COMPILED_RULES_STORE" as PKG_CR $ERD_PKG_CAS {

  entity "$TABLE_SNAPSHOTS" as Snapshots <<immutable>> <<content_addressed>> <<system_of_record>> {
    * **cg_ir_snapshot_hash** : CHAR(64) <<PK, SHA-256>>
    --
    frozen_env_hash : CHAR(64) <<SHA-256>>
    engine_version : TEXT
    directive_graph_version : TEXT
    compiled_at : TIMESTAMPTZ <<excluded from hash>>
    provenance : JSONB
    conflicts_domain_version : TEXT <<nullable>>
    manifest_ref : TEXT
  }

  entity "$TABLE_NODES" as Nodes <<immutable>> <<content_addressed>> {
    * **node_hash** : CHAR(64) <<PK, SHA-256>>
    --
    node_id : TEXT <<logical control identity>>
    node_kind : $ENUM_NODE_KIND
    lineage_id : UUID <<indexed>>
    execution_id : TEXT <<indexed>>
    priority_level : INTEGER <<nullable, cascade input>>
    authored_at : TIMESTAMPTZ <<nullable, recency cascade>>
    node_body : JSONB
    semantic_hash : CHAR(64) <<SHA-256>>
    presentation_hash : CHAR(64) <<SHA-256>>
    creator_provenance : TEXT
    deprecated : BOOLEAN <<default false>>
  }

  entity "$TABLE_EDGES" as Edges <<immutable>> <<content_addressed>> {
    * **edge_hash** : CHAR(64) <<PK, SHA-256>>
    --
    source_id : TEXT
    target_id : TEXT
    edge_kind : $ENUM_EDGE_KIND
    o source_node_hash : CHAR(64) <<FK → Nodes, nullable>>
    o target_node_hash : CHAR(64) <<FK → Nodes, nullable>>
  }

  entity "$TABLE_SNAPSHOT_NODES" as SnapshotNodes <<immutable>> {
    * o **snapshot_hash** : CHAR(64) <<PK, FK → Snapshots>>
    * o **node_hash** : CHAR(64) <<PK, FK → Nodes>>
  }

  entity "$TABLE_SNAPSHOT_EDGES" as SnapshotEdges <<immutable>> {
    * o **snapshot_hash** : CHAR(64) <<PK, FK → Snapshots>>
    * o **edge_hash** : CHAR(64) <<PK, FK → Edges>>
  }

  entity "$TABLE_LINEAGE_HEADS" as LineageHeads <<secondary_index>> <<mutable>> {
    * **lineage_id** : UUID <<PK>>
    --
    o head_snapshot_hash : CHAR(64) <<FK → Snapshots, SHA-256>>
    head_revision : INTEGER <<revision-monotonic>>
    updated_at : TIMESTAMPTZ
  }

  enum "$ENUM_NODE_KIND" as NodeKind {
    control
    gateway
    join
  }

  enum "$ENUM_EDGE_KIND" as EdgeKind {
    depends_on
    sequence
    conflict
  }
}

Snapshots ||--o{ SnapshotNodes : "snapshot_hash"
Nodes ||--o{ SnapshotNodes : "node_hash"
Snapshots ||--o{ SnapshotEdges : "snapshot_hash"
Edges ||--o{ SnapshotEdges : "edge_hash"
Nodes ||--o{ Edges : "source_node_hash"
Nodes ||--o{ Edges : "target_node_hash"
LineageHeads }o--|| Snapshots : "head_snapshot_hash"
Nodes }o..|| NodeKind : "node_kind domain"
Edges }o..|| EdgeKind : "edge_kind domain"

legend bottom
  |= Stereotype |= Meaning |
  | <<immutable>> <<content_addressed>> | Blob identity = hash; never updated in place |
  | <<secondary_index>> | lineage_id → head_snapshot_hash (mirrors directives head) |
  | Guard facts | sameHashAndFrozenEnv · sameLineageId · priority/recency columns |
  | Trigger effects | publish snapshot · head advance · node deprecated flag |
  | $LEGEND_ERD |
endlegend

footer ERD-002 · compiled_rules_store · Contract 1.3.0 · Selma

@enduml
