@startuml erd_002_compiled_rules_store
' ============================================================
' Title:     ERD-002 Compiled Rules Store
' Source:    docs/spec/contracts/data_stores/compiled_rules_store.yaml (physical_model)
'            docs/schema/rule_schema.json (executable projection → node_body)
'            docs/spec/contracts/compilation/pipeline.yaml
' C4:        compiled_rules_store ← compiled_rules_repository
' Package:   compiled_rules_infrastructure (C4: compiled_rules_repository)
' Contract:  docs/standards/VERSION
' Cardinality: every FK edge is Parent ||--o{ Child (1:M only)
' Associative entities resolve conceptual M:N as two 1:M pairs
' ============================================================

!include common/erd_styles.puml
!include common/erd_identities.puml

title $TITLE_COMPILED_RULES

package "$PKG_COMPILED_RULES_STORE" as PKG_CR $ERD_PKG_CAS {

  entity "$TABLE_SNAPSHOTS" as Snapshots <<immutable>> <<content_addressed>> <<system_of_record>> {
    * **cg_ir_snapshot_hash** : CHAR(64) <<PK, SHA-256>>
    --
    frozen_env_hash : CHAR(64) <<SHA-256>>
    engine_version : TEXT
    directive_graph_version : TEXT
    compiled_at : TIMESTAMPTZ <<excluded from hash>>
    provenance : JSONB
    conflicts_domain_version : TEXT <<nullable>>
    manifest_ref : TEXT
    --
    <<trigger>> onPublishImmutable()
    <<guard>> compiledAtExcludedFromHash()
    <<guard>> identicalHashIsDedupNoOp()
    <<integrity>> recomputeSnapshotHashMatchesPk()
  }

  entity "$TABLE_NODES" as Nodes <<immutable>> <<content_addressed>> {
    * **node_hash** : CHAR(64) <<PK, SHA-256>>
    --
    node_id : TEXT <<logical control identity>>
    node_kind : $ENUM_NODE_KIND
    lineage_id : UUID <<indexed>>
    execution_id : TEXT <<indexed>>
    priority_level : INTEGER <<nullable, cascade input>>
    authored_at : TIMESTAMPTZ <<nullable, recency cascade>>
    node_body : JSONB
    semantic_hash : CHAR(64) <<SHA-256>>
    presentation_hash : CHAR(64) <<SHA-256>>
    creator_provenance : TEXT
    deprecated : BOOLEAN <<default false>>
    --
    <<trigger>> onStoreDedupByNodeHash()
    <<guard>> semanticHashExcludesNeighbors()
    <<integrity>> nodeHashEqualsDualHashCompose()
  }

  entity "$TABLE_EDGES" as Edges <<immutable>> <<content_addressed>> {
    * **edge_hash** : CHAR(64) <<PK, SHA-256>>
    --
    source_id : TEXT
    target_id : TEXT
    edge_kind : $ENUM_EDGE_KIND
    o source_node_hash : CHAR(64) <<FK → Nodes>>
    o target_node_hash : CHAR(64) <<FK → Nodes>>
    --
    <<trigger>> onStoreDedupByEdgeHash()
    <<guard>> edgeDirectionalDependsOn()
    <<integrity>> edgeHashEqualsSourceTargetPair()
  }

  ' Associative entity: conceptual Snapshot M:N Node → two 1:M only
  entity "$TABLE_SNAPSHOT_NODES" as SnapshotNodes <<immutable>> <<associative>> {
    * o **snapshot_hash** : CHAR(64) <<PK part, FK → Snapshots>>
    * o **node_hash** : CHAR(64) <<PK part, FK → Nodes>>
    --
    <<integrity>> compositePkMembership()
  }

  ' Associative entity: conceptual Snapshot M:N Edge → two 1:M only
  entity "$TABLE_SNAPSHOT_EDGES" as SnapshotEdges <<immutable>> <<associative>> {
    * o **snapshot_hash** : CHAR(64) <<PK part, FK → Snapshots>>
    * o **edge_hash** : CHAR(64) <<PK part, FK → Edges>>
    --
    <<integrity>> compositePkMembership()
  }

  entity "$TABLE_LINEAGE_HEADS" as LineageHeads <<secondary_index>> <<mutable>> {
    * **lineage_id** : UUID <<PK>>
    --
    o head_snapshot_hash : CHAR(64) <<FK → Snapshots, SHA-256>>
    head_revision : INTEGER <<revision-monotonic>>
    updated_at : TIMESTAMPTZ
    --
    <<trigger>> onOutboxCompletedAdvanceHead()
    <<guard>> headRevisionMonotonic()
    <<guard>> lateOlderCompileMustNotClobber()
    <<integrity>> headPointsToExistingSnapshot()
  }

  enum "$ENUM_NODE_KIND" as NodeKind {
    control
    gateway
    join
  }

  enum "$ENUM_EDGE_KIND" as EdgeKind {
    depends_on
    sequence
    conflict
  }
}

' ── 1:M only (Parent ||--o{ Child) ──
Snapshots ||--o{ SnapshotNodes : "1:M snapshot_hash"
Nodes ||--o{ SnapshotNodes : "1:M node_hash"
Snapshots ||--o{ SnapshotEdges : "1:M snapshot_hash"
Edges ||--o{ SnapshotEdges : "1:M edge_hash"
Nodes ||--o{ Edges : "1:M source_node_hash"
Nodes ||--o{ Edges : "1:M target_node_hash"
Snapshots ||--o{ LineageHeads : "1:M head_snapshot_hash"

Nodes }o..|| NodeKind
Edges }o..|| EdgeKind

legend bottom
  |= Rule |= Application |
  | No M:N edge | Snapshot↔Node / Snapshot↔Edge use **associative** tables (two 1:M) |
  | Graph edge | Nodes 1:M Edges twice (source role · target role) — still 1:M |
  | Head index | Snapshots 1:M LineageHeads (many lineages may pin same hash) |
  | Methods | <<trigger>> publish/dedup · <<guard>> hash rules · <<integrity>> CAS |
  | $LEGEND_ERD |
endlegend

footer ERD-002 · compiled_rules_store · docs/standards/VERSION · Selma

@enduml
