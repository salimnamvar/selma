@startuml erd_004_artifacts_store
' ============================================================
' Title:     ERD-004 Artifacts Store
' Source:    docs/spec/contracts/data_stores/artifacts_store.yaml (physical_model)
'            docs/spec/contracts/inspection/pipeline.yaml
'            docs/spec/contracts/conflict/detection.yaml
'            docs/spec/contracts/certification/gates.yaml
' C4:        artifacts_store ← artifacts_repository
' Package:   artifacts_infrastructure (C4: artifacts_repository)
' Contract:  docs/standards/VERSION
' Cardinality: every FK edge is Parent ||--o{ Child (1:M only)
' ============================================================

!include common/erd_styles.puml
!include common/erd_identities.puml

title $TITLE_ARTIFACTS

package "$PKG_ARTIFACTS_STORE" as PKG_ART $ERD_PKG_STORE {

  entity "$TABLE_INSPECTION_SNAPSHOTS" as InspectionSnapshots <<write_once>> <<system_of_record>> {
    * **inspection_id** : UUID <<PK>>
    --
    target_id : TEXT
    target_hash : CHAR(64) <<SHA-256>>
    cg_ir_snapshot_hash : CHAR(64) <<SHA-256>>
    frozen_env_hash : CHAR(64) <<SHA-256>>
    engine_version : TEXT
    inspector : TEXT
    started_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ
    status : $ENUM_INSPECTION_STATUS
    finding_count : INTEGER
    skipped_nodes : JSONB <<ordered node_id array>>
    evaluate_retry_count : INTEGER <<default 0>>
    system_state_hash : CHAR(64) <<SHA-256>>
    object_key : TEXT <<object store locator>>
    content_hash : CHAR(64) <<SHA-256, nullable>>
    --
    <<trigger>> onInspectionCompletedWriteOnce()
    <<guard>> skippedNodesImpliesPartial()
    <<guard>> evaluateRetryWithinMax()
    <<integrity>> systemStateHashFiveDimensions()
  }

  entity "$TABLE_PIPELINE_TRACES" as PipelineTraces <<write_once>> {
    * **trace_id** : UUID <<PK>>
    --
    o **inspection_id** : UUID <<FK → InspectionSnapshots>>
    sequence_index : INTEGER <<chronological order>>
    stage : $ENUM_PIPELINE_STAGE
    node_id : TEXT <<nullable, evaluate stage>>
    started_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ
    status : $ENUM_TRACE_STATUS
    trigger_name : TEXT <<nullable, stage pass|fault|retry>>
    error : TEXT <<nullable>>
    duration_ms : INTEGER
    --
    <<trigger>> onStageCompleteAppendTrace()
    <<guard>> sequenceIndexChronological()
    <<integrity>> durationMatchesTimestamps()
  }

  entity "$TABLE_CONFLICT_ARTIFACTS" as ConflictArtifacts <<append_only>> {
    * **artifact_id** : UUID <<PK part>>
    * **version** : INTEGER <<PK part, append-only>>
    --
    conflict_type : $ENUM_CONFLICT_TYPE
    binding_status : $ENUM_BINDING_STATUS
    lineage_id_a : UUID
    lineage_id_b : UUID
    rule_a_id : TEXT <<execution_id>>
    rule_b_id : TEXT <<execution_id>>
    cg_ir_snapshot_hash : CHAR(64) <<frozen snapshot, SHA-256>>
    resolution_type : TEXT <<override|priority|specificity|recency|artifact>>
    resolution_trace : JSONB
    requires_human_action : BOOLEAN
    decision_actor : TEXT <<nullable>>
    created_at : TIMESTAMPTZ
    created_by : TEXT
    object_key : TEXT <<nullable>>
    --
    <<trigger>> onConflictOpenedNewVersion()
    <<trigger>> onHumanResolveAppendVersion()
    <<trigger>> onArchiveAppendVersion()
    <<guard>> sameLineageIdForBinding()
    <<guard>> differentLineageIdForAdvisory()
    <<guard>> decisionOnFrozenSnapshotOnly()
    <<integrity>> versionMonotonicPerArtifact()
  }

  entity "$TABLE_EVIDENCE_ARTIFACTS" as EvidenceArtifacts <<write_once>> {
    * **evidence_id** : UUID <<PK>>
    --
    finding_id : UUID <<indexed>>
    content_hash : CHAR(64) <<SHA-256>>
    object_key : TEXT
    media_type : TEXT <<nullable>>
    submitted_by : TEXT <<evidence submitter>>
    created_by : TEXT
    created_at : TIMESTAMPTZ
    --
    <<trigger>> onEvidenceSubmitWriteOnce()
    <<guard>> submittedByRecordedForSoD()
    <<integrity>> contentHashImmutable()
  }

  entity "$TABLE_CERTIFICATION_RUNS" as CertificationRuns <<mutable>> {
    * **run_id** : UUID <<PK>>
    --
    status : $ENUM_CERTIFICATION_RUN_STATUS
    trigger_source : TEXT <<ci|manual|retrigger>>
    started_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ <<nullable>>
    overall_pass : BOOLEAN <<nullable>>
    --
    <<trigger>> onCertificationTriggered()
    <<trigger>> onGatesCompleteSealRun()
    <<guard>> allGatesPresentBeforeCertified()
    <<integrity>> runStatusLegalTransitions()
  }

  entity "$TABLE_CERTIFICATION_ARTIFACTS" as CertificationArtifacts <<write_once>> {
    * **cert_id** : UUID <<PK>>
    --
    o **run_id** : UUID <<FK → CertificationRuns>>
    gate_id : TEXT <<AA-01 .. AA-09>>
    pass_fail : BOOLEAN
    evidence_ref : TEXT
    checked_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
    object_key : TEXT <<nullable>>
    --
    <<trigger>> onGateResultWriteOnce()
    <<guard>> gateIdInAa01ToAa09()
    <<integrity>> oneResultPerGatePerRun()
  }

  enum "$ENUM_INSPECTION_STATUS" as InspectionStatus {
    completed
    partial
    failed
  }

  enum "$ENUM_PIPELINE_STAGE" as PipelineStage {
    normalize
    classify
    select_controls
    evaluate
    aggregate
    report
  }

  enum "$ENUM_TRACE_STATUS" as TraceStatus {
    success
    skipped
    failed
  }

  enum "$ENUM_CONFLICT_TYPE" as ConflictType {
    within_lineage
    cross_lineage
  }

  enum "$ENUM_BINDING_STATUS" as BindingStatus {
    pending
    resolved
    rejected
    archived
    advisory
  }

  enum "$ENUM_CERTIFICATION_RUN_STATUS" as CertificationRunStatus {
    triggered
    collecting_evidence
    validating_gates
    passed
    failed
    remediation_required
    certified
    archived
  }
}

' ── 1:M only ──
InspectionSnapshots ||--o{ PipelineTraces : "1:M inspection_id"
CertificationRuns ||--o{ CertificationArtifacts : "1:M run_id"

' Standalone parents (no parent table in this store): ConflictArtifacts, EvidenceArtifacts
' Evidence is keyed by finding_id (cross-store pointer, not FK edge)

InspectionSnapshots }o..|| InspectionStatus
PipelineTraces }o..|| PipelineStage
PipelineTraces }o..|| TraceStatus
ConflictArtifacts }o..|| ConflictType
ConflictArtifacts }o..|| BindingStatus
CertificationRuns }o..|| CertificationRunStatus

legend bottom
  |= Rule |= Application |
  | 1:M only | Inspection → Traces · Run → Gate artifacts |
  | Standalone | Conflict / Evidence have no in-store parent (cross-store IDs only) |
  | Versioning | Conflict 1:M is **versions of same artifact_id** (composite PK) |
  | Methods | <<trigger>> write-once/append · <<guard>> lineage/skip/retry · <<integrity>> hash |
  | $LEGEND_ERD |
endlegend

footer ERD-004 · artifacts_store · docs/standards/VERSION · Selma

@enduml
