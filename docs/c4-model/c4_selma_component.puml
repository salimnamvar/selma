' ============================================================
' Title:     Selma -- Component Diagram
' Boundary:  Application
' Purpose:   Clean Architecture inside Application:
'            API (driving) → use-case clusters → repositories
'            (driven). Domain services (e.g. ResolveConflict)
'            are not peer components.
' Contract:  1.1.0
' ============================================================
@startuml c4_selma_component
title Selma -- Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!theme plain
!include ./common/c4_styles.puml
!include ./common/c4_identities.puml

LAYOUT_LEFT_RIGHT()

System_Ext(target_sources, $NAME_target_sources, $DESC_target_sources)

Container_Ext(clients, $NAME_clients, $TECH_clients, $DESC_clients)

ContainerDb_Ext(directives, $NAME_directives, $TECH_directives, $DESC_directives, $tags="store")
ContainerDb_Ext(compiled_rules, $NAME_compiled_rules, $TECH_compiled_rules, $DESC_compiled_rules, $tags="store")
ContainerDb_Ext(finding_events, $NAME_finding_events, $TECH_finding_events, $DESC_finding_events, $tags="store")
ContainerDb_Ext(artifacts, $NAME_artifacts, $TECH_artifacts, $DESC_artifacts, $tags="store")

Container_Boundary(application, $NAME_application) {

    Component(api, $NAME_api, $TECH_api, $DESC_api, $tags="gate")

    Component(compilation, $NAME_compilation, $TECH_compilation, $DESC_compilation, $tags="hermetic")
    Component(inspection, $NAME_inspection, $TECH_inspection, $DESC_inspection)
    Component(findings, $NAME_findings, $TECH_findings, $DESC_findings)

    Component(directives_repository, $NAME_directives_repository, $TECH_directives_repository, $DESC_directives_repository)
    Component(compiled_rules_repository, $NAME_compiled_rules_repository, $TECH_compiled_rules_repository, $DESC_compiled_rules_repository)
    Component(finding_events_repository, $NAME_finding_events_repository, $TECH_finding_events_repository, $DESC_finding_events_repository)
    Component(artifacts_repository, $NAME_artifacts_repository, $TECH_artifacts_repository, $DESC_artifacts_repository)
    Component(target_sources_gateway, $NAME_target_sources_gateway, $TECH_target_sources_gateway, $DESC_target_sources_gateway)

}

' Driving: clients → api
Rel(clients, api, "resource-oriented API calls", "REST / HTTPS", $tags="capability_enforced")

' API → use-case clusters
Rel(api, directives_repository, "directive resource CRUD and lifecycle", "Internal", $tags="capability_enforced")
Rel(api, compilation, "triggers compile on directive change", "Internal")
Rel(api, inspection, "creates inspections with target body or reference", "Internal", $tags="capability_enforced")
Rel(api, findings, "finding transitions, evidence, guidance reads", "Internal", $tags="capability_enforced")
Rel(api, finding_events_repository, "appends capability denial events", "Append-Only", $tags="immutable")

' Compilation
Rel(compilation, directives_repository, "reads executable documents under read-lock", "Internal", $tags="compile_only")
Rel(compilation, compiled_rules_repository, "publishes compiled rule snapshots", "Internal", $tags="compile_only")

' Inspection
Rel(inspection, target_sources_gateway, "fetches remote targets when referenced", "Internal", $tags="mediated")
Rel(inspection, compiled_rules_repository, "loads frozen compiled rules", "Internal", $tags="validation_only")
Rel(inspection, findings, "opens findings after evaluation", "Internal", $tags="immutable")
Rel(inspection, artifacts_repository, "writes inspection snapshots and traces", "Internal", $tags="immutable")

' Findings
Rel(findings, finding_events_repository, "appends lifecycle and SoD events", "Internal", $tags="immutable")
Rel(findings, compiled_rules_repository, "reads creator provenance for SoD", "Internal", $tags="validation_only")
Rel(findings, directives_repository, "reads policy doctrine for guidance", "Internal", $tags="guidance_only")
Rel(findings, artifacts_repository, "reads and writes conflict and evidence artifacts", "Internal", $tags="immutable")

' Optional external
Rel(target_sources_gateway, target_sources, "fetches targets by reference", "HTTPS / API", $tags="mediated")

' Repositories → stores
Rel(directives_repository, directives, "persists dual-document directives", "SQL", $tags="capability_enforced")
Rel(compiled_rules_repository, compiled_rules, "publishes and loads snapshots", "CAS", $tags="immutable")
Rel(finding_events_repository, finding_events, "appends events", "Append-Only", $tags="immutable")
Rel(artifacts_repository, artifacts, "write-once artifacts", "Object Write", $tags="immutable")

SHOW_LEGEND()
@enduml
