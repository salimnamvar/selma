' ============================================================
' Title:     Selma -- Component Diagram
' Source:    docs/standards/c4_registry.yaml (peers.components, peers.stores)
' C4:        clients → api → *_application → *_repository | *_gateway → *_store
'            narrow: api → finding_events_repository (DenialAuditPort path)
' Purpose:   Product peers and dependencies only. Modules → package/.
'            Topology → deployment/. FSMs → state/. Domain services not peers.
' Contract:  1.3.0
' ============================================================
@startuml c4_selma_component
title Selma -- Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml
!theme plain
!include ./common/c4_styles.puml
!include ./common/c4_identities.puml

LAYOUT_LEFT_RIGHT()

System_Ext(target_sources, $NAME_target_sources, $DESC_target_sources)
Container_Ext(clients, $NAME_clients, $TECH_clients, $DESC_clients)

System_Boundary(selma, $NAME_selma) {

    Container_Boundary(application, $NAME_application) {

        ' ── Driving adapter (interface) ──
        Component(api, $NAME_api, $TECH_api, $DESC_api, $tags="gate")

        ' ── Application use-case clusters (*_application) ──
        Component(directives_application, $NAME_directives_application, $TECH_directives_application, $DESC_directives_application)
        Component(compilation_application, $NAME_compilation_application, $TECH_compilation_application, $DESC_compilation_application, $tags="hermetic")
        Component(inspections_application, $NAME_inspections_application, $TECH_inspections_application, $DESC_inspections_application)
        Component(findings_application, $NAME_findings_application, $TECH_findings_application, $DESC_findings_application)

        ' ── Driven adapters (infrastructure) ──
        Component(directives_repository, $NAME_directives_repository, $TECH_directives_repository, $DESC_directives_repository)
        Component(compiled_rules_repository, $NAME_compiled_rules_repository, $TECH_compiled_rules_repository, $DESC_compiled_rules_repository)
        Component(finding_events_repository, $NAME_finding_events_repository, $TECH_finding_events_repository, $DESC_finding_events_repository)
        Component(artifacts_repository, $NAME_artifacts_repository, $TECH_artifacts_repository, $DESC_artifacts_repository)
        Component(target_sources_gateway, $NAME_target_sources_gateway, $TECH_target_sources_gateway, $DESC_target_sources_gateway)

    }

    ' ── Stores (frameworks & drivers; outside Application process) ──
    ContainerDb(directives_store, $NAME_directives_store, $TECH_directives_store, $DESC_directives_store, $tags="store")
    ContainerDb(compiled_rules_store, $NAME_compiled_rules_store, $TECH_compiled_rules_store, $DESC_compiled_rules_store, $tags="store")
    ContainerDb(finding_events_store, $NAME_finding_events_store, $TECH_finding_events_store, $DESC_finding_events_store, $tags="store")
    ContainerDb(artifacts_store, $NAME_artifacts_store, $TECH_artifacts_store, $DESC_artifacts_store, $tags="store")

}

' ── Driving: clients → api ──
Rel(clients, api, "resource-oriented API calls", "REST / HTTPS", $tags="capability_enforced")

' ── api → application use-case clusters only ──
Rel(api, directives_application, "directive resource CRUD and lifecycle", "Internal", $tags="capability_enforced")
Rel(api, compilation_application, "triggers compile on directive change", "Internal", $tags="capability_enforced")
Rel(api, inspections_application, "creates inspections with target body or reference", "Internal", $tags="capability_enforced")
Rel(api, findings_application, "finding transitions, evidence, guidance reads", "Internal", $tags="capability_enforced")
' Port-typed exception: api depends on DenialAuditPort only (not full FindingEventRepository).
' Implementer is DenialAuditAdapter in findings_infrastructure; rendered target is the
' repository peer for C4 layout. Composition root MUST inject DenialAuditPort surface only.
Rel(api, finding_events_repository, "DenialAuditPort only (AppendDenial; ISP — not full event repo)", "Append-Only", $tags="immutable")

' ── Directives Application ──
' Compile coupling is store-mediated (compile_request outbox in directives_store).
' No direct directives_application → compilation_application edge (audit hardening).
Rel(directives_application, directives_repository, "reads and writes dual-document directives; enqueues compile_request outbox", "Internal")

' ── Compilation Application (hermetic) ──
Rel(compilation_application, directives_repository, "CompilerReadPort: read executables; drain compile_request outbox under short read-lock", "Internal", $tags="compile_only")
Rel(compilation_application, compiled_rules_repository, "publishes compiled rule snapshots", "Internal", $tags="compile_only")

' ── Inspections Application ──
Rel(inspections_application, target_sources_gateway, "fetches remote targets when referenced", "Internal", $tags="mediated")
Rel(inspections_application, compiled_rules_repository, "loads frozen compiled rules", "Internal", $tags="validation_only")
Rel(inspections_application, findings_application, "FindingOpenPort: open findings after evaluation", "Internal")
Rel(inspections_application, artifacts_repository, "writes inspection snapshots and traces", "Internal", $tags="immutable")

' ── Findings Application ──
Rel(findings_application, finding_events_repository, "appends lifecycle and SoD events", "Internal", $tags="immutable")
Rel(findings_application, finding_events_repository, "loads event stream for state hydration", "Internal", $tags="validation_only")
Rel(findings_application, compiled_rules_repository, "reads creator provenance for SoD", "Internal", $tags="validation_only")
Rel(findings_application, directives_repository, "GuidanceReadPort: doctrine by paired_policy_ref revision", "Internal", $tags="guidance_only")
Rel(findings_application, artifacts_repository, "reads and writes conflict and evidence artifacts", "Internal")

' ── Optional external (gateway → system) ──
Rel(target_sources_gateway, target_sources, "fetches targets by reference", "HTTPS / API", $tags="mediated")

' ── Repositories → stores (frameworks & drivers) ──
Rel(directives_repository, directives_store, "persists dual-document directives", "SQL")
Rel(compiled_rules_repository, compiled_rules_store, "publishes and loads snapshots", "CAS", $tags="immutable")
Rel(finding_events_repository, finding_events_store, "appends events", "Append-Only", $tags="immutable")
Rel(artifacts_repository, artifacts_store, "write-once artifacts", "Object Write", $tags="immutable")

SHOW_LEGEND()
@enduml
