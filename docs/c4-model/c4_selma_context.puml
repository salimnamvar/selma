' ============================================================
' Title:     Selma -- Context Diagram
' Boundary:  Selma
' Purpose:   Black-box view of the two governance actors and the
'            five external systems Selma compiles against, certifies,
'            and streams findings and security audit records into.
' Contract:  1.0.0
' Diagram:   1.0.0 (Phase B AIP alignment)
' ============================================================
@startuml c4_selma_context
title Selma -- Context Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Context.puml
!theme plain
!include ./common/c4_styles.puml
!include ./common/c4_identities.puml

LAYOUT_LEFT_RIGHT()

' ============================================================
'  ACTORS
' ============================================================

Person(regulatory_official, $NAME_regulatory_official, $DESC_regulatory_official)
Person(compliance_rep, $NAME_compliance_rep, $DESC_compliance_rep)


' ============================================================
'  SYSTEM IN SCOPE
' ============================================================

System(selma, $NAME_selma, $DESC_selma)


' ============================================================
'  EXTERNAL SYSTEMS
' ============================================================

System_Ext(governance_contracts, $NAME_governance_contracts, $DESC_governance_contracts)
System_Ext(cicd, $NAME_cicd, $DESC_cicd)
System_Ext(regulated_systems, $NAME_regulated_systems, $DESC_regulated_systems)
System_Ext(audit_platform, $NAME_audit_platform, $DESC_audit_platform)
System_Ext(remediation_systems, $NAME_remediation_systems, $DESC_remediation_systems)


' ============================================================
'  RELATIONSHIPS -- Actor Ingress
' ============================================================

Rel(regulatory_official, selma, "authors and governs directives; resolves findings; views analytics", "HTTPS", $tags="capability_enforced")
Rel(compliance_rep, selma, "submits targets for inspection; acknowledges findings; views findings and analytics", "HTTPS", $tags="capability_enforced")


' ============================================================
'  RELATIONSHIPS -- External System Interactions
' ============================================================

Rel(selma, governance_contracts, "optional import/export of dual-document directive packages", "HTTPS / Package", $tags="mediated")
Rel(cicd, selma, "triggers architectural certification and runtime compliance checks", "CI/CD")
Rel(selma, regulated_systems, "inspects targets conforming to target schema", "HTTPS / API", $tags="mediated")
Rel(selma, audit_platform, "publishes finding events, security audit records, inspection snapshots, and certification artifacts for long-term retention", "Append-Only", $tags="immutable_async")
Rel(selma, remediation_systems, "emits finding events and status changes", "Mediated / Webhook", $tags="mediated_async")

SHOW_LEGEND()
@enduml
