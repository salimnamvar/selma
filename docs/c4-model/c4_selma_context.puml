' ============================================================
' Title:     Selma -- Context Diagram
' Boundary:  Selma
' Purpose:   Actors and optional external Target Sources.
'            Tier-C integrations (CI/CD, audit export, remediation)
'            are not first-class context peers.
' Contract:  1.0.0
' ============================================================
@startuml c4_selma_context
title Selma -- Context Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Context.puml
!theme plain
!include ./common/c4_styles.puml
!include ./common/c4_identities.puml

LAYOUT_LEFT_RIGHT()

Person(regulatory_official, $NAME_regulatory_official, $DESC_regulatory_official)
Person(compliance_representative, $NAME_compliance_representative, $DESC_compliance_representative)

System(selma, $NAME_selma, $DESC_selma)

System_Ext(target_sources, $NAME_target_sources, $DESC_target_sources)

Rel(regulatory_official, selma, "authors directives; resolves findings; reads guidance", "HTTPS", $tags="capability_enforced")
Rel(compliance_representative, selma, "submits targets and inspections; acknowledges findings; reads guidance", "HTTPS", $tags="capability_enforced")
Rel(selma, target_sources, "optionally fetches targets by reference", "HTTPS / API", $tags="mediated")

SHOW_LEGEND()
@enduml
