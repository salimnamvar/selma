' ============================================================
' Title:     Selma -- C4 Canonical Entity Identities
' Purpose:   Single source of truth for entity IDs, Names, Tech,
'            and Descriptions across Context, Container, and
'            Component diagrams. Include after c4_styles.puml.
'
' Naming (Clean Architecture + Resource-Oriented Design):
'   Every structural ID carries a layer postfix (or role token):
'
'   | Kind                         | ID pattern                    | Examples |
'   |------------------------------|-------------------------------|----------|
'   | Actor / system / external    | snake_case role               | selma, target_sources |
'   | Container (process)          | role token                    | clients, application |
'   | Store (frameworks & drivers) | {resource}_store              | directives_store |
'   | Use-case cluster (app)       | {resource|process}_application| findings_application |
'   | Driven store adapter         | {resource}_repository         | directives_repository |
'   | Driven external adapter      | {external}_gateway            | target_sources_gateway |
'   | Driving gate                 | api                           | api |
'
'   Application use-case clusters:
'     • directives_application   — directives resource
'     • compilation_application  — hermetic compile → compiled_rules_store
'     • inspections_application  — inspections resource
'     • findings_application     — findings resource (SoR: finding_events_store)
'
'   Stores:
'     • directives_store | compiled_rules_store
'     • finding_events_store | artifacts_store
'
' Clean Architecture dependency rule (Component level):
'   clients → api → *_application → *_repository/*_gateway → *_store / externals
'   Domain services (e.g. ResolveConflict) stay inside use cases;
'   they are not C4 peer components.
'
' Contract:  1.1.0 (docs/spec/contracts/)
' ============================================================

' ------------------------------------------------------------
' Actors
' Layers: Context, Container
' ------------------------------------------------------------
!$NAME_regulatory_official = "Regulatory Official"
!$DESC_regulatory_official = "Human or AI agent for the regulatory authority. Authors and governs dual-document directives, resolves conflicts and finding dispositions under capability and SoD rules, and reads findings and guidance."

!$NAME_compliance_representative = "Compliance Representative"
!$DESC_compliance_representative = "Human, AI agent, or service for the regulated entity. Submits targets (inline or by reference), acknowledges findings, submits evidence, and reads findings and guidance. Cannot author directives or waive findings."

' ------------------------------------------------------------
' System in scope
' ------------------------------------------------------------
!$NAME_selma = "Selma"
!$DESC_selma = "Domain-agnostic rule regularity platform. Authors dual-document directives, compiles executable rules to immutable CG-IR, inspects targets, manages finding lifecycle with audit trail, and resolves guidance from paired policy doctrines."

' ------------------------------------------------------------
' External systems (optional integrations only)
' NOTE: CI/CD, long-term audit export, and remediation ticketing
' are not first-class C4 peers; they are optional clients/exports.
' ------------------------------------------------------------
!$NAME_target_sources = "Target Sources"
!$DESC_target_sources = "Optional external systems that supply inspection targets when not submitted inline (repositories, ledgers, document stores, sensors). Mediated pull only; never mutated by Selma. Primary path remains target payload on the inspection resource."

' ------------------------------------------------------------
' Containers (deployable / process boundaries)
' NOTE: 'clients' represents the logical set of driving adapters.
' For deployment topology, Web UI is served via CDN/Public zone,
' while CLI/Desktop are local executables.
' Selma is an API-first platform.
' ------------------------------------------------------------
!$NAME_clients = "Clients"
!$TECH_clients = "CLI / Web / Desktop / Mobile"
!$DESC_clients = "Driving adapters (Clean Architecture outer ring). Authenticate users and map user intent to resource-oriented API calls against the Application. No domain rules live here."

!$NAME_application = "Application"
!$TECH_application = "REST API / Python / RE2 / JSON Schema / SHA-256"
!$DESC_application = "Application runtime containing the API gate, use-case clusters (*_application), domain execution, and infrastructure adapters (*_repository, *_gateway). Domain logic remains isolated inside domain packages. Dual-document directives in Directives Store; evaluation uses Compiled Rules Store only; guidance loads doctrines from Directives Store after findings exist."

' ------------------------------------------------------------
' Data stores (resource collections — ContainerDb)
' Always $tags="store"
' IDs: {resource}_store  (frameworks & drivers ring)
' ------------------------------------------------------------
!$NAME_directives_store = "Directives Store"
!$TECH_directives_store = "PostgreSQL"
!$DESC_directives_store = "Resource collection of dual-document directives (executable rule + policy doctrine), co-versioned per revision with lineage/execution identity, paired_policy_ref, and lifecycle. System of record for authoring and guidance prose."

!$NAME_compiled_rules_store = "Compiled Rules Store"
!$TECH_compiled_rules_store = "Content-Addressed Storage"
!$DESC_compiled_rules_store = "Resource collection of immutable CG-IR snapshots (compiled executable rules only), keyed by content hash. Evaluation source at inspection time; never rewritten."

!$NAME_finding_events_store = "Finding Events Store"
!$TECH_finding_events_store = "PostgreSQL (append-only table)"
!$DESC_finding_events_store = "Resource collection of append-only finding lifecycle events and capability denials. System of record for finding state, disposition history, and in-product audit trail."

!$NAME_artifacts_store = "Artifacts Store"
!$TECH_artifacts_store = "Object Store"
!$DESC_artifacts_store = "Resource collection of write-once evidence: inspection snapshots, execution traces, conflict artifacts, and certification reports. Large immutable blobs separate from the event log."

' ------------------------------------------------------------
' Components inside Application
'
' Driving (interface adapters):
'   api
'
' Application use-case clusters (*_application):
'   directives_application | compilation_application |
'   inspections_application | findings_application
'
' Driven (infrastructure adapters):
'   *_repository  — store ports
'   *_gateway     — optional external gateway
' ------------------------------------------------------------
!$NAME_api = "API"
!$TECH_api = "FastAPI / Pydantic"
!$DESC_api = "Resource-oriented ingress and capability/SoD gate (Clean Architecture driving adapter). Authenticates (JWT bearer; see OpenAPI securitySchemes), enforces capabilities from the authorization contracts, validates request/response resources, and dispatches only to application use-case clusters (*_application). Capability denials append via application-owned DenialAuditPort (implemented by Finding Events Repository). No domain rules and no direct store I/O."

!$NAME_directives_application = "Directives Application"
!$TECH_directives_application = "Python / Pydantic"
!$DESC_directives_application = "Application use-case cluster for the directives resource (Create/Get/List/Update and lifecycle). Orchestrates dual-document mutations through Directives Repository; may trigger Compilation Application after durable writes. Does not compile rules or evaluate targets itself."

!$NAME_compilation_application = "Compilation Application"
!$TECH_compilation_application = "Python / JSON Schema / SHA-256"
!$DESC_compilation_application = "Hermetic application use-case cluster for the compile process (publishes to Compiled Rules Store). Reads executable documents from Directives Repository under hermetic boundary; validates schema and discriminators; publishes Compiled Rules snapshots. Does not load policy doctrines for evaluation. Uses ResolveConflict as an in-process domain service, not a peer component."

!$NAME_inspections_application = "Inspections Application"
!$TECH_inspections_application = "Python / RE2 Regex / SHA-256"
!$DESC_inspections_application = "Application use-case cluster for the inspections resource. Runs the six-stage pipeline against Compiled Rules and a Target (inline body or optional Target Sources). Opens findings via Findings Application; writes inspection evidence to Artifacts Store. Never reads policy doctrines."

!$NAME_findings_application = "Findings Application"
!$TECH_findings_application = "Python / Pydantic"
!$DESC_findings_application = "Application use-case cluster for the findings resource: 11-state lifecycle, SoD, dispositions, evidence, and read models including guidance. Guidance resolves policy doctrine by the finding's revision-pinned paired_policy_ref (not latest doctrine). Appends to Finding Events Store; does not write Compiled Rules or mutate directives from analytics. Declares DenialAuditPort for the api gate (implemented by Finding Events Repository)."

!$NAME_directives_repository = "Directives Repository"
!$TECH_directives_repository = "Python / SQLAlchemy / PostgreSQL"
!$DESC_directives_repository = "Infrastructure adapter implementing DirectiveRepository (port owned by application). Persists dual-document directives to Directives Store; exposes readExecutable (compile) and readPolicyDoctrine (guidance_only)."

!$NAME_compiled_rules_repository = "Compiled Rules Repository"
!$TECH_compiled_rules_repository = "Python / SHA-256 / CAS"
!$DESC_compiled_rules_repository = "Infrastructure adapter implementing CompiledRulesRepository. Publishes and loads immutable compiled rule snapshots in Compiled Rules Store."

!$NAME_finding_events_repository = "Finding Events Repository"
!$TECH_finding_events_repository = "Python / SHA-256 / Append-Only Log"
!$DESC_finding_events_repository = "Infrastructure adapter implementing FindingEventRepository. Appends finding and denial events to Finding Events Store with hash-chain integrity; supports stream load for state hydration."

!$NAME_artifacts_repository = "Artifacts Repository"
!$TECH_artifacts_repository = "Python / Object Store"
!$DESC_artifacts_repository = "Infrastructure adapter implementing ArtifactRepository. Write-once storage of inspection, conflict, and certification artifacts in Artifacts Store."

!$NAME_target_sources_gateway = "Target Sources Gateway"
!$TECH_target_sources_gateway = "Python / HTTP Client / Schema Validation"
!$DESC_target_sources_gateway = "Optional infrastructure gateway implementing TargetGateway. Fetches and normalizes targets from Target Sources when an inspection requests a remote reference instead of an inline body."
