' ============================================================
' Title:     Selma -- C4 Canonical Entity Identities
' Purpose:   Single source of truth for entity IDs, Names, Tech,
'            and Descriptions across Context, Container, and
'            Component diagrams. Include after c4_styles.puml.
'
' Naming (Clean Architecture + Resource-Oriented Design):
'   - IDs: snake_case resource or role tokens, stable across layers
'   - Resources: plural collection names (directives, findings, …)
'   - Application use-case clusters named by primary resource
'   - Infrastructure: *_repository (store ports), *_gateway (externals)
'   - No Tier-C peers: CI/CD, audit export, remediation notify,
'     architectural auditor, freestanding conflict/analyzer engines
'
' Contract:  1.1.0 (docs/spec/contracts/)
' ============================================================

' ------------------------------------------------------------
' Actors
' Layers: Context, Container
' ------------------------------------------------------------
!$NAME_regulatory_official = "Regulatory Official"
!$DESC_regulatory_official = "Human or AI agent for the regulatory authority. Authors and governs dual-document directives, resolves conflicts and finding dispositions under capability and SoD rules, and reads findings and guidance."

!$NAME_compliance_representative = "Compliance Representative"
!$DESC_compliance_representative = "Human, AI agent, or service for the regulated entity. Submits targets (inline or by reference), acknowledges findings, submits evidence, and reads findings and guidance. Cannot author directives or waive findings."

' ------------------------------------------------------------
' System in scope
' ------------------------------------------------------------
!$NAME_selma = "Selma"
!$DESC_selma = "Domain-agnostic rule regularity platform. Authors dual-document directives, compiles executable rules to immutable CG-IR, inspects targets, manages finding lifecycle with audit trail, and resolves guidance from paired policy doctrines."

' ------------------------------------------------------------
' External systems (optional integrations only)
' NOTE: CI/CD, long-term audit export, and remediation ticketing
' are not first-class C4 peers; they are optional clients/exports.
' ------------------------------------------------------------
!$NAME_target_sources = "Target Sources"
!$DESC_target_sources = "Optional external systems that supply inspection targets when not submitted inline (repositories, ledgers, document stores, sensors). Mediated pull only; never mutated by Selma. Primary path remains target payload on the inspection resource."

' ------------------------------------------------------------
' Containers (deployable / process boundaries)
' ------------------------------------------------------------
!$NAME_clients = "Clients"
!$TECH_clients = "CLI / Web / Desktop / Mobile"
!$DESC_clients = "Driving adapters (Clean Architecture outer ring). Authenticate users and map user intent to resource-oriented API calls against the Application. No domain rules live here."

!$NAME_application = "Application"
!$TECH_application = "REST API / Python / RE2 / JSON Schema / SHA-256"
!$DESC_application = "Application + domain process: resource API gate, compilation, inspection, finding lifecycle, and driven repositories. Dual-document directives in Directives; evaluation uses Compiled Rules only; guidance loads doctrines from Directives after findings exist."

' ------------------------------------------------------------
' Data stores (resource collections — ContainerDb)
' Always $tags="store"
' ------------------------------------------------------------
!$NAME_directives = "Directives"
!$TECH_directives = "PostgreSQL"
!$DESC_directives = "Resource collection of dual-document directives (executable rule + policy doctrine), co-versioned per revision with lineage/execution identity, paired_policy_ref, and lifecycle. System of record for authoring and guidance prose."

!$NAME_compiled_rules = "Compiled Rules"
!$TECH_compiled_rules = "Content-Addressed Storage"
!$DESC_compiled_rules = "Resource collection of immutable CG-IR snapshots (compiled executable rules only), keyed by content hash. Evaluation source at inspection time; never rewritten."

!$NAME_finding_events = "Finding Events"
!$TECH_finding_events = "Append-Only Log"
!$DESC_finding_events = "Resource collection of append-only finding lifecycle events and capability denials. System of record for finding state, disposition history, and in-product audit trail."

!$NAME_artifacts = "Artifacts"
!$TECH_artifacts = "Object Store"
!$DESC_artifacts = "Resource collection of write-once evidence: inspection snapshots, execution traces, conflict artifacts, and certification reports. Large immutable blobs separate from the event log."

' ------------------------------------------------------------
' Components inside Application
'   api              — interface adapter / application gate
'   compilation      — application use-case cluster (compile resource)
'   inspection       — application use-case cluster (inspections)
'   findings         — application use-case cluster (findings resource)
'   *_repository     — infrastructure driven adapters (ports)
'   target_sources_gateway — optional infrastructure gateway
' ------------------------------------------------------------
!$NAME_api = "API"
!$TECH_api = "FastAPI / Pydantic"
!$DESC_api = "Resource-oriented ingress (Clean Architecture driving side). Authenticates, enforces capabilities, validates request/response resources, and dispatches to compilation, inspection, and findings use cases. Orchestrates directive mutations and compile triggers."

!$NAME_compilation = "Compilation"
!$TECH_compilation = "Python / JSON Schema / SHA-256"
!$DESC_compilation = "Application service for the compile use case. Reads executable documents from Directives (repository) under hermetic boundary; validates schema and discriminators; publishes Compiled Rules snapshots. Does not load policy doctrines for evaluation. Uses ResolveConflict as an in-process domain service, not a peer component."

!$NAME_inspection = "Inspection"
!$TECH_inspection = "Python / RE2 Regex / SHA-256"
!$DESC_inspection = "Application service for the inspections resource. Runs the six-stage pipeline against Compiled Rules and a Target (inline body or optional Target Sources). Emits findings into the findings use case; writes inspection evidence to Artifacts. Never reads policy doctrines."

!$NAME_findings = "Findings"
!$TECH_findings = "Python / Pydantic"
!$DESC_findings = "Application service for the findings resource: 10-state lifecycle, SoD, dispositions, evidence, and read models including guidance (doctrine via Directives repository + paired_policy_ref). Appends Finding Events; does not write Compiled Rules or mutate directives from analytics."

!$NAME_directives_repository = "Directives Repository"
!$TECH_directives_repository = "Python / SQLAlchemy / PostgreSQL"
!$DESC_directives_repository = "Infrastructure adapter implementing DirectiveRepository. Persists dual-document directives; exposes readExecutable (compile) and readPolicyDoctrine (guidance_only)."

!$NAME_compiled_rules_repository = "Compiled Rules Repository"
!$TECH_compiled_rules_repository = "Python / SHA-256 / CAS"
!$DESC_compiled_rules_repository = "Infrastructure adapter implementing CgIrRepository. Publishes and loads immutable compiled rule snapshots."

!$NAME_finding_events_repository = "Finding Events Repository"
!$TECH_finding_events_repository = "Python / SHA-256 / Append-Only Log"
!$DESC_finding_events_repository = "Infrastructure adapter implementing EventStore. Appends finding and denial events with hash-chain integrity."

!$NAME_artifacts_repository = "Artifacts Repository"
!$TECH_artifacts_repository = "Python / Object Store"
!$DESC_artifacts_repository = "Infrastructure adapter implementing ArtifactRepository. Write-once storage of inspection, conflict, and certification artifacts."

!$NAME_target_sources_gateway = "Target Sources Gateway"
!$TECH_target_sources_gateway = "Python / HTTP Client / Schema Validation"
!$DESC_target_sources_gateway = "Optional infrastructure gateway for TargetGateway. Fetches and normalizes targets from Target Sources when inspection requests a remote reference instead of an inline body."
