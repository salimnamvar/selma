' ============================================================
' Title:     Selma -- C4 Style Overrides
' Purpose:   C4 element + relationship styles mapped to the
'            Clean Architecture MACRO / MICRO palette
'            (docs/standards/common/ca_palette.puml).
' Contract:  1.1.0
'
' Include AFTER C4_Context / C4_Container / C4_Component.
' Then include ./common/c4_identities.puml.
' End every diagram with SHOW_LEGEND().
'
' MACRO mapping:
'   person              → CA actors
'   container / component → CA interface
'   system (Selma)      → CA application (product process)
'   *_store tag         → CA frameworks
'   external_*          → CA external
'   hermetic tag        → CA infrastructure / hermetic
'   gate tag            → CA micro gate
'
' MICRO mapping (relationship tags): capability, hermetic,
'   immutable, mediated, async, validation_only, guidance_only
' ============================================================

!include ../../standards/common/ca_palette.puml

' ------------------------------------------------------------
' C4 label-break knobs
' ------------------------------------------------------------
!$DEFAULT_WRAP_WIDTH = 160
!$MAX_MESSAGE_SIZE = 90
!$REL_DESCR_MAX_CHAR_WIDTH = 24
!$REL_TECHN_MAX_CHAR_WIDTH = 16
!$BOUNDARY_DESCR_MAX_CHAR_WIDTH = 28

' ------------------------------------------------------------
' Layout & typography
' ------------------------------------------------------------
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam roundCorner 8
skinparam monochrome false
skinparam handwritten false

skinparam backgroundColor $CA_CANVAS
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor $CA_INK

skinparam wrapWidth 160
skinparam maxMessageSize 90
skinparam nodesep 160
skinparam ranksep 180

skinparam responseMessageBelowArrow true
skinparam arrowThickness 1.5
skinparam arrowFontSize 9

skinparam packageBorderColor $CA_INK
skinparam packageFontColor $CA_INK
skinparam packageFontStyle bold
skinparam componentBorderColor $CA_INK
skinparam rectangleBorderColor $CA_INK
skinparam databaseBorderColor $CA_INK
skinparam personBorderColor $CA_INK

skinparam legendBackgroundColor $CA_LEGEND_BG
skinparam legendBorderColor $CA_LEGEND_BORDER
skinparam legendFontSize 9

' ------------------------------------------------------------
' Element palette — MACRO layers via ca_palette
' ------------------------------------------------------------
!if %function_exists("C4Version")

' Actors → CA actors
UpdateElementStyle("person", $bgColor=$CA_SOLID_ACTOR, $fontColor="#FFFFFF", $borderColor="#2F4A73", $shadowing="false", $legendText="person / actor (CA actors)")
UpdateElementStyle("external_person", $bgColor=$CA_SOLID_EXTERNAL_PERSON, $fontColor="#FFFFFF", $borderColor="#6B7A90", $shadowing="false", $legendText="external person")

' System in scope → CA application (process)
UpdateElementStyle("system", $bgColor=$CA_SOLID_APPLICATION, $fontColor="#FFFFFF", $borderColor="#0F4F47", $shadowing="false", $borderThickness="2", $legendText="system (CA application)")
UpdateElementStyle("external_system", $bgColor=$CA_SOLID_EXTERNAL, $fontColor="#FFFFFF", $borderColor="#5C636A", $shadowing="false", $legendText="external system (CA external)")

' Containers → CA interface (runtime shell)
UpdateElementStyle("container", $bgColor=$CA_SOLID_INTERFACE, $fontColor="#FFFFFF", $borderColor="#1F5BB5", $shadowing="false", $legendText="container (CA interface)")
UpdateElementStyle("external_container", $bgColor="#A0A8B0", $fontColor="#FFFFFF", $borderColor="#7A828A", $shadowing="false", $legendText="external container")

' Components → soft interface (nested under container)
UpdateElementStyle("component", $bgColor=$CA_SOLID_INTERFACE_SOFT, $fontColor="#0D2137", $borderColor=$CA_SOLID_INTERFACE, $shadowing="false", $borderThickness="1", $legendText="component (CA interface nest)")

UpdateRelStyle($CA_ARROW, "#5A6B7A")

UpdateBoundaryStyle("", $bgColor=$CA_BOUNDARY_DEFAULT_FILL, $fontColor=$CA_INK, $borderColor="#34495E", $shadowing="false", $borderStyle="dashed", $borderThickness="2", $legendText="boundary")
UpdateBoundaryStyle("system", $bgColor=$CA_BOUNDARY_SYSTEM_FILL, $fontColor="#0F4F47", $borderColor=$CA_SOLID_APPLICATION, $shadowing="false", $borderStyle="dashed", $borderThickness="2", $type="System", $legendText="system boundary (CA application)")
UpdateBoundaryStyle("container", $bgColor=$CA_BOUNDARY_CONTAINER_FILL, $fontColor="#1F5BB5", $borderColor=$CA_SOLID_INTERFACE, $shadowing="false", $borderStyle="dashed", $borderThickness="2", $type="Container", $legendText="container boundary (CA interface)")

' Frameworks & drivers
AddElementTag("store", $bgColor=$CA_SOLID_FRAMEWORKS, $fontColor="#FFFFFF", $borderColor=$CA_BORDER_FRAMEWORKS_DEEP, $shadowing="false", $legendText="data store (CA frameworks)")

' MICRO tags
AddElementTag("hermetic", $bgColor=$CA_SOLID_HERMETIC, $fontColor="#FFFFFF", $borderColor=$CA_BORDER_HERMETIC, $borderStyle="dashed", $borderThickness="2", $legendText="hermetic (CA infrastructure)")
AddElementTag("gate", $bgColor=$CA_SOLID_GATE, $fontColor="#FFFFFF", $borderColor=$CA_BORDER_GATE_DEEP, $legendText="capability gate (CA micro gate)")

' Relationship MICRO tags
AddRelTag("capability_enforced", $textColor="#922B21", $lineColor=$CA_SOLID_CAPABILITY, $lineStyle="solid", $lineThickness="2", $legendText="capability-enforced\npermission gate before action")
AddRelTag("compile_only", $textColor="#9A5B00", $lineColor="#E67E22", $lineStyle="dashed", $lineThickness="2", $legendText="compile-time only\nruntime access prohibited")
AddRelTag("immutable", $textColor="#0B5E3C", $lineColor=$CA_SOLID_IMMUTABLE, $lineStyle="solid", $lineThickness="2", $legendText="append-only / immutable\nnever mutated")
AddRelTag("mediated", $textColor="#5B2C6F", $lineColor=$CA_SOLID_MEDIATED, $lineStyle="dashed", $lineThickness="2", $legendText="mediated output\nno external state mutation")
AddRelTag("async", $textColor="#1A5276", $lineColor=$CA_SOLID_ASYNC, $lineStyle="dotted", $lineThickness="2", $legendText="asynchronous\neventually consistent")
AddRelTag("validation_only", $textColor="#0E6655", $lineColor=$CA_SOLID_VALIDATION, $lineStyle="dashed", $lineThickness="2", $legendText="validation only\nread/inspect, no mutation")
AddRelTag("immutable_async", $textColor="#0B5E3C", $lineColor=$CA_SOLID_IMMUTABLE, $lineStyle="dotted", $lineThickness="2", $legendText="append-only + async\nnever mutated, eventual delivery")
AddRelTag("mediated_async", $textColor="#5B2C6F", $lineColor=$CA_SOLID_MEDIATED, $lineStyle="dotted", $lineThickness="2", $legendText="mediated + async\nno external mutation, eventual")
AddRelTag("guidance_only", $textColor="#1A5276", $lineColor="#2E86C1", $lineStyle="dotted", $lineThickness="1", $legendText="guidance only\nread for reasoning, not evaluation")

!endif
