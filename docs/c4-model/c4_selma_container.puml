' ============================================================
' Title:     Selma -- Container Diagram
' Boundary:  Selma
' Purpose:   Deployable/process units: clients, application,
'            four *_store. Runtime zones/TLS: docs/deployment/.
'            Code modules: docs/package/.
' Contract:  1.1.0
' ============================================================
@startuml c4_selma_container
title Selma -- Container Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!theme plain
!include ./common/c4_styles.puml
!include ./common/c4_identities.puml

LAYOUT_LEFT_RIGHT()

Person(regulatory_official, $NAME_regulatory_official, $DESC_regulatory_official)
Person(compliance_representative, $NAME_compliance_representative, $DESC_compliance_representative)

System_Ext(target_sources, $NAME_target_sources, $DESC_target_sources)

Container_Ext(clients, $NAME_clients, $TECH_clients, $DESC_clients)

System_Boundary(selma, $NAME_selma) {

    Container(application, $NAME_application, $TECH_application, $DESC_application)

    ContainerDb(directives_store, $NAME_directives_store, $TECH_directives_store, $DESC_directives_store, $tags="store")
    ContainerDb(compiled_rules_store, $NAME_compiled_rules_store, $TECH_compiled_rules_store, $DESC_compiled_rules_store, $tags="store")
    ContainerDb(finding_events_store, $NAME_finding_events_store, $TECH_finding_events_store, $DESC_finding_events_store, $tags="store")
    ContainerDb(artifacts_store, $NAME_artifacts_store, $TECH_artifacts_store, $DESC_artifacts_store, $tags="store")

}

Rel(regulatory_official, clients, "authors directives; resolves findings; reads guidance", "HTTPS", $tags="capability_enforced")
Rel(compliance_representative, clients, "submits targets and inspections; acknowledges findings; reads guidance", "HTTPS", $tags="capability_enforced")

Rel(clients, application, "resource-oriented API calls", "REST / HTTPS", $tags="capability_enforced")

Rel(application, target_sources, "optionally fetches targets by reference", "HTTPS / API", $tags="mediated")

Rel(application, directives_store, "reads and writes dual-document directives", "SQL")
Rel(application, compiled_rules_store, "publishes and loads compiled rule snapshots", "CAS", $tags="immutable")
Rel(application, finding_events_store, "appends finding and denial events", "Append-Only", $tags="immutable")
Rel(application, artifacts_store, "stores inspection, conflict, and certification artifacts", "Object Write", $tags="immutable")

SHOW_LEGEND()
@enduml
