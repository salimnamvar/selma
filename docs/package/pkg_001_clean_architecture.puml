@startuml pkg_001_clean_architecture
' ============================================================
' Title:     PKG-001 Clean Architecture Packages
' Source:    docs/c4-model/README.md package alignment
' C4:        {resource}_{layer} maps to C4 peers
' Contract:  1.1.0
' ============================================================
' PKG-001 · Clean Architecture — {resource}_{layer} modules
' Local include (do not use !includeurl for in-repo styles)
!include ../class/common/cd_styles.puml

title **PKG-001 — Clean Architecture Packages**\nSelma · {resource}_{layer} · Resource-Oriented Design\n

skinparam package {
  BackgroundColor #F0F4F8
  BorderColor #5B7BA5
  FontSize 12
  FontStyle bold
}

package "<<interface>>\n*_interface" as INTERFACES #E3F2FD/1565C0 {
  package "rest_interface" as IF_REST #BBDEFB/1976D2 {
    [Resource routers + capability gate] as REST_ROUTER
  }
  package "cli_interface" as IF_CLI #BBDEFB/1976D2
  package "tui_interface" as IF_TUI #BBDEFB/1976D2
}

package "<<composition>>" as COMPOSITION #E8EAF6/3F51B5 {
  [DI / Wiring] as WIRING
}

package "<<infrastructure>>\n*_infrastructure" as INFRASTRUCTURE #FFF3E0/E65100 {
  package "directives_infrastructure" as INFRA_DIR #FFE0B2/F57C00 {
    [SqlDirectiveRepository] as SQL_DIR
  }
  package "compiled_rules_infrastructure" as INFRA_CR #FFE0B2/F57C00 {
    [ContentAddressedCompiledRulesRepository] as CAS_CR
  }
  package "findings_infrastructure" as INFRA_FE #FFE0B2/F57C00 {
    [AppendOnlyFindingEventRepository] as EVT_REPO
  }
  package "artifacts_infrastructure" as INFRA_ART #FFE0B2/F57C00 {
    [ObjectArtifactRepository] as OBJ_ART
  }
  package "inspections_infrastructure" as INFRA_INS #FFE0B2/F57C00 {
    [HttpTargetSourcesGateway] as TGT_GW
  }
}

package "<<application>>\n*_application" as APPLICATION #E8F5E9/2E7D32 {
  package "directives_application" as APP_DIR #C8E6C9/388E3C {
    [CreateDirective / GetDirective / ListDirectives / …] as UC_DIR
    interface DirectiveRepository
  }
  package "compiled_rules_application\n(C4: compilation_application)" as APP_CR #C8E6C9/388E3C {
    [CompileDirectives / PublishCompiledRules / DrainOutbox] as UC_CR
    interface CompiledRulesRepository
    interface CompilerReadPort
  }
  package "inspections_application" as APP_INS #C8E6C9/388E3C {
    [CreateInspection / GetInspection] as UC_INS
    interface InspectionArtifactPort
  }
  package "findings_application" as APP_FIND #C8E6C9/388E3C {
    [GetFinding / ListFindings / GetFindingGuidance / …] as UC_FIND
    interface FindingEventRepository
    interface DenialAuditPort
    interface GuidanceReadPort
    interface FindingArtifactPort
  }
}

package "<<domain>>\n*_domain" as DOMAIN #FFFFFF/78909C {
  package "shared_domain" as DOM_SHARED
  package "directives_domain" as DOM_DIR
  package "compiled_rules_domain" as DOM_CR
  package "inspections_domain" as DOM_INS
  package "findings_domain" as DOM_FIND
  package "conflicts_domain" as DOM_CON {
    [ResolveConflict] as RESOLVE
  }
}

INTERFACES .down.> APPLICATION : <<uses>>
IF_REST ..> DenialAuditPort : <<uses>> gate denials
COMPOSITION .down.> INTERFACES : <<wires>>
COMPOSITION .down.> INFRASTRUCTURE : <<wires>>
COMPOSITION .down.> APPLICATION : <<wires>>
COMPOSITION .down.> DOMAIN : <<wires>>

INFRA_DIR ..> APP_DIR : <<implements>>
INFRA_DIR ..> CompilerReadPort : <<implements>>
INFRA_DIR ..> GuidanceReadPort : <<implements>>
INFRA_CR ..> APP_CR : <<implements>>
INFRA_FE ..> APP_FIND : <<implements>>
INFRA_FE ..> DenialAuditPort : <<implements>>
INFRA_ART ..> InspectionArtifactPort : <<implements>>
INFRA_ART ..> FindingArtifactPort : <<implements>>
INFRA_INS ..> APP_INS : <<implements>>

APP_DIR .down.> DOM_DIR : <<depends>>
APP_CR .down.> DOM_CR : <<depends>>
APP_CR .down.> DOM_CON : <<depends>> ResolveConflict
APP_INS .down.> DOM_INS : <<depends>>
APP_INS .down.> DOM_CON : <<depends>> ResolveConflict
APP_FIND .down.> DOM_FIND : <<depends>>

DOM_DIR .down.> DOM_SHARED
DOM_CR .down.> DOM_SHARED
DOM_INS .down.> DOM_SHARED
DOM_FIND .down.> DOM_SHARED
DOM_CON .down.> DOM_SHARED

note right of APPLICATION
  **ROD operations**
  Create/Get/List/Update + lifecycle verbs
  GetFindingGuidance (sub-resource;
  doctrine by paired_policy_ref revision)
  No bare execute() as public API

  **DenialAuditPort**
  Application-owned; consumed by api/rest_interface;
  implemented by findings_infrastructure.
  Single method: AppendDenial(...)
end note

note right of INFRASTRUCTURE
  **C4 repositories**
  directives_repository
  compiled_rules_repository
  finding_events_repository
  artifacts_repository
  target_sources_gateway

  **Alignment with C4:**
  Each infrastructure package implements
  a C4 repository/gateway component.
  findings_infrastructure also implements
  DenialAuditPort for the capability gate.
end note

legend bottom
  |= Pattern |= Example |
  | {resource}_domain | directives_domain |
  | {resource}_application | findings_application |
  | {resource}_infrastructure | directives_infrastructure |
  | {channel}_interface | rest_interface |

  **Alignment with C4:**
  Packages map to C4 components:
  - directives_application → directives_application
  - directives_infrastructure → directives_repository
  - compiled_rules_* (compile) → compilation_application + compiled_rules_repository
  - inspections_* → inspections_application (+ target_sources_gateway)
  - findings_* → findings_application + finding_events_repository
  - DenialAuditPort → app port; implementer finding_events_repository
  - artifacts_infrastructure → artifacts_repository
  - conflicts_domain → ResolveConflict (not C4 component)
  - stores → directives_store | compiled_rules_store |
             finding_events_store | artifacts_store
endlegend

footer PKG-001 · {resource}_{layer} · Selma

@enduml
