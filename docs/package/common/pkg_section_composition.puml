' ============================================================
' Section: COMPOSITION ROOT (v1 single Application process)
' Aliases: COMPOSITION, WIRE_APP, WIRE_PORTS, WIRE_OUTBOX
' ============================================================

package "$TITLE_COMPOSITION" as COMPOSITION #EDE7F6/5E35B1 {
  together {
    [ApplicationContainer] as WIRE_APP
    [PortBindings] as WIRE_PORTS
    [OutboxDrainScheduler] as WIRE_OUTBOX
    ["$PORT_CERT_ART"] as P_CERT_ART <<port>>
  }
  WIRE_APP -[hidden]right- WIRE_PORTS
  WIRE_PORTS -[hidden]right- WIRE_OUTBOX
  WIRE_OUTBOX -[hidden]right- P_CERT_ART
}
