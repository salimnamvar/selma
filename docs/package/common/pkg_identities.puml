' ============================================================
' Title:     Selma -- Package Diagram Identities (canonical aliases)
' Purpose:   Stable alias registry for package diagrams — same role
'            as c4_identities.puml for C4. Display titles + C4 peer map.
'            Sections MUST use these aliases only (do not invent IDs).
' Contract:  1.1.0
'
' Naming dual (intentional):
'   C4 peer: compilation_application
'   Package: compiled_rules_application / APP_CR / P_CR_*
'
' Alias prefixes:
'   IF_* / REST_* / CLI_* / TUI_*  — interface
'   WIRE_*                          — composition
'   APP_* / UC_* / P_*              — application + use cases + ports
'   DOM_* / AGG_* / VO_* / SVC_*    — domain
'   INFRA_* / SQL_* / CAS_* / …     — infrastructure adapters
'   ST_* / EXT                      — stores + external
' ============================================================

' ── Layer package display titles ────────────────────────────
!$TITLE_INTERFACES = "<<interface>> *_interface"
!$TITLE_COMPOSITION = "<<composition>> composition_root"
!$TITLE_APPLICATION = "<<application>> *_application"
!$TITLE_DOMAIN = "<<domain>> *_domain"
!$TITLE_INFRASTRUCTURE = "<<infrastructure>> *_infrastructure"
!$TITLE_STORES = "<<frameworks & drivers>>\nstore symbols (C4 *_store IDs)"
!$TITLE_EXTERNAL = "<<external>>\ntarget_sources (C4)"

' ── Resource package titles (C4 peer in subtitle where dual) ─
!$TITLE_IF_REST = "rest_interface (C4: api)"
!$TITLE_IF_CLI = "cli_interface (C4: clients)"
!$TITLE_IF_TUI = "tui_interface (C4: clients)"

!$TITLE_APP_DIR = "directives_application\n(C4: directives_application)"
!$TITLE_APP_CR = "compiled_rules_application\n(C4: compilation_application)"
!$TITLE_APP_INS = "inspections_application\n(C4: inspections_application)"
!$TITLE_APP_FIND = "findings_application\n(C4: findings_application)"

!$TITLE_INFRA_DIR = "directives_infrastructure\n(C4: directives_repository)"
!$TITLE_INFRA_CR = "compiled_rules_infrastructure\n(C4: compiled_rules_repository)"
!$TITLE_INFRA_FE = "findings_infrastructure\n(C4: finding_events_repository)"
!$TITLE_INFRA_ART = "artifacts_infrastructure\n(C4: artifacts_repository)"
!$TITLE_INFRA_INS = "inspections_infrastructure\n(C4: target_sources_gateway)"
!$TITLE_INFRA_PLAT = "platform_infrastructure"

