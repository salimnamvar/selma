' ============================================================
' Title:     Selma — Component Diagram (Core Engine)
' Boundary:  Core Engine container
' Purpose:   Shows the eight core components, the validation
'            pipeline, the Steward orchestration loop, and
'            the five validation pillars
' Milestone: v0.1.0
' Version:   2.0.0
' Source:    contracts/SPECIFICATION.md §3-6, README.md,
'            contracts/policy_doctrine.yaml, contracts/rule_schema.json
' Review:    docs/C4_Design/README.md
' ============================================================

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Component.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma — Component Diagram (Core Engine)\nValidation Pipeline & Steward Orchestration

' ─── EXTERNAL CONTAINERS ─────────────────────────────────────────
Container_Ext(storage, "Rule Storage", "File System", "Per-domain policy.md and rules.yaml.")
Container_Ext(llm_adapter, "LLM Adapter", "Python", "Handles communication with external LLM API.")
Container_Ext(policy_contract, "Policy Doctrine", "YAML", "policy_doctrine.yaml — The Societal Lens.")
Container_Ext(rule_contract, "Rule Schema", "JSON", "rule_schema.json — The Mechanical Lens.")

' ─── CORE ENGINE BOUNDARY ────────────────────────────────────────
Container_Boundary("core_boundary", "Core Engine") {

    ' ── Domain Management ──────────────────────────────────────
    Component(domain_registry, "Domain Registry", "Module", "Manages registration of new domains.\nScaffolds folder structure with\npolicy.md and rules.yaml templates.")

    ' ── CRUD Operations ────────────────────────────────────────
    Component(crud, "CRUD Operations", "Module", "Creates, reads, updates, and deletes\nrules while maintaining traceability.\nAuto-bumps versions on changes.")

    ' ── Version Manager ────────────────────────────────────────
    Component(versioner, "Version Manager", "Module", "Auto-bumps versions (SemVer MAJOR.MINOR.PATCH)\nfor domains. Synchronizes contract versions.\nIncrements based on change severity.")

    ' ── Validation Pipeline (Five Pillars) ─────────────────────
    Component(validator, "Validator Orchestrator", "Module", "Coordinates the five validation pillars:\n1. Policy Structure\n2. Rule Schema\n3. Traceability Bond\n4. Contamination Guard\n5. Conflict Detection")

    Component(policy_validator, "Policy Validator", "Module", "Validates policy.md structure:\n- Required sections present\n- Correct content types\n- No forbidden fields (contamination)")
    note right of policy_validator : **Pillar 1**\nSPECIFICATION.md §6.1

    Component(rule_validator, "Rule Validator", "Module", "Validates rules.yaml against rule_schema.json:\n- JSON Schema compliance\n- Required fields present\n- No forbidden root fields")
    note right of rule_validator : **Pillar 2**\nSPECIFICATION.md §6.2

    Component(trace_validator, "Traceability Validator", "Module", "Validates bidirectional bond:\n- Every Machine ID ↔ rule id\n- Every anchor_ref → valid section\n- Contract version synchronization")
    note right of trace_validator : **Pillar 3**\nSPECIFICATION.md §6.3

    Component(contamination_guard, "Contamination Guard", "Module", "Enforces separation principle:\n- Policy: no machine fields\n- Rules: no human prose fields\n- Cross-contract pollution detection")
    note right of contamination_guard : **Pillar 4**\nSPECIFICATION.md §6.4

    ' ── Conflict Reasoner ──────────────────────────────────────
    Component(reasoner, "Conflict Reasoner", "Module", "Detects rule conflicts and suggests\nresolution based on priority hierarchy:\nconstitutional > statutory > regulatory\n> operational > advisory")
    note right of reasoner : **Pillar 5**\nSPECIFICATION.md §4.4

    ' ── Steward Agent (AI Orchestrator) ────────────────────────
    Component(steward, "Steward Agent", "Module", "Autonomous AI rule writer.\nOrchestration loop:\n1. Read domain state\n2. Generate rules via LLM\n3. Persist to storage\n4. Validate (all 5 pillars)\n5. Self-correct if errors\n6. Bump version\n7. Output diff summary")

    ' ── Export / Import ────────────────────────────────────────
    Component(exporter, "Domain Exporter", "Module", "Packages entire domains for export.\nImport/export rule sets for backup\nor cross-domain transfer.")

    ' ── Query Engine ───────────────────────────────────────────
    Component(query_engine, "Query Engine", "Module", "Retrieves rules by ID, domain,\nstatus, priority, or type.\nReturns filtered, sorted results.")
}

' ─── RELATIONSHIPS: Domain Management ────────────────────────────
Rel(domain_registry, storage, "Creates domain folders\nand template files")
Rel(domain_registry, crud, "Registers new domains\nfor CRUD operations")

' ─── RELATIONSHIPS: CRUD & Versioning ────────────────────────────
Rel(crud, storage, "Reads/Writes\npolicy.md and rules.yaml")
Rel(crud, versioner, "Triggers version bump\non create/update/delete")
Rel(versioner, crud, "Returns new version\nafter bump")
Rel(crud, domain_registry, "Delegates domain creation\nfor new domains")

' ─── RELATIONSHIPS: Validation Pipeline ──────────────────────────
Rel(validator, policy_validator, "Orchestrates\npolicy validation")
Rel(validator, rule_validator, "Orchestrates\nrule validation")
Rel(validator, trace_validator, "Orchestrates\ntraceability validation")
Rel(validator, contamination_guard, "Orchestrates\ncontamination check")
Rel(validator, reasoner, "Orchestrates\nconflict detection")

Rel(policy_validator, policy_contract, "Reads writing principles,\nvalidates against doctrine")
Rel(rule_validator, rule_contract, "Reads JSON Schema,\nvalidates rules against it")
Rel(trace_validator, policy_contract, "Extracts Machine IDs\nfrom directive tables")
Rel(trace_validator, rule_contract, "Extracts rule ids\nand anchor_refs")
Rel(contamination_guard, policy_contract, "Scans for forbidden\nmachine fields")
Rel(contamination_guard, rule_contract, "Scans for forbidden\nhuman fields")
Rel(reasoner, rule_contract, "Reads conflicts_with,\ndepends_on, priority")

' ─── RELATIONSHIPS: Steward Agent ────────────────────────────────
Rel(steward, crud, "Persists AI-generated\nrules to storage")
Rel(steward, validator, "Validates generated\nrules iteratively")
Rel(steward, llm_adapter, "Calls LLM for\nrule generation")
Rel(steward, versioner, "Triggers version bump\nafter successful generation")

' ─── RELATIONSHIPS: Export & Query ────────────────────────────────
Rel(exporter, storage, "Reads domain files\nfor packaging")
Rel(query_engine, storage, "Reads rules\nfor filtering/sorting")
Rel(query_engine, rule_contract, "Reads schema for\nfield definitions")

' ─── RELATIONSHIPS: Validator to Storage ──────────────────────────
Rel(validator, storage, "Reads policy.md\nand rules.yaml for validation")

@enduml
