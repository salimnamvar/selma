' ============================================================
' Title:     Selma — Context Diagram
' Boundary:  Selma Universal Rule Governance Engine
' Purpose:   Shows Selma as the system under design, its actors,
'            external dependencies, the dual-contract bond,
'            and the four-pillar core engine
' Milestone: v0.1.0
' Version:   4.0.0
' Source:    contracts/SPECIFICATION.md, contracts/policy_doctrine.yaml,
'            contracts/rule_schema.json, README.md
' Review:    docs/C4_Design/README.md
' ============================================================

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Context.puml
!theme plain

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

title Selma — Context Diagram\nUniversal Rule Governance Engine

' ─── ACTORS ──────────────────────────────────────────────────────
Person(admin, "Rule Administrator", "Human authoring and maintaining\nrule sets via CLI or REST API.")
Person(steward, "AI Steward", "Autonomous agent that writes rules\nfrom natural language. Orchestrates\nthe four-pillar pipeline.")
Person(developer, "Domain Developer", "Builds downstream services that\nconsume rules via API or export.")

' ─── SYSTEM UNDER DESIGN ─────────────────────────────────────────
System(selma, "Selma", "Universal Rule Governance Engine.\nFour Pillars: Definition, Maintenance,\nMechanical Linting, Reasoning.\nWrites, validates, lints, and reasons\nABOUT THE RULES THEMSELVES.")

' ─── EXTERNAL DEPENDENCIES ───────────────────────────────────────
System_Ext(llm, "LLM Service", "OpenAI / Anthropic API.\nNatural language understanding\nfor rule generation and reasoning.")
System_Ext(fs, "File System", "Stores policy.md and rules.yaml\nper domain. YAML + Markdown.")
System_Ext(repo, "Git Repository", "Optional version control for\ntracking rule history and audit trail.")

' ─── RELATIONSHIPS ───────────────────────────────────────────────
Rel(admin, selma, "CRUD operations,\nvalidation, queries", "HTTPS / CLI")
Rel(steward, selma, "Submits natural language\nrule requests, orchestrates pipeline", "HTTPS")
Rel(developer, selma, "Fetches rules,\nexports domains", "HTTPS")

Rel(selma, llm, "Delegates AI rule generation\nand deep reasoning", "HTTPS")
Rel(selma, fs, "Reads/writes policy.md\nand rules.yaml per domain", "I/O")
Rel(selma, repo, "Commits changes\n(optional audit trail)", "Git")

' ─── NOTES ───────────────────────────────────────────────────────
note left of selma
  **Four Pillars**
  1. Definition Engine (Creator)
  2. Maintenance Engine (Curator)
  3. Mechanical Linting (Inspector)
  4. Reasoning Engine (Arbiter)
end note

note bottom of selma
  **Dual-Contract Architecture**
  Policy Doctrine (human lens) ←→
  Rule Schema (machine lens)
  Connected by Traceability Bond
  (Machine ID ↔ anchor_ref)
end note

@enduml
