@startuml c4_selma_container
' ============================================================
' Title:     Selma — Container Diagram
' Boundary:  Selma Universal Rule Governance Engine
' Purpose:   Show Selma's single deployable container,
'            external systems, and configuration data
' Milestone: v1.0
' Version:   1.3.0
' Source:    contracts/SPECIFICATION.md
' ============================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!include common/c4_styles.puml
!theme plain
LAYOUT_WITH_LEGEND()

title SELMA System — Container Diagram

Person(admin, "Rule Administrator", "Human authoring and maintaining rule sets", $sprite="person")
Person(agent, "AI Agent", "Autonomous agent that submits NL requests", $sprite="person")
Person(developer, "Domain Developer", "Builds downstream services that consume rules", $sprite="person")

System_Boundary(selma_service, "SELMA System") {

    Container(selma_application, "SELMA Application", "Python / FastAPI", "REST API + Core Engine (Definition, Maintenance, Linting, Reasoning, Steward)", $tags="container")

    Container(contracts, "Contracts", "YAML / JSON", "policy_doctrine.yaml and rule_schema.json (static data loaded at startup)", $tags="datastore")
}

System_Ext(llm, "LLM Service", "OpenAI / Anthropic", $tags="external")
System_Ext(fs, "Rule Storage", "File System (local, network, or S3)", $tags="external")
System_Ext(repo, "Git Repository", "Optional version control", $tags="external")

Rel(admin, selma_application, "CRUD, validate, query rules", "HTTPS")
Rel(agent, selma_application, "Submit NL requests", "HTTPS")
Rel(developer, selma_application, "Fetch rules, export domains", "HTTPS")

Rel(selma_application, contracts, "Reads contracts at startup", "I/O")

Rel(selma_application, llm, "Calls for rule generation and reasoning", "HTTPS")
Rel(selma_application, fs, "Reads/writes per-domain policy.md and rules.yaml", "I/O")
Rel(selma_application, repo, "Commits changes (optional)", "Git")

@enduml
