' ============================================================
' Title:     Selma — Container Diagram
' Boundary:  Selma Universal Rule Governance Engine
' Purpose:   Shows Selma's internal containers, the dual-contract
'            files, and the four-pillar pipeline
' Milestone: v0.1.0
' Version:   4.0.0
' Source:    contracts/SPECIFICATION.md §2, contracts/README.md,
'            README.md §Architecture
' Review:    docs/C4_Design/README.md
' ============================================================

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Container.puml
!theme plain

LAYOUT_WITH_LEGEND()

title Selma — Container Diagram\nInternal Containers, Four Pillars & Dual-Contract Architecture

' ─── ACTORS ──────────────────────────────────────────────────────
Person(admin, "Rule Administrator")
Person(steward, "AI Steward")
Person(developer, "Domain Developer")

' ─── SELMA SYSTEM BOUNDARY ───────────────────────────────────────
System_Boundary("selma_boundary", "Selma — Universal Rule Governance Engine") {

    ' ── API Layer ──────────────────────────────────────────────
    Container(api, "Web API", "Python / FastAPI", "REST endpoints for CRUD,\nvalidation, and queries.\n/health, /domains, /rules.")

    ' ── Core Engine (Four Pillars) ─────────────────────────────
    Container(core, "Core Engine", "Python", "Four-pillar pipeline:\n1. Definition (Creator)\n2. Maintenance (Curator)\n3. Mechanical Linting (Inspector)\n4. Reasoning (Arbiter)\nOrchestrated by Steward Agent.")

    ' ── Contracts (The Dual-Contract Bond) ─────────────────────
    Container(policy_contract, "Policy Doctrine", "YAML", "policy_doctrine.yaml.\nThe Societal Lens — defines how\nhumans write rules: prose structure,\ngovernance, sanctions, writing principles.")
    Container(rule_contract, "Rule Schema", "JSON", "rule_schema.json.\nThe Mechanical Lens — defines how\nmachines execute rules: data structure,\nlifecycle, parameters, conditions.")

    ' ── Storage ────────────────────────────────────────────────
    Container(storage, "Rule Storage", "File System", "Per-domain policy.md and rules.yaml.\nYAML + Markdown for human readability.")

    ' ── LLM Integration ───────────────────────────────────────
    Container(llm_adapter, "LLM Adapter", "Python", "Handles communication with\nexternal LLM API. Retry, fallback,\nand prompt management.")
}

' ─── EXTERNAL SYSTEMS ────────────────────────────────────────────
System_Ext(llm, "LLM Service", "OpenAI / Anthropic")
System_Ext(repo, "Git Repository", "Optional version control")

' ─── ACTOR → API RELATIONSHIPS ───────────────────────────────────
Rel(admin, api, "CRUD, validate,\nquery rules", "HTTPS")
Rel(steward, api, "Submit NL requests,\nfetch domain state", "HTTPS")
Rel(developer, api, "Fetch rules,\nexport domains", "HTTPS")

' ─── API → CORE RELATIONSHIPS ────────────────────────────────────
Rel(api, core, "Dispatches requests\nto four-pillar pipeline")

' ─── CORE → CONTRACTS (The Bond) ─────────────────────────────────
Rel(core, policy_contract, "Reads writing principles,\nvalidates policy structure,\nenforces contamination guard")
Rel(core, rule_contract, "Reads schema,\nvalidates rules,\nenforces contamination guard")

note bottom of policy_contract
  **Policy → Rule Bond**
  Machine ID columns in
  directive tables
end note

note bottom of rule_contract
  **Rule → Policy Bond**
  anchor_ref field links
  back to policy section
end note

' ─── CORE → STORAGE ──────────────────────────────────────────────
Rel(core, storage, "Reads/writes per-domain\npolicy.md and rules.yaml")

' ─── CORE → LLM ─────────────────────────────────────────────────
Rel(core, llm_adapter, "Delegates AI rule generation\nand deep reasoning")
Rel(llm_adapter, llm, "Calls LLM API", "HTTPS")

' ─── CORE → VERSION CONTROL ──────────────────────────────────────
Rel(core, repo, "Commits changes\n(optional audit trail)", "Git")

' ─── NOTES ───────────────────────────────────────────────────────
note top of core
  **Four-Pillar Pipeline**
  ┌─────────────────────────────────────┐
  │ 1. Definition Engine (Creator)     │
  │    ID generation, prose drafting   │
  │                                     │
  │ 2. Maintenance Engine (Curator)    │
  │    CRUD, SemVer bumping, deprecation│
  │                                     │
  │ 3. Mechanical Linting (Inspector)  │
  │    Syntax, schema, contamination   │
  │    Hard Fail on violations         │
  │                                     │
  │ 4. Reasoning Engine (Arbiter)      │
  │    Conflicts, priority, redundancy │
  │    Soft Warnings with suggestions  │
  └─────────────────────────────────────┘
end note

@enduml
