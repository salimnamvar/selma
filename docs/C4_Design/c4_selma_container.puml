@startuml c4_selma_container
' ============================================================
' Title:     Selma — Container Diagram
' Boundary:  Selma Universal Rule Governance Engine
' Purpose:   Show Selma's single deployable container,
'            external systems, and configuration data
' Milestone: v1.0
' Version:   1.1.0 (C4-compliant)
' Source:    contracts/SPECIFICATION.md
' ============================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!include common/c4_styles.puml
skinparam linetype polyline

title Selma — Container Diagram (C4-compliant)

' ── Actors ──
Person(admin, "Rule Administrator", "Human authoring and maintaining rule sets", $sprite="person")
Person(agent, "AI Agent", "Autonomous agent that submits NL requests", $sprite="person")
Person(developer, "Domain Developer", "Builds downstream services that consume rules", $sprite="person")

' ── Selma System Boundary ──
System_Boundary(selma_boundary, "Selma") {

    ' ── SINGLE CONTAINER: Web Application ──
    Container(web, "Web Application", "Python / FastAPI", "REST API + Core Engine (Definition, Maintenance, Linting, Reasoning, Steward)", $tags="container")

    ' ── CONFIGURATION DATA (not deployable, bundled at build time) ──
    Container(config, "Configuration", "YAML / JSON", "policy_doctrine.yaml & rule_schema.json (loaded at startup)", $tags="datastore")
}

' ── External Systems ──
System_Ext(llm, "LLM Service", "OpenAI / Anthropic", $tags="external")
System_Ext(fs, "Rule Storage", "File System (./domains/)", $tags="external")
System_Ext(repo, "Git Repository", "Optional version control", $tags="external")

' ── Actor → Web ──
Rel(admin, web, "→ CRUD, validate, query rules", "HTTPS")
Rel(agent, web, "→ submit NL requests", "HTTPS")
Rel(developer, web, "→ fetch rules, export domains", "HTTPS")

' ── Web → Configuration (read-only at startup) ──
Rel(web, config, "→ reads contracts at startup", "I/O")

' ── Web → External Systems ──
Rel(web, llm, "→ calls for rule generation and reasoning", "HTTPS")
Rel(web, fs, "→ reads/writes per-domain policy.md and rules.yaml", "I/O")
Rel(web, repo, "→ commits changes (optional)", "Git")

$selma_legend_container()

@enduml
