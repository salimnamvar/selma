@startuml c4_selma_container
' ============================================================
' Title:     Selma — Container Diagram
' Boundary:  Selma Universal Rule Governance Engine
' Purpose:   Show Selma's internal containers, the dual-contract
'            files, and the four-pillar pipeline
' Milestone: v1.0
' Version:   1.0.0
' Source:    contracts/SPECIFICATION.md
' ============================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Container.puml
!include common/c4_styles.puml
skinparam linetype polyline

title Selma — Container Diagram

' ── Actors ──
Person(admin, "Rule Administrator", "Human authoring and maintaining rule sets", $sprite="person")
Person(agent, "AI Agent", "Autonomous agent that orchestrates the four-pillar pipeline", $sprite="person")
Person(developer, "Domain Developer", "Builds downstream services that consume rules", $sprite="person")

' ── Selma System Boundary ──
System_Boundary(selma_boundary, "Selma") {

    ' ── API Layer ──
    Container(api, "Web API", "Python / FastAPI", "REST endpoints for CRUD, validation, and queries", $tags="controller")

    ' ── Core Engine (Four Pillars) ──
    Container(core, "Core Engine", "Python", "Four-pillar pipeline orchestrated by Steward Agent", $tags="service")

    ' ── Contracts (Dual-Contract Bond) ──
    Container(policy_contract, "Policy Doctrine", "YAML", "Human lens: prose structure, governance, writing principles", $tags="contract")
    Container(rule_contract, "Rule Schema", "JSON", "Machine lens: data structure, lifecycle, parameters, conditions", $tags="contract")

    ' ── Storage ──
    Container(storage, "Rule Storage", "File System", "Per-domain policy.md and rules.yaml", $tags="repository")

    ' ── LLM Integration ──
    Container(llm_adapter, "LLM Adapter", "Python", "LLM API communication with retry and fallback", $tags="repository")
}

' ── External Systems ──
System_Ext(llm, "LLM Service", "OpenAI / Anthropic", $tags="external")
System_Ext(repo, "Git Repository", "Optional version control", $tags="external")

' ── Actor → API ──
Rel(admin, api, "→ CRUD, validate, query rules", "HTTPS")
Rel(agent, api, "→ submit NL requests, fetch domain state", "HTTPS")
Rel(developer, api, "→ fetch rules, export domains", "HTTPS")

' ── API → Core ──
Rel(api, core, "→ dispatches requests to four-pillar pipeline")

' ── Core → Contracts ──
Rel(core, policy_contract, "→ reads writing principles, validates policy structure")
Rel(core, rule_contract, "→ reads schema, validates rules")

' ── Core → Storage ──
Rel(core, storage, "→ reads and writes per-domain policy.md and rules.yaml")

' ── Core → LLM ──
Rel(core, llm_adapter, "→ delegates AI rule generation and deep reasoning")
Rel(llm_adapter, llm, "→ calls LLM API", "HTTPS")

' ── Core → Version Control ──
Rel(core, repo, "→ commits changes", "Git")

$selma_legend_container()

@enduml
