' ============================================================
' Title:     Selma C4 - Apply Shared Styles
' Purpose:  Unified palette for all C4 levels.
'           Internal elements: solid borders, vibrant colors.
'           External elements: dashed borders, muted distinct colors.
'           Each entity type has its own external color.
' Version:  1.0.0
' Source:   docs/C4_Design/common/c4_styles.puml
' Ref:      https://github.com/plantuml-stdlib/C4-PlantUML
' ============================================================

' ---------------------------------------------------------------
' Element Tags - Internal (solid borders, Selma-owned)
' ---------------------------------------------------------------

' Person
AddElementTag("person", $bgColor="#08427B", $fontColor="#FFFFFF", $borderColor="#073B6F", $legendText="Person")

' System
AddElementTag("system", $bgColor="#1168BD", $fontColor="#FFFFFF", $borderColor="#3C7FC0", $legendText="System")

' Container
AddElementTag("container", $bgColor="#438DD5", $fontColor="#FFFFFF", $borderColor="#3C7FC0", $legendText="Container")

' Backend Container
AddElementTag("backend_container", $bgColor="#438DD5", $fontColor="#FFFFFF", $borderColor="#3C7FC0", $legendText="Backend Container")

' Client Container (product UI)
AddElementTag("client_container", $bgColor="#E8EAF6", $fontColor="#1A237E", $borderColor="#3949AB", $legendText="Client Container")

' Contract Container
AddElementTag("contract", $bgColor="#FFF8E1", $fontColor="#E65100", $borderColor="#FFB300", $legendText="Contract")

' Interface
AddElementTag("interface", $bgColor="#5C6BC0", $fontColor="#FFFFFF", $borderColor="#3949AB", $legendText="Interface")

' Database / Datastore
AddElementTag("datastore", $bgColor="#FFFDE7", $fontColor="#F57F17", $borderColor="#F9A825", $legendText="Database")

' Component
AddElementTag("component", $bgColor="#85BBF0", $fontColor="#000000", $borderColor="#78A8D8", $legendText="Component")

' Controller
AddElementTag("controller", $bgColor="#E3F2FD", $fontColor="#0D47A1", $borderColor="#1565C0", $legendText="Controller")

' Service
AddElementTag("service", $bgColor="#FFF3E0", $fontColor="#BF360C", $borderColor="#E65100", $legendText="Service")

' Repository
AddElementTag("repository", $bgColor="#E8F5E9", $fontColor="#1B5E20", $borderColor="#2E7D32", $legendText="Repository")

' Infrastructure
AddElementTag("infrastructure", $bgColor="#E8F5E9", $fontColor="#1B5E20", $borderColor="#2E7D32", $legendText="Infrastructure")

' ---------------------------------------------------------------
' Element Tags - External (dashed borders, outside Selma ownership)
' ---------------------------------------------------------------

' External Person
AddElementTag("external_person", $bgColor="#686868", $fontColor="#FFFFFF", $borderColor="#8A8A8A", $borderStyle="dashed", $legendText="External Person")

' External System
AddElementTag("external_system", $bgColor="#999999", $fontColor="#FFFFFF", $borderColor="#8A8A8A", $borderStyle="dashed", $legendText="External System")

' External Container
AddElementTag("external_container", $bgColor="#B3B3B3", $fontColor="#FFFFFF", $borderColor="#A6A6A6", $borderStyle="dashed", $legendText="External Container")

' External Database
AddElementTag("external_datastore", $bgColor="#FFF9C4", $fontColor="#F57F17", $borderColor="#FBC02D", $borderStyle="dashed", $legendText="External Database")

' ---------------------------------------------------------------
' Legacy tag - kept for backward compatibility
' ---------------------------------------------------------------
AddElementTag("external", $bgColor="#999999", $fontColor="#FFFFFF", $borderColor="#8A8A8A", $borderStyle="dashed", $legendText="External System")

' ---------------------------------------------------------------
' Relationship Tags
' ---------------------------------------------------------------

' Synchronous (solid blue line)
AddRelTag("sync", $textColor="#1565C0", $lineColor="#1565C0", $legendText="Synchronous")

' Asynchronous (dotted orange line)
AddRelTag("async", $textColor="#E65100", $lineColor="#E65100", $legendText="Asynchronous", $lineStyle=DottedLine())

' ---------------------------------------------------------------
' Legend styling
' ---------------------------------------------------------------

skinparam legendFontColor #000000
skinparam legendBackgroundColor #FFFFFF

' ---------------------------------------------------------------
' Boundary layer stereotypes
' ---------------------------------------------------------------

skinparam rectangle<<controller>> {
    BackgroundColor<<controller>> #E3F2FD
    BorderColor<<controller>> #1565C0
    FontColor<<controller>> #0D47A1
}

skinparam rectangle<<service>> {
    BackgroundColor<<service>> #FFF3E0
    BorderColor<<service>> #E65100
    FontColor<<service>> #BF360C
}

skinparam rectangle<<repository>> {
    BackgroundColor<<repository>> #E8F5E9
    BorderColor<<repository>> #2E7D32
    FontColor<<repository>> #1B5E20
}

skinparam rectangle<<infrastructure>> {
    BackgroundColor<<infrastructure>> #E8F5E9
    BorderColor<<infrastructure>> #2E7D32
    FontColor<<infrastructure>> #1B5E20
}

skinparam rectangle<<contract>> {
    BackgroundColor<<contract>> #FFF8E1
    BorderColor<<contract>> #FFB300
    FontColor<<contract>> #E65100
}

skinparam database<<datastore>> {
    BackgroundColor<<datastore>> #FFFDE7
    BorderColor<<datastore>> #F9A825
    FontColor<<datastore>> #F57F17
}

' ---------------------------------------------------------------
' Legend Procedures
' ---------------------------------------------------------------

!procedure $selma_legend_context()
legend right
    |= <color:#000000>Symbol |= <color:#000000>Meaning |
    |<#08427B> <color:#FFFFFF>**Person**</color> | <color:#000000>Rule Administrator, AI Steward, Domain Developer</color> |
    |<#1168BD> <color:#FFFFFF>**System**</color> | <color:#000000>Selma</color> |
    |<#999999> <color:#FFFFFF>**External System**</color> | <color:#000000>LLM Service, File System, Git Repository</color> |
    |<color:#1565C0> --- </color> | <color:#000000>Synchronous</color> |
    |<color:#E65100> ... </color> | <color:#000000>Asynchronous</color> |
end legend
!endprocedure

!procedure $selma_legend_container()
legend right
