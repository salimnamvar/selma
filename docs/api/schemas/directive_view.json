{
  "title": "DirectiveView",
  "description": "Dual-document directive resource (directives_application \u2192 directives_repository \u2192 directives_store). Schema: docs/spec/contracts/directive/lifecycle.yaml, identity.yaml, and data_stores/directives_store.yaml. Executable rule (rule_schema) + policy doctrine (policy_doctrine) co-versioned. Only the executable compiles into CG-IR; doctrine is guidance_only after findings exist.",
  "type": "object",
  "required": [
    "lineage_id",
    "execution_id",
    "status",
    "revision",
    "executable_document",
    "policy_doctrine_document",
    "paired_policy_ref",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "lineage_id": {
      "type": "string",
      "description": "Immutable lineage root identifier. Never changes across revisions, forks, merges, or splits. Assigned once at creation from Machine ID.",
      "pattern": "^[A-Z]{2,5}\\d{3}[A-Z]?$",
      "example": "SC101"
    },
    "execution_id": {
      "type": "string",
      "description": "Active node identity for CG-IR compilation and runtime evaluation. Changes on fork, merge, or split. On first creation equals lineage_id.",
      "pattern": "^[A-Z][A-Z0-9]+(-[0-9]+(-[A-Z0-9]+)*)?$",
      "example": "SC101"
    },
    "status": {
      "type": "string",
      "description": "Lifecycle state of the directive. Per directive/lifecycle.yaml: draft \u2192 active \u2192 deprecated|superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ]
    },
    "revision": {
      "type": "integer",
      "description": "Monotonically increasing revision counter. Incremented on each content modification.",
      "minimum": 1
    },
    "executable_document": {
      "type": "object",
      "description": "Executable rule document. Conforms to rule_schema.json. Compile-time evaluation source only.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Rule execution ID (same as execution_id at root creation)."
        },
        "lineage_id": {
          "type": "string",
          "description": "Lineage ID reference."
        },
        "name": {
          "type": "string",
          "description": "Human-readable rule name."
        },
        "description": {
          "type": "string",
          "description": "Rule description and rationale."
        },
        "type": {
          "type": "string",
          "description": "Deontic modality type.",
          "enum": [
            "obligation",
            "prohibition",
            "permission"
          ]
        },
        "severity_default": {
          "type": "string",
          "description": "Default severity for Fail outcomes.",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "detection": {
          "type": "object",
          "description": "Detection strategy and adapter configuration.",
          "additionalProperties": true
        },
        "scope": {
          "type": "object",
          "description": "Applicability scope for control selection.",
          "properties": {
            "target_type": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "domain": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "jurisdiction": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "conflicts_with": {
          "type": "array",
          "description": "Declared conflict pairs (compile-time only).",
          "items": {
            "type": "string"
          }
        },
        "depends_on": {
          "type": "array",
          "description": "Execution IDs of directives this directive depends on.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "policy_doctrine_document": {
      "type": "object",
      "description": "Paired policy doctrine document. Conforms to policy_doctrine.yaml structure. Stored in directives with the executable document; guidance_only after findings_application (never evaluation/FSM).",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Directive metadata including lifecycle operation provenance.",
      "properties": {
        "created_by": {
          "type": "string",
          "description": "Actor ID of the directive author."
        },
        "migration": {
          "type": "object",
          "description": "Migration metadata for superseded or merged directives.",
          "properties": {
            "superseded_by": {
              "type": "string",
              "description": "Execution ID of the successor directive (for superseded status)."
            },
            "merge_provenance": {
              "type": "array",
              "description": "Source lineage IDs for merge operations.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "parent_lineage_ids": {
          "type": "array",
          "description": "Parent lineage IDs from fork/merge/split operations.",
          "items": {
            "type": "string"
          }
        },
        "parent_execution_ids": {
          "type": "array",
          "description": "Parent execution IDs from fork/merge/split operations.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Directive creation timestamp (ISO 8601, UTC). Frozen into CG-IR node_body for conflict resolution determinism."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of most recent modification (ISO 8601, UTC)."
    },
    "_links": {
      "type": "object",
      "description": "HATEOAS navigation links.",
      "properties": {
        "self": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            }
          }
        },
        "revisions": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            }
          }
        },
        "compilations": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            }
          }
        },
        "latest_revision": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "example": {
    "lineage_id": "SC101",
    "execution_id": "SC101",
    "status": "active",
    "revision": 3,
    "executable_document": {
      "id": "SC101",
      "lineage_id": "SC101",
      "name": "Parameterized Queries",
      "description": "All database queries MUST use parameterized query mechanisms. String interpolation in SQL construction is prohibited.",
      "type": "obligation",
      "severity_default": "high",
      "detection": {
        "strategy": "pattern",
        "pattern_spec": {
          "language": "python",
          "patterns": [
            "f\".*SELECT.*",
            "f\".*INSERT.*",
            "f\".*UPDATE.*",
            "f\".*DELETE.*"
          ]
        }
      },
      "scope": {
        "target_type": [
          "text"
        ],
        "domain": [
          "security"
        ],
        "jurisdiction": [
          "any"
        ],
        "conflicts_with": [],
        "depends_on": []
      }
    },
    "policy_doctrine_document": {
      "doctrine": {
        "name": "sc101_parameterized_queries",
        "version": "1.0.0"
      },
      "guidance": {
        "reasoning": "String interpolation in SQL enables injection attacks.",
        "remediation_strategy": "Use parameterized queries for all database interactions"
      }
    },
    "paired_policy_ref": "sc101_parameterized_queries",
    "metadata": {
      "created_by": "user:alice",
      "migration": {}
    },
    "created_at": "2024-06-01T00:00:00Z",
    "updated_at": "2025-01-10T14:30:00Z",
    "_links": {
      "self": {
        "href": "/directives/SC101"
      },
      "revisions": {
        "href": "/directives/SC101/revisions"
      },
      "compilations": {
        "href": "/directives/SC101/compilations"
      },
      "latest_revision": {
        "href": "/directives/SC101/revisions/3"
      }
    }
  }
}
