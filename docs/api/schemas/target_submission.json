{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://selma.dev/schemas/target_submission.json",
  "title": "TargetSubmission",
  "description": "Payload for submitting a target for inspection. Conforms to the inspection pipeline contract (docs/spec/contracts/inspection/pipeline.yaml).",
  "type": "object",
  "required": ["target_id", "target_type", "target_data"],
  "properties": {
    "target_id": {
      "type": "string",
      "description": "Unique identifier for the target being inspected.",
      "minLength": 1,
      "examples": ["tgt_001", "file:src/auth/login.py"]
    },
    "target_type": {
      "type": "string",
      "description": "Classification of the target content. Determines evaluation strategy.",
      "enum": ["text", "structured", "binary"],
      "examples": ["text"]
    },
    "target_data": {
      "type": "object",
      "description": "The actual content to inspect. Structure depends on target_type.",
      "properties": {
        "content": {
          "type": "string",
          "description": "Inline content for text targets."
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 hash of the content for integrity verification.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "description": "URI reference for binary or externally-stored targets."
        },
        "fields": {
          "type": "object",
          "description": "Structured field map for structured targets.",
          "additionalProperties": true
        }
      },
      "required": ["content_hash"],
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the target. Used for scope matching during control selection.",
      "properties": {
        "domain": {
          "type": "string",
          "description": "Domain classification (e.g. 'finance', 'healthcare')."
        },
        "jurisdiction": {
          "type": "string",
          "description": "Regulatory jurisdiction (e.g. 'EU', 'US-CA')."
        },
        "format": {
          "type": "string",
          "description": "Content format hint (e.g. 'python', 'json', 'yaml')."
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of submission."
        },
        "submitted_by": {
          "type": "string",
          "description": "Actor ID of the submitter."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "target_id": "src/auth/login.py",
      "target_type": "text",
      "target_data": {
        "content": "def login(username, password):\n    query = f\"SELECT * FROM users WHERE name='{username}'\"\n    return db.execute(query)\n",
        "content_hash": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
      },
      "metadata": {
        "domain": "security",
        "format": "python",
        "submitted_at": "2025-01-15T10:30:00Z",
        "submitted_by": "user:alice"
      }
    }
  ]
}
