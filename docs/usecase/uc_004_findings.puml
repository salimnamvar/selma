@startuml uc_004_findings
' ============================================================
' Title:     UC-004 Findings
' Source:    docs/spec/contracts/finding_lifecycle/
' C4:        findings_application
' Package:   findings_application
' Contract:  docs/standards/VERSION ============================================================
!include common/uc_styles.puml
!include common/uc_identities.puml

title $TITLE_FINDINGS

left to right direction

actor "$ACTOR_REGULATORY_OFFICIAL" as ACTOR_RO $CA_FILL_ACTOR
actor "$ACTOR_COMPLIANCE_REPRESENTATIVE" as ACTOR_CR $CA_FILL_ACTOR
actor "$ACTOR_SYSTEM" as ACTOR_SYS $CA_FILL_EXTERNAL

rectangle "$GRP_APPLICATION_LAYER" as SYS $UC_PKG_APPLICATION {
  !include common/uc_section_findings.puml
}

' System opens findings from inspection pipeline
ACTOR_SYS --> UC_FIND_OPEN

' Both C4 persons read findings
ACTOR_RO --> UC_FIND_GET
ACTOR_RO --> UC_FIND_LIST
ACTOR_CR --> UC_FIND_GET
ACTOR_CR --> UC_FIND_LIST

' Regulatory Official: dispositions via TransitionFinding
ACTOR_RO --> UC_FIND_TRANS
ACTOR_RO --> UC_FIND_CONFLICT

' Compliance Representative: evidence and acknowledge path
ACTOR_CR --> UC_FIND_TRANS
ACTOR_CR --> UC_FIND_EVID

' Read models
ACTOR_RO --> UC_FIND_GUIDE
ACTOR_RO --> UC_FIND_AGGR
ACTOR_CR --> UC_FIND_GUIDE
ACTOR_CR --> UC_FIND_AGGR

footer $FOOTER_FINDINGS

@enduml
