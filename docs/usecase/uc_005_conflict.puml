@startuml uc_005_conflict
' ============================================================
' Title:     UC-005 Conflict
' Source:    docs/spec/contracts/conflict/
' C4:        ResolveConflict (domain · not peer)
' Package:   conflicts_domain · findings_application
' Contract:  1.2.0
' ============================================================
!include common/uc_styles.puml
!include common/uc_identities.puml

title $TITLE_CONFLICT

left to right direction

!include common/uc_section_actors.puml

rectangle "$PKG_SYSTEM_BOUNDARY" as SYS $UC_PKG_APPLICATION {
  !include common/uc_section_conflict.puml
}

' Domain ResolveConflict invoked by compile / inspect pipelines (system)
ACTOR_SYS --> UC_CON_RESOLVE

' Human review of escalated conflict artifacts
ACTOR_RO --> UC_FIND_CONFLICT

footer $FOOTER_CONFLICT

@enduml
