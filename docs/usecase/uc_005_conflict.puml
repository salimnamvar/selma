@startuml uc_005_conflict
' ============================================================
' Title:     UC-005 Conflict
' Source:    docs/spec/contracts/conflict/
' C4:        ResolveConflict (domain · not peer)
' Contract:  1.1.0
' ============================================================
!include common/uc_styles.puml

title **UC-005 — Conflict Resolution**\n(Domain service ResolveConflict · not a C4 peer)\nUsed by compilation_application / inspections_application

left to right direction

actor "Regulatory\nOfficial" as RO #E3F2FD

rectangle "Selma Application" as SYS {
  rectangle "Conflict (domain service + artifacts)" as BOUNDED {

    usecase "Detect Conflict"                as UC1
    usecase "Resolve Conflict\n(deterministic)" as UC2
    usecase "Escalate to\nHuman Review"      as UC3
    usecase "Review Conflict\nArtifact"      as UC4
  }
}

' ---- associations ----
RO --> UC4

UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<extend>>
UC3 ..> UC4 : <<include>>

' ---- notes ----
note right of UC1
  **Pre:** Multiple directives or rules overlap
  on the same target scope
  **Post:** Conflict artifact may be written
  to artifacts_store (kind=conflict)
  **Contract:** conflict/detection.yaml
  **C4:** not a freestanding conflict engine
end note

note right of UC2
  **Pre:** Conflict detected, strategy available
  **Post:** Deterministic precedence applied
  (in-process during compile/inspect)
  **Contract:** conflict/precedence.yaml
end note

note bottom of UC3
  **Pre:** Deterministic resolution not possible
  **Post:** Artifact escalated; human review via
  POST /artifacts/{id}/resolutions
  [capability conflict.resolve]
  **Contract:** conflict/precedence.yaml
end note

@enduml
