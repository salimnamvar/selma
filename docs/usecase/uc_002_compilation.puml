@startuml uc_002_compilation
' ============================================================
' Title:     UC-002 Compilation
' Source:    docs/spec/contracts/compilation/
' C4:        compilation_application
' Package:   compiled_rules_application
' Contract:  1.2.0
' ============================================================
!include common/uc_styles.puml
!include common/uc_identities.puml

title $TITLE_COMPILATION

left to right direction

actor "$ACTOR_REGULATORY_OFFICIAL" as ACTOR_RO $CA_FILL_ACTOR
actor "$ACTOR_SYSTEM" as ACTOR_SYS $CA_FILL_EXTERNAL

rectangle "$GRP_APPLICATION_LAYER" as SYS $UC_PKG_APPLICATION {
  !include common/uc_section_compilation.puml
}

' Regulatory Official changes that enqueue compile (indirect trigger)
ACTOR_RO --> UC_CR_COMPILE

' Outbox drain and automated compile are system-driven
ACTOR_SYS --> UC_CR_DRAIN
ACTOR_SYS --> UC_CR_COMPILE

footer $FOOTER_COMPILATION

@enduml
