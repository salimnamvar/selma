@startuml uc_006_authorization
' ============================================================
' Title:     UC-006 Authorization
' Source:    docs/spec/contracts/authorization/
' C4:        api
' Package:   rest_interface
' Contract:  1.2.0
' ============================================================
!include common/uc_styles.puml
!include common/uc_identities.puml

title $TITLE_AUTHORIZATION

left to right direction

actor "$ACTOR_REGULATORY_OFFICIAL" as ACTOR_RO $CA_FILL_ACTOR
actor "$ACTOR_COMPLIANCE_REPRESENTATIVE" as ACTOR_CR $CA_FILL_ACTOR

rectangle "$PKG_SYSTEM_BOUNDARY" as SYS $UC_PKG_APPLICATION {
  !include common/uc_section_authorization.puml
}

ACTOR_RO --> UC_AUTH_AUTHN
ACTOR_CR --> UC_AUTH_AUTHN
ACTOR_RO --> UC_AUTH_CHECK
ACTOR_CR --> UC_AUTH_CHECK

footer $FOOTER_AUTHORIZATION

@enduml
