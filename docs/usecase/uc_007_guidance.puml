@startuml uc_007_guidance
' ============================================================
' Title:     UC-007 Guidance
' Source:    docs/schema/policy_doctrine.yaml
' C4:        findings_application
' Package:   findings_application
' Contract:  1.3.0
' ============================================================
!include common/uc_styles.puml
!include common/uc_identities.puml

title $TITLE_GUIDANCE

left to right direction

actor "$ACTOR_REGULATORY_OFFICIAL" as ACTOR_RO $CA_FILL_ACTOR
actor "$ACTOR_COMPLIANCE_REPRESENTATIVE" as ACTOR_CR $CA_FILL_ACTOR

rectangle "$GRP_APPLICATION_LAYER" as SYS $UC_PKG_APPLICATION {
  !include common/uc_section_guidance.puml
}

ACTOR_RO --> UC_FIND_GUIDE
ACTOR_RO --> UC_FIND_AGGR
ACTOR_CR --> UC_FIND_GUIDE
ACTOR_CR --> UC_FIND_AGGR

footer $FOOTER_GUIDANCE

@enduml
