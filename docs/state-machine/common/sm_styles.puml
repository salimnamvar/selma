' ============================================================
' Selma — Shared State Machine Theme
' Contract: docs/spec/contracts/ 1.0.0
' Usage:    !include ./common/sm_styles.puml
'
' Governance:
'   Doctrine:      .nasim/rules/state-machine-policy-doctrine.md
'   Specification: .nasim/rules/state-machine-specification.md
'   Notation:      .nasim/rules/state-machine-notation.md
'
' Notes are FORBIDDEN in state-machine .puml files (project rule).
' STM-036 invariants live in diagram headers + README companion.
' ============================================================

skinparam defaultFontName       "Arial"
skinparam defaultFontSize       11
skinparam stateFontSize         11
skinparam transitionFontSize    9
skinparam defaultTextAlignment  center
skinparam shadowing             false
skinparam roundCorner           8
skinparam handwritten           false
skinparam backgroundColor       #FAFBFC
skinparam titleFontSize         16
skinparam titleFontStyle        bold
skinparam titleFontColor        #1A2332

' Semantic palette:
'   Persisted / stable     blue       #3B7DD8
'   In-flight / system     teal       #1B7A6E
'   Terminal / sink        dark grey  #4A4A4A
'   Error / deny           red        #A93226
'   Pending human          amber      #B9770E
'   Resolved positive      green      #2C6E49
'
' Notes are FORBIDDEN in state-machine diagrams (§0.1).
' Do not reintroduce skinparam note or note blocks.

skinparam state {
  BorderColor                #2C3E50
  FontColor                  #FFFFFF
  BackgroundColor            #3B7DD8
  BorderThickness            2
  FontStyle                  bold
  StartColor                 #1B7A6E
  EndColor                   #4A4A4A
  ArrowColor                 #34495E
  ArrowThickness             2
}

skinparam nodesep            50
skinparam ranksep            60
skinparam linetype           polyline
