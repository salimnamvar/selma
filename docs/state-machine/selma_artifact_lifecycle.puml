@startuml selma_artifact_lifecycle
' ============================================================
' Selma — Artifact Lifecycle State Machine
' Source:  docs/spec/contracts/data_stores/
' C4:      Snapshots Adapter → artifact_store → audit_platform
'          Compiled Rules Adapter → cgir_store (CG-IR snapshots)
'          Findings & Audit Trail Adapter → event_store (events)
' Contract: 1.0.0
' ============================================================

title Selma — Artifact Lifecycle FSM\n<size:12><i>Immutable creation · orthogonal reference ‖ replication · no silent rewrite</i></size>

!include ./common/sm_styles.puml

[*] --> Building : <b>ArtifactBuildStarted</b>\nactor: System (producer)\ncommand: begin artifact build\nproducers: Hermetic Compiler | Rule Inspector |\nConflict Resolver | Architectural Auditor | Lifecycle Finder

state "Building" as Building #B9770E : **entry** transient workspace\n**allowed** compute hashes · validate\n**forbidden** durable truth claim\n**not** durable until Published
state "Validated" as Validated #1B7A6E : **entry** integrity checks OK\nhashes computed\n**allowed** CAS put / write-once\n**forbidden** skip integrity
state "Rejected\nBuild" as RejectedBuild #A93226 : **entry** validation failed **terminal**\n**allowed** producer retry as new build\n**forbidden** durable artifact

' ---------- Orthogonal: reference lifecycle ‖ audit replication ----------
state "Durable Artifact" as Durable #2C6E49 {
  state "Reference Region" as RefRegion {
    [*] --> Published
    state "Published" as Published #2C6E49 : **entry** content-addressed or write-once committed\n**allowed** pin · consumers\n**forbidden** in-place update · delete CG-IR/events
    state "Active\nReference" as ActiveReference #3B7DD8 : **entry** referenced by inspections\nor human workflows\n**allowed** supersede selection\n**forbidden** mutate bytes
    state "Superseded\nReference" as SupersededReference #4A4A4A : **entry** newer snapshot supersedes selection\nold bytes remain\n**allowed** archive · audit read\n**forbidden** rewrite content

    Published --> ActiveReference : <b>ArtifactReferenced</b>\nactor: System | human workflow\ncommand: reference artifact
    ActiveReference --> SupersededReference : <b>ArtifactSuperseded</b>\nactor: System\ncommand: newer CG-IR / new inspection wins selection
  }
  --
  state "Replication Region" as ReplRegion {
    [*] --> NotReplicated
    state "Not\nReplicated" as NotReplicated #B9770E : **entry** no audit_platform copy yet\n**allowed** async replicate\n**forbidden** claim replica exists
    state "Replicated" as Replicated #2C6E49 : **entry** audit_platform append-only copy\n**allowed** retain\n**forbidden** mutate replica as source of truth rewrite

    NotReplicated --> Replicated : <b>ArtifactReplicated</b>\nactor: System\ncommand: append-only copy to audit_platform
  }
}

state "Archived" as Archived #4A4A4A : **entry** long-term retention **terminal**\n**allowed** read-only · audit_platform copy\n**forbidden** delete before retention policy

Building --> Validated : <b>ArtifactValidated</b>\nactor: System\ncommand: validate hashes / schema
Building --> RejectedBuild : <b>ArtifactBuildRejected</b>\nactor: System\n/ noDurableArtifact()
RejectedBuild --> [*] : <b>Finalized</b>\nactor: System

Validated --> Durable : <b>ArtifactPublished</b>\nactor: System (adapter)\ncommand: content-addressed publish\n[identicalContentIdempotentSameHash]

' Exit composite when reference region reaches retention
SupersededReference --> Archived : <b>ArtifactArchived</b>\nactor: System\ncommand: apply retention (§3.5 defaults)

Archived --> [*] : <b>Finalized</b>\nactor: System

@enduml
