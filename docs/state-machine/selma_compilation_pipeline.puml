@startuml selma_compilation_pipeline
' ============================================================
' Selma — Hermetic Compilation / CG-IR Pipeline
' Source:  docs/spec/contracts/compilation/pipeline.yaml
'          docs/spec/contracts/compilation/hermetic_boundary.yaml
' C4:      Hermetic Compiler → Compiled Rules Adapter → compiled_rules
' Contract: 1.0.0
' ============================================================

title Selma — Hermetic Compilation / CG-IR Pipeline\n<size:12><i>Hierarchical validate → materialize · all-or-nothing CAS · no runtime policy</i></size>

!include ./common/sm_styles.puml

[*] --> Requested : <b>CompileRequested</b>\nactor: System | CI/CD\ncommand: directive change | scheduled compile

state "Requested" as Requested #B9770E : **entry** request_id assigned\n**allowed** dedup by (graph version + frozen_env)\n**forbidden** partial CG-IR write
state "Queued" as Queued #B9770E : **entry** FIFO queue\n**allowed** writer-preference scheduling\n**forbidden** skip lock (directives lock contract)
state "Acquire\nRead Lock" as AcquireReadLock #B9770E : **entry** seek directives read lock\n**allowed** concurrent compiles\n**forbidden** write-lock-while-awaiting-compile

' ---------- Composite: structural validation gates ----------
state "Structural Validation" as StructuralValidation #1B7A6E {
  [*] --> SchemaValidate
  state "Schema\nGate" as SchemaValidate #1B7A6E : **entry** JSON Schema Draft 2020-12\n**allowed** structural projection only\n**forbidden** skip complexity pass
  state "Complexity\nGate" as ComplexityValidate #1B7A6E : **entry** AST walk post-schema\n**allowed** depth≤32 · nodes≤256 · width≤64\nregex≤4096 · metadata≤16384 B\n**forbidden** schema-only conformance claim
  state "Portability\nGate" as PortabilityValidate #1B7A6E : **entry** RE2 · IEEE 754 finite\nUTC-Z · NFC · flags {i,m,s} only\n**forbidden** engine-specific regex
  state "Discriminator\nGate" as DiscriminatorValidate #1B7A6E : **entry** detection.strategy ↔ *_spec\nAST discriminator (compilation contract)\n**forbidden** weak if/then only
  state "Lineage DAG\nGate" as LineageValidate #1B7A6E : **entry** acyclicity · depth≤64\nparent existence · op cardinality\n**forbidden** self-reference

  SchemaValidate --> ComplexityValidate : <b>CompileGatePassed</b>\nactor: System (Hermetic Compiler)\n/ gateSchema()
  ComplexityValidate --> PortabilityValidate : <b>CompileGatePassed</b>\nactor: System\n/ gateComplexity()
  PortabilityValidate --> DiscriminatorValidate : <b>CompileGatePassed</b>\nactor: System\n/ gatePortability()
  DiscriminatorValidate --> LineageValidate : <b>CompileGatePassed</b>\nactor: System\n/ gateDiscriminator()
  LineageValidate --> [*] : <b>CompileGatePassed</b>\nactor: System\n/ gateLineage()\n/ recordLineageValidation()
}

' ---------- Composite: hash / conflict / policy materialization ----------
state "Materialize CG-IR" as MaterializeCgIr #1B7A6E {
  [*] --> HashNodes
  state "Hash Nodes" as HashNodes #1B7A6E : **entry** dual-hash model (compilation contract)\nsemantic_hash = SHA-256(semantic_body)\npresentation_hash = SHA-256(presentation_body)\nnode_hash = SHA-256({semantic, presentation})\n**allowed** reuse detection subgraph if semantic_hash match\n**forbidden** embed neighbor context · include presentation in semantic_hash
  state "Hash Edges" as HashEdges #1B7A6E : **entry** edge_hash = SHA-256(source, target)\n**allowed** directional depends_on only
  state "Conflict\nMap" as ConflictMap #1B7A6E : **entry** resolve_conflict mapping\nprecedence conflict/precedence.yaml\n**forbidden** bind cross-lineage
  state "Snapshot\nHash" as SnapshotHash #1B7A6E : **entry** cg_ir_snapshot_hash =\nSHA-256(sorted node_hashes +\nsorted edge_hashes + provenance)\n**forbidden** include compiled_at (US-CP-001)\nCAS: identical hash → dedup no-op
  state "Policy Runtime\nProhibition Assert" as PolicyAssert #1B7A6E : **entry** AA-02 path assert\n**allowed** policy absent from runtime paths\n**forbidden** load policy_doctrine.yaml

  HashNodes --> HashEdges : <b>CompileNodesHashed</b>\nactor: System
  HashEdges --> ConflictMap : <b>CompileEdgesHashed</b>\nactor: System
  ConflictMap --> SnapshotHash : <b>CompileConflictsMapped</b>\nactor: System\n/ unresolvedToConflictArtifactMeta()\n/ crossLineageAdvisoryOnly()
  SnapshotHash --> PolicyAssert : <b>CompileSnapshotHashed</b>\nactor: System
  PolicyAssert --> [*] : <b>CompileGatePassed</b>\nactor: System\n/ gateAa02()
}

state "Publish CAS" as Publish #2C6E49 : **entry** immutable snapshot write\n**allowed** dedup if hash exists\n**forbidden** in-place mutate
state "Release Lock\n(Success)" as ReleaseLockOk #2C6E49 : **entry** read lock released after publish\n**allowed** inspections may pin hash
state "Release Lock\n(Abort)" as ReleaseLockFail #A93226 : **entry** read lock released after fail\n**allowed** Directive Graph unchanged
state "Completed" as Completed #2C6E49 : **entry** snapshot live\n**allowed** pin by inspection\n**forbidden** mutate snapshot
state "Failed" as Failed #A93226 : **entry** no partial CG-IR\n**allowed** audit entry only\n**forbidden** publish · graph mutation

Requested --> Queued : <b>CompileQueued</b>\nactor: System\ncommand: schedule compile
Queued --> AcquireReadLock : <b>CompileDequeued</b>\nactor: System\ncommand: grant FIFO slot
AcquireReadLock --> StructuralValidation : <b>CompileLockAcquired</b>\nactor: System\ncommand: acquire read lock
AcquireReadLock --> Queued : <b>CompileLockDeferred</b>\nactor: System\n[writeLockHeldOrWritePending]\n/ retryFifo()

' Composite completion: all structural gates passed
StructuralValidation --> MaterializeCgIr : <b>CompileStructuralOk</b>\nactor: System
MaterializeCgIr --> Publish : <b>CompileMaterialized</b>\nactor: System

' External FAIL exits from nested gates
SchemaValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ schemaErrorNoPartialCgIr()
ComplexityValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ complexityError()
PortabilityValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ portabilityError()
DiscriminatorValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ discriminatorError()
LineageValidate --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ lineageError()
PolicyAssert --> Failed : <b>CompileGateFailed</b>\nactor: System\n/ architecturalAuditErrorAa02()

Publish --> ReleaseLockOk : <b>CgIrPublished</b>\nactor: System\ncommand: write-once publish
ReleaseLockOk --> Completed : <b>CompileLockReleased</b>\nactor: System
Completed --> [*] : <b>Finalized</b>\nactor: System

Failed --> ReleaseLockFail : <b>CompileLockReleased</b>\nactor: System
ReleaseLockFail --> [*] : <b>Finalized</b>\nactor: System

@enduml
