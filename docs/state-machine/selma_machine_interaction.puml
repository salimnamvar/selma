@startuml selma_machine_interaction
' ============================================================
' Selma — State Machine Interaction Overview
' Source:  C4 component map + docs/state-machine ownership
' Contract: 8.2.4
' Role:    Cross-machine handoff overview (not a lifecycle aggregate)
'
' Doctrine compliance (STM-034):
'   Compliance: Exploratory (overview diagram; not a single lifecycle)
'   Documentation tier: Minimal
'   Purpose: Cross-machine handoffs between catalog machines
'   Scope: Collaboration overview only — STM-010 exempt (not one lifecycle)
'   Initial: Authz (ingress)
'   Terminal: DomainUnchanged deny path; Artifact archived sink
'   Event set: MutatingRequestReceived, AuthzAllowedDirective,
'              AuthzAllowedInspection, AuthzAllowedFinding,
'              AuthzAllowedConflict, AuthzDenied,
'              CompileRequested, HashDetailEntered, HashDetailReturned,
'              CgIrPublished, DirectiveRecorded, CgIrPinned,
'              FindingsBirthed, InspectionArtifactPublished,
'              ConflictDetected, FindingEventAppended, HlcTagged,
'              ConflictArtifactPublished, CertificationArtifactPublished,
'              CertificationSamplesRead, ArtifactRetained
'   Unhandled-event policy: ignore (overview; no aggregate authority)
'   Event naming paradigm: past-tense (STM-032)
'   Key invariants: no 9th independent aggregate; detail views nest
'                   under Finding/Compilation owners
' ============================================================

title Selma — State Machine Interaction Overview\n<size:12><i>C4 handoffs · primary machines · detail views · no independent 9th aggregate</i></size>

!include ./common/sm_styles.puml

state "Capability Authorization" as Authz #B9770E : **cross-cutting**\ningress · matrix · SoD · stage\nallow | deny + audit
state "Directive Lifecycle" as Dir #2C6E49 : Draft · Active\nDeprecated · Superseded\nfork/merge/split → Draft children
state "Compilation / CG-IR" as Comp #1B7A6E : hermetic gates\nread lock · CAS publish
state "CG-IR Hash Detail" as Hash #1B7A6E : dual-hash · reuse\n(detail of Comp)
state "Inspection Execution" as Insp #1B7A6E : six pure stages\npin · evaluate · report
state "Finding Lifecycle" as Find #3B7DD8 : **normative §3.1**\n10 states · SoD · system close
state "HLC Detail" as Hlc #3B7DD8 : (pt, lc) advance\n(detail of event envelope)
state "Conflict Resolution" as Conf #1B7A6E : cascade · artifact\nbinding vs advisory
state "Architectural Certification" as Cert #B9770E : AA-01..AA-07\nCI/CD only
state "Artifact Lifecycle" as Art #4A4A4A : write-once · CAS\nreplicate · archive

[*] --> Authz : <b>MutatingRequestReceived</b>
Authz --> Dir : <b>AuthzAllowedDirective</b>\n[capability directive.*]
Authz --> Insp : <b>AuthzAllowedInspection</b>\n[capability inspection.*]
Authz --> Find : <b>AuthzAllowedFinding</b>\n[capability finding.* | evidence.*]
Authz --> Conf : <b>AuthzAllowedConflict</b>\n[capability conflict.resolve]
Authz --> [*] : <b>AuthzDenied</b>\nDomainUnchanged

Dir --> Comp : <b>CompileRequested</b>\npublish / identity op
Comp --> Hash : <b>HashDetailEntered</b>\nHash Nodes zoom
Hash --> Comp : <b>HashDetailReturned</b>\nsnapshot hash ready
Comp --> Art : <b>CgIrPublished</b>
Dir --> Art : <b>DirectiveRecorded</b>

Insp --> Comp : <b>CgIrPinned</b>\npin cg_ir_snapshot_hash
Insp --> Find : <b>FindingsBirthed</b>\nFindingCreated on Report
Insp --> Art : <b>InspectionArtifactPublished</b>\nsnapshot + trace
Insp --> Conf : <b>ConflictDetected</b>\nmulti-rule fire on frozen CG-IR

Find --> Hlc : <b>FindingEventAppended</b>\nevery success event
Hlc --> Find : <b>HlcTagged</b>\ntag logical_clock
Find --> Art : <b>FindingEventAppended</b>\nappend event_store

Conf --> Art : <b>ConflictArtifactPublished</b>
Comp --> Conf : <b>ConflictDetected</b>\ncompile-time conflict map

Cert --> Art : <b>CertificationArtifactPublished</b>
Cert --> Comp : <b>CertificationSamplesRead</b>\nread CG-IR samples
Cert --> Find : <b>CertificationSamplesRead</b>\nSoD / mediated-feedback tests\n(no production mutation)

Art --> [*] : <b>ArtifactRetained</b>\narchived / retained

@enduml
