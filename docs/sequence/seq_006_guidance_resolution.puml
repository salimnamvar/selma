@startuml seq_006_guidance_resolution
!include common/seq_styles.puml

title SEQ-006 Guidance Resolution\nResolve Paired Policy Doctrine for Finding Guidance

actor "User" as user
participant "selma_interface\n(CLI/WebApp/DesktopApp/MobileApp)" as SI #EBCB8B
participant "application_service\n(FastAPI/Pydantic)" as AS #88C0D0
participant "finding_analyzer\n(Python/Pydantic)" as FA #A3BE8C
participant "directives_adapter\n(SQLAlchemy/PostgreSQL)" as DA #D08770
database "directive_store\n(dual documents)" as DS #5E81AC

autonumber

user -> SI: request guidance for finding
activate SI

SI -> AS: GET /findings/{id}/guidance
activate AS

AS -> FA: route query(finding_id)
activate FA

group Load Finding Projection
    FA -> FA: load finding projection
    note right of FA
        Extract paired_policy_ref
        from finding record.
    end note
end

group Load Policy Doctrine (guidance_only)
    FA -> DA: readPolicyDoctrine(paired_policy_ref)
    activate DA
    DA -> DS: SELECT policy_doctrine_document\nWHERE paired_policy_ref = ?
    activate DS
    DS --> DA: doctrine document
    deactivate DS
    DA --> FA: GuidancePayload
    deactivate DA
end

group Map Guidance Components
    FA -> FA: map vocabulary (domain terms)
    FA -> FA: map remediation (action steps)
    FA -> FA: map domain_examples (reference cases)
end

FA -> FA: compose GuidanceView

FA --> AS: GuidanceView
deactivate FA

AS --> SI: guidance response
deactivate AS

SI --> user: guidance view
deactivate SI

note right of DA
    Directives Adapter is the sole
    reader of policy doctrines.
    Doctrines live with executable
    rules in directive_store — no
    filesystem PolicyDoctrineReader.
end note

note right of FA
    GuidanceView contains:
    - vocabulary mapping
    - remediation steps
    - domain examples
    - severity context
    Never used for evaluation/FSM.
end note

footer SEQ-006 | Selma Project | Guidance Resolution

@enduml
