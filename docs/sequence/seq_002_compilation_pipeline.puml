@startuml seq_002_compilation_pipeline
' ============================================================
' Title:     SEQ-002 Compilation Pipeline
' Source:    docs/spec/contracts/compilation/
' C4:        compilation_application → compiled_rules_repository
' Contract:  docs/standards/VERSION ============================================================
!include common/seq_styles.puml

title SEQ-002 Compilation Pipeline\nHermetic Compilation of Directive Graph to CG-IR

actor "Trigger" as trigger
participant "compilation_application\n(Python/JSON Schema/SHA-256)" as HC #A3BE8C
database "directives_store\n(PostgreSQL)" as DS #4C566A
participant "compiled_rules_repository\n(Python/SHA-256/CAS)" as CRA #B48EAD
database "compiled_rules_store\n(Content-Addressed Storage)" as CS #4C566A

autonumber

trigger -> HC: compile request (directive change or explicit compile)
activate HC

group Ingestion Phase
    HC -> DS: acquire read_lock(directive_set)
    note right of HC: Short read lock; release after
    materializing executables (lock-free CPU)
    activate DS
    DS --> HC: lock acquired
    deactivate DS

    HC -> DS: load directive graph
    activate DS
    DS --> HC: directive records (with lineage metadata)
    deactivate DS
end

group Validation Phase
    HC -> HC: validate identity (lineage_id integrity)
    note right of HC
        Ensure every directive has
        a valid lineage_id chain.
    end note

    HC -> HC: validate schema (JSON Schema)
    note right of HC
        Structural validation
        against directive schema.
    end note

    HC -> HC: detect strategy discriminators
    note right of HC
        Identify control/condition
        strategy patterns.
    end note

    HC -> HC: validate complexity limits
    note right of HC
        depth / nodes / width / regex
        within policy bounds.
    end note

    HC -> HC: validate portability
    note right of HC
        RE2-compatible regex,
        UTC timestamps only,
        finite numeric values.
    end note
end

group Materialization Phase
    HC -> HC: materialize CG-IR nodes
    HC -> HC: materialize CG-IR edges
    HC -> HC: compute node_hash (SHA-256)
    HC -> HC: compute edge_hash (SHA-256)
    HC -> HC: compute snapshot_hash (SHA-256)
end

group Incremental Reuse
    HC -> HC: compute dirty set from lineage changes
    note right of HC
        Only recompile subtrees
        whose directive source changed.
    end note
    HC -> HC: reuse unchanged subtrees
end

group Publication Phase
    HC -> CRA: publish immutable snapshot (CG-IR)
    activate CRA

    CRA -> CS: CAS write (deduplicate nodes)
    activate CS
    CS --> CRA: nodes stored
    deactivate CS

    CRA -> CS: CAS write (deduplicate edges)
    activate CS
    CS --> CRA: edges stored
    deactivate CS

    CRA -> CS: CAS write (snapshot reference)
    activate CS
    CS --> CRA: snapshot_id (hash-based)
    deactivate CS

    CRA --> HC: snapshot published (snapshot_id)
    deactivate CRA
end

HC -> DS: release read_lock(directive_set)
activate DS
DS --> HC: lock released
deactivate DS

HC --> trigger: compilation result (snapshot_id, diagnostics)
deactivate HC

note right of CS
    Content-Addressed Storage:
    identical nodes/edges are
    stored once, referenced by hash.
end note

footer SEQ-002 | Selma Project | Compilation Pipeline

@enduml
