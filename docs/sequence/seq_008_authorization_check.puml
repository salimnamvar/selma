@startuml seq_008_authorization_check
' ============================================================
' Title:     SEQ-008 Authorization Check
' Source:    docs/spec/contracts/authorization/
' C4:        api gate → DenialAuditPort → finding_events_repository
' Contract:  1.1.0
' ============================================================
!include common/seq_styles.puml

title SEQ-008 Authorization Check\nCapability-Based Access Control with SoD

actor "User" as user
participant "clients\n(CLI/Web/Desktop/Mobile)" as SI #EBCB8B
participant "api\n(FastAPI/Pydantic)" as AS #88C0D0
participant "finding_events_repository\n(Append-Only)" as FAA #D08770
database "finding_events_store\n(Append-Only Log)" as ES #4C566A

autonumber

user -> SI: request with credentials
activate SI

SI -> AS: REST request (with auth token)
activate AS

group Authentication
    AS -> CE: Authenticate(JWT)
    activate CE
    note right of CE
        Verify signature (JWKS), iss, aud, exp.
        Extract sub + capabilities/roles.
        See authorization.authentication.
    end note
    CE --> AS: Actor + effective capabilities
    deactivate CE
end

group Capability Check
    AS -> CE: Authorize(actor, required_capability)

    alt Capability Denied
        AS -> DAP: AppendDenial(...)
        activate DAP
        DAP -> FAA: implement DenialAuditPort
        activate FAA
        FAA -> ES: write CapabilityDenied
        activate ES
        ES --> FAA: acknowledged
        deactivate ES
        FAA --> DAP: committed
        deactivate FAA
        DAP --> AS: audited
        deactivate DAP

        AS --> SI: 403 CapabilityDenied
        SI --> user: access denied
    end
end

group Segregation of Duties Check
    AS -> CE: check SoD constraints
    note right of CE
        Verify no SoD violations:
        - creator cannot approve own work
        - author cannot waive own findings
        - conflicting role pairs enforced
    end note

    alt SoD Violation
        AS -> DAP: AppendDenial(... SoD)
        activate DAP
        DAP -> FAA: implement DenialAuditPort
        activate FAA
        FAA -> ES: write SoDDenied
        activate ES
        ES --> FAA: acknowledged
        deactivate ES
        FAA --> DAP: committed
        deactivate FAA
        DAP --> AS: audited
        deactivate DAP

        AS --> SI: 403 CapabilityDenied
        SI --> user: access denied
    end
end

== Authorized Path ==

AS -> AS: proceed with operation
note right of AS
    All authorization checks passed.
    Execute the requested operation.
end note

AS --> SI: operation result
deactivate AS

SI --> user: response
deactivate SI

note right of FAA
    All authorization decisions
    (allow and deny) are audited.
    Append-only, immutable log.
end note

footer SEQ-008 | Selma Project | Authorization Check

@enduml
