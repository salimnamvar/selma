' ============================================================
' Title:     Selma — Sequence Diagram Styles
' Purpose:   Sequence view chrome + CA MACRO colors (ca_palette).
' Contract:  docs/standards/VERSION
' Include order:
'   !include ./common/seq_styles.puml
'   !include ./common/seq_identities.puml
' ============================================================

!include ../../standards/common/ca_palette.puml

skinparam defaultFontName       "Arial"
skinparam defaultFontSize       11
skinparam shadowing             false
skinparam backgroundColor       $CA_CANVAS
skinparam titleFontSize         16
skinparam titleFontStyle        bold
skinparam titleFontColor        $CA_INK

skinparam sequence {
  ArrowColor                  $CA_ARROW
  ArrowFontColor              $CA_INK
  ArrowFontSize               10
  ArrowThickness              1.5

  LifeLineBorderColor         $CA_BORDER_INTERFACE
  LifeLineBackgroundColor     $CA_FILL_INTERFACE

  ParticipantBorderColor      $CA_BORDER_INTERFACE
  ParticipantBackgroundColor  $CA_FILL_INTERFACE
  ParticipantFontColor        $CA_INK
  ParticipantFontSize         11

  ActorBorderColor            $CA_BORDER_ACTOR
  ActorBackgroundColor        $CA_FILL_ACTOR
  ActorFontColor              $CA_INK

  GroupBorderColor            $CA_BORDER_APPLICATION
  GroupBackgroundColor        $CA_FILL_APPLICATION
  GroupFontColor              $CA_INK
  GroupHeaderFontColor        $CA_SOLID_APPLICATION

  DividerBorderColor          $CA_BORDER_NEUTRAL
  DividerBackgroundColor      $CA_LEGEND_BG
  DividerFontColor            $CA_SOLID_INTERFACE

  BoxBorderColor              $CA_BORDER_NEUTRAL
  BoxBackgroundColor          $CA_LEGEND_BG

  ReferenceBorderColor        $CA_BORDER_INTERFACE
  ReferenceBackgroundColor    $CA_FILL_INTERFACE
  ReferenceFontColor          $CA_INK
}

skinparam database {
  BackgroundColor             $CA_FILL_FRAMEWORKS
  BorderColor                 $CA_BORDER_FRAMEWORKS
  FontColor                   $CA_INK
}

skinparam footer {
  FontColor                   $CA_BORDER_NEUTRAL
  FontSize                    10
}

' MICRO aliases for sequence (no invented hex in diagram bodies)
' Bare hex (no #) for use as: participant X #$SEQ_INTERFACE
!$SEQ_ACTOR          = "E8EAF6"
!$SEQ_INTERFACE      = "E1F5FE"
!$SEQ_APPLICATION    = "E0F2F1"
!$SEQ_DOMAIN         = "F3E5F5"
!$SEQ_INFRASTRUCTURE = "FFF3E0"
!$SEQ_FRAMEWORKS     = "E8F5E9"
!$SEQ_EXTERNAL       = "ECEFF1"
!$SEQ_GATE           = "FFEBEE"
!$SEQ_HERMETIC       = "FFFDE7"
