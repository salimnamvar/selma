@startuml seq_004_finding_lifecycle
' ============================================================
' Title:     SEQ-004 Finding Lifecycle
' Source:    docs/spec/contracts/finding_lifecycle/
' C4:        findings_application → finding_events_repository
' Contract:  docs/standards/VERSION ============================================================
!include common/seq_styles.puml

title SEQ-004 Finding Lifecycle\n11-State FSM Finding State Transitions

actor "User" as user
participant "clients\n(CLI/Web/Desktop/Mobile)" as SI #EBCB8B
participant "api\n(FastAPI/Pydantic)" as AS #88C0D0
participant "findings_application\n(Python/Pydantic)" as LF #B48EAD
participant "finding_events_repository\n(Append-Only)" as FAA #D08770
database "finding_events_store\n(Append-Only Log)" as ES #4C566A

autonumber

== Auto-Transition: Created -> Open ==

LF -> LF: FindingFsm: Created -> Open
activate LF
LF -> FAA: append FindingOpened event
activate FAA
FAA -> ES: write record
activate ES
ES --> FAA: acknowledged
deactivate ES
FAA --> LF: committed
deactivate FAA
deactivate LF

== Evidence Submission Flow ==

user -> SI: submit evidence for finding
activate SI

SI -> AS: POST /findings/{id}:attachEvidence
activate AS

AS -> LF: route transition(finding_id, evidence)
activate LF

LF -> LF: FindingFsm: Acknowledged -> EvidenceSubmitted
note right of LF
  No SoD check per TR-FL-005.
  SoD-002 is enforced at approval
  time (TR-FL-007), not submission.
end note
LF -> FAA: append DispositionChanged event
activate FAA
FAA -> ES: write record
activate ES
ES --> FAA: acknowledged
deactivate ES
FAA --> LF: committed
deactivate FAA

LF -> LF: auto-transition: EvidenceSubmitted -> PendingVerification
LF -> FAA: append DispositionChanged event
activate FAA
FAA -> ES: write record
activate ES
ES --> FAA: acknowledged
deactivate ES
FAA --> LF: committed
deactivate FAA

LF --> AS: transition result
deactivate LF

AS --> SI: evidence accepted
deactivate AS

SI --> user: confirmation
deactivate SI

== Waiver Flow ==

user -> SI: waive finding
activate SI

SI -> AS: POST /findings/{id}:transitionFinding\n(action=waive)
activate AS

AS -> LF: route waive(finding_id, reason)
activate LF

group Authorization Gate
    LF -> LF: CapabilityGate.check(finding.waive)
    alt capability denied
        LF --> AS: 403 Forbidden
        AS --> SI: error response
        SI --> user: error
    end
end

group SoD Policy Check (SOD-001)
    LF -> LF: SodPolicy.creator_cannot_waive(actor, finding)
    alt SoD violation
        LF --> AS: SoD violation error
        AS --> SI: 403 Forbidden
        SI --> user: error
    end
end

LF -> LF: FindingFsm: Open|Ack|Evidence|Pending|Rejected -> Waived\n(TR-FL-004 multi-from; INV-FL-006)
LF -> LF: FindingFsm: Waived -> Closed
LF -> FAA: append FindingClosed event
activate FAA
FAA -> ES: write record
activate ES
ES --> FAA: acknowledged
deactivate ES
FAA --> LF: committed
deactivate FAA

LF --> AS: waive result
deactivate LF

AS --> SI: finding waived and closed
deactivate AS

SI --> user: confirmation
deactivate SI

note right of LF
  INV-FL-006: dismiss/waive/supersede
  from Open and all non-terminal
  remediation states so Acknowledged
  cannot permanently block closure.
end note

note right of LF
  INV-FL-020: Human-triggered FSM
  transitions and any resulting
  system-auto transitions (e.g.
  Waived→Closed) MUST be appended
  atomically in one DB transaction.
end note

note right of LF
    Finding FSM States (11):
    Created → Open → Acknowledged →
    EvidenceSubmitted → PendingVerification →
    Verified → Closed | Waived | Dismissed |
    Rejected | Superseded
end note

footer SEQ-004 | Selma Project | Finding Lifecycle

@enduml
