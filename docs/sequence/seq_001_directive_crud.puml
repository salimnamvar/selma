@startuml seq_001_directive_crud
' ============================================================
' Title:     SEQ-001 Directive CRUD
' Source:    docs/spec/contracts/directive/
' C4:        api → directives_application → directives_repository
' Contract:  docs/standards/VERSION ============================================================
!include common/seq_styles.puml

title SEQ-001 Directive CRUD\nCreate / Modify / Retire / Fork / Merge / Split / Restore

actor "User" as user
participant "clients\n(CLI/Web/Desktop/Mobile)" as SI #EBCB8B
participant "api\n(FastAPI/Pydantic)" as AS #88C0D0
participant "directives_application\n(Python/Pydantic)" as DIRAPP #A3BE8C
participant "directives_repository\n(SQLAlchemy/PostgreSQL)" as DA #81A1C1
database "directives_store\n(PostgreSQL)" as DS #4C566A
participant "compilation_application\n(Python/JSON Schema/SHA-256)" as HC #B48EAD
participant "compiled_rules_repository\n(Python/SHA-256/CAS)" as CRA #81A1C1

autonumber

user -> SI: directive operation request
activate SI

SI -> AS: REST request (create/modify/retire/fork/merge/split/restore)
activate AS

group Authorization Gate
    AS -> AS: CapabilityGate.check(required_capability)
    alt capability denied
        AS --> SI: 403 Forbidden
        SI --> user: error response
    end
end

group Directive Operation
    AS -> DIRAPP: route operation(type, payload)
    activate DIRAPP
    DIRAPP -> DA: persist dual-document directive
    activate DA

    DA -> DS: acquire write_lock(directive_id)
    activate DS
    DS --> DA: lock acquired
    deactivate DS

    group Atomic Write
        DA -> DS: execute operation (create revision)
        activate DS
        DS --> DA: operation result (revision_id)
        deactivate DS
    end

    DA -> DS: release write_lock(directive_id)
    activate DS
    DS --> DA: lock released
    deactivate DS

    DA --> DIRAPP: operation result
    deactivate DA
    DIRAPP --> AS: operation result
    deactivate DIRAPP
end

group Recompilation (outbox drain)
    note over AS, DS
      compile_request was inserted in the same DB transaction
      as the durable directive mutation (transactional outbox).
    end note
    HC -> DA: DrainOutbox / claim compile_request (lineage, revision)
    activate HC
    DA -> DS: UPDATE compile_request status=in_progress
    HC -> DA: CompilerReadPort: read executables under short read-lock
    activate DA
    DA -> DS: acquire read_lock / SELECT FOR SHARE
    activate DS
    DS --> DA: lock acquired
    deactivate DS
    DA --> HC: executable documents (materialized)
    DA -> DS: release read_lock
    activate DS
    DS --> DA: lock released
    deactivate DS
    deactivate DA

    HC -> HC: hermetic compile (lock-free CPU)
    HC -> CRA: publish CG-IR snapshot
    activate CRA
    CRA --> HC: snapshot published
    deactivate CRA
    HC -> DA: mark compile_request completed
    HC --> AS: compilation complete (or async poll via /compilations)
    deactivate HC
end

AS --> SI: response (directive_dto)
deactivate AS

SI --> user: operation result
deactivate SI

note right of DS
    All directive mutations are
    versioned revisions with
    immutable history.
end note

note right of HC
    Compilation is hermetic:
    deterministic output from
    directive state alone.
end note

footer SEQ-001 | Selma Project | Directive CRUD Lifecycle

@enduml
