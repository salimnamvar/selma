' ============================================================
' Title:     Selma — Clean Architecture color palette (SSoT)
' Purpose:   MACRO layer colors + MICRO concern colors shared by
'            C4, package, class, deployment, state, and use-case diagrams.
' Contract:  1.1.0
'
' Include:
'   !include ../../standards/common/ca_palette.puml
'
' MACRO rings use widely spaced hues (≈45–60°) so layers read
' as distinct at a glance — not tint variants of the same green/blue.
'
'   ACTORS           indigo        people
'   INTERFACE        sky cyan-blue driving adapters
'   APPLICATION      teal          use cases
'   DOMAIN           violet        enterprise entities (core)
'   INFRASTRUCTURE   vivid orange  driven adapters
'   FRAMEWORKS       forest green  stores / DB / object
'   EXTERNAL         blue-grey     outside product
'   COMPOSITION      deep indigo   main / DI (not a peer)
'
' MICRO (cross-cutting; not CA rings):
'   GATE             crimson       permission deny
'   HERMETIC         gold amber    compile-only / pure eval
'   TERMINAL         charcoal      sinks
' ============================================================

!$CA_CANVAS            = "#FAFBFC"
!$CA_INK               = "#1A2332"
!$CA_ARROW             = "#37474F"
!$CA_BORDER_NEUTRAL    = "#546E7A"
!$CA_LEGEND_BG         = "#FFFFFF"
!$CA_LEGEND_BORDER     = "#CFD8DC"

' ============================================================
' MACRO — Clean Architecture layers (high-contrast hues)
' ============================================================

' ACTORS — indigo (people)
!$CA_SOLID_ACTOR       = "#3F51B5"
!$CA_FILL_ACTOR        = "#E8EAF6"
!$CA_BORDER_ACTOR      = "#303F9F"
!$CA_PKG_ACTOR         = "#E8EAF6/3F51B5"

' INTERFACE — sky cyan-blue (driving adapters / clients / api shell)
!$CA_SOLID_INTERFACE   = "#0288D1"
!$CA_FILL_INTERFACE    = "#E1F5FE"
!$CA_BORDER_INTERFACE  = "#01579B"
!$CA_PKG_INTERFACE     = "#E1F5FE/0288D1"
!$CA_SOLID_INTERFACE_SOFT = "#4FC3F7"
!$CA_PKG_INTERFACE_NEST = "#B3E5FC/0288D1"

' APPLICATION — teal (use cases) — not forest green
!$CA_SOLID_APPLICATION = "#00897B"
!$CA_FILL_APPLICATION  = "#E0F2F1"
!$CA_BORDER_APPLICATION = "#00695C"
!$CA_PKG_APPLICATION   = "#E0F2F1/00897B"
!$CA_PKG_APPLICATION_NEST = "#B2DFDB/00897B"

' DOMAIN — violet (enterprise core) — warm vs composition indigo
!$CA_SOLID_DOMAIN      = "#7B1FA2"
!$CA_FILL_DOMAIN       = "#F3E5F5"
!$CA_BORDER_DOMAIN     = "#4A148C"
!$CA_PKG_DOMAIN        = "#F3E5F5/7B1FA2"
!$CA_PKG_DOMAIN_NEST   = "#E1BEE7/7B1FA2"

' INFRASTRUCTURE — vivid orange (driven adapters)
!$CA_SOLID_INFRASTRUCTURE = "#EF6C00"
!$CA_FILL_INFRASTRUCTURE  = "#FFF3E0"
!$CA_BORDER_INFRASTRUCTURE = "#E65100"
!$CA_PKG_INFRASTRUCTURE = "#FFF3E0/EF6C00"
!$CA_PKG_INFRASTRUCTURE_NEST = "#FFE0B2/EF6C00"

' FRAMEWORKS & DRIVERS — forest green (stores) — distinct from teal app
!$CA_SOLID_FRAMEWORKS  = "#2E7D32"
!$CA_FILL_FRAMEWORKS   = "#E8F5E9"
!$CA_BORDER_FRAMEWORKS = "#1B5E20"
!$CA_PKG_FRAMEWORKS    = "#E8F5E9/2E7D32"
!$CA_BORDER_FRAMEWORKS_DEEP = "#1B5E20"

' EXTERNAL — blue-grey (outside Selma)
!$CA_SOLID_EXTERNAL    = "#607D8B"
!$CA_FILL_EXTERNAL     = "#ECEFF1"
!$CA_BORDER_EXTERNAL   = "#455A64"
!$CA_PKG_EXTERNAL      = "#ECEFF1/607D8B"
!$CA_SOLID_EXTERNAL_PERSON = "#78909C"

' COMPOSITION — deep indigo (wiring; cooler than domain violet)
!$CA_SOLID_COMPOSITION = "#283593"
!$CA_FILL_COMPOSITION  = "#E8EAF6"
!$CA_BORDER_COMPOSITION = "#1A237E"
!$CA_PKG_COMPOSITION   = "#E8EAF6/283593"

' ============================================================
' MICRO — cross-cutting (must not collide with MACRO solids)
' ============================================================

!$CA_SOLID_GATE        = "#C62828"
!$CA_FILL_GATE         = "#FFEBEE"
!$CA_BORDER_GATE       = "#B71C1C"
!$CA_PKG_GATE          = "#FFEBEE/C62828"
!$CA_BORDER_GATE_DEEP  = "#B71C1C"

' Hermetic: gold (yellower than infrastructure orange)
!$CA_SOLID_HERMETIC    = "#F9A825"
!$CA_FILL_HERMETIC     = "#FFFDE7"
!$CA_BORDER_HERMETIC   = "#F57F17"
!$CA_PKG_HERMETIC      = "#FFFDE7/F9A825"

!$CA_SOLID_TERMINAL    = "#37474F"
!$CA_FILL_TERMINAL     = "#ECEFF1"
!$CA_BORDER_TERMINAL   = "#263238"

!$CA_SOLID_ENTITY      = "#546E7A"
!$CA_FILL_ENTITY       = "#ECEFF1"
!$CA_PKG_ENTITY        = "#ECEFF1/546E7A"

!$CA_SOLID_ASYNC       = "#0277BD"
!$CA_SOLID_MEDIATED    = "#7B1FA2"
!$CA_SOLID_IMMUTABLE   = "#2E7D32"
!$CA_SOLID_VALIDATION  = "#00897B"
!$CA_SOLID_CAPABILITY  = "#C62828"

' C4 boundaries (light tints of application / interface)
!$CA_BOUNDARY_SYSTEM_FILL    = "#E0F2F1"
!$CA_BOUNDARY_CONTAINER_FILL = "#E1F5FE"
!$CA_BOUNDARY_DEFAULT_FILL   = "#F5F7FA"
