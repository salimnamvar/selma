@startuml act_001_inspection_pipeline
' ============================================================
' Selma — ACT-001: Inspection Pipeline (Activity Diagram)
' Source:  docs/spec/contracts/inspection/pipeline.yaml
'          docs/spec/contracts/inspection/finding_contract.yaml
' C4:      inspections_application → artifacts_repository → artifacts_store
'          inspection → findings_application (finding birth)
' Contract: docs/standards/VERSION
' Six-stage pure evaluation pipeline with parallel node execution,
' typed error handling, and immutable snapshot storage.
' ============================================================

title ACT-001: Inspection Pipeline\n<size:12><i>Receive → Normalize → Classify → Select → Evaluate → Aggregate → Report</i></size>

!include common/act_styles.puml

|#E8F4F8|Submission Layer|
start
:Receive Target Submission;

:Authenticate & Check Capability\n<color:#00897B><b>inspection.submit</b></color>;

note right
  Capability enforced at ingress.
  403 on failure → no snapshot created.
end note

:Load Frozen CG-IR Snapshot;

note right
  Pins: target_hash, cg_ir_snapshot_hash,
  frozen_env_hash, engine_version
end note

|#ECEFF4|Validation|
:Parse Target Format;

:Validate Target Schema;

if (Schema Valid?) then (no)
  #C62828:Abort with Schema Error;
  stop
else (yes)
endif

:Normalize Field Names\n(NFC · UTC · IEEE 754);

|#E8F4F8|Classification|
:Determine Target Category;

:Map to Applicable Rule Sets;

|#EBCB8B|Control Selection|
:Filter CG-IR Nodes by Applicability;

:Apply Scope Matcher;

:Skip Inapplicable Nodes\n(record in skipped_nodes);

note right
  Nodes with unmet dependencies
  or outside scope are skipped,
  not failed.
end note

|#ECEFF4|Evaluation|
fork
  :Load Detection Spec;
  :Run Pure Evaluator (no I/O);
  :Record Outcome\n(pass / fail / error);
  if (Evaluation Failed?) then (fail)
    :Create Finding Draft;
  else (pass or error)
    if (Evaluation Error?) then (error)
      :Skip Node\n(record in skipped_nodes);
    else (pass)
      :Record Pass;
    endif
  endif
fork again
  :Load Detection Spec;
  :Run Pure Evaluator (no I/O);
  :Record Outcome\n(pass / fail / error);
  if (Evaluation Failed?) then (fail)
    :Create Finding Draft;
  else (pass or error)
    if (Evaluation Error?) then (error)
      :Skip Node\n(record in skipped_nodes);
    else (pass)
      :Record Pass;
    endif
  endif
fork again
  :Evaluate Additional Nodes...;
end fork

note right
  Parallel execution of
  independent CG-IR nodes.
  Topological DAG ordering
  for dependent nodes.
end note

|#E8F4F8|Aggregation|
:Collect All Findings;

:Compute Severity Rollup;

:Compute system_state_hash;

|#ECEFF4|Reporting|
fork
  :Build InspectionSnapshot;
  :Store Snapshot (immutable);
  if (Storage Succeeded?) then (no)
    :Retry with Backoff;
    note right
      Exponential backoff on
      infrastructure failure.
    end note
    :Store Snapshot (immutable);
  else (yes)
  endif
fork again
  :Emit FindingCreated Events;
end fork

note right
  Snapshot storage and event
  emission run in parallel.
end note

:Return Results;

|#E8F4F8|Outcome|
if (Skipped Nodes Present?) then (yes)
  #F9A825:Status = Partial;
else (no)
  #2E7D32:Status = Completed;
endif

stop

@enduml
