@startuml act_002_finding_disposition
' ============================================================
' Selma — ACT-002: Finding Disposition (Activity Diagram)
' Source:  docs/spec/contracts/finding_lifecycle/states.yaml
'          docs/spec/contracts/finding_lifecycle/transitions.yaml
' C4:      findings_application → Finding Events
' Contract: 1.1.0
'
' Finding lifecycle transitions driven by Regulatory Officials
' and Compliance Representatives with capability + SoD gates.
' ============================================================

title ACT-002: Finding Disposition\n<size:12><i>Created → Open → [Acknowledged | Waived | Dismissed | Superseded] → EvidenceSubmitted → PendingVerification → [Verified | Rejected] → Terminal</i></size>

!include common/act_styles.puml

|#E8F4F8|System Auto-Transition|
start
:Finding Created\n(system auto-transition to Open);

|#ECEFF4|Actor Routing|
if (Who is Acting?) then (Compliance Representative)
  :Authenticate\n<b>Compliance Representative</b>;
  if (What Action?) then (Acknowledge)
    :Check Capability\n<color:#00897B><b>finding.acknowledge</b></color>;
    note right
      No SoD check per TR-FL-002.
      Capability gate only.
    end note
    :Transition: Open → Acknowledged;
    :Append DispositionChanged Event;
  elseif (Submit Evidence) then
    :Check Capability\n<color:#00897B><b>evidence.submit</b></color>;
    note right
      No SoD check per TR-FL-005.
      SoD-002 is enforced at approval
      time (TR-FL-007), not submission.
    end note
    :Transition: Acknowledged → Evidence Submitted;
    :Auto-transition: Evidence Submitted → Pending Verification;
    :Append DispositionChanged Events;
    note right
      INV-FL-020: Auto-transition appended
      atomically with the human event
      in a single DB transaction.
    end note
  elseif (Request Reinspection) then
    :Check Capability\n<color:#00897B><b>inspection.reinspect</b></color>;
    :Trigger New Inspection;
    note right
      Creates a new inspection
      with reference to this finding.
    end note
  endif
elseif (Regulatory Official) then
  :Authenticate\n<b>Regulatory Official</b>;
  if (What Action?) then (Waive)
    :Check Capability\n<color:#00897B><b>finding.waive</b></color>;
    :Check SoD\n(SOD-001: not the creator);
    note right
      Segregation of Duties (SOD-001):
      creator ≠ waiving official.
    end note
    :Transition: {Open|Ack|Evidence|Pending|Rejected}\n→ Waived (TR-FL-004);
    :Auto-transition: Waived → Closed;
    :Append DispositionChanged\n+ FindingClosed Events;
    note right
      INV-FL-006: RO disposition allowed
      from any non-terminal remediation
      state (stale-ack closure).
      INV-FL-020: Waived→Closed appended
      atomically with human waive event.
    end note
  elseif (Dismiss) then
    :Check Capability\n<color:#00897B><b>finding.dismiss</b></color>;
    note right
      No SoD check per TR-FL-003.
      Capability gate only.
      Multi-from sources per INV-FL-006.
    end note
    :Transition: {Open|Ack|Evidence|Pending|Rejected}\n→ Dismissed (TR-FL-003);
    :Append DispositionChanged Event;
  elseif (Supersede) then
    :Check Capability\n<color:#00897B><b>finding.supersede</b></color>;
    :Check SoD\n(SOD-003: not the creator);
    note right
      Segregation of Duties (SOD-003):
      creator ≠ superseding official.
      Actor MUST NOT be in creator_provenance.
      Multi-from sources per INV-FL-006.
    end note
    :Transition: {Open|Ack|Evidence|Pending|Rejected}\n→ Superseded (TR-FL-012);
    :Append DispositionChanged Event;
  elseif (Verify Evidence) then
    :Check Capability\n<color:#00897B><b>finding.approve_remediation</b></color>;
    :Check SoD\n(SOD-002: not the evidence submitter);
    note right
      Segregation of Duties (SOD-002):
      actor ≠ evidence_submitter.
    end note
    :Transition: Pending Verification → Verified;
    :Auto-transition: Verified → Closed;
    :Append DispositionChanged\n+ FindingClosed Events;
    note right
      INV-FL-020: Verified→Closed appended
      atomically with human approve event.
    end note
  elseif (Reject Evidence) then
    :Check Capability\n<color:#00897B><b>finding.reject_remediation</b></color>;
    note right
      No SoD check per TR-FL-008.
      Capability gate only.
    end note
    :Transition: Pending Verification → Rejected;
    :Append DispositionChanged Event;
  elseif (Reopen) then
    :Check Capability\n<color:#00897B><b>finding.reopen</b></color>;
    note right
      TR-FL-009: first-class finding.reopen
      (NOT reject_remediation). Mandatory comments.
    end note
    :Transition: Rejected → Open;
    :Append DispositionChanged Event;
  endif
endif

|#E8F4F8|Terminal Check|
if (Is Terminal State?\nClosed / Dismissed / Superseded) then (yes)
  #37474F:Final State Reached;
  stop
else (no)
  :Wait for Next Action;
  note right
    Finding remains in current
    disposition state until
    next authorized action.
  end note
  stop
endif

@enduml
