' ============================================================
' Title:     Selma — Activity Diagram Styles
' Purpose:   Activity view chrome + CA MACRO colors (ca_palette).
' Contract:  docs/standards/VERSION
' Include order:
'   !include ./common/act_styles.puml
'   !include ./common/act_identities.puml
' ============================================================

!include ../../standards/common/ca_palette.puml

skinparam defaultFontName       "Arial"
skinparam defaultFontSize       11
skinparam defaultTextAlignment  center
skinparam shadowing             false
skinparam roundCorner           8
skinparam handwritten           false
skinparam backgroundColor       $CA_CANVAS
skinparam titleFontSize         16
skinparam titleFontStyle        bold
skinparam titleFontColor        $CA_INK

skinparam activity {
  BorderColor                $CA_INK
  FontColor                  $CA_INK
  BackgroundColor            $CA_FILL_APPLICATION
  BorderThickness            2
  StartColor                 $CA_SOLID_APPLICATION
  EndColor                   $CA_SOLID_TERMINAL
  ArrowColor                 $CA_ARROW
  ArrowThickness             1.5
  DiamondBorderColor         $CA_BORDER_HERMETIC
  DiamondBackgroundColor     $CA_FILL_HERMETIC
  DiamondFontColor           $CA_INK
}

skinparam partition {
  BorderColor                $CA_BORDER_INTERFACE
  BackgroundColor            $CA_FILL_INTERFACE
  FontColor                  $CA_INK
  FontSize                   12
  FontStyle                  bold
}

skinparam arrow {
  Color                      $CA_ARROW
  Thickness                  1.5
  FontColor                  $CA_BORDER_NEUTRAL
  FontSize                   10
}

skinparam footer {
  FontColor                  $CA_BORDER_NEUTRAL
  FontSize                   10
}

' Partition color aliases (set via |#hex|partition|)
' Bare hex for |#$ACT_LANE_*| and #$ACT_OK:
!$ACT_LANE_ACTOR          = "E8EAF6"
!$ACT_LANE_INTERFACE      = "E1F5FE"
!$ACT_LANE_APPLICATION    = "E0F2F1"
!$ACT_LANE_DOMAIN         = "F3E5F5"
!$ACT_LANE_INFRASTRUCTURE = "FFF3E0"
!$ACT_LANE_FRAMEWORKS     = "E8F5E9"
!$ACT_LANE_GATE           = "FFEBEE"
!$ACT_LANE_HERMETIC       = "FFFDE7"
!$ACT_ABORT               = "C62828"
!$ACT_OK                  = "2E7D32"
