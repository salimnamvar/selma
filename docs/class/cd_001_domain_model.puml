@startuml cd_001_domain_model
' ============================================================
' Title:     CLS-001 Domain Model
' Source:    docs/spec/contracts/ + docs/schema/
' C4:        domain types; ResolveConflict (domain · not peer)
' Package:   shared_domain | directives_domain | compiled_rules_domain |
'            inspections_domain | findings_domain | conflicts_domain
' Contract:  1.1.0
' ============================================================
' Owns: aggregates, entities, value objects, domain services, domain events.
' Does not own: ports (CLS-002), adapters (CLS-003), routers (CLS-004),
' package edges (package/), peer graph (c4-model/), FSM tables (state/).

!include common/cd_styles.puml

title **CLS-001 — Domain Model**\nClean Architecture entities · package-aligned domain modules\n

' ═══════════════════════════════════════════════════════════
'  shared_domain
' ═══════════════════════════════════════════════════════════
package "shared_domain" as DOM_SHARED #ECEFF1 {

  class "**LineageId**" as LineageId <<Value Object>> #E8EAF6/3F51B5 {
    + value: String
    --
    <<invariant>> matches ^[A-Z]{2,5}-\\d{3}[A-Z]?$
  }

  class "**ExecutionId**" as ExecutionId <<Value Object>> #E8EAF6/3F51B5 {
    + value: UUID
  }

  class "**Revision**" as Revision <<Value Object>> #E8EAF6/3F51B5 {
    + value: int {> 0}
  }

  class "**FindingId**" as FindingId <<Value Object>> #E8EAF6/3F51B5 {
    + value: UUID
  }

  class "**ActorId**" as ActorId <<Value Object>> #E8EAF6/3F51B5 {
    + value: String
  }

  class "**HlcTimestamp**" as HlcTimestamp <<Value Object>> #E8EAF6/3F51B5 {
    + wall_time: DateTime
    + logical: int
  }

  class "**PairedPolicyRef**" as PairedPolicyRef <<Value Object>> #E8EAF6/3F51B5 {
    + policy_id: String
    + version: String
    + uri: URI
  }

  class "**SnapshotHash**" as SnapshotHash <<Value Object>> #E8EAF6/3F51B5 {
    + value: String {SHA-256}
  }

  class "**NodeHash**" as NodeHash <<Value Object>> #E8EAF6/3F51B5 {
    + value: String {SHA-256}
  }

  class "**EdgeHash**" as EdgeHash <<Value Object>> #E8EAF6/3F51B5 {
    + value: String {SHA-256}
  }

  class "**FrozenEnvHash**" as FrozenEnvHash <<Value Object>> #E8EAF6/3F51B5 {
    + value: String {SHA-256}
  }

  class "**TargetHash**" as TargetHash <<Value Object>> #E8EAF6/3F51B5 {
    + value: String {SHA-256}
  }

  class "**SystemStateHash**" as SystemStateHash <<Value Object>> #E8EAF6/3F51B5 {
    + value: String {SHA-256}
  }

  class "**CapabilityId**" as CapabilityId <<Value Object>> #E8EAF6/3F51B5 {
    + value: String
    + scope: String
  }

  class "**EventId**" as EventId <<Value Object>> #E8EAF6/3F51B5 {
    + value: UUID
  }

  class "**DeonticModality**" as DeonticModality <<Value Object>> #E8EAF6/3F51B5 {
    + modality: ModalityKind
    + strength: int
  }

  enum "**ModalityKind**" as ModalityKind #FFF8E1/F9A825 {
    must
    may
    should
    shall
  }

  class "**Subject**" as Subject <<Value Object>> #E8EAF6/3F51B5 {
    + subject_type: String
    + identifier: String
  }

  class "**Predicate**" as Predicate <<Value Object>> #E8EAF6/3F51B5 {
    + verb: String
    + object_ref: String
    + constraints: Map
  }

  class "**Applicability**" as Applicability <<Value Object>> #E8EAF6/3F51B5 {
    + scope: String
    + specificity: int
    + constraints: Map
  }

  class "**Priority**" as Priority <<Value Object>> #E8EAF6/3F51B5 {
    + value: int
    + tier: String
  }

  class "**DetectionSpec**" as DetectionSpec <<Value Object>> #E8EAF6/3F51B5 {
    + strategy_ref: String
    + parameters: Map
    + adapter_hint: String
  }

  class "**DetectionStrategy**" as DetectionStrategy <<Value Object>> #E8EAF6/3F51B5 {
    + strategy_id: String
    + adapter_key: String
    + parameters: Map
  }

  class "**EvidenceRef**" as EvidenceRef <<Value Object>> #E8EAF6/3F51B5 {
    + artifact_uri: URI
    + hash: String {SHA-256}
    + collected_at: HlcTimestamp
  }

  class "**GuidancePayload**" as GuidancePayload <<Value Object>> #E8EAF6/3F51B5 {
    + doctrine_text: String
    + remediation_steps: List~String~
    + references: List~URI~
  }

  class "**ResolutionTrace**" as ResolutionTrace <<Value Object>> #E8EAF6/3F51B5 {
    + steps: List~ResolutionStep~
    + winner: LineageId
    + reason: String
  }

  class "**Provenance**" as Provenance <<Value Object>> #E8EAF6/3F51B5 {
    + source_ref: String
    + author: ActorId
    + created_at: HlcTimestamp
  }

  class "**PipelineTraceEntry**" as PipelineTraceEntry <<Value Object>> #E8EAF6/3F51B5 {
    + stage: String
    + started_at: DateTime
    + completed_at: DateTime
    + status: String
  }

  class "**SkippedNode**" as SkippedNode <<Value Object>> #E8EAF6/3F51B5 {
    + node_id: String
    + reason: String
  }
}

' ═══════════════════════════════════════════════════════════
'  directives_domain
' ═══════════════════════════════════════════════════════════
package "directives_domain" as DOM_DIR #F0F4F8/5B7BA5 {

  class "**Directive**" as Directive <<Aggregate Root>> #E0F2F1/00897B {
    + lineage_id: LineageId
    + execution_id: ExecutionId
    + status: DirectiveStatus
    + revision: Revision
    + executable_document: ExecutableRuleDoc
    + policy_doctrine_document: PolicyDoctrineDoc
    + paired_policy_ref: PairedPolicyRef
    + subject: Subject
    + predicate: Predicate
    + detection_spec: DetectionSpec
    + applicability: Applicability
    + priority: Priority
    + modality: DeonticModality
    + metadata: Map
    --
    <<invariant>> dual documents co-versioned per revision
    <<invariant>> paired_policy_ref resolves within lineage
  }

  class "**DirectiveRevision**" as DirectiveRevision <<Entity>> #ECEFF1/546E7A {
    + revision: Revision
    + changed_at: HlcTimestamp
    + changed_by: ActorId
    + executable_document: ExecutableRuleDoc
    + policy_doctrine_document: PolicyDoctrineDoc
    + paired_policy_ref: PairedPolicyRef
  }

  class "**ExecutableRuleDoc**" as ExecutableRuleDoc <<Value Object>> #E8EAF6/3F51B5 {
    + content: Map
    --
    <<schema>> docs/schema/rule_schema.json
    <<role>> compile-time evaluation only
  }

  class "**PolicyDoctrineDoc**" as PolicyDoctrineDoc <<Value Object>> #E8EAF6/3F51B5 {
    + content: Map
    --
    <<schema>> docs/schema/policy_doctrine.yaml
    <<role>> guidance_only after findings
  }

  enum "**DirectiveStatus**" as DirectiveStatus #FFF8E1/F9A825 {
    draft
    active
    deprecated
    superseded
  }

  class "**LineageService**" as LineageService <<Domain Service>> #E8F5E9/2E7D32 {
    + fork(lineage: LineageId): LineageId
    + merge(left: LineageId, right: LineageId): LineageId
    + split(lineage: LineageId): List~LineageId~
  }

  class "**DetectionDiscriminator**" as DetectionDiscriminator <<Domain Service>> #E8F5E9/2E7D32 {
    + resolve(spec: DetectionSpec, active: Directive): DetectionStrategy
  }
}

' ═══════════════════════════════════════════════════════════
'  compiled_rules_domain
' ═══════════════════════════════════════════════════════════
package "compiled_rules_domain" as DOM_CR #F0F4F8/5B7BA5 {

  class "**CgIrSnapshot**" as CgIrSnapshot <<Aggregate Root>> #E0F2F1/00897B {
    + cg_ir_snapshot_hash: SnapshotHash
    + frozen_env_hash: FrozenEnvHash
    + engine_version: String
    + compiled_at: DateTime
    + provenance: Provenance
    --
    <<invariant>> hash == SHA-256(controls ∥ edges ∥ env)
  }

  class "**ControlNode**" as ControlNode <<Entity>> #ECEFF1/546E7A {
    + node_id: String
    + node_hash: NodeHash
    + kind: NodeKind
    + payload: Map
  }

  class "**DependencyEdge**" as DependencyEdge <<Entity>> #ECEFF1/546E7A {
    + edge_hash: EdgeHash
    + source_id: String
    + target_id: String
    + kind: EdgeKind
  }

  class "**LineageHead**" as LineageHead <<Entity>> #ECEFF1/546E7A {
    + lineage_id: LineageId
    + head_snapshot_hash: SnapshotHash
    + revision: Revision
    --
    <<role>> revision-monotonic head index
  }

  enum "**NodeKind**" as NodeKind #FFF8E1/F9A825 {
    control
    gateway
    join
  }

  enum "**EdgeKind**" as EdgeKind #FFF8E1/F9A825 {
    depends_on
    sequence
    conflict
  }
}

' ═══════════════════════════════════════════════════════════
'  inspections_domain
' ═══════════════════════════════════════════════════════════
package "inspections_domain" as DOM_INS #F0F4F8/5B7BA5 {

  class "**Inspection**" as Inspection <<Aggregate Root>> #E0F2F1/00897B {
    + inspection_id: UUID
    + target: Target
    + target_hash: TargetHash
    + cg_ir_snapshot_hash: SnapshotHash
    + frozen_env_hash: FrozenEnvHash
    + engine_version: String
    + inspector: ActorId
    + started_at: DateTime
    + completed_at: DateTime
    + status: InspectionStatus
    + finding_count: int
    + skipped_nodes: List~SkippedNode~
    + pipeline_trace: List~PipelineTraceEntry~
    + system_state_hash: SystemStateHash
    --
    <<invariant>> completed ⇒ completed_at >= started_at
  }

  class "**Target**" as Target <<Value Object>> #E8EAF6/3F51B5 {
    + target_id: String
    + target_hash: TargetHash
    + kind: String
    + payload_ref: String
  }

  enum "**InspectionStatus**" as InspectionStatus #FFF8E1/F9A825 {
    completed
    partial
    failed
  }

  class "**ScopeMatcher**" as ScopeMatcher <<Domain Service>> #E8F5E9/2E7D32 {
    + match(applicability: Applicability, target: Target): int
  }
}

' ═══════════════════════════════════════════════════════════
'  findings_domain
' ═══════════════════════════════════════════════════════════
package "findings_domain" as DOM_FIND #F0F4F8/5B7BA5 {

  class "**Finding**" as Finding <<Aggregate Root>> #E0F2F1/00897B {
    + finding_id: FindingId
    + inspection_id: UUID
    + control_id: String
    + target_hash: TargetHash
    + fsm_state: FindingState
    + disposition: Disposition
    + severity: Severity
    + evidence_ref: EvidenceRef
    + paired_policy_ref: PairedPolicyRef
    + creator_provenance: Provenance
    --
    <<invariant>> disposition requires terminal state
  }

  class "**FindingProjection**" as FindingProjection <<Read Model>> #E8EAF6/3F51B5 {
    + finding_id: FindingId
    + fsm_state: FindingState
    + disposition: Disposition
    + severity: Severity
    + chain_head: String
    + updated_at: HlcTimestamp
  }

  class "**FindingFsm**" as FindingFsm <<Domain Service>> #E8F5E9/2E7D32 {
    + transition(finding: Finding, target: FindingState, actor: ActorId): boolean
    + allowedTransitions(current: FindingState): Set~FindingState~
    + checkSegregationOfDuties(finding: Finding, actor: ActorId, action: String): boolean
  }

  class "**GuidanceResolver**" as GuidanceResolver <<Domain Service>> #E8F5E9/2E7D32 {
    + materialize(ref: PairedPolicyRef, doctrine: PolicyDoctrineDoc): GuidancePayload
  }

  class "**GuidanceView**" as GuidanceView <<Read Model>> #E8EAF6/3F51B5 {
    + directive_lineage_id: LineageId
    + doctrine_text: String
    + paired_policy_ref: PairedPolicyRef
  }

  class "**AggregateReport**" as AggregateReport <<Read Model>> #E8EAF6/3F51B5 {
    + scope: String
    + period: DateRange
    + finding_counts: Map~Severity,int~
    + directive_coverage: double
  }

  enum "**FindingState**" as FindingState #FFF8E1/F9A825 {
    Created
    Open
    Acknowledged
    EvidenceSubmitted
    PendingVerification
    Verified
    Rejected
    Dismissed
    Waived
    Superseded
    Closed
  }

  enum "**Disposition**" as Disposition #FFF8E1/F9A825 {
    valid
    invalid
    waived
    dismissed
    superseded
  }

  enum "**Severity**" as Severity #FFF8E1/F9A825 {
    critical
    high
    medium
    low
    informational
  }
}

' ═══════════════════════════════════════════════════════════
'  conflicts_domain (not C4 peer)
' ═══════════════════════════════════════════════════════════
package "conflicts_domain" as DOM_CON #F0F4F8/5B7BA5 {

  class "**ResolveConflict**" as ResolveConflict <<Domain Service>> #E8F5E9/2E7D32 {
    + resolve(a: Directive, b: Directive): ConflictArtifact
    + resolveControlPair(a: ControlNode, b: ControlNode): ConflictArtifact
  }

  class "**ConflictArtifact**" as ConflictArtifact <<Aggregate Root>> #E0F2F1/00897B {
    + artifact_id: UUID
    + conflict_kind: ConflictKind
    + binding_status: BindingStatus
    + resolution_trace: ResolutionTrace
    + parties: List~LineageId~
  }

  enum "**ConflictKind**" as ConflictKind #FFF8E1/F9A825 {
    within_lineage
    cross_lineage_advisory
  }

  enum "**BindingStatus**" as BindingStatus #FFF8E1/F9A825 {
    unresolved
    advisory
    bound
    superseded
  }
}

' ═══════════════════════════════════════════════════════════
'  Domain events (raised by aggregates / services)
' ═══════════════════════════════════════════════════════════
package "domain_events" as EVT_PKG #FFFDE7/E0C96F {

  abstract class "**DomainEvent**" as DomainEvent <<Domain Event>> #FFF8E1/FF8F00 {
    + event_id: EventId
    + occurred_at: HlcTimestamp
  }

  class "**FindingCreated**" as FindingCreated <<Domain Event>> #FFF8E1/FF8F00 {
    + finding_id: FindingId
    + inspection_id: UUID
    + severity: Severity
  }

  class "**FindingStateChanged**" as FindingStateChanged <<Domain Event>> #FFF8E1/FF8F00 {
    + finding_id: FindingId
    + from_state: FindingState
    + to_state: FindingState
    + actor_id: ActorId
  }

  class "**DispositionChanged**" as DispositionChanged <<Domain Event>> #FFF8E1/FF8F00 {
    + finding_id: FindingId
    + old_disposition: Disposition
    + new_disposition: Disposition
  }

  class "**FindingClosed**" as FindingClosed <<Domain Event>> #FFF8E1/FF8F00 {
    + finding_id: FindingId
    + final_disposition: Disposition
  }

  class "**CapabilityDenied**" as CapabilityDenied <<Domain Event>> #FFF8E1/FF8F00 {
    + capability_id: CapabilityId
    + actor_id: ActorId
    + action: String
    + reason: String
  }

  class "**CgIrPublished**" as CgIrPublished <<Domain Event>> #FFF8E1/FF8F00 {
    + cg_ir_snapshot_hash: SnapshotHash
    + engine_version: String
  }

  class "**InspectionCompleted**" as InspectionCompleted <<Domain Event>> #FFF8E1/FF8F00 {
    + inspection_id: UUID
    + finding_count: int
    + status: InspectionStatus
  }

  class "**ConflictEscalated**" as ConflictEscalated <<Domain Event>> #FFF8E1/FF8F00 {
    + conflict_kind: ConflictKind
    + directive_a: LineageId
    + directive_b: LineageId
  }

  class "**DirectiveLifecycleChanged**" as DirectiveLifecycleChanged <<Domain Event>> #FFF8E1/FF8F00 {
    + lineage_id: LineageId
    + from_status: DirectiveStatus
    + to_status: DirectiveStatus
  }

  FindingCreated --|> DomainEvent
  FindingStateChanged --|> DomainEvent
  DispositionChanged --|> DomainEvent
  FindingClosed --|> DomainEvent
  CapabilityDenied --|> DomainEvent
  CgIrPublished --|> DomainEvent
  InspectionCompleted --|> DomainEvent
  ConflictEscalated --|> DomainEvent
  DirectiveLifecycleChanged --|> DomainEvent
}

' ═══════════════════════════════════════════════════════════
'  Certification payload types (offline tool · not peer)
' ═══════════════════════════════════════════════════════════
package "certification_payloads" as DOM_CERT #F0F4F8/5B7BA5 {

  class "**CertificationRun**" as CertificationRun <<Value Object>> #E8EAF6/3F51B5 {
    + run_id: UUID
    + started_at: DateTime
    + completed_at: DateTime
    + overall_status: PassFail
  }

  class "**GateResult**" as GateResult <<Value Object>> #E8EAF6/3F51B5 {
    + gate_id: String {AA-01..AA-09}
    + passed: boolean
    + evidence_ref: String
    + checked_at: DateTime
  }

  enum "**PassFail**" as PassFail #FFF8E1/F9A825 {
    pass
    fail
  }
}

' ═══════════════════════════════════════════════════════════
'  Authorization grant (api gate reads; domain type)
' ═══════════════════════════════════════════════════════════
package "authorization_domain" as DOM_AUTH #F0F4F8/5B7BA5 {

  class "**ActorCapabilityGrant**" as ActorCapabilityGrant <<Entity>> #ECEFF1/546E7A {
    + actor_id: ActorId
    + capability_id: CapabilityId
    + granted_at: HlcTimestamp
    + expires_at: HlcTimestamp
    + constraints: Map
  }

  class "**CapabilityGate**" as CapabilityGate <<Domain Service>> #E8F5E9/2E7D32 {
    + check(capability: CapabilityId, actor: ActorId, grants: List~ActorCapabilityGrant~): boolean
  }
}

' ═══════════════════════════════════════════════════════════
'  RELATIONSHIPS
' ═══════════════════════════════════════════════════════════

Directive *-- "0..*" DirectiveRevision
Directive *-- ExecutableRuleDoc
Directive *-- PolicyDoctrineDoc
Directive --> LineageId
Directive --> ExecutionId
Directive --> Revision
Directive --> PairedPolicyRef
Directive --> Subject
Directive --> Predicate
Directive --> DetectionSpec
Directive --> Applicability
Directive --> Priority
Directive --> DeonticModality
Directive --> DirectiveStatus
DeonticModality --> ModalityKind
DirectiveRevision *-- ExecutableRuleDoc
DirectiveRevision *-- PolicyDoctrineDoc

CgIrSnapshot *-- "0..*" ControlNode
CgIrSnapshot *-- "0..*" DependencyEdge
CgIrSnapshot --> SnapshotHash
CgIrSnapshot --> FrozenEnvHash
CgIrSnapshot --> Provenance
ControlNode --> NodeHash
ControlNode --> NodeKind
DependencyEdge --> EdgeHash
DependencyEdge --> EdgeKind
LineageHead --> LineageId
LineageHead --> SnapshotHash
LineageHead --> CgIrSnapshot

Inspection --> Target
Inspection --> TargetHash
Inspection --> SnapshotHash
Inspection --> FrozenEnvHash
Inspection --> SystemStateHash
Inspection --> "0..*" SkippedNode
Inspection --> "0..*" PipelineTraceEntry
Inspection --> InspectionStatus
Target --> TargetHash

Finding --> FindingId
Finding --> FindingState
Finding --> Disposition
Finding --> Severity
Finding --> EvidenceRef
Finding --> PairedPolicyRef
Finding --> Provenance
Finding --> TargetHash
FindingProjection --> FindingId
FindingProjection --> FindingState

ConflictArtifact --> ConflictKind
ConflictArtifact --> BindingStatus
ConflictArtifact --> ResolutionTrace
ConflictArtifact --> "2..*" LineageId

CertificationRun *-- "1..9" GateResult
CertificationRun --> PassFail

Finding ..> Inspection : inspection_id
Inspection ..> CgIrSnapshot : cg_ir_snapshot_hash
ConflictArtifact ..> Directive : parties
Finding ..> GuidancePayload : guidance materialization

LineageService ..> Directive
DetectionDiscriminator ..> Directive
DetectionDiscriminator ..> DetectionStrategy
ResolveConflict ..> Directive
ResolveConflict ..> ControlNode
ResolveConflict ..> ConflictArtifact
FindingFsm ..> Finding
FindingFsm ..> FindingState
ScopeMatcher ..> Applicability
ScopeMatcher ..> Target
GuidanceResolver ..> PairedPolicyRef
GuidanceResolver ..> PolicyDoctrineDoc
GuidanceResolver ..> GuidancePayload
CapabilityGate ..> CapabilityId
CapabilityGate ..> ActorCapabilityGrant

Finding ..> FindingCreated
Finding ..> FindingStateChanged
Finding ..> DispositionChanged
Finding ..> FindingClosed
CapabilityGate ..> CapabilityDenied
CgIrSnapshot ..> CgIrPublished
Inspection ..> InspectionCompleted
ResolveConflict ..> ConflictEscalated
Directive ..> DirectiveLifecycleChanged

GuidanceView ..> PairedPolicyRef
GuidanceView ..> LineageId
AggregateReport ..> Severity

