@startuml cd_001_domain_model
' ============================================================
' Title:     CLS-001 Domain Model
' Source:    docs/spec/contracts/ + docs/schema/
' C4:        domain types; ResolveConflict (domain · not peer)
' Package:   shared_domain | directives_domain | compiled_rules_domain |
'            inspections_domain | findings_domain | conflicts_domain
' Contract:  1.1.0
'
' Structure (mirrors package/state/deployment/c4 common/):
'   common/cd_styles.puml
'   common/cd_identities.puml
'   common/cd_section_domain_*.puml
'   common/cd_section_domain_connections.puml
'
' This file only orchestrates includes.
' ============================================================

!include common/cd_styles.puml
!include common/cd_identities.puml

title $TITLE_DOMAIN

!include common/cd_section_domain_shared.puml
!include common/cd_section_domain_directives.puml
!include common/cd_section_domain_compiled_rules.puml
!include common/cd_section_domain_inspections.puml
!include common/cd_section_domain_findings.puml
!include common/cd_section_domain_conflicts.puml
!include common/cd_section_domain_events.puml
!include common/cd_section_domain_certification.puml
!include common/cd_section_domain_authorization.puml

!include common/cd_section_domain_connections.puml

legend bottom
  |= Archetype |= C4 color family |
  | Aggregate Root | store green #2C6E49 |
  | Value Object / Read Model | container blue #3B7DD8 |
  | Domain Service | process teal #1B7A6E |
  | Domain Event / Enum | hermetic amber #B9770E |
  | Entity | neutral grey |
  | Packages | `*_domain` modules (package view owns edges) |
endlegend

footer $FOOTER_DOMAIN

@enduml
