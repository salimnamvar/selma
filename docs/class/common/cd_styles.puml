' ============================================================
' Title:     Class diagram shared styles
' Package:   docs/class/common
' Contract:  1.1.0
' ============================================================
' Include: !include common/cd_styles.puml
' Class diagrams must not use note blocks — encode design in types.

skinparam backgroundColor #FAFBFC
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultFontName "Inter,Segoe UI,Helvetica,Arial,sans-serif"
skinparam defaultFontSize 12
skinparam defaultFontColor #2C3E50

skinparam package {
  BackgroundColor #F0F4F8
  BorderColor #5B7BA5
  BorderStyle solid
  FontSize 13
  FontStyle bold
  FontColor #2C3E50
  StereotypeFontSize 11
  StereotypeFontColor #5B7BA5
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #7F8C9A
  FontSize 12
  FontStyle bold
  HeaderBackgroundColor #E8EDF2
  AttributeFontSize 11
  StereotypeFontSize 10
  StereotypeFontColor #5B7BA5
}

skinparam abstract {
  BackgroundColor #F7F9FB
  BorderColor #95A5B6
  FontStyle italic
}

skinparam enum {
  BackgroundColor #FFF8E7
  BorderColor #D4A843
  StereotypeFontColor #B8860B
}

skinparam interface {
  BackgroundColor #EAF7F0
  BorderColor #3DAA6D
  StereotypeFontColor #2E8B57
}

skinparam ArrowColor #5B7BA5
skinparam ArrowThickness 1
skinparam Linetype ortho

skinparam legend {
  BackgroundColor #F5F7FA
  BorderColor #B0BEC5
  FontSize 10
}

