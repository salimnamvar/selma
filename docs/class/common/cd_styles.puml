!$CD_COLOR_PENDING   = $CA_SOLID_HERMETIC
!$CD_COLOR_TERMINAL  = $CA_SOLID_TERMINAL
!$CD_COLOR_DOMAIN    = $CA_SOLID_DOMAIN
!$CD_COLOR_EXTERNAL  = $CA_SOLID_EXTERNAL
