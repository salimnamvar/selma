' ============================================================
' Title:     Selma — Class Diagram Styles
' Purpose:   Class view chrome + aliases to CA palette.
'            MACRO = Clean Architecture layers; MICRO = type archetypes.
' Contract:  docs/standards/VERSION
' Include order:
'   !include common/cd_styles.puml   (pulls ca_palette)
'   !include common/cd_identities.puml
' ============================================================

!include ../../standards/common/ca_palette.puml

!theme plain
skinparam backgroundColor $CA_CANVAS
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam defaultFontColor $CA_INK
skinparam defaultTextAlignment left
skinparam handwritten false
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor $CA_INK
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40

skinparam packageStyle rectangle
skinparam package {
  FontSize 12
  FontStyle bold
  FontColor $CA_INK
  BorderThickness 2
  StereotypeFontSize 10
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor $CA_BORDER_NEUTRAL
  FontSize 11
  FontStyle bold
  HeaderBackgroundColor $CA_BOUNDARY_DEFAULT_FILL
  AttributeFontSize 10
  StereotypeFontSize 9
  StereotypeFontColor $CA_BORDER_NEUTRAL
  BorderThickness 1.5
}

skinparam abstract {
  BackgroundColor $CA_FILL_TERMINAL
  BorderColor $CA_SOLID_ENTITY
  FontStyle italic
}

skinparam enum {
  BackgroundColor $CA_FILL_HERMETIC
  BorderColor $CA_SOLID_HERMETIC
  StereotypeFontColor $CA_BORDER_HERMETIC
}

skinparam interface {
  BackgroundColor $CA_FILL_GATE
  BorderColor $CA_SOLID_GATE
  StereotypeFontColor $CA_BORDER_GATE_DEEP
}

skinparam ArrowColor $CA_ARROW
skinparam ArrowThickness 1.5
skinparam ArrowFontSize 9
skinparam ArrowFontColor $CA_INK

skinparam legend {
  BackgroundColor $CA_LEGEND_BG
  BorderColor $CA_LEGEND_BORDER
  FontSize 10
}

' ── MACRO aliases (CA layers) ───────────────────────────────
!$CD_LAYER_ACTOR_SOLID           = $CA_SOLID_ACTOR
!$CD_LAYER_INTERFACE_SOLID       = $CA_SOLID_INTERFACE
!$CD_LAYER_APPLICATION_SOLID     = $CA_SOLID_APPLICATION
!$CD_LAYER_DOMAIN_SOLID          = $CA_SOLID_DOMAIN
!$CD_LAYER_INFRASTRUCTURE_SOLID  = $CA_SOLID_INFRASTRUCTURE
!$CD_LAYER_FRAMEWORKS_SOLID      = $CA_SOLID_FRAMEWORKS
!$CD_LAYER_EXTERNAL_SOLID        = $CA_SOLID_EXTERNAL
!$CD_LAYER_COMPOSITION_SOLID     = $CA_SOLID_COMPOSITION

' Package ring strings (must match package diagram)
!$CD_PKG_DOMAIN          = $CA_PKG_DOMAIN
!$CD_PKG_APPLICATION     = $CA_PKG_APPLICATION
!$CD_PKG_INFRASTRUCTURE  = $CA_PKG_INFRASTRUCTURE
!$CD_PKG_INTERFACE       = $CA_PKG_INTERFACE
!$CD_PKG_COMPOSITION     = $CA_PKG_COMPOSITION
!$CD_PKG_GATE            = $CA_PKG_GATE
!$CD_PKG_FRAMEWORKS      = $CA_PKG_FRAMEWORKS

' ── MICRO aliases (type archetypes inside layers) ───────────
' Aggregate root lives in domain but durability → frameworks green
!$CD_ARCH_AGGREGATE  = $CA_PKG_FRAMEWORKS
!$CD_ARCH_VO         = $CA_PKG_INTERFACE
!$CD_ARCH_SERVICE    = $CA_PKG_DOMAIN
!$CD_ARCH_USECASE    = $CA_PKG_APPLICATION
!$CD_ARCH_PORT       = $CA_PKG_GATE
!$CD_ARCH_ENTITY     = $CA_PKG_ENTITY
!$CD_ARCH_EVENT      = $CA_PKG_HERMETIC
!$CD_ARCH_ENUM       = $CA_PKG_HERMETIC
!$CD_ARCH_ADAPTER    = $CA_PKG_INFRASTRUCTURE
!$CD_ARCH_DTO        = $CA_PKG_INTERFACE
!$CD_ARCH_INTERFACE  = $CA_PKG_INTERFACE
!$CD_ARCH_COMPOSITION = $CA_PKG_COMPOSITION

' Legacy short aliases (prefer CD_LAYER_* / CD_ARCH_*)
!$CD_COLOR_ACTOR     = $CA_SOLID_ACTOR
!$CD_COLOR_CONTAINER = $CA_SOLID_INTERFACE
!$CD_COLOR_PROCESS   = $CA_SOLID_APPLICATION
!$CD_COLOR_STORE     = $CA_SOLID_FRAMEWORKS
