package "$PKG_FINDINGS_DOMAIN" as DOM_FIND #F3E5F5/7B1FA2 {

  class "**Finding**" as Finding <<Aggregate Root>> #E8F5E9/2E7D32 {
    + finding_id: FindingId
    + inspection_id: UUID
    + control_id: String
    + target_hash: TargetHash
    + fsm_state: FindingState
    + disposition: Disposition
    + severity: Severity
    + evidence_ref: EvidenceRef
    + paired_policy_ref: PairedPolicyRef
    + creator_provenance: Provenance
    --
    <<invariant>> disposition requires terminal state
  }

  class "**FindingProjection**" as FindingProjection <<Read Model>> #E1F5FE/0288D1 {
    + finding_id: FindingId
    + fsm_state: FindingState
    + disposition: Disposition
    + severity: Severity
    + chain_head: String
    + updated_at: HlcTimestamp
  }

  class "**FindingFsm**" as FindingFsm <<Domain Service>> #F3E5F5/7B1FA2 {
    + transition(finding: Finding, target: FindingState, actor: ActorId): boolean
    + allowedTransitions(current: FindingState): Set~FindingState~
    + checkSegregationOfDuties(finding: Finding, actor: ActorId, action: String): boolean
  }

  class "**GuidanceResolver**" as GuidanceResolver <<Domain Service>> #F3E5F5/7B1FA2 {
    + materialize(ref: PairedPolicyRef, doctrine: PolicyDoctrineDoc): GuidancePayload
  }

  class "**GuidanceView**" as GuidanceView <<Read Model>> #E1F5FE/0288D1 {
    + directive_lineage_id: LineageId
    + doctrine_text: String
    + paired_policy_ref: PairedPolicyRef
  }

  class "**AggregateReport**" as AggregateReport <<Read Model>> #E1F5FE/0288D1 {
    + scope: String
    + period: DateRange
    + finding_counts: Map~Severity,int~
    + directive_coverage: double
  }

  enum "**FindingState**" as FindingState #FFFDE7/F9A825 {
    Created
    Open
    Acknowledged
    EvidenceSubmitted
    PendingVerification
    Verified
    Rejected
    Dismissed
    Waived
    Superseded
    Closed
  }

  enum "**Disposition**" as Disposition #FFFDE7/F9A825 {
    valid
    invalid
    waived
    dismissed
    superseded
  }

  enum "**Severity**" as Severity #FFFDE7/F9A825 {
    critical
    high
    medium
    low
    informational
  }
}

