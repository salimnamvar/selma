package "$PKG_CONFLICTS_DOMAIN" as DOM_CON #F3E5F5/7B1FA2 {

  class "**ResolveConflict**" as ResolveConflict <<Domain Service>> #F3E5F5/7B1FA2 {
    + resolve(a: Directive, b: Directive): ConflictArtifact
    + resolveControlPair(a: ControlNode, b: ControlNode): ConflictArtifact
  }

  class "**ConflictArtifact**" as ConflictArtifact <<Aggregate Root>> #E8F5E9/2E7D32 {
    + artifact_id: UUID
    + conflict_kind: ConflictKind
    + binding_status: BindingStatus
    + resolution_trace: ResolutionTrace
    + parties: List~LineageId~
  }

  enum "**ConflictKind**" as ConflictKind #FFFDE7/F9A825 {
    within_lineage
    cross_lineage_advisory
  }

  enum "**BindingStatus**" as BindingStatus #FFFDE7/F9A825 {
    unresolved
    advisory
    bound
    superseded
  }
}

