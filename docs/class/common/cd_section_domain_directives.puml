package "$PKG_DIRECTIVES_DOMAIN" as DOM_DIR #F3E5F5/7B1FA2 {

  class "**Directive**" as Directive <<Aggregate Root>> #E8F5E9/2E7D32 {
    + lineage_id: LineageId
    + execution_id: ExecutionId
    + status: DirectiveStatus
    + revision: Revision
    + executable_document: ExecutableRuleDoc
    + policy_doctrine_document: PolicyDoctrineDoc
    + paired_policy_ref: PairedPolicyRef
    + subject: Subject
    + predicate: Predicate
    + detection_spec: DetectionSpec
    + applicability: Applicability
    + priority: Priority
    + modality: DeonticModality
    + metadata: Map
    --
    <<invariant>> dual documents co-versioned per revision
    <<invariant>> paired_policy_ref resolves within lineage
  }

  class "**DirectiveRevision**" as DirectiveRevision <<Entity>> #ECEFF1/546E7A {
    + revision: Revision
    + changed_at: HlcTimestamp
    + changed_by: ActorId
    + executable_document: ExecutableRuleDoc
    + policy_doctrine_document: PolicyDoctrineDoc
    + paired_policy_ref: PairedPolicyRef
  }

  class "**ExecutableRuleDoc**" as ExecutableRuleDoc <<Value Object>> #E1F5FE/0288D1 {
    + content: Map
    --
    <<schema>> docs/schema/rule_schema.json
    <<role>> compile-time evaluation only
  }

  class "**PolicyDoctrineDoc**" as PolicyDoctrineDoc <<Value Object>> #E1F5FE/0288D1 {
    + content: Map
    --
    <<schema>> docs/schema/policy_doctrine.yaml
    <<role>> guidance_only after findings
  }

  enum "**DirectiveStatus**" as DirectiveStatus #FFFDE7/F9A825 {
    draft
    active
    deprecated
    superseded
  }

  class "**LineageService**" as LineageService <<Domain Service>> #F3E5F5/7B1FA2 {
    + fork(lineage: LineageId): LineageId
    + merge(left: LineageId, right: LineageId): LineageId
    + split(lineage: LineageId): List~LineageId~
  }

  class "**DetectionDiscriminator**" as DetectionDiscriminator <<Domain Service>> #F3E5F5/7B1FA2 {
    + resolve(spec: DetectionSpec, active: Directive): DetectionStrategy
  }
}

