package "$PKG_DOMAIN_EVENTS" as EVT_PKG #FFFDE7/F9A825 {

  abstract class "**DomainEvent**" as DomainEvent <<Domain Event>> #FFFDE7/F9A825 {
    + event_id: EventId
    + occurred_at: HlcTimestamp
  }

  class "**FindingCreated**" as FindingCreated <<Domain Event>> #FFFDE7/F9A825 {
    + finding_id: FindingId
    + inspection_id: UUID
    + severity: Severity
  }

  class "**FindingStateChanged**" as FindingStateChanged <<Domain Event>> #FFFDE7/F9A825 {
    + finding_id: FindingId
    + from_state: FindingState
    + to_state: FindingState
    + actor_id: ActorId
  }

  class "**DispositionChanged**" as DispositionChanged <<Domain Event>> #FFFDE7/F9A825 {
    + finding_id: FindingId
    + old_disposition: Disposition
    + new_disposition: Disposition
  }

  class "**FindingClosed**" as FindingClosed <<Domain Event>> #FFFDE7/F9A825 {
    + finding_id: FindingId
    + final_disposition: Disposition
  }

  class "**CapabilityDenied**" as CapabilityDenied <<Domain Event>> #FFFDE7/F9A825 {
    + capability_id: CapabilityId
    + actor_id: ActorId
    + action: String
    + reason: String
  }

  class "**CgIrPublished**" as CgIrPublished <<Domain Event>> #FFFDE7/F9A825 {
    + cg_ir_snapshot_hash: SnapshotHash
    + engine_version: String
  }

  class "**InspectionCompleted**" as InspectionCompleted <<Domain Event>> #FFFDE7/F9A825 {
    + inspection_id: UUID
    + finding_count: int
    + status: InspectionStatus
  }

  class "**ConflictEscalated**" as ConflictEscalated <<Domain Event>> #FFFDE7/F9A825 {
    + conflict_kind: ConflictKind
    + directive_a: LineageId
    + directive_b: LineageId
  }

  class "**DirectiveLifecycleChanged**" as DirectiveLifecycleChanged <<Domain Event>> #FFFDE7/F9A825 {
    + lineage_id: LineageId
    + from_status: DirectiveStatus
    + to_status: DirectiveStatus
  }

  FindingCreated --|> DomainEvent
  FindingStateChanged --|> DomainEvent
  DispositionChanged --|> DomainEvent
  FindingClosed --|> DomainEvent
  CapabilityDenied --|> DomainEvent
  CgIrPublished --|> DomainEvent
  InspectionCompleted --|> DomainEvent
  ConflictEscalated --|> DomainEvent
  DirectiveLifecycleChanged --|> DomainEvent
}

