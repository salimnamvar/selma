@startuml cd_003_infrastructure_adapters
' ============================================================
' Title:     CLS-003 Infrastructure Adapters
' Source:    docs/spec/contracts/data_stores/
' C4:        *_repository / target_sources_gateway → *_store
' Contract:  1.1.0
' ============================================================
' CLS-003 · Infrastructure — {resource}_infrastructure adapters
!include common/cd_styles.puml

title **CLS-003 — Infrastructure Adapters**\nROD port methods · {resource}_infrastructure modules\n

package "<<ports>>\nApplication ports (ISP)" as PORTS #FCE4EC/C62828 {
  interface "**DirectiveRepository**" as DirectiveRepository <<Port>>
  interface "**CompilerReadPort**" as CompilerReadPort <<Port>>
  interface "**GuidanceReadPort**" as GuidanceReadPort <<Port>>
  interface "**CompiledRulesRepository**" as CompiledRulesRepository <<Port>>
  interface "**FindingEventRepository**" as FindingEventRepository <<Port>>
  interface "**DenialAuditPort**" as DenialAuditPort <<Port>>
  interface "**InspectionArtifactPort**" as InspectionArtifactPort <<Port>>
  interface "**FindingArtifactPort**" as FindingArtifactPort <<Port>>
  interface "**CertificationArtifactPort**" as CertificationArtifactPort <<Port>>
  interface "**TargetSourcesGateway**" as TargetSourcesGateway <<Port>>
}

package "directives_infrastructure" as INFRA_DIR #FFE0B2/F57C00 {
  class "**SqlDirectiveWriter**" as SqlDirectiveWriter <<Adapter>> {
    + GetDirective(...)
    + SaveDirective(... If-Match)
    + EnqueueCompileRequest(...)
    --
    <<implements>> DirectiveRepository only
    write path; same PG pool optional
  }
  class "**SqlCompilerReader**" as SqlCompilerReader <<Adapter>> {
    + GetDirectiveExecutableDocument(...)
    --
    <<implements>> CompilerReadPort only
    no SaveDirective / doctrine methods
  }
  class "**SqlGuidanceReader**" as SqlGuidanceReader <<Adapter>> {
    + GetDirectivePolicyDoctrine(...)
    --
    <<implements>> GuidanceReadPort only
    revision-pinned doctrine reads
  }
  note right of SqlCompilerReader
    ISP: three adapter classes (or narrow façades).
    Composition root injects the port type, never
    a shared multi-port concrete into compile path.
    God-adapter SqlDirectiveRepository is **forbidden**.
  end note
}

package "compiled_rules_infrastructure" as INFRA_CR #FFE0B2/F57C00 {
  class "**ContentAddressedCompiledRulesRepository**" as ContentAddressedCompiledRulesRepository <<Adapter>> {
    + GetCompiledRules(snapshot_hash)
    + GetLatestCompiledRules(lineage_id)
    + PublishCompiledRules(... revision-monotonic head)
    --
    GetLatest resolves head_snapshot_hash
    via lineage_head_index (not compiled_at)
  }
}

package "findings_infrastructure" as INFRA_FE #FFE0B2/F57C00 {
  class "**AppendOnlyFindingEventRepository**" as AppendOnlyFindingEventRepository <<Adapter>> {
    + AppendFindingEvent(... expected_chain_head)
    + ListFindingEvents(...)
    + GetFindingProjection(...)
    --
    <<implements>> FindingEventRepository only
  }
  class "**DenialAuditAdapter**" as DenialAuditAdapter <<Adapter>> {
    + AppendDenial(...)
    --
    <<implements>> DenialAuditPort only
    dedicated pool bulkhead; no full repo surface
  }
  note right of DenialAuditAdapter
    api receives DenialAuditPort only.
    MUST NOT inject FindingEventRepository into api.
  end note
}

package "artifacts_infrastructure" as INFRA_ART #FFE0B2/F57C00 {
  class "**ObjectStoreClient**" as ObjectStoreClient <<SharedClient>> {
    + PutOnce(...)
    + Get(...)
  }
  class "**InspectionArtifactAdapter**" as InspectionArtifactAdapter <<Adapter>> {
    + SaveInspectionArtifact(...)
    + GetInspectionArtifact(...)
  }
  class "**FindingArtifactAdapter**" as FindingArtifactAdapter <<Adapter>> {
    + SaveConflictArtifact(...)
    + SaveEvidenceArtifact(...)
  }
  class "**CertificationArtifactAdapter**" as CertificationArtifactAdapter <<Adapter>> {
    + SaveCertificationArtifact(...)
  }
}

package "inspections_infrastructure" as INFRA_INS #FFE0B2/F57C00 {
  class "**HttpTargetSourcesGateway**" as HttpTargetSourcesGateway <<Adapter>> {
    + GetTarget(... timeout, circuit breaker)
    + HashTarget(...)
  }
}

package "authorization (api support)" as INFRA_AUTH_MOD #FFE0B2/F57C00 {
  class "**CapabilityEnforcer**" as CapabilityEnforcer {
    + Authenticate(jwt): Actor
    + Authorize(actor, capability): Decision
    + AuditDenial(decision): void
    --
    <<shared>> all driving adapters
  }
}

SqlDirectiveWriter ..|> DirectiveRepository
SqlCompilerReader ..|> CompilerReadPort
SqlGuidanceReader ..|> GuidanceReadPort
ContentAddressedCompiledRulesRepository ..|> CompiledRulesRepository
AppendOnlyFindingEventRepository ..|> FindingEventRepository
DenialAuditAdapter ..|> DenialAuditPort
InspectionArtifactAdapter ..|> InspectionArtifactPort
FindingArtifactAdapter ..|> FindingArtifactPort
CertificationArtifactAdapter ..|> CertificationArtifactPort
InspectionArtifactAdapter --> ObjectStoreClient
FindingArtifactAdapter --> ObjectStoreClient
CertificationArtifactAdapter --> ObjectStoreClient
HttpTargetSourcesGateway ..|> TargetSourcesGateway

' Detection evaluators live under inspections path (not a C4 peer engine).
package "inspections_infrastructure\n(evaluators)" as INFRA_DET #FFE0B2/F57C00 {
  class "**DetectionEvaluator**" as DetectionEvaluator {
    + ValidateDetectionSpec(...)
    + EvaluateControls(...)
    --
    <<pure>> no I/O · no randomness (AA-03)
  }
}

package "platform_infrastructure" as INFRA_PLAT #FFE0B2/F57C00 {
  class "**Hasher**" as Hasher {
    + ComputeSha256(data): String
    + ComposeHashes(parts): String
  }
  class "**HybridLogicalClock**" as HybridLogicalClock {
    + Now(): HlcTimestamp
    + Advance(remote): HlcTimestamp
  }
}

legend bottom
  |= Module |= Implements (ISP ports) |
  | directives_infrastructure | SqlDirectiveWriter / SqlCompilerReader / SqlGuidanceReader (one port each) |
  | compiled_rules_infrastructure | CompiledRulesRepository |
  | findings_infrastructure | FindingEventRepository + DenialAuditAdapter (ISP-split) |
  | artifacts_infrastructure | InspectionArtifactPort + FindingArtifactPort + CertificationArtifactPort (shared ObjectStoreClient) |
  | inspections_infrastructure | TargetSourcesGateway (resilient HTTP + SSRF allowlist) |
  | authorization (api support) | CapabilityEnforcer (shared class; all driving adapters) |
endlegend

@enduml
