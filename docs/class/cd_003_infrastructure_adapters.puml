!includeurl common/cd_styles.puml

title **CLS-003 — Infrastructure Adapters**\nROD port methods · {resource}_infrastructure modules\n

package "<<ports>>\nApplication ports" as PORTS #FCE4EC/C62828 {
  interface "**DirectiveRepository**" as DirectiveRepository <<Port>> {
    + GetDirective(lineage_id: LineageId): Directive
    + ListDirectives(filter: Map): List~Directive~
    + SaveDirective(directive: Directive): void
    + AllocateExecutionId(): ExecutionId
    + GetDirectiveExecutableDocument(id): ExecutableRuleDoc
    + GetDirectivePolicyDoctrine(ref: PairedPolicyRef): GuidancePayload
    + ListDirectivePolicyRefs(filter: Map): List~PairedPolicyRef~
  }
  interface "**CompiledRulesRepository**" as CompiledRulesRepository <<Port>> {
    + GetCompiledRules(snapshot_hash: String): CgIrSnapshot
    + GetLatestCompiledRules(): CgIrSnapshot
    + PublishCompiledRules(snapshot: CgIrSnapshot): void
  }
  interface "**FindingEventRepository**" as FindingEventRepository <<Port>> {
    + AppendFindingEvent(event: DomainEvent): void
    + ListFindingEvents(finding_id: FindingId): List~DomainEvent~
    + ListFindingEventsSince(from: HlcTimestamp): List~DomainEvent~
  }
  interface "**ArtifactRepository**" as ArtifactRepository <<Port>> {
    + SaveInspectionArtifact(snapshot: InspectionSnapshot): void
    + GetInspectionArtifact(id: UUID): InspectionSnapshot
    + SaveConflictArtifact(artifact: ConflictArtifact): void
    + GetConflictArtifact(id: UUID): ConflictArtifact
    + SaveCertificationArtifact(run: CertificationRun): void
  }
  interface "**TargetSourcesGateway**" as TargetSourcesGateway <<Port>> {
    + GetTarget(target_ref: String): Target
    + HashTarget(target: Target): TargetHash
  }
}

package "directives_infrastructure" as INFRA_DIR #FFE0B2/F57C00 {
  class "**SqlDirectiveRepository**" as SqlDirectiveRepository <<Adapter>> {
    + GetDirective(...)
    + ListDirectives(...)
    + SaveDirective(...)
    + GetDirectiveExecutableDocument(...)
    + GetDirectivePolicyDoctrine(...)
  }
}

package "compiled_rules_infrastructure" as INFRA_CR #FFE0B2/F57C00 {
  class "**ContentAddressedCompiledRulesRepository**" as ContentAddressedCompiledRulesRepository <<Adapter>> {
    + GetCompiledRules(...)
    + GetLatestCompiledRules(...)
    + PublishCompiledRules(...)
  }
}

package "findings_infrastructure" as INFRA_FE #FFE0B2/F57C00 {
  class "**AppendOnlyFindingEventRepository**" as AppendOnlyFindingEventRepository <<Adapter>> {
    + AppendFindingEvent(...)
    + ListFindingEvents(...)
    + ListFindingEventsSince(...)
  }
}

package "artifacts_infrastructure" as INFRA_ART #FFE0B2/F57C00 {
  class "**ObjectArtifactRepository**" as ObjectArtifactRepository <<Adapter>> {
    + SaveInspectionArtifact(...)
    + GetInspectionArtifact(...)
    + SaveConflictArtifact(...)
    + SaveCertificationArtifact(...)
  }
}

package "inspections_infrastructure" as INFRA_INS #FFE0B2/F57C00 {
  class "**HttpTargetSourcesGateway**" as HttpTargetSourcesGateway <<Adapter>> {
    + GetTarget(...)
    + HashTarget(...)
  }
}

' Detection evaluators live under inspections path (not a C4 peer engine).
package "inspections_infrastructure\n(evaluators)" as INFRA_DET #FFE0B2/F57C00 {
  class "**DetectionEvaluator**" as DetectionEvaluator {
    + ValidateDetectionSpec(...)
    + EvaluateControls(...)
    --
    <<pure>> no I/O · no randomness (AA-03)
  }
}

' Capability checks enforced at api gate (cross-cutting, not a store peer).
package "authorization (api support)" as INFRA_AUTH #FFE0B2/F57C00 {
  class "**CapabilitySource**" as CapabilitySource {
    + ListActorCapabilities(actor_id): Set~CapabilityId~
    + HasCapability(actor_id, capability): boolean
  }
}

package "platform_infrastructure" as INFRA_PLAT #FFE0B2/F57C00 {
  class "**Hasher**" as Hasher {
    + ComputeSha256(data): String
    + ComposeHashes(parts): String
  }
  class "**HybridLogicalClock**" as HybridLogicalClock {
    + Now(): HlcTimestamp
    + Advance(remote): HlcTimestamp
  }
}

DirectiveRepository <|.. SqlDirectiveRepository
CompiledRulesRepository <|.. ContentAddressedCompiledRulesRepository
FindingEventRepository <|.. AppendOnlyFindingEventRepository
ArtifactRepository <|.. ObjectArtifactRepository
TargetSourcesGateway <|.. HttpTargetSourcesGateway

