@startuml cd_002_application_services
' ============================================================
' Title:     CLS-002 Application Services
' Source:    docs/spec/contracts/
' C4:        directives|compilation|inspections|findings_application
' Package:   directives_application | compiled_rules_application |
'            inspections_application | findings_application
' Contract:  1.1.0
' ============================================================
' Owns: ISP port interfaces (method shapes), ROD use cases, application DTOs.
' Does not own: domain aggregates (CLS-001), adapter classes (CLS-003),
' package module edges (package/), peer Rel graph (c4-model/).

!include common/cd_styles.puml

title **CLS-002 — Application Services**\nROD use cases · ISP ports · DTOs\n

' ═══════════════════════════════════════════════════════════
'  ISP PORTS (owned by application packages)
' ═══════════════════════════════════════════════════════════
package "application.ports" as PORTS #FCE4EC/C62828 {

  interface "**DirectiveRepository**" as DirectiveRepository <<Port>> {
    + GetDirective(lineage_id: LineageId): Directive
    + ListDirectives(filter: Map): List~Directive~
    + SaveDirective(directive: Directive, if_match: ETag): void
    + AllocateExecutionId(): ExecutionId
    + EnqueueCompileRequest(lineage_id: LineageId, revision: Revision): void
    --
    <<owner>> directives_application
    <<implementer>> directives_infrastructure.SqlDirectiveWriter
  }

  interface "**CompilerReadPort**" as CompilerReadPort <<Port>> {
    + GetDirectiveExecutableDocument(id: LineageId | ExecutionId): ExecutableRuleDoc
    --
    <<owner>> compiled_rules_application
    <<c4>> compilation_application
    <<implementer>> directives_infrastructure.SqlCompilerReader
  }

  interface "**GuidanceReadPort**" as GuidanceReadPort <<Port>> {
    + GetDirectivePolicyDoctrine(ref: PairedPolicyRef): GuidancePayload
    --
    <<owner>> findings_application
    <<implementer>> directives_infrastructure.SqlGuidanceReader
  }

  interface "**CompiledRulesRepository**" as CompiledRulesRepository <<Port>> {
    + GetCompiledRules(snapshot_hash: SnapshotHash): CgIrSnapshot
    + GetLatestCompiledRules(lineage_id: LineageId): CgIrSnapshot
    + PublishCompiledRules(snapshot: CgIrSnapshot): void
    --
    <<owner>> compiled_rules_application
    <<consumers>> inspections_application · findings_application (SoD)
    <<implementer>> compiled_rules_infrastructure
  }

  interface "**FindingEventRepository**" as FindingEventRepository <<Port>> {
    + AppendFindingEvent(event: DomainEvent, expected_chain_head: String?): void
    + ListFindingEvents(finding_id: FindingId): List~DomainEvent~
    + ListFindingEventsSince(from: HlcTimestamp): List~DomainEvent~
    + GetFindingProjection(finding_id: FindingId): FindingProjection
    --
    <<owner>> findings_application
    <<implementer>> findings_infrastructure.AppendOnlyFindingEventRepository
  }

  interface "**FindingOpenPort**" as FindingOpenPort <<Port>> {
    + open_findings(inspection_id: UUID, findings: List~DetectionOutcome~): Result
    --
    <<owner>> findings_application
    <<implementer>> findings_application.OpenFindings
    <<consumer>> inspections_application
    <<atomic>> FindingCreated + Open
  }

  interface "**DenialAuditPort**" as DenialAuditPort <<Port>> {
    + AppendDenial(actor: ActorId, capability: String, action: String, reason: String, timestamp: HlcTimestamp): void
    --
    <<owner>> findings_application
    <<consumer>> rest|cli|tui_interface only
    <<implementer>> findings_infrastructure.DenialAuditAdapter
  }

  interface "**InspectionArtifactPort**" as InspectionArtifactPort <<Port>> {
    + SaveInspectionArtifact(snapshot: Inspection): void
    + GetInspectionArtifact(id: UUID): Inspection
    --
    <<owner>> inspections_application
    <<implementer>> artifacts_infrastructure.InspectionArtifactAdapter
  }

  interface "**FindingArtifactPort**" as FindingArtifactPort <<Port>> {
    + SaveConflictArtifact(artifact: ConflictArtifact): void
    + GetConflictArtifact(id: UUID): ConflictArtifact
    + SaveEvidenceArtifact(artifact: EvidenceRef): void
    --
    <<owner>> findings_application
    <<implementer>> artifacts_infrastructure.FindingArtifactAdapter
  }

  interface "**CertificationArtifactPort**" as CertificationArtifactPort <<Port>> {
    + SaveCertificationArtifact(run: CertificationRun): void
    --
    <<owner>> composition binds offline certification_tool
    <<implementer>> artifacts_infrastructure.CertificationArtifactAdapter
  }

  interface "**TargetSourcesGateway**" as TargetSourcesGateway <<Port>> {
    + GetTarget(target_ref: String): Target
    + HashTarget(target: Target): TargetHash
    --
    <<owner>> inspections_application
    <<implementer>> inspections_infrastructure.HttpTargetSourcesGateway
    <<resilience>> timeout · retries · circuit breaker · bulkhead
  }
}

' ═══════════════════════════════════════════════════════════
'  DTOs
' ═══════════════════════════════════════════════════════════
package "application.dto" as DTO_PKG #E8EAF6/3F51B5 {

  class "**DirectiveCreateRequest**" as DirectiveCreateRequest <<DTO>> #E8EAF6/3F51B5 {
    + lineage_id: LineageId
    + subject: Subject
    + predicate: Predicate
    + detection_spec: DetectionSpec
    + paired_policy_ref: PairedPolicyRef
    + applicability: Applicability
    + priority: Priority
    + modality: DeonticModality
  }

  class "**DirectiveUpdateRequest**" as DirectiveUpdateRequest <<DTO>> #E8EAF6/3F51B5 {
    + lineage_id: LineageId
    + if_match: ETag
    + changes: Map
  }

  class "**InspectRequest**" as InspectRequest <<DTO>> #E8EAF6/3F51B5 {
    + target_id: String
    + target_payload: Map
    + directive_lineage_ids: List~LineageId~
  }

  class "**InspectResponse**" as InspectResponse <<DTO>> #E8EAF6/3F51B5 {
    + inspection_id: UUID
    + finding_count: int
    + status: InspectionStatus
    + findings: List~FindingSummary~
  }

  class "**FindingTransitionRequest**" as FindingTransitionRequest <<DTO>> #E8EAF6/3F51B5 {
    + finding_id: FindingId
    + target_state: FindingState
    + reason: String
    + comments: String
  }

  class "**AggregateQueryRequest**" as AggregateQueryRequest <<DTO>> #E8EAF6/3F51B5 {
    + scope: String
    + period: DateRange
    + filters: Map
  }

  class "**DetectionOutcome**" as DetectionOutcome <<DTO>> #E8EAF6/3F51B5 {
    + control_id: String
    + severity: Severity
    + evidence: Map
  }

  class "**FindingSummary**" as FindingSummary <<DTO>> #E8EAF6/3F51B5 {
    + finding_id: FindingId
    + fsm_state: FindingState
    + severity: Severity
  }

  class "**ETag**" as ETag <<DTO>> #E8EAF6/3F51B5 {
    + value: String
  }
}

' ═══════════════════════════════════════════════════════════
'  directives_application
' ═══════════════════════════════════════════════════════════
package "directives_application" as UC_DIR #E8F5E9/2E7D32 {

  class "**CreateDirective**" as CreateDirective <<Use Case>> #E8F5E9/2E7D32 {
    - repo: DirectiveRepository
    - lineage: LineageService
    + execute(req: DirectiveCreateRequest): Directive
    --
    <<requires>> directive.create
  }

  class "**GetDirective**" as GetDirective <<Use Case>> #E8F5E9/2E7D32 {
    - repo: DirectiveRepository
    + execute(lineage_id: LineageId): Directive
  }

  class "**ListDirectives**" as ListDirectives <<Use Case>> #E8F5E9/2E7D32 {
    - repo: DirectiveRepository
    + execute(filter: Map): List~Directive~
  }

  class "**UpdateDirective**" as UpdateDirective <<Use Case>> #E8F5E9/2E7D32 {
    - repo: DirectiveRepository
    + execute(req: DirectiveUpdateRequest): Directive
    --
    <<requires>> directive.modify
  }

  class "**LifecycleTransitions**" as LifecycleTransitions <<Use Case>> #E8F5E9/2E7D32 {
    - repo: DirectiveRepository
    - lineage: LineageService
    + Retire(lineage_id: LineageId): Directive
    + Fork(source: LineageId): Directive
    + Merge(left: LineageId, right: LineageId): Directive
    + Split(source: LineageId): List~Directive~
    + Restore(lineage_id: LineageId, revision: Revision): Directive
    --
    <<requires>> directive.retire|fork|merge|restore
  }
}

' ═══════════════════════════════════════════════════════════
'  compiled_rules_application (C4: compilation_application)
' ═══════════════════════════════════════════════════════════
package "compiled_rules_application\n(C4: compilation_application)" as UC_CR #E8F5E9/2E7D32 {

  class "**CompileDirectives**" as CompileDirectives <<Use Case>> #E8F5E9/2E7D32 {
    - compilerRead: CompilerReadPort
    - compiledRules: CompiledRulesRepository
    - resolveConflict: ResolveConflict
    + execute(lineage_ids: List~LineageId~): CgIrSnapshot
  }

  class "**PublishCompiledRules**" as PublishCompiledRules <<Use Case>> #E8F5E9/2E7D32 {
    - compiledRules: CompiledRulesRepository
    + execute(snapshot: CgIrSnapshot): void
  }

  class "**DrainOutbox**" as DrainOutbox <<Use Case>> #E8F5E9/2E7D32 {
    - compile: CompileDirectives
    + execute(): int
    --
    <<role>> drains compile_request outbox
  }

  class "**ValidateDirectiveDocuments**" as ValidateDirectiveDocuments <<Use Case>> #E8F5E9/2E7D32 {
    + execute(directive: Directive): ValidationResult
  }
}

' ═══════════════════════════════════════════════════════════
'  inspections_application
' ═══════════════════════════════════════════════════════════
package "inspections_application" as UC_INS #E8F5E9/2E7D32 {

  class "**CreateInspection**" as CreateInspection <<Use Case>> #E8F5E9/2E7D32 {
    - targets: TargetSourcesGateway
    - compiledRules: CompiledRulesRepository
    - artifacts: InspectionArtifactPort
    - pipeline: RunInspectionPipeline
    + execute(req: InspectRequest): InspectResponse
    --
    <<requires>> inspection.submit
  }

  class "**GetInspection**" as GetInspection <<Use Case>> #E8F5E9/2E7D32 {
    - artifacts: InspectionArtifactPort
    + execute(id: UUID): Inspection
  }

  class "**RunInspectionPipeline**" as RunInspectionPipeline <<Use Case>> #E8F5E9/2E7D32 {
    - compiledRules: CompiledRulesRepository
    - artifacts: InspectionArtifactPort
    - findingOpen: FindingOpenPort
    - resolveConflict: ResolveConflict
    + execute(inspection: Inspection, snapshot: CgIrSnapshot): InspectResponse
  }
}

' ═══════════════════════════════════════════════════════════
'  findings_application
' ═══════════════════════════════════════════════════════════
package "findings_application" as UC_FIND #E8F5E9/2E7D32 {

  class "**GetFinding**" as GetFinding <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    + execute(finding_id: FindingId): FindingProjection
    --
    <<requires>> finding.view
  }

  class "**ListFindings**" as ListFindings <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    + execute(filter: Map): List~FindingProjection~
    --
    <<requires>> finding.view
  }

  class "**TransitionFinding**" as TransitionFinding <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    - fsm: FindingFsm
    - compiledRules: CompiledRulesRepository
    + execute(req: FindingTransitionRequest, actor: ActorId): FindingProjection
    --
    <<requires>> finding.acknowledge|waive|dismiss|verify
  }

  class "**GetFindingGuidance**" as GetFindingGuidance <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    - guidance: GuidanceReadPort
    + execute(finding_id: FindingId): GuidancePayload
  }

  class "**AttachEvidence**" as AttachEvidence <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    - artifacts: FindingArtifactPort
    + execute(finding_id: FindingId, evidence: EvidenceRef): FindingProjection
    --
    <<requires>> evidence.submit
  }

  class "**OpenFindings**" as OpenFindings <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    - fsm: FindingFsm
    + open_findings(inspection_id: UUID, findings: List~DetectionOutcome~): Result
    --
    <<implements>> FindingOpenPort
  }

  class "**ListFindingAggregates**" as ListFindingAggregates <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    + execute(req: AggregateQueryRequest): AggregateReport
    --
    <<requires>> analytics.view
  }

  class "**ReviewConflictArtifact**" as ReviewConflictArtifact <<Use Case>> #E8F5E9/2E7D32 {
    - artifacts: FindingArtifactPort
    - events: FindingEventRepository
    + execute(artifact_id: UUID, decision: String): ConflictArtifact
    --
    <<requires>> conflict.resolve
  }
}

