!include common/cd_styles.puml

title **CLS-002 — Application Services**\nSelma · Rule Regularity Platform\n

' ═══════════════════════════════════════════════════════════
'  PORT INTERFACES
' ═══════════════════════════════════════════════════════════
package "<<application.ports>>\nRepository & Gateway Ports" as PORTS #FCE4EC/C62828 {

  interface "**DirectiveRepository**" as DirectiveRepository <<Port>> {
    + GetDirective(lineage_id: LineageId): Directive
    + ListDirectives(filter: Map): List~Directive~
    + SaveDirective(directive: Directive, if_match: ETag): void
    + AllocateExecutionId(): ExecutionId
    + EnqueueCompileRequest(lineage_id: LineageId, revision: int): void
    --
    <<owner>> directives_application
  }

  interface "**CompilerReadPort**" as CompilerReadPort <<Port>> {
    + GetDirectiveExecutableDocument(id: LineageId | ExecutionId): ExecutableRuleDoc
    --
    <<owner>> compiled_rules_application (C4: compilation_application)
    <<ISP>> compile path only; no doctrine
  }

  interface "**GuidanceReadPort**" as GuidanceReadPort <<Port>> {
    + GetDirectivePolicyDoctrine(ref: PairedPolicyRef): GuidancePayload
    --
    <<owner>> findings_application
    <<ISP>> guidance_only; revision-pinned ref
  }

  interface "**CompiledRulesRepository**" as CompiledRulesRepository <<Port>> {
    + GetCompiledRules(snapshot_hash: String): CgIrSnapshot
    + GetLatestCompiledRules(lineage_id): CgIrSnapshot
    + PublishCompiledRules(snapshot: CgIrSnapshot): void
  }

  interface "**FindingEventRepository**" as FindingEventRepository <<Port>> {
    + AppendFindingEvent(event: DomainEvent, expected_chain_head: String?): void
    + ListFindingEvents(finding_id: FindingId): List~DomainEvent~
    + ListFindingEventsSince(from: HlcTimestamp): List~DomainEvent~
    + GetFindingProjection(finding_id: FindingId): FindingProjection
  }

  interface "**DenialAuditPort**" as DenialAuditPort <<Port>> {
    + AppendDenial(actor: ActorId, capability: String, action: String, reason: String, timestamp: HlcTimestamp): void
    --
    <<owner>> findings_application (application-owned)
    <<consumer>> api / rest_interface only
    <<implementer>> findings_infrastructure / finding_events_repository
  }

  interface "**InspectionArtifactPort**" as InspectionArtifactPort <<Port>> {
    + SaveInspectionArtifact(snapshot: InspectionSnapshot): void
    + GetInspectionArtifact(id: UUID): InspectionSnapshot
    --
    <<owner>> inspections_application
  }

  interface "**FindingArtifactPort**" as FindingArtifactPort <<Port>> {
    + SaveConflictArtifact(artifact: ConflictArtifact): void
    + GetConflictArtifact(id: UUID): ConflictArtifact
    + SaveEvidenceArtifact(artifact: EvidenceArtifact): void
    --
    <<owner>> findings_application
  }

  interface "**CertificationArtifactPort**" as CertificationArtifactPort <<Port>> {
    + SaveCertificationArtifact(run: CertificationRun): void
    --
    <<owner>> certification_tool (offline)
  }

  interface "**TargetSourcesGateway**" as TargetSourcesGateway <<Port>> {
    + GetTarget(target_ref: String): Target
    + HashTarget(target: Target): TargetHash
    --
    <<resilience>> timeout ≤5s; retries ≤2; circuit breaker; bulkhead pool
  }

}

' ═══════════════════════════════════════════════════════════
'  APPLICATION DTOs
' ═══════════════════════════════════════════════════════════
package "<<application.dto>>\nData Transfer Objects" as DTO_PKG #E8EAF6/3F51B5 {

  class "**InspectRequest**" as InspectRequest <<DTO>> #E8EAF6/3F51B5 {
    + target_id: String
    + target_payload: Map
    + directive_ids: List~LineageId~
  }

  class "**InspectResponse**" as InspectResponse <<DTO>> #E8EAF6/3F51B5 {
    + inspection_id: UUID
    + finding_count: int
    + status: InspectionStatus
    + findings: List~FindingSummary~
  }

  class "**QueryRequest**" as QueryRequest <<DTO>> #E8EAF6/3F51B5 {
    + scope: String
    + period: DateRange
    + filters: Map
  }

  class "**DirectiveCreateRequest**" as DirectiveCreateRequest <<DTO>> #E8EAF6/3F51B5 {
    + lineage_id: LineageId
    + subject: Subject
    + predicate: Predicate
    + detection_spec: DetectionSpec
    + paired_policy_ref: PairedPolicyRef
    + applicability: Applicability
    + priority: Priority
    + modality: DeonticModality
  }
}

' ═══════════════════════════════════════════════════════════
'  GOVERNANCE USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.directives_application>>\nDirectives Application" as UC_GOVERNANCE #E8F5E9/2E7D32 {

  abstract class "**CreateDirective**" as CreateDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + CreateDirective(req: DirectiveCreateRequest): Directive
    --
    <<requires>> directive.create
    <<module>> directives_application
  }

  abstract class "**UpdateDirective**" as UpdateDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + UpdateDirective(id: LineageId, changes: Map): Directive
    --
    <<requires>> directive.modify
    <<module>> directives_application
  }

  abstract class "**RetireDirective**" as RetireDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + RetireDirective(id: LineageId): Directive
    --
    <<requires>> directive.retire
    <<module>> directives_application
  }

  abstract class "**ForkDirective**" as ForkDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + ForkDirective(source: LineageId): Directive
    --
    <<requires>> directive.fork
    <<module>> directives_application
  }

  abstract class "**MergeDirectives**" as MergeDirectives <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + MergeDirectives(left: LineageId, right: LineageId): Directive
    --
    <<requires>> directive.merge
    <<module>> directives_application
  }

  abstract class "**SplitDirective**" as SplitDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - lineageService: LineageService
    + SplitDirective(source: LineageId): List~Directive~
    --
    <<requires>> directive.fork
    <<module>> directives_application
  }

  abstract class "**RestoreDirective**" as RestoreDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + RestoreDirective(id: LineageId, revision: int): Directive
    --
    <<requires>> directive.restore
    <<module>> directives_application
  }

  abstract class "**GetDirective**" as GetDirective <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + GetDirective(id: LineageId): Directive
    --
    <<module>> directives_application
  }

  abstract class "**ListDirectives**" as ListDirectives <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + ListDirectives(filter: Map): List~Directive~
    --
    <<module>> directives_application
  }
}

' ═══════════════════════════════════════════════════════════
'  COMPILATION USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.compilation_application>>\nCompilation Application" as UC_COMPILATION #E8F5E9/2E7D32 {

  abstract class "**CompileDirectives**" as CompileDirectives <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    - compiledRulesRepo: CompiledRulesRepository
    + CompileDirectives(lineageIds: List~LineageId~): CgIrSnapshot
    --
    <<module>> compilation_application
  }

  abstract class "**ValidateDirectiveDocuments**" as ValidateDirectiveDocuments <<Use Case>> #E8F5E9/2E7D32 {
    + ValidateDirectiveDocuments(directive: Directive): ValidationResult
    --
    <<module>> compilation_application
  }

  abstract class "**PublishCompiledRules**" as PublishCompiledRules <<Use Case>> #E8F5E9/2E7D32 {
    - compiledRulesRepo: CompiledRulesRepository
    + PublishCompiledRules(snapshot: CgIrSnapshot): void
    --
    <<module>> compilation_application
  }
}

' ═══════════════════════════════════════════════════════════
'  INSPECTION USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.inspections_application>>\nInspections Application" as UC_INSPECTION #E8F5E9/2E7D32 {

  abstract class "**CreateInspection**" as CreateInspection <<Use Case>> #E8F5E9/2E7D32 {
    - targetGateway: TargetSourcesGateway
    - compiledRulesRepo: CompiledRulesRepository
    - artifactRepo: ArtifactRepository
    + CreateInspection(req: InspectRequest): InspectResponse
    --
    <<module>> inspections_application
    <<requires>> inspection.submit
  }

  abstract class "**GetInspection**" as GetInspection <<Use Case>> #E8F5E9/2E7D32 {
    - artifactRepo: ArtifactRepository
    + GetInspection(id: UUID): InspectionSnapshot
    --
    <<module>> inspections_application
  }
}

' ═══════════════════════════════════════════════════════════
'  FINDING USE CASES
' ═══════════════════════════════════════════════════════════
package "<<use_cases.findings_application>>\nFindings Application" as UC_FINDING #E8F5E9/2E7D32 {

  abstract class "**CreateFinding**" as CreateFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - events: FindingEventRepository
    + CreateFinding(inspection_id: UUID, outcome: DetectionOutcome): Finding
    --
    <<module>> findings_application
  }

  abstract class "**AcknowledgeFinding**" as AcknowledgeFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - events: FindingEventRepository
    + AcknowledgeFinding(finding_id: FindingId): Finding
    --
    <<requires>> finding.acknowledge
    <<module>> findings_application
  }

  abstract class "**SubmitFindingEvidence**" as SubmitFindingEvidence <<Use Case>> #E8F5E9/2E7D32 {
    - artifactRepo: ArtifactRepository
    - events: FindingEventRepository
    + SubmitFindingEvidence(finding_id: FindingId, evidence: EvidenceRef): Finding
    --
    <<requires>> evidence.submit
    <<module>> findings_application
  }

  abstract class "**WaiveFinding**" as WaiveFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - events: FindingEventRepository
    + WaiveFinding(finding_id: FindingId, reason: String): Finding
    --
    <<requires>> finding.waive
    <<SoD>> actor ∉ creator_provenance
    <<module>> findings_application
  }

  abstract class "**DismissFinding**" as DismissFinding <<Use Case>> #E8F5E9/2E7D32 {
    - findingFsm: FindingFsm
    - events: FindingEventRepository
    + DismissFinding(finding_id: FindingId, reason: String): Finding
    --
    <<requires>> finding.dismiss
    <<module>> findings_application
  }

  abstract class "**GetFinding**" as GetFinding <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    + GetFinding(finding_id: FindingId): Finding
    --
    <<requires>> finding.view
    <<module>> findings_application
  }

  abstract class "**ListFindings**" as ListFindings <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    + ListFindings(filter: Map): List~Finding~
    --
    <<requires>> finding.view
    <<module>> findings_application
  }

  abstract class "**GetFindingGuidance**" as GetFindingGuidance <<Use Case>> #E8F5E9/2E7D32 {
    - directiveRepo: DirectiveRepository
    + GetFindingGuidance(finding_id: FindingId): GuidancePayload
    --
    <<guidance_only>> GetDirectivePolicyDoctrine
    <<module>> findings_application
  }
}

' ═══════════════════════════════════════════════════════════
'  ARTIFACT / CONFLICT REVIEW (not freestanding C4 engines)
'  ResolveConflict domain service lives under domain;
'  human review is findings/artifacts-backed convenience.
' ═══════════════════════════════════════════════════════════
package "<<use_cases.findings_application>>\nConflict artifact review\n(findings + artifacts · not a C4 peer)" as UC_CONFLICT_REVIEW #E8F5E9/2E7D32 {

  abstract class "**ReviewConflictArtifact**" as ReviewConflictArtifact <<Use Case>> #E8F5E9/2E7D32 {
    - artifactRepo: ArtifactRepository
    - events: FindingEventRepository
    + ReviewConflictArtifact(artifact_id: UUID, decision: String): ConflictArtifact
    --
    <<requires>> conflict.resolve
    <<module>> findings_application
    note: deterministic resolve is domain service\nused by compilation/inspections_application
  }

  abstract class "**ListFindingAggregates**" as ListFindingAggregates <<Use Case>> #E8F5E9/2E7D32 {
    - events: FindingEventRepository
    + ListFindingAggregates(req: QueryRequest): AggregateReport
    --
    <<requires>> analytics.view
    <<module>> findings_application
    note: read model over finding_events_store\n— not a freestanding analytics engine
  }
}

note as N_CERT
  **certification_tool (offline/CI)**
  AA-01…AA-08 are **not** in-process application use cases.
  The tool suite may write certification blobs via
  ArtifactRepository → artifacts_store.
  Clients **read** them as Artifacts (kind=certification).
  See contracts/certification/gates.yaml.
end note

