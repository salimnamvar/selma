# Software Design Toolchain — Environment Configuration
# Copy to .env and adjust values as needed.

# Usecase-Diagram configuration
UD_RULES_DIR=~/.agent-global/shared/rules/software-design/usecase-diagram
UD_TEMPLATES_DIR=~/.agent-global/shared/templates
UD_SHARED_DIR=~/.agent-global/shared
