{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts/policy-schema.json",
  "title": "Policy Schema",
  "description": "Machine contract for policy data files. Supports both specific rules (executable checks) and flexible standards (principle-based guidelines).",
  "type": "object",
  "required": ["version", "name", "description", "policies"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of the contract format."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Kebab-case domain name."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "One-line description of what this policy domain covers."
    },
    "prose": {
      "type": "object",
      "description": "Reference to the human-readable policy document.",
      "required": ["document"],
      "properties": {
        "document": {
          "type": "string",
          "description": "Filename of the policy document."
        }
      },
      "additionalProperties": false
    },
    "tooling": {
      "type": "object",
      "description": "Paths to executable tooling scripts.",
      "properties": {
        "check": { "type": "string", "description": "Path to check script." },
        "fix": { "type": "string", "description": "Path to fix script." }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Validation scope names this domain supports."
    },
    "discovery": {
      "type": "object",
      "description": "File and content discovery configuration.",
      "properties": {
        "file_glob": { "type": "string", "description": "Glob pattern for target files." },
        "content_glob": { "type": "string", "description": "Glob pattern for content files." },
        "skip_dir_names": { "type": "array", "items": { "type": "string" }, "description": "Directory names to skip." },
        "skip_file_patterns": { "type": "array", "items": { "type": "string" }, "description": "File patterns to skip." }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "additionalProperties": { "type": ["integer", "number", "string", "boolean"] },
      "description": "Named thresholds referenced by policies (DRY — single source of truth)."
    },
    "vocabulary": {
      "type": "object",
      "description": "Shared word lists and term registries used by policies.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "patterns": {
      "type": "object",
      "description": "Named regex and lexical patterns used by policies.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "regex": { "type": "string", "description": "Regex pattern string." },
          "description": { "type": "string", "description": "Human-readable description." },
          "examples": { "type": "array", "items": { "type": "string" }, "description": "Example matches." }
        },
        "additionalProperties": true
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/policy" },
      "description": "Policy definitions — specific rules and flexible standards."
    },
    "extensions": {
      "type": "object",
      "description": "Domain-specific extension data. Unconstrained.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "policy": {
      "type": "object",
      "required": ["id", "type", "scope", "severity", "message", "policy_ref"],
      "description": "A single policy item — either a specific rule or a flexible standard.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Stable policy ID. Prefix matches domain name, e.g. XX-001, XX-002."
        },
        "type": {
          "type": "string",
          "enum": ["rule", "standard"],
          "description": "Rule = specific, executable check with clear trigger and consequence. Standard = principle-based guideline allowing interpretation."
        },
        "scope": {
          "type": "string",
          "description": "When the policy runs. Must match a declared layer."
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "description": "Violation severity."
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "description": "Violation message template."
        },
        "check_type": {
          "type": "string",
          "minLength": 1,
          "description": "Executor key in the check registry. Required for type=rule, omitted for type=standard."
        },
        "principle": {
          "type": "string",
          "description": "Guiding principle for reasoning output."
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Cross-reference to policy document section ID. Must match a section ID defined in policy-doc.yaml."
        },
        "reasoning": {
          "type": "string",
          "description": "Why the policy exists."
        },
        "fix": {
          "type": "string",
          "description": "Actionable fix suggestion."
        },
        "params": {
          "type": "object",
          "description": "Policy-specific parameters passed to the check function.",
          "properties": {
            "pattern": { "type": "string", "description": "Regex pattern to match against." },
            "glob": { "type": "string", "description": "Glob pattern for file matching." },
            "max_length": { "type": "integer", "description": "Maximum allowed length." },
            "min_length": { "type": "integer", "description": "Minimum required length." },
            "allowed_values": { "type": "array", "items": { "type": "string" }, "description": "List of allowed values." },
            "case_sensitive": { "type": "boolean", "description": "Whether matching is case-sensitive." }
          },
          "additionalProperties": false
        },
        "skip_when": {
          "type": "object",
          "description": "Conditions to skip this policy.",
          "properties": {
            "file_matches": { "type": "string", "description": "Skip if filename matches this glob." },
            "dir_matches": { "type": "string", "description": "Skip if directory matches this pattern." },
            "extension_in": { "type": "array", "items": { "type": "string" }, "description": "Skip if file extension is in this list." },
            "path_contains": { "type": "string", "description": "Skip if file path contains this string." }
          },
          "additionalProperties": false
        },
        "interpretation": {
          "type": "object",
          "description": "Guidance for applying judgment. Use with type=standard.",
          "properties": {
            "factors": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Relevant considerations when interpreting this standard."
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "context": { "type": "string" },
                  "outcome": { "type": "string" }
                }
              },
              "description": "Illustrative scenarios showing how the standard applies."
            },
            "anti_patterns": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Common misinterpretations to avoid."
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "rule" } } },
          "then": { "required": ["check_type"] }
        },
        {
          "if": { "properties": { "type": { "const": "standard" } } },
          "then": { "required": ["principle", "interpretation"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
