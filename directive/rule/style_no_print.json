{
  "lineage_id": "STYLE-3",
  "id": "STYLE-3-NO-PRINT",
  "type": "prohibition",
  "message": "print() used in production code",
  "evaluator_type": "ast_call_check",
  "evaluator_config": {
    "forbidden_functions": [
      "print"
    ],
    "message_template": "print() detected in production code \u2014 use logging or structlog"
  },
  "weight": "low",
  "priority": "operational",
  "status": "active",
  "created_at": "2026-07-25T00:00:00Z",
