{
  "lineage_id": "SC-010",
  "id": "SC-010",
  "type": "obligation",
  "message": "Function exceeds 150 executable statement nodes",
  "evaluator_type": "ast_walk",
  "evaluator_config": {
    "walk_nodes": [
      "Assign",
      "Expr",
      "If",
      "For",
      "While",
      "With",
      "Try",
      "Raise",
      "Assert"
    ],
    "scope_filters": {
      "exclude_name_matches": [
        "^__.*__$"
      ],
      "exclude_decorators": [
        "property",
        "cached_property"
      ]
    },
    "count": {
      "operator": "gt",
      "value": 150
    },
    "message_template": "Function '{name}' has {count} executable statement nodes (max 150)",
    "root_nodes": [
      "FunctionDef",
      "AsyncFunctionDef"
    ]
  },
  "weight": "medium",
  "priority": "regulatory",
  "status": "active",
  "created_at": "2026-07-25T00:00:00Z",
  "anchor_ref": "section:directives/sc010_function_length",
  "rationale": "Long functions are cognitively opaque. The universal limit of 150 executable statement nodes accommodates legitimate high-density pure functions (dispatch tables, schema walkers) while still flagging unbounded growth. Dunders and properties are out of scope.",
  "remediation": "Decompose into sub-functions. Each function should have a single, well-defined responsibility.",
  "parameters": {
    "max_lines": 150
  }
}
